ask.cancel()\n42\t\n43\t\n44\tapp = FastAPI(title=\"Ассистент разработчика и поддержки\", lifespan=lifespan)\n45\tapp.mount(\"/mcp/git\", git_mcp.server.streamable_http_app(streamable_http_path=\"/\"))\n46\tapp.mount(\"/mcp/crm\", crm_mcp.server.streamable_http_app(streamable_http_path=\"/\"))\n47\tapp.mount(\"/mcp/files\", files_mcp.server.streamable_http_app(streamable_http_path=\"/\"))\n48\t\n49\t\n50\tclass Command(BaseModel):\n51\t    text: str\n52\t\n53\t\n54\tclass Question(BaseModel):\n55\t    question: str\n56\t    ticket_id: str | None = None\n57\t\n58\t\n59\tclass Task(BaseModel):\n60\t    goal: str\n61\t\n62\t\n63\t@app.get(\"/\", include_in_schema=False)\n64\tasync def page():\n65\t    return FileResponse(PAGE)\n66\t\n67\t\n68\t@app.get(\"/support\", include_in_schema=False)\n69\tasync def support_page():\n70\t    return FileResponse(SUPPORT_PAGE)\n71\t\n72\t\n73\t@app.get(\"/files\", include_in_schema=False)\n74\tasync def files_page():\n75\t    return FileResponse(FILES_PAGE)\n76\t\n77\t\n78\t@app.get(\"/api/status\")\n79\tasync def status():\n80\t    ollama, project = await asyncio.gather(llm.status(), assistant.project())\n81\t    return {\"project\": {**project, \"path\": str(config.PROJECT_DIR)}, \"ollama\": ollama,\n82\t            \"model\": config.MODEL, \"embed_model\": config.EMBED_MODEL, \"docs\": rag.info()}\n83\t\n84\t\n85\t@app.post(\"/api/help\")\n86\tasync def help_command(command: Command):\n87\t    question = assistant.parse(command.text)\n88\t    if question is None:\n89\t        raise HTTPException(status_code=400, detail=\"Команда ассистента: /help <вопрос о проекте>\")\n90\t\n91\t    async def stream():\n92\t        async for event in assistant.answer(question):\n93\t            yield assistant.dumps(event)\n94\t\n95\t    return StreamingResponse(stream(), media_type=\"application/x-ndjson\")\n96\t\n97\t\n98\t@app.get(\"/api/support/status\")\n99\tasync def support_status():\n100\t    ollama, crm = await asyncio.gather(llm.status(), support.queue())\n101\t    return {\"ollama\": ollama, \"model\": config.MODEL, \"embed_model\": config.EMBED_MODEL,\n102\t            \"kb\": support.index.info(), \"crm\": crm}\n103\t\n104\t\n105\t@app.post(\"/api/support/answer\")\n106\tasync def support_answer(body: Question):\n107\t    question = body.question.strip()\n108\t    if not question:\n109\t        raise HTTPException(status_code=400, detail=\"Напишите вопрос клиента\")\n110\t\n111\t    async def stream():\n112\t        async for event in support.answer(body.ticket_id, question):\n113\t            yield assistant.dumps(event)\n114\t\n115\t    return StreamingResponse(stream(), media_type=\"application/x-ndjson\")\n116\t\n117\t\n118\t@app.post(\"/api/files/run\")\n119\tasync def files_run(task: Task):\n120\t    goal = task.goal.strip()\n121\t    if not goal:\n122\t        raise HTTPException(status_code=400, detail=\"Напишите задачу: что найти, обновить или создать\")\n123\t\n124\t    async def stream():\n125\t        async for event in files.run(goal):\n126\t            yield assistant.dumps(event)\n127\t\n128\t    return StreamingResponse(stream(), media_type=\"application/x-ndjson\")\n129\t\n130\t\n131\t@app.post(\"/api/files/apply\")\n132\tasync def files_apply():\n133\t    return await files.apply()\n134\t\n135\t\n136\t@app.post(\"/api/files/discard\")\n137\tasync def files_discard():\n138\t    return await files.discard()\n139\t\n140\t\n141\t@app.exception_handler(RequestValidationError)\n142\tasync def validation_error_handler(request: Request, exc: RequestValidationError):\n143\t    \"\"\"Перевод ошибок валидации FastAPI в 400 с русским текстом.\"\"\"\n144\t    errors = exc.errors()\n145\t    # Извлекаем имя поля из пути (location)\n146\t    field_name = None\n147\t    for err in errors:\n148\t        loc = err.get(\"loc\", [])\n149\t        if len(loc) > 1:\n150\t            field_name = loc[1]  # 'body' -> 'text' или 'question' или 'goal'\n151\t            break\n152\t    if not field_name:\n153\t        return JSONResponse(\n154\t            status_code=400,\n155\t            content={\"detail\": \"Неверный формат запроса\"}\n156\t        )\n157\t    # Русские описания полей\n158\t    field_desc = {\n159\t        \"text\": \"Команда ассистента: /help <вопрос о проекте>\",\n160\t        \"question\": \"Напишите вопрос клиента\",\n161\t        \"goal\": \"Напишите задачу: что найти, обновить или создать\"\n162\t    }\n163\t    return JSONResponse(\n164\t        status_code=400,\n165\t        content={\"detail\": field_desc.get(field_name, f\"Поле '{field_name}' неверно\")}\n166\t    )\n167\t\n168\t\n169\tif __name__ == \"__main__\":\n170\t    uvicorn.run(app, host=config.HOST, port=config.PORT)\n171\t"}]},"parent_tool_use_id":null,"session_id":"abc01440-c85f-4913-aa71-ad562c627436","uuid":"6ab04c02-22b9-4162-9269-33accdc81ebd","timestamp":"2026-10-24T22:52:19.960Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\USER\\AppData\\Local\\Temp\\claude-rules\\loop-v1\\app\\main.py","content":"\"\"\"Ассистент разработчика и поддержки: страница /help, место оператора поддержки /support, работа с файлами\nпроекта /files, MCP-серверы git на /mcp/git, CRM на /mcp/crm и файлов на /mcp/files.\"\"\"\nimport asyncio\nimport logging\nfrom contextlib import asynccontextmanager\n\nimport uvicorn\nfrom fastapi import FastAPI, HTTPException, Request\nfrom fastapi.exceptions import RequestValidationError\nfrom fastapi.responses import FileResponse, JSONResponse, StreamingResponse\nfrom pydantic import BaseModel\n\nfrom app import assistant, config, crm_mcp, files, files_mcp, git_mcp, llm, rag, support\n\nlogging.basicConfig(level=logging.INFO)\nlogger = logging.getLogger(__name__)\n\nPAGE = config.ROOT / \"static\" / \"index.html\"\nSUPPORT_PAGE = config.ROOT / \"static\" / \"support.html\"\nFILES_PAGE = config.ROOT / \"static\" / \"files.html\"\n\n\nasync def warm_up():\n    \"\"\"Векторы документации и базы знаний, модель — при старте, чтобы первый вопрос не ждал.\"\"\"\n    try:\n        logger.info(\"Индекс документации: %s\", await rag.ensure_index())\n        logger.info(\"База знаний поддержки: %s\", await support.ensure_index())\n        await llm.load()\n        logger.info(\"Модель %s загружена в память\", config.MODEL)\n    except Exception as exc:\n        logger.warning(\"Подготовка не завершена: %s\", exc)\n\n\n@asynccontextmanager\nasync def lifespan(app):\n    # у смонтированных приложений MCP свой lifespan не запускается — менеджеры сессий поднимаем здесь\n    async with git_mcp.server.session_manager.run(), crm_mcp.server.session_manager.run(), \\\n            files_mcp.server.session_manager.run():\n        task = asyncio.create_task(warm_up())\n        yield\n        task.cancel()\n\n\napp = FastAPI(title=\"Ассистент разработчика и поддержки\", lifespan=lifespan)\napp.mount(\"/mcp/git\", git_mcp.server.streamable_http_app(streamable_http_path=\"/\"))\napp.mount(\"/mcp/crm\", crm_mcp.server.streamable_http_app(streamable_http_path=\"/\"))\napp.mount(\"/mcp/files\", files_mcp.server.streamable_http_app(streamable_http_path=\"/\"))\n\n\nclass Command(BaseModel):\n    text: str\n\n\nclass Question(BaseModel):\n    question: str\n    ticket_id: str | None = None\n\n\nclass Task(BaseModel):\n    goal: str\n\n\n@app.get(\"/\", include_in_schema=False)\nasync def page():\n    return FileResponse(PAGE)\n\n\n@app.get(\"/support\", include_in_schema=False)\nasync def support_page():\n    return FileResponse(SUPPORT_PAGE)\n\n\n@app.get(\"/files\", include_in_schema=False)\nasync def files_page():\n    return FileResponse(FILES_PAGE)\n\n\n@app.get(\"/api/status\")\nasync def status():\n    ollama, project = await asyncio.gather(llm.status(), assistant.project())\n    return {\"project\": {**project, \"path\": str(config.PROJECT_DIR)}, \"ollama\": ollama,\n            \"model\": config.MODEL, \"embed_model\": config.EMBED_MODEL, \"docs\": rag.info()}\n\n\n@app.post(\"/api/help\")\nasync def help_command(command: Command):\n    question = assistant.parse(command.text)\n    if question is None:\n        raise HTTPException(status_code=400, detail=\"Команда ассистента: /help <вопрос о проекте>\")\n\n    async def stream():\n        async for event in assistant.answer(question):\n            yield assistant.dumps(event)\n\n    return StreamingResponse(stream(), media_type=\"application/x-ndjson\")\n\n\n@app.get(\"/api/support/status\")\nasync def support_status():\n    ollama, crm = await asyncio.gather(llm.status(), support.queue())\n    return {\"ollama\": ollama, \"model\": config.MODEL, \"embed_model\": config.EMBED_MODEL,\n            \"kb\": support.index.info(), \"crm\": crm}\n\n\n@app.post(\"/api/support/answer\")\nasync def support_answer(body: Question):\n    question = body.question.strip()\n    if not question:\n        raise HTTPException(status_code=400, detail=\"Напишите вопрос клиента\")\n\n    async def stream():\n        async for event in support.answer(body.ticket_id, question):\n            yield assistant.dumps(event)\n\n    return StreamingResponse(stream(), media_type=\"application/x-ndjson\")\n\n\n@app.post(\"/api/files/run\")\nasync def files_run(task: Task):\n    goal = task.goal.strip()\n    if not goal:\n        raise HTTPException(status_code=400, detail=\"Напишите задачу: что найти, обновить или создать\")\n\n    async def stream():\n        async for event in files.run(goal):\n            yield assistant.dumps(event)\n\n    return StreamingResponse(stream(), media_type=\"application/x-ndjson\")\n\n\n@app.post(\"/api/files/apply\")\nasync def files_apply():\n    return await files.apply()\n\n\n@app.post(\"/api/files/discard\")\nasync def files_discard():\n    return await files.discard()\n\n\n@app.exception_handler(RequestValidationError)\nasync def validation_error_handler(request: Request, exc: RequestValidationError):\n    \"\"\"Перевод ошибок валидации FastAPI в 400 с русским текстом.\"\"\"\n    errors = exc.errors()\n    # Извлекаем имя поля из пути (location)\n    field_name = None\n    for err in errors:\n        loc = err.get(\"loc\", [])\n        if len(loc) > 1:\n            field_name = loc[1]  # 'body' -> 'text' или 'question' или 'goal'\n            break\n    if not field_name:\n        return JSONResponse(\n            status_code=400,\n            content={\"detail\": \"Неверный формат запроса\"}\n        )\n    # Русские описания полей\n    field_desc = {\n        \"text\": \"Команда ассистента: /help <вопрос о проекте>\",\n        \"question\": \"Напишите вопрос клиента\",\n        \"goal\": \"Напишите задачу: что найти, обновить или создать\"\n    }\n    return JSONResponse(\n        status_code=400,\n        content={\"detail\": field_desc.get(field_name, f\"Поле '{field_name}' неверно\")}\n    )\n\n\nif __name__ == \"__main__\":\n    uvicorn.run(app, host=config.HOST, port=config.PORT)\n","numLines":171,"startLine":1,"totalLines":171}},"tool_result_meta":[{"id":"toolu_65299895dffd4d359576d9ff","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
