review.count(20, self.words), \"20 файлов\")\n\n    def test_count_one_21(self):\n        \"\"\"Число 21 использует форму 'one'.\"\"\"\n        self.assertEqual(review.count(21, self.words), \"21 файл\")\n\n    def test_count_one_111(self):\n        \"\"\"Число 111 — особенный случай (111 % 100 = 11), использует форму 'many'.\"\"\"\n        self.assertEqual(review.count(111, self.words), \"111 файлов\")\n\n    def test_count_large_number(self):\n        \"\"\"Большие числа форматируются с разделителями тысяч.\"\"\"\n        self.assertEqual(review.count(1234, self.words), \"1 234 файла\")\n\n\nclass NumberTest(unittest.TestCase):\n    \"\"\"Тестируем форматирование чисел.\"\"\"\n\n    def test_number_integer(self):\n        \"\"\"Целое число форматируется без дробной части.\"\"\"\n        self.assertEqual(review.number(1000, 0), \"1 000\")\n\n    def test_number_thousands_separator(self):\n        \"\"\"Разделитель тысяч — пробел.\"\"\"\n        self.assertEqual(review.number(1234567, 0), \"1 234 567\")\n\n    def test_number_decimal_comma(self):\n        \"\"\"Десятичный разделитель — запятая.\"\"\"\n        self.assertEqual(review.number(3.14159, 2), \"3,14\")\n\n    def test_number_format_combined(self):\n        \"\"\"Тысячи через пробел, дробь через запятую.\"\"\"\n        self.assertEqual(review.number(1234567.891, 2), \"1 234 567,89\")\n\n    def test_number_digits_param(self):\n        \"\"\"Параметр digits контролирует количество знаков после запятой.\"\"\"\n        self.assertEqual(review.number(2.5, 0), \"2\")\n        self.assertEqual(review.number(2.5, 1), \"2,5\")\n        self.assertEqual(review.number(2.5, 3), \"2,500\")\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n","numLines":88,"startLine":1,"totalLines":88}},"tool_result_meta":[{"id":"toolu_531827b2b058444d86c269e7","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
