{"type":"assistant","message":{"id":"msg_0b39804d-b1a4-914b-94d3-5c4ab36097c7","type":"message","role":"assistant","model":"qwen3.5-122b-a10b","content":[{"type":"tool_use","id":"toolu_2f1856d4249649deb287d6a3","name":"Write","input":{"file_path":"C:\\Users\\USER\\AppData\\Local\\Temp\\claude-rules\\loop-v1\\tests\\test_crm_mcp.py","content":"\"\"\"Тесты app/crm_mcp.py: инструменты MCP-сервера CRM поддержки.\"\"\"\nimport json\nimport tempfile\nimport unittest\nfrom pathlib import Path\n\nfrom mcp.server.mcpserver.exceptions import ToolError\n\nfrom app import crm_mcp\n\n\nclass ListTicketsTest(unittest.TestCase):\n    \"\"\"Тестируем list_tickets — очередь обращений.\"\"\"\n\n    def setUp(self):\n        \"\"\"Создаём временный CRM-файл.\"\"\"\n        self._crm_file = tempfile.NamedTemporaryFile(mode=\"w\", suffix=\".json\", delete=False)\n        json.dump({\n            \"users\": [\n                {\"id\": \"U-01\", \"name\": \"Иван Петров\", \"org\": \"Вуз А\"},\n                {\"id\": \"U-02\", \"name\": \"Анна Сидорова\", \"org\": \"Вуз Б\"},\n            ],\n            \"tickets\": [\n                {\n                    \"id\": \"T-1001\",\n                    \"user_id\": \"U-01\",\n                    \"subject\": \"Первое обращение\",\n                    \"message\": \"Проблема 1\",\n                    \"status\": \"новый\",\n                    \"priority\": \"высокий\",\n                    \"created\": \"2026-10-10 10:00\",\n                },\n                {\n                    \"id\": \"T-1002\",\n                    \"user_id\": \"U-02\",\n                    \"subject\": \"Второе обращение\",\n                    \"message\": \"Проблема 2\",\n                    \"status\": \"решён\",\n                    \"priority\": \"низкий\",\n                    \"created\": \"2026-10-09 09:00\",\n                },\n                {\n                    \"id\": \"T-1003\",\n                    \"user_id\": \"U-01\",\n                    \"subject\": \"Третье обращение\",\n                    \"message\": \"Проблема 3\",\n                    \"status\": \"новый\",\n                    \"priority\": \"средний\",\n                    \"created\": \"2026-10-11 11:00\",\n                },\n            ],\n        }, self._crm_file, ensure_ascii=False)\n        self._crm_file.close()\n        # Подменяем файл CRM перед импортом модуля\n        self._old_config = crm_mcp.config\n        class FakeConfig:\n            CRM_FILE = Path(self._crm_file.name)\n        crm_mcp.config = FakeConfig()\n\n    def tearDown(self):\n        \"\"\"Удаляем временный файл.\"\"\"\n        Path(self._crm_file.name).unlink()\n        crm_mcp.config = self._old_config\n\n    def test_list_tickets_only_open_sorted_newest_first(self):\n        \"\"\"Без include_closed — только открытые, новые сверху.\"\"\"\n        result = crm_mcp.list_tickets()\n        self.assertEqual(result[\"count\"], 2)\n        ids = [t[\"id\"] for t in result[\"tickets\"]]\n        # T-1003 создан позже T-1001, должен быть первым\n        self.assertEqual(ids, [\"T-1003\", \"T-1001\"])\n\n    def test_list_tickets_with_closed(self):\n        \"\"\"С include_closed=True — все обращения.\"\"\"\n        result = crm_mcp.list_tickets(include_closed=True)\n        self.assertEqual(result[\"count\"], 3)\n        ids = [t[\"id\"] for t in result[\"tickets\"]]\n        # Новые сверху: T-1003, T-1001, T-1002\n        self.assertEqual(ids, [\"T-1003\", \"T-1001\", \"T-1002\"])\n\n\nclass GetTicketTest(unittest.TestCase):\n    \"\"\"Тестируем get_ticket — поиск обращения по номеру.\"\"\"\n\n    def setUp(self):\n        \"\"\"Создаём временный CRM-файл.\"\"\"\n        self._crm_file = tempfile.NamedTemporaryFile(mode=\"w\", suffix=\".json\", delete=False)\n        json.dump({\n            \"users\": [{\"id\": \"U-01\", \"name\": \"Иван\", \"org\": \"Вуз\"}],\n            \"tickets\": [\n                {\n                    \"id\": \"T-1041\",\n                    \"user_id\": \"U-01\",\n                    \"subject\": \"Тема\",\n                    \"message\": \"Сообщение\",\n                    \"status\": \"новый\",\n                    \"priority\": \"высокий\",\n                    \"created\": \"2026-10-17 09:12\",\n                    \"technical\": {\"Запрос\": \"POST /predict\"},\n                },\n            ],\n        }, self._crm_file, ensure_ascii=False)\n        self._crm_file.close()\n        self._old_config = crm_mcp.config\n        class FakeConfig:\n            CRM_FILE = Path(self._crm_file.name)\n        crm_mcp.config = FakeConfig()\n\n    def tearDown(self):\n        Path(self._crm_file.name).unlink()\n        crm_mcp.config = self._old_config\n\n    def test_get_ticket_found(self):\n        \"\"\"Находит обращение по точному номеру.\"\"\"\n        result = crm_mcp.get_ticket(\"T-1041\")\n        self.assertEqual(result[\"id\"], \"T-1041\")\n        self.assertEqual(result[\"subject\"], \"Тема\")\n\n    def test_get_ticket_case_insensitive(self):\n        \"\"\"Поиск без учёта регистра — малые буквы.\"\"\"\n        result = crm_mcp.get_ticket(\"t-1041\")\n        self.assertEqual(result[\"id\"], \"T-1041\")\n\n    def test_get_ticket_ignores_whitespace(self):\n        \"\"\"Поиск игнорирует пробелы вокруг номера.\"\"\"\n        result = crm_mcp.get_ticket(\" t-1041 \")\n        self.assertEqual(result[\"id\"], \"T-1041\")\n\n    def test_get_ticket_not_found(self):\n        \"\"\"Нет такого обращения — ToolError с нормализованным номером.\"\"\"\n        with self.assertRaises(ToolError) as ctx:\n            crm_mcp.get_ticket(\"T-9999\")\n        self.assertIn(\"T-9999\", str(ctx.exception))\n        self.assertIn(\"нет в CRM\", str(ctx.exception))\n\n    def test_get_ticket_not_found_normalized(self):\n        \"\"\"Ошибка показывает нормализованный номер (верхний регистр, без пробелов).\"\"\"\n        with self.assertRaises(ToolError) as ctx:\n            crm_mcp.get_ticket(\" t-9999 \")\n        error_msg = str(ctx.exception)\n        self.assertIn(\"T-9999\", error_msg)  # не \" t-9999 \" и не \"t-9999\"\n\n\nclass GetUserTest(unittest.TestCase):\n    \"\"\"Тестируем get_user — поиск клиента по номеру.\"\"\"\n\n    def setUp(self):\n        \"\"\"Создаёт временный CRM-файл.\"\"\"\n        self._crm_file = tempfile.NamedTemporaryFile(mode=\"w\", suffix=\".json\", delete=False)\n        json.dump({\n            \"users\": [\n                {\n                    \"id\": \"U-01\",\n                    \"name\": \"Игорь Ветров\",\n                    \"org\": \"Университет «Меридиан»\",\n                    \"role\": \"разработчик\",\n                },\n            ],\n            \"tickets\": [\n                {\n                    \"id\": \"T-1041\",\n                    \"user_id\": \"U-01\",\n                    \"subject\": \"Обращение 1\",\n                    \"status\": \"новый\",\n                    \"created\": \"2026-10-17 09:12\",\n                },\n                {\n                    \"id\": \"T-1033\",\n                    \"user_id\": \"U-01\",\n                    \"subject\": \"Решённое\",\n                    \"status\": \"решён\",\n                    \"created\": \"2026-10-08 10:15\",\n                    \"resolution\": \"Решено.\",\n                },\n            ],\n        }, self._crm_file, ensure_ascii=False)\n        self._crm_file.close()\n        self._old_config = crm_mcp.config\n        class FakeConfig:\n            CRM_FILE = Path(self._crm_file.name)\n        crm_mcp.config = FakeConfig()\n\n    def tearDown(self):\n        Path(self._crm_file.name).unlink()\n        crm_mcp.config = self._old_config\n\n    def test_get_user_found(self):\n        \"\"\"Находит клиента по точному номеру.\"\"\"\n        result = crm_mcp.get_user(\"U-01\")\n        self.assertEqual(result[\"id\"], \"U-01\")\n        self.assertEqual(result[\"name\"], \"Игорь Ветров\")\n\n    def test_get_user_case_insensitive(self):\n        \"\"\"Поиск без учёта регистра — малые буквы.\"\"\"\n        result = crm_mcp.get_user(\"u-01\")\n        self.assertEqual(result[\"id\"], \"U-01\")\n\n    def test_get_user_ignores_whitespace(self):\n        \"\"\"Поиск игнорирует пробелы вокруг номера.\"\"\"\n        result = crm_mcp.get_user(\" u-01 \")\n        self.assertEqual(result[\"id\"], \"U-01\")\n\n    def test_get_user_not_found(self):\n        \"\"\"Нет такого клиента — ToolError.\"\"\"\n        with self.assertRaises(ToolError) as ctx:\n            crm_mcp.get_user(\"U-99\")\n        self.assertIn(\"U-99\", str(ctx.exception))\n\n    def test_get_user_not_found_normalized(self):\n        \"\"\"Ошибка показывает нормализованный номер.\"\"\"\n        with self.assertRaises(ToolError) as ctx:\n            crm_mcp.get_user(\" u-99 \")\n        self.assertIn(\"U-99\", str(ctx.exception))\n\n    def test_get_user_includes_tickets(self):\n        \"\"\"Клиент включает список всех его обращений.\"\"\"\n        result = crm_mcp.get_user(\"U-01\")\n        self.assertIn(\"tickets\", result)\n        self.assertEqual(len(result[\"tickets\"]), 2)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":14118,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"b7ee0599-3ba8-4681-bb75-b8b13ae994a5","uuid":"c25dabc0-881b-49de-996d-9727d043db0e","timestamp":"2026-10-24T23:01:38.465Z"}
