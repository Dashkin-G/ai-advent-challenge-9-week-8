{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_3ba41af4bc8043d2b5d00006","type":"tool_result","content":"1\t\"\"\"Настройки ассистента: какой проект он объясняет, где Ollama и какие модели.\"\"\"\n2\timport os\n3\tfrom pathlib import Path\n4\t\n5\tROOT = Path(__file__).parent.parent\n6\t\n7\t# Проект, о котором отвечает ассистент: его документация и git\n8\tPROJECT_DIR = Path(os.getenv(\"PROJECT_DIR\", ROOT.parent / \"ml-student-dropout\")).resolve()\n9\tDOCS = [\"README.md\", \"docs/*.md\"]\n10\tCODE = [\"*.py\"]  # код проекта — в RAG ревью вместе с документацией\n11\t\n12\t# Поддержка: база знаний и CRM — JSON с клиентами и их обращениями\n13\tFAQ = ROOT / \"support\" / \"faq.md\"\n14\tCRM_FILE = Path(os.getenv(\"CRM_FILE\", ROOT / \"support\" / \"crm.json\"))\n15\t\n16\tOLLAMA_URL = os.getenv(\"OLLAMA_URL\", \"http://127.0.0.1:11434\")\n17\tMODEL = os.getenv(\"MODEL\", \"qwen3.5:4b\")\n18\tEMBED_MODEL = os.getenv(\"EMBED_MODEL\", \"bge-m3\")\n19\tTOP = int(os.getenv(\"TOP\", \"3\"))  # фрагментов документации в промпт\n20\t\n21\tHOST = os.getenv(\"HOST\", \"127.0.0.1\")\n22\tPORT = int(os.getenv(\"PORT\", \"8001\"))  # 8000 обычно занят самим ML-проектом\n23\t# Для внутреннего обращения MCP используем localhost независимо от HOST (0.0.0.0 нельзя использовать как клиентский адрес)\n24\t_mcp_host = \"127.0.0.1\" if HOST == \"0.0.0.0\" else HOST\n25\tMCP_URL = f\"http://{_mcp_host}:{PORT}/mcp/git/\"\n26\tCRM_MCP_URL = f\"http://{_mcp_host}:{PORT}/mcp/crm/\"\n27\tFILES_MCP_URL = f\"http://{_mcp_host}:{PORT}/mcp/files/\"\n28\tDATA_DIR = Path(os.getenv(\"DATA_DIR\", ROOT / \"data\"))\n29\t\n30\t# Запросы к себе (MCP) и к Ollama — мимо системного прокси\n31\tos.environ[\"NO_PROXY\"] = \",\".join(filter(None, [os.getenv(\"NO_PROXY\"), \"127.0.0.1\", \"localhost\"]))\n32\t"}]},"parent_tool_use_id":"toolu_1dff4bf20396414582e7ed21","agent_id":"aecc0104cd8a2379f","session_id":"913bd46d-14a0-416b-aaec-7afee4f8906a","uuid":"7e867ccd-3775-43bf-80a7-a9