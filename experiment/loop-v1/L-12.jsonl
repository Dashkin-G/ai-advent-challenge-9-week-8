{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_b120c463b2184c9289595172","type":"tool_result","content":"1\t\"\"\"MCP-сервер git: ветка, изменения, файлы и diff проекта, история, изменения pull request. Только чтение.\"\"\"\n2\timport subprocess\n3\tfrom typing import Annotated, Any\n4\t\n5\tfrom mcp.server.mcpserver import MCPServer\n6\tfrom mcp.server.mcpserver.exceptions import ToolError\n7\tfrom pydantic import Field\n8\t\n9\tfrom app import config\n10\t\n11\tserver = MCPServer(\n12\t    name=\"git\",\n13\t    version=\"1.2.0\",\n14\t    instructions=\"Git-репозиторий проекта, о котором отвечает ассистент: текущая ветка, незакоммиченные \"\n15\t                 \"изменения, список файлов, diff, история коммитов, файлы любого коммита и изменения pull request \"\n16\t                 \"между двумя ветками. Инструменты только читают, ничего не меняют.\",\n17\t)\n18\t\n19\tSTATUS = {\"M\": \"изменён\", \"A\": \"добавлен\", \"D\": \"удалён\", \"R\": \"переименован\", \"?\": \"новый\", \"U\": \"конфликт\"}\n20\tRef = Annotated[str, Field(description=\"Ветка или коммит, например main\")]\n21\t# diff PR разбирается кодом: один формат при любых настройках git пользователя (цвет, префиксы, внешний diff)\n22\tPLAIN = [\"--no-color\", \"--no-ext-diff\", \"--no-renames\"]\n23\t\n24\t\n25\tdef git(*args):\n26\t    # quotepath=false — пути не по-латински приходят как есть, а не восьмеричными кодами\n27\t    done = subprocess.run([\"git\", \"-c\", \"core.quotepath=false\", \"-C\", str(config.PROJECT_DIR), *args],\n28\t                          capture_output=True, text=True, encoding=\"utf-8\", errors=\"replace\", timeout=15)\n29\t    if done.returncode != 0:\n30\t        # ToolError доходит до клиента своим текстом; любое другое исключение SDK прячет за общей фразой\n31\t        raise ToolError(done.stderr.strip() or f\"git {' '.join(args)} завершился с кодом {done.returncode}\")\n32\t    return done.stdout\n33\t\n34\t\n35\t@server.tool()\n36\tdef git_branch() -> dict[str, Any]:\n37\t    \"\"\"Текущая ветка, все локальные ветки и последний коммит.\"\"\"\n38\t    branch = git(\"branch\", \"--show-current\").strip() or \"(detached HEAD)\"\n39\t    branches = git(\"branch\", \"--format=%(refname:short)\").split()\n40\t    # в пустом репозитории лог выдает ошибку — возвращаем заглушку\n41\t    try:\n42\t        last_commit = git(\"log\", \"-1\", \"--format=%h %s · %cd\", \"--date=format:%d.%m.%Y %H:%M\").strip()\n43\t    except ToolError:\n44\t        last_commit = \"коммитов нет\"\n45\t    return {\"branch\": branch, \"branches\": branches, \"last_commit\": last_commit}\n46\t\n47\t\n48\t@server.tool()\n49\tdef git_status() -> dict[str, Any]:\n50\t    \"\"\"Незакоммиченные изменения: какие файлы изменены, добавлены, удалены или новые.\"\"\"\n51\t    changed = []\n52\t    for line in git(\"status\", \"--porcelain=v1\", \"--untracked-files=all\").splitlines():\n53\t        code = line[:2].strip()\n54\t        changed.append({\"path\": line[3:].strip('\"'), \"status\": STATUS.get(code[:1], code)})\n55\t    return {\"clean\": not changed, \"count\": len(changed), \"changed\": changed}\n56\t\n57\t\n58\t@server.tool()\n59\tdef list_files(\n60\t    path: Annotated[str, Field(description=\"Папка внутри проекта, например src/ml; пусто — весь проект\")] = \"\",\n61\t    ref: Annotated[str, Field(description=\"Ветка или коммит; пусто — рабочая папка с новыми файлами\")] = \"\",\n62\t) -> dict[str, Any]:\n63\t    \"\"\"Файлы проекта — отслеживаемые git и новые, без игнорируемых (.venv, data, models); или файлы коммита.\"\"\"\n64\t    if ref:\n65\t        found = git(\"ls-tree\", \"-r\", \"--name-only\", ref, \"--\", path or \".\").splitlines()\n66\t    else:\n67\t        found = git(\"ls-files\", \"--cached\", \"--others\", \"--exclude-standard\", \"--\", path or \".\").splitlines()\n68\t    return {\"path\": path or \".\", \"ref\": ref, \"count\": len(found), \"files\": found}\n69\t\n70\t\n71\t@server.tool()\n72\tdef read_file(\n73\t    path: Annotated[str, Field(description=\"Файл внутри проекта, например src/ml/model.py\")],\n74\t    ref: Ref = \"HEAD\",\n75\t) -> dict[str, Any]:\n76\t    \"\"\"Текст файла в указанном коммите или ветке.\"\"\"\n77\t    return {\"path\": path, \"ref\": ref, \"text\": git(\"show\", f\"{ref}:{path}\")}\n78\t\n79\t\n80\t@server.tool()\n81\tdef git_diff(\n82\t    path: Annotated[str, Field(description=\"Файл внутри проекта; пусто — все изменения\")] = \"\",\n83\t    max_lines: Annotated[int, Field(ge=10, le=400, description=\"Сколько строк diff вернуть\")] = 80,\n84\t) -> dict[str, Any]:\n85\t    \"\"\"Незакоммиченные правки отслеживаемых файлов (git diff HEAD): что именно поменялось.\"\"\"\n86\t    lines = git(\"diff\", \"HEAD\", \"--\", path or \".\").splitlines()\n87\t    return {\"path\": path or \".\", \"lines\": len(lines), \"truncated\": len(lines) > max_lines,\n88\t            \"diff\": \"\\n\".join(lines[:max_lines])}\n89\t\n90\t\n91\t@server.tool()\n92\tdef git_log(\n93\t    n: Annotated[int, Field(ge=1, le=50, description=\"Сколько последних коммитов\")] = 20,\n94\t    path: Annotated[str, Field(description=\"Только коммиты, которые меняли этот файл или папку; пусто — все\")] = \"\",\n95\t    oldest_first: Annotated[bool, Field(description=\"Сначала старые коммиты — история по порядку\")] = False,\n96\t) -> dict[str, Any]:\n97\t    \"\"\"История текущей ветки без merge-коммитов, новые сверху: дата, хеш, сообщение, изменённые файлы и\n98\t    сколько строк добавлено и удалено.\"\"\"\n99\t    commits = []\n100\t    try:\n101\t        out = git(\"log\", f\"-{n}\", \"--no-merges\", *([\"--reverse\"] if oldest_first else []), *PLAIN, \"--numstat\",\n102\t                  \"--date=format:%d.%m.%Y\", \"--format=%x1e%h%x1f%ad%x1f%s\", \"--\", path or \".\")\n103\t    except ToolError:\n104\t        # в пустом репозитории лог выдает ошибку — возвращаем пустой результат\n105\t        return {\"count\": 0, \"commits\": []}\n106\t    for record in out.split(