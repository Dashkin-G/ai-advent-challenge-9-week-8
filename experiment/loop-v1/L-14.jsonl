{"type":"assistant","message":{"id":"msg_9075b700-b912-9ca5-a939-0dce0e8e1545","type":"message","role":"assistant","model":"qwen3.5-122b-a10b","content":[{"type":"tool_use","id":"toolu_ff39aaeafebe49f783218d3f","name":"Write","input":{"file_path":"C:\\Users\\USER\\AppData\\Local\\Temp\\claude-rules\\loop-v1\\tests\\test_files_mcp.py","content":"\"\"\"Тесты app/files_mcp.py: инструменты MCP-сервера файлов.\"\"\"\nimport os\nimport shutil\nimport tempfile\nimport unittest\nfrom pathlib import Path\n\nfrom mcp.server.mcpserver.exceptions import ToolError\n\nfrom app import files_mcp, config\n\n\nclass TestPathValidation(unittest.TestCase):\n    \"\"\"Тестируем проверку путей в _rel: за пределы проекта и в .git — нельзя.\"\"\"\n\n    def test_path_outside_project_raises_toolerror(self):\n        \"\"\"Путь вне проекта (../x.txt) — ToolError.\"\"\"\n        with self.assertRaises(ToolError) as ctx:\n            files_mcp._rel(\"../x.txt\")\n        self.assertIn(\"вне проекта\", str(ctx.exception))\n\n    def test_path_in_git_folder_raises_toolerror(self):\n        \"\"\"Путь в .git (.git/config) — ToolError.\"\"\"\n        with self.assertRaises(ToolError) as ctx:\n            files_mcp._rel(\".git/config\")\n        self.assertIn(\".git\", str(ctx.exception))\n        self.assertIn(\"недоступна\", str(ctx.exception))\n\n\nclass TestEditFile(unittest.TestCase):\n    \"\"\"Тестируем edit_file: правка идёт в черновик, а не на диск.\"\"\"\n\n    def setUp(self):\n        \"\"\"Создаём временный git-репозиторий с файлом.\"\"\"\n        self._old_project_dir = config.PROJECT_DIR\n        self._temp_dir = Path(tempfile.mkdtemp())\n        # Инициализируем git-репозиторий\n        subprocess_run([\"git\", \"init\"], cwd=self._temp_dir, capture_output=True)\n        config.PROJECT_DIR = self._temp_dir\n        files_mcp.draft.clear()\n\n        # Создаём тестовый файл на диске\n        self._test_file = self._temp_dir / \"test.txt\"\n        self._test_file.write_text(\"строка 1\\nстрока 2\\nстрока 3\", encoding=\"utf-8\")\n        # Добавляем файл в git\n        subprocess_run([\"git\", \"add\", \"test.txt\"], cwd=self._temp_dir, capture_output=True)\n\n    def tearDown(self):\n        \"\"\"Удаляем временный репозиторий.\"\"\"\n        shutil.rmtree(self._temp_dir, ignore_errors=True)\n        config.PROJECT_DIR = self._old_project_dir\n        files_mcp.draft.clear()\n\n    def test_edit_file_visible_in_read_file(self):\n        \"\"\"edit_file: правка видна в read_file.\"\"\"\n        files_mcp.edit_file(\"test.txt\", \"строка 2\", \"строка два\")\n        result = files_mcp.read_file(\"test.txt\")\n        self.assertIn(\"строка два\", result[\"text\"])\n\n    def test_edit_file_visible_in_search(self):\n        \"\"\"edit_file: правка видна в search.\"\"\"\n        files_mcp.edit_file(\"test.txt\", \"строка 2\", \"строка два уникальная\")\n        result = files_mcp.search(\"строка два уникальная\")\n        self.assertGreater(result[\"count\"], 0)\n\n    def test_edit_file_not_written_to_disk(self):\n        \"\"\"edit_file: правка не записана на диск.\"\"\"\n        original = self._test_file.read_text(encoding=\"utf-8\")\n        files_mcp.edit_file(\"test.txt\", \"строка 2\", \"строка два\")\n        # Файл на диске остался прежним\n        self.assertEqual(self._test_file.read_text(encoding=\"utf-8\"), original)\n\n\nclass TestWriteFile(unittest.TestCase):\n    \"\"\"Тестируем write_file: создание нового файла.\"\"\"\n\n    def setUp(self):\n        \"\"\"Создаём временный git-репозиторий.\"\"\"\n        self._old_project_dir = config.PROJECT_DIR\n        self._temp_dir = Path(tempfile.mkdtemp())\n        subprocess_run([\"git\", \"init\"], cwd=self._temp_dir, capture_output=True)\n        config.PROJECT_DIR = self._temp_dir\n        files_mcp.draft.clear()\n\n    def tearDown(self):\n        shutil.rmtree(self._temp_dir, ignore_errors=True)\n        config.PROJECT_DIR = self._old_project_dir\n        files_mcp.draft.clear()\n\n    def test_write_file_new_visible_in_read_file(self):\n        \"\"\"write_file: новый файл виден в read_file.\"\"\"\n        files_mcp.write_file(\"new.txt\", \"новый файл\")\n        result = files_mcp.read_file(\"new.txt\")\n        self.assertIn(\"новый файл\", result[\"text\"])\n\n    def test_write_file_new_visible_in_search(self):\n        \"\"\"write_file: новый файл виден в search.\"\"\"\n        files_mcp.write_file(\"new.txt\", \"новый файл с уникальным текстом\")\n        result = files_mcp.search(\"уникальный текст\")\n        self.assertGreater(result[\"count\"], 0)\n\n    def test_write_file_new_not_written_to_disk(self):\n        \"\"\"write_file: новый файл не создан на диске.\"\"\"\n        files_mcp.write_file(\"new.txt\", \"новый файл\")\n        disk_file = self._temp_dir / \"new.txt\"\n        self.assertFalse(disk_file.exists())\n\n    def test_write_file_over_existing_raises_toolerror(self):\n        \"\"\"write_file поверх существующего файла — ToolError.\"\"\"\n        existing = self._temp_dir / \"existing.txt\"\n        existing.write_text(\"существует\", encoding=\"utf-8\")\n        # Добавляем в git чтобы он был виден\n        subprocess_run([\"git\", \"add\", \"existing.txt\"], cwd=self._temp_dir, capture_output=True)\n        with self.assertRaises(ToolError) as ctx:\n            files_mcp.write_file(\"existing.txt\", \"новая версия\")\n        self.assertIn(\"уже есть\", str(ctx.exception))\n\n\nclass TestDiscardDraft(unittest.TestCase):\n    \"\"\"Тестируем discard_draft: очистка черновика.\"\"\"\n\n    def setUp(self):\n        \"\"\"Создаём временный git-репозиторий с файлом.\"\"\"\n        self._old_project_dir = config.PROJECT_DIR\n        self._temp_dir = Path(tempfile.mkdtemp())\n        subprocess_run([\"git\", \"init\"], cwd=self._temp_dir, capture_output=True)\n        config.PROJECT_DIR = self._temp_dir\n        files_mcp.draft.clear()\n\n        self._test_file = self._temp_dir / \"test.txt\"\n        self._test_file.write_text(\"строка 1\\nстрока 2\", encoding=\"utf-8\")\n        subprocess_run([\"git\", \"add\", \"test.txt\"], cwd=self._temp_dir, capture_output=True)\n\n    def tearDown(self):\n        shutil.rmtree(self._temp_dir, ignore_errors=True)\n        config.PROJECT_DIR = self._old_project_dir\n        files_mcp.draft.clear()\n\n    def test_discard_draft_clears_edits(self):\n        \"\"\"discard_draft: правки удалены из черновика.\"\"\"\n        files_mcp.edit_file(\"test.txt\", \"строка 1\", \"строка один правка\")\n        result = files_mcp.discard_draft()\n        self.assertEqual(result[\"discarded\"], 1)\n        # После отмены читается с диска\n        read_result = files_mcp.read_file(\"test.txt\")\n        self.assertIn(\"строка 1\", read_result[\"text\"])\n        self.assertNotIn(\"строка один правка\", read_result[\"text\"])\n\n    def test_discard_draft_clears_new_files(self):\n        \"\"\"discard_draft: новые файлы удалены из черновика.\"\"\"\n        files_mcp.write_file(\"new.txt\", \"новый файл для теста очистки\")\n        result = files_mcp.discard_draft()\n        self.assertEqual(result[\"discarded\"], 1)\n        # Файла больше нет даже в черновике\n        with self.assertRaises(ToolError):\n            files_mcp.read_file(\"new.txt\")\n\n\ndef subprocess_run(args, **kwargs):\n    \"\"\"Вспомогательная функция для запуска git.\"\"\"\n    import subprocess\n    return subprocess.run(args, **kwargs)\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":14612,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"9caea058-88e4-471b-b0a6-155ad12cafc6","uuid":"e855d9f6-da07-4460-8bb1-4cc26ded7bdf","timestamp":"2026-10-24T23:10:45.626Z"}
