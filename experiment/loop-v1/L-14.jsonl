{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_e4918a1509e54ff7a77659ee","type":"tool_result","content":"1\t\"\"\"MCP-сервер git: ветка, изменения, файлы и diff проекта, история, изменения pull request. Только чтение.\"\"\"\n2\timport subprocess\n3\tfrom typing import Annotated, Any\n4\t\n5\tfrom mcp.server.mcpserver import MCPServer\n6\tfrom mcp.server.mcpserver.exceptions import ToolError\n7\tfrom pydantic import Field\n8\t\n9\tfrom app import config\n10\t\n11\tserver = MCPServer(\n12\t    name=\"git\",\n13\t    version=\"1.2.0\",\n14\t    instructions=\"Git-репозиторий проекта, о котором отвечает ассистент: текущая ветка, незакоммиченные \"\n15\t                 \"изменения, список файлов, diff, история коммитов, файлы любого коммита и изменения pull request \"\n16\t                 \"между двумя ветками. Инструменты только читают, ничего не меняют.\",\n17\t)\n18\t\n19\tSTATUS = {\"M\": \"изменён\", \"A\": \"добавлен\", \"D\": \"удалён\", \"R\": \"переименован\", \"?\": \"новый\", \"U\": \"конфликт\"}\n20\tRef = Annotated[str, Field(description=\"Ветка или коммит, например main\")]\n21\t# diff PR разбирается кодом: один формат при любых настройках git пользователя (цвет, префиксы, внешний diff)\n22\tPLAIN = [\"--no-color\", \"--no-ext-diff\", \"--no-renames\"]\n23\t\n24\t\n25\tdef git(*args):\n26\t    # quotepath=false — пути не по-латински приходят как есть, а не восьмеричными кодами\n27\t    done = subprocess.run([\"git\", \"-c\", \"core.quotepath=false\", \"-C\", str(config.PROJECT_DIR), *args],\n28\t                          capture_output=True, text=True, encoding=\"utf-8\", errors=\"replace\", timeout=15)\n29\t    if done.returncode != 0:\n30\t        # ToolError доходит до клиента своим текстом; любое другое исключение SDK прячет за общей фразой\n31\t        raise ToolError(done.stderr.strip() or f\"git {' '.join(args)} завершился с кодом {done.returncode}\")\n32\t    return done.stdout\n33\t\n34\t\n35\t@server.tool()\n36\tdef git_branch() -> dict[str, Any]:\n37\t    \"\"\"Текущая ветка, все локальные ветки и последний коммит.\"\"\"\n38\t    branch = git(\"branch\", \"--show-current\").strip() or \"(detached HEAD)\"\n39\t    branches = git(\"branch\", \"--format=%(refname:short)\").split()\n40\t    # в пустом репозитории лог выдает ошибку — возвращаем заглушку\n41\t    try:\n42\t        last_commit = git(\"log\", \"-1\", \"--format=%h %s · %cd\", \"--date=format:%d.%m.%Y %H:%M\").strip()\n43\t    except ToolError:\n44\t        last_commit = \"коммитов нет\"\n45\t    return {\"branch\": branch, \"branches\": branches, \"last_commit\": last_commit}\n46\t\n47\t\n48\t@server.tool()\n49\tdef git_status() -> dict[str, Any]:\n50\t    \"\"\"Незакоммиченные изменения: какие файлы изменены, добавлены, удалены или новые.\"\"\"\n51\t    changed = []\n52\t    for line in git(\"status\", \"--porcelain=v1\", \"--untracked-files=all\").splitlines():\n53\t        code = line[:2].strip()\n54\t        changed.append({\"path\": line[3:].strip('\"'), \"status\": STATUS.get(code[:1], code)})\n55\t    return {\"clean\": not changed, \"count\": len(changed), \"changed\": changed}\n56\t\n57\t\n58\t@server.tool()\n59\tdef list_files(\n60\t    path: Annotated[str, Field(description=\"Папка внутри проекта, например src/ml; пусто — весь проект\")] = \"\",\n61\t    ref: Annotated[str, Field(description=\"Ветка или коммит; пусто — рабочая папка с новыми файлами\")] = \"\",\n62\t) -> dict[str, Any]:\n63\t    \"\"\"Файлы проекта — отслеживаемые git и новые, без игнорируемых (.venv, data, models); или файлы коммита.\"\"\"\n64\t    if ref:\n65\t        found = git(\"ls-tree\", \"-r\", \"--name-only\", ref, \"--\", path or \".\").splitlines()\n66\t    else:\n67\t        found = git(\"ls-files\", \"--cached\", \"--others\", \"--exclude-standard\", \"--\", path or \".\").splitlines()\n68\t    return {\"path\": path or \".\", \"ref\": ref, \"count\": len(found), \"files\": found}\n69\t\n70\t\n71\t@server.tool()\n72\tdef read_file(\n73\t    path: Annotated[str, Field(description=\"Файл внутри проекта, например src/ml/model.py\")],\n74\t    ref: Ref = \"HEAD\",\n75\t) -> dict[str, Any]:\n76\t    \"\"\"Текст файла в указанном коммите или ветке.\"\"\"\n77\t    return {\"path\": path, \"ref\": ref, \"text\": git(\"show\", f\"{ref}:{path}\")}\n78\t\n79\t\n80\t@server.tool()\n81\tdef git_diff(\n82\t    path: Annotated[str, Field(description=\"Файл внутри проекта; пусто — все изменения\")] = \"\",\n83\t    max_lines: Annotated[int, Field(ge=10, le=400, description=\"Сколько строк diff вернуть\")] = 80,\n84\t) -> dict[str, Any]:\n85\t    \"\"\"Незакоммиченные правки отслеживаемых файлов (git diff HEAD): что именно поменялось.\"\"\"\n86\t    lines = git(\"diff\", \"HEAD\", \"--\", path or \".\").splitlines()\n87\t    return {\"path\": path or \".\", \"lines\": len(lines), \"truncated\": len(lines) > max_lines,\n88\t            \"diff\": \"\\n\".join(lines[:max_lines])}\n89\t\n90\t\n91\t@server.tool()\n92\tdef git_log(\n93\t    n: Annotated[int, Field(ge=1, le=50, description=\"Сколько последних коммитов\")] = 20,\n94\t    path: Annotated[str, Field(description=\"Только коммиты, которые меняли этот файл или папку; пусто — все\")] = \"\",\n95\t    oldest_first: Annotated[bool, Field(description=\"Сначала старые коммиты — история по порядку\")] = False,\n96\t) -> dict[str, Any]:\n97\t    \"\"\"История текущей ветки без merge-коммитов, новые сверху: дата, хеш, сообщение, изменённые файлы и\n98\t    сколько строк добавлено и удалено.\"\"\"\n99\t    commits = []\n100\t    try:\n101\t        out = git(\"log\", f\"-{n}\", \"--no-merges\", *([\"--reverse\"] if oldest_first else []), *PLAIN, \"--numstat\",\n102\t                  \"--date=format:%d.%m.%Y\", \"--format=%x1e%h%x1f%ad%x1f%s\", \"--\", path or \".\")\n103\t    except ToolError:\n104\t        # в пустом репозитории лог выдает ошибку — возвращаем пустой результат\n105\t        return {\"count\": 0, \"commits\": []}\n106\t    for record in out.split(\"\\x1e\")[1:]:\n107\t        head, *lines = record.strip(\"\\n\").split(\"\\n\")\n108\t        sha, date, subject = head.split(\"\\x1f\")\n109\t        stats = [line.split(\"\\t\", 2) for line in lines if line]\n110\t        commits.append({\"date\": date, \"hash\": sha, \"subject\": subject, \"files\": [file for _, _, file in stats],\n111\t                        # «-» вместо числа — двоичный файл\n112\t                        \"added\": sum(int(a) for a, _, _ in stats if a != \"-\"),\n113\t                        \"deleted\": sum(int(d) for _, d, _ in stats if d != \"-\")})\n114\t    return {\"count\": len(commits), \"commits\": commits}\n115\t\n116\t\n117\t@server.tool()\n118\tdef pr_files(base: Ref, head: Ref) -> dict[str, Any]:\n119\t    \"\"\"Изменённые файлы pull request — что сделано в head с момента ответвления от base: статус файла и\n120\t    сколько строк добавлено и удалено. Переименование показывается как удаление и добавление.\"\"\"\n121\t    changes = f\"{base}...{head}\"\n122\t    counts = {}\n123\t    for line in git(\"diff\", \"--numstat\", *PLAIN, changes).splitlines():\n124\t        added, deleted, path = line.split(\"\\t\", 2)\n125\t        counts[path] = (int(added), int(deleted)) if added != \"-\" else (0, 0)  # «-» — двоичный файл\n126\t    files = []\n127\t    for line in git(\"diff\", \"--name-status\", *PLAIN, changes).splitlines():\n128\t        code, path = line.split(\"\\t\", 1)\n129\t        added, deleted = counts.get(path, (0, 0))\n130\t        files.append({\"path\": path, \"status\": STATUS.get(code[:1], code), \"added\": added, \"deleted\": deleted})\n131\t    return {\n132\t        \"base\": base, \"head\": head,\n133\t        \"merge_base\": git(\"merge-base\", base, head).strip(),\n134\t        \"head_sha\": git(\"rev-parse\", head).strip(),\n135\t        \"files\": files,\n136\t        \"added\": sum(f[\"added\"] for f in files),\n137\t        \"deleted\": sum(f[\"deleted\"] for f in files),\n138\t    }\n139\t\n140\t\n141\t@server.tool()\n142\tdef pr_diff(\n143\t    base: Ref,\n144\t    head: Ref,\n145\t    path: Annotated[str, Field(description=\"Файл внутри проекта; пусто — все файлы\")] = \"\",\n146\t    max_lines: Annotated[int, Field(ge=10, le=5000, description=\"Сколько строк diff вернуть\")] = 2000,\n147\t) -> dict[str, Any]:\n148\t    \"\"\"Diff pull request (git diff base...head): изменения head с момента ответвления от base,\n149\t    по 5 строк контекста вокруг правок.\"\"\"\n150\t    lines = git(\"diff\", \"-U5\", *PLAIN, \"--src-prefix=a/\", \"--dst-prefix=b/\", f\"{base}...{head}\", \"--\",\n151\t                path or \".\").splitlines()\n152\t    return {\"path\": path or \".\", \"lines\": len(lines), \"truncated\": len(lines) > max_lines,\n153\t            \"diff\": \"\\n\".join(lines[:max_lines])}\n154\t"}]},"parent_tool_use_id":"toolu_e1c08059e1374adcaf51cde8","agent_id":"a878f5f402045a4d8","session_id":"9caea058-88e4-471b-b0a6-155ad12cafc6","uuid":"17429e40-e510-400a-b0e1-b4a7401f57ed","timestamp":"2026-10-24T23:10:04.363Z","tool_result_meta":[{"id":"toolu_e4918a1509e54ff7a77659ee","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"qa","task_description":"Test files_mcp module"}
