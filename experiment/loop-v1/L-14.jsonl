{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_24c41bf558ff499ab2361077","type":"tool_result","content":"1\t\"\"\"Тесты app/crm_mcp.py: инструменты MCP-сервера CRM поддержки.\"\"\"\n2\timport json\n3\timport tempfile\n4\timport unittest\n5\tfrom pathlib import Path\n6\t\n7\tfrom mcp.server.mcpserver.exceptions import ToolError\n8\t\n9\tfrom app import crm_mcp\n10\t\n11\t\n12\tclass ListTicketsTest(unittest.TestCase):\n13\t    \"\"\"Тестируем list_tickets — очередь обращений.\"\"\"\n14\t\n15\t    def setUp(self):\n16\t        \"\"\"Создаём временный CRM-файл.\"\"\"\n17\t        self._crm_file = tempfile.NamedTemporaryFile(mode=\"w\", suffix=\".json\", delete=False)\n18\t        json.dump({\n19\t            \"users\": [\n20\t                {\"id\": \"U-01\", \"name\": \"Иван Петров\", \"org\": \"Вуз А\"},\n21\t                {\"id\": \"U-02\", \"name\": \"Анна Сидорова\", \"org\": \"Вуз Б\"},\n22\t            ],\n23\t            \"tickets\": [\n24\t                {\n25\t                    \"id\": \"T-1001\",\n26\t                    \"user_id\": \"U-01\",\n27\t                    \"subject\": \"Первое обращение\",\n28\t                    \"message\": \"Проблема 1\",\n29\t                    \"status\": \"новый\",\n30\t                    \"priority\": \"высокий\",\n31\t                    \"created\": \"2026-10-10 10:00\",\n32\t                },\n33\t                {\n34\t                    \"id\": \"T-1002\",\n35\t                    \"user_id\": \"U-02\",\n36\t                    \"subject\": \"Второе обращение\",\n37\t                    \"message\": \"Проблема 2\",\n38\t                    \"status\": \"решён\",\n39\t                    \"priority\": \"низкий\",\n40\t                    \"created\": \"2026-10-09 09:00\",\n41\t                },\n42\t                {\n43\t                    \"id\": \"T-1003\",\n44\t                    \"user_id\": \"U-01\",\n45\t                    \"subject\": \"Третье обращение\",\n46\t                    \"message\": \"Проблема 3\",\n47\t                    \"status\": \"новый\",\n48\t                    \"priority\": \"средний\",\n49\t                    \"created\": \"2026-10-11 11:00\",\n50\t                },\n51\t            ],\n52\t        }, self._crm_file, ensure_ascii=False)\n53\t        self._crm_file.close()\n54\t        # Подменяем файл CRM перед импортом модуля\n55\t        self._old_config = crm_mcp.config\n56\t        class FakeConfig:\n57\t            CRM_FILE = Path(self._crm_file.name)\n58\t        crm_mcp.config = FakeConfig()\n59\t\n60\t    def tearDown(self):\n61\t        \"\"\"Удаляем временный файл.\"\"\"\n62\t        Path(self._crm_file.name).unlink()\n63\t        crm_mcp.config = self._old_config\n64\t\n65\t    def test_list_tickets_only_open_sorted_newest_first(self):\n66\t        \"\"\"Без include_closed — только открытые, новые сверху.\"\"\"\n67\t        result = crm_mcp.list_tickets()\n68\t        self.assertEqual(result[\"count\"], 2)\n69\t        ids = [t[\"id\"] for t in result[\"tickets\"]]\n70\t        # T-1003 создан позже T-1001, должен быть первым\n71\t        self.assertEqual(ids, [\"T-1003\", \"T-1001\"])\n72\t\n73\t    def test_list_tickets_with_closed(self):\n74\t        \"\"\"С include_closed=True — все обращения.\"\"\"\n75\t        result = crm_mcp.list_tickets(include_closed=True)\n76\t        self.assertEqual(result[\"count\"], 3)\n77\t        ids = [t[\"id\"] for t in result[\"tickets\"]]\n78\t        # Новые сверху: T-1003, T-1001, T-1002\n79\t        self.assertEqual(ids, [\"T-1003\", \"T-1001\", \"T-1002\"])\n80\t\n81\t\n82\tclass GetTicketTest(unittest.TestCase):\n83\t    \"\"\"Тестируем get_ticket — поиск обращения по номеру.\"\"\"\n84\t\n85\t    def setUp(self):\n86\t        \"\"\"Создаём временный CRM-файл.\"\"\"\n87\t        self._crm_file = tempfile.NamedTemporaryFile(mode=\"w\", suffix=\".json\", delete=False)\n88\t        json.dump({\n89\t            \"users\": [{\"id\": \"U-01\", \"name\": \"Иван\", \"org\": \"Вуз\"}],\n90\t            \"tickets\": [\n91\t                {\n92\t                    \"id\": \"T-1041\",\n93\t                    \"user_id\": \"U-01\",\n94\t                    \"subject\": \"Тема\",\n95\t                    \"message\": \"Сообщение\",\n96\t                    \"status\": \"новый\",\n97\t                    \"priority\": \"высокий\",\n98\t                    \"created\": \"2026-10-17 09:12\",\n99\t                    \"technical\": {\"Запрос\": \"POST /predict\"},\n100\t                },\n101\t            ],\n102\t        }, self._crm_file, ensure_ascii=False)\n103\t        self._crm_file.close()\n104\t        self._old_config = crm_mcp.config\n105\t        class FakeConfig:\n106\t            CRM_FILE = Path(self._crm_file.name)\n107\t        crm_mcp.config = FakeConfig()\n108\t\n109\t    def tearDown(self):\n110\t        Path(self._crm_file.name).unlink()\n111\t        crm_mcp.config = self._old_config\n112\t\n113\t    def test_get_ticket_found(self):\n114\t        \"\"\"Находит обращение по точному номеру.\"\"\"\n115\t        result = crm_mcp.get_ticket(\"T-1041\")\n116\t        self.assertEqual(result[\"id\"], \"T-1041\")\n117\t        self.assertEqual(result[\"subject\"], \"Тема\")\n118\t\n119\t    def test_get_ticket_case_insensitive(self):\n120\t        \"\"\"Поиск без учёта регистра — малые буквы.\"\"\"\n121\t        result = crm_mcp.get_ticket(\"t-1041\")\n122\t        self.assertEqual(result[\"id\"], \"T-1041\")\n123\t\n124\t    def test_get_ticket_ignores_whitespace(self):\n125\t        \"\"\"Поиск игнорирует пробелы вокруг номера.\"\"\"\n126\t        result = crm_mcp.get_ticket(\" t-1041 \")\n127\t        self.assertEqual(result[\"id\"], \"T-1041\")\n128\t\n129\t    def test_get_ticket_not_found(self):\n130\t        \"\"\"Нет такого обращения — ToolError с нормализованным номером.\"\"\"\n131\t        with self.assertRaises(ToolError) as ctx:\n132\t            crm_mcp.get_ticket(\"T-9999\")\n133\t        self.assertIn(\"T-9999\", str(ctx.exception))\n134\t        self.assertIn(\"нет в CRM\", str(ctx.exception))\n135\t\n136\t    def test_get_ticket_not_found_normalized(self):\n137\t        \"\"\"Ошибка показывает нормализованный номер (верхний регистр, без пробелов).\"\"\"\n138\t        with self.assertRaises(ToolError) as ctx:\n139\t            crm_mcp.get_ticket(\" t-9999 \")\n140\t        error_msg = str(ctx.exception)\n141\t        self.assertIn(\"T-9999\", error_msg)  # не \" t-9999 \" и не \"t-9999\"\n142\t\n143\t\n144\tclass GetUserTest(unittest.TestCase):\n145\t    \"\"\"Тестируем get_user — поиск клиента по номеру.\"\"\"\n146\t\n147\t    def setUp(self):\n148\t        \"\"\"Создаёт временный CRM-файл.\"\"\"\n149\t        self._crm_file = tempfile.NamedTemporaryFile(mode=\"w\", suffix=\".json\", delete=False)\n150\t        json.dump({\n151\t            \"users\": [\n152\t                {\n153\t                    \"id\": \"U-01\",\n154\t                    \"name\": \"Игорь Ветров\",\n155\t                    \"org\": \"Университет «Меридиан»\",\n156\t                    \"role\": \"разработчик\",\n157\t                },\n158\t            ],\n159\t            \"tickets\": [\n160\t                {\n161\t                    \"id\": \"T-1041\",\n162\t                    \"user_id\": \"U-01\",\n163\t                    \"subject\": \"Обращение 1\",\n164\t                    \"status\": \"новый\",\n165\t                    \"created\": \"2026-10-17 09:12\",\n166\t                },\n167\t                {\n168\t                    \"id\": \"T-1033\",\n169\t                    \"user_id\": \"U-01\",\n170\t                    \"subject\": \"Решённое\",\n171\t                    \"status\": \"решён\",\n172\t                    \"created\": \"2026-10-08 10:15\",\n173\t                    \"resolution\": \"Решено.\",\n174\t                },\n175\t            ],\n176\t        }, self._crm_file, ensure_ascii=False)\n177\t        self._crm_file.close()\n178\t        self._old_config = crm_mcp.config\n179\t        class FakeConfig:\n180\t            CRM_FILE = Path(self._crm_file.name)\n181\t        crm_mcp.config = FakeConfig()\n182\t\n183\t    def tearDown(self):\n184\t        Path(self._crm_file.name).unlink()\n185\t        crm_mcp.config = self._old_config\n186\t\n187\t    def test_get_user_found(self):\n188\t        \"\"\"Находит клиента по точному номеру.\"\"\"\n189\t        result = crm_mcp.get_user(\"U-01\")\n190\t        self.assertEqual(result[\"id\"], \"U-01\")\n191\t        self.assertEqual(result[\"name\"], \"Игорь Ветров\")\n192\t\n193\t    def test_get_user_case_insensitive(self):\n194\t        \"\"\"Поиск без учёта регистра — малые буквы.\"\"\"\n195\t        result = crm_mcp.get_user(\"u-01\")\n196\t        self.assertEqual(result[\"id\"], \"U-01\")\n197\t\n198\t    def test_get_user_ignores_whitespace(self):\n199\t        \"\"\"Поиск игнорирует пробелы вокруг номера.\"\"\"\n200\t        result = crm_mcp.get_user(\" u-01 \")\n201\t        self.assertEqual(result[\"id\"], \"U-01\")\n202\t\n203\t    def test_get_user_not_found(self):\n204\t        \"\"\"Нет такого клиента — ToolError.\"\"\"\n205\t        with self.assertRaises(ToolError) as ctx:\n206\t            crm_mcp.get_user(\"U-99\")\n207\t        self.assertIn(\"U-99\", str(ctx.exception))\n208\t\n209\t    def test_get_user_not_found_normalized(self):\n210\t        \"\"\"Ошибка показывает нормализованный номер.\"\"\"\n211\t        with self.assertRaises(ToolError) as ctx:\n212\t            crm_mcp.get_user(\" u-99 \")\n213\t        self.assertIn(\"U-99\", str(ctx.exception))\n214\t\n215\t    def test_get_user_includes_tickets(self):\n216\t        \"\"\"Клиент включает список всех его обращений.\"\"\"\n217\t        result = crm_mcp.get_user(\"U-01\")\n218\t        self.assertIn(\"tickets\", result)\n219\t        self.assertEqual(len(result[\"tickets\"]), 2)\n220\t\n221\t\n222\tif __name__ == \"__main__\":\n223\t    unittest.main()\n224\t"}]},"parent_tool_use_id":"toolu_e1c08