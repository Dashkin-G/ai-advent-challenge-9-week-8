keys=True).encode()).hexdigest()\n174\t        if fingerprint == self.fingerprint:\n175\t            return\n176\t        started = time.perf_counter()\n177\t        chunks = [chunk for file, text in texts.items() for chunk in split(file, text)]\n178\t        cache = {}\n179\t        if self.cache.exists():\n180\t            try:\n181\t                cache = json.loads(self.cache.read_text(encoding=\"utf-8\"))\n182\t            except json.JSONDecodeError:  # битый кэш — пересчитать всё\n183\t                pass\n184\t        keys = [_key(chunk) for chunk in chunks]\n185\t        missing = [i for i, key in enumerate(keys) if key not in cache]\n186\t        if missing:\n187\t            vectors = await llm.embed([_embedded(chunks[i]) for i in missing])\n188\t            cache.update({keys[i]: vector for i, vector in zip(missing, vectors)})\n189\t            self.cache.parent.mkdir(parents=True, exist_ok=True)\n190\t            self.cache.write_text(json.dumps({key: cache[key] for key in keys}), encoding=\"utf-8\")  # только живые\n191\t        matrix = None\n192\t        if keys:\n193\t            matrix = np.array([cache[key] for key in keys], dtype=np.float32)\n194\t            matrix /= np.linalg.norm(matrix, axis=1, keepdims=True)\n195\t        self.fingerprint, self.chunks, self.matrix = fingerprint, chunks, matrix\n196\t        self.built = {\"embedded\": len(missing), \"seconds\": round(time.perf_counter() - started, 2)}\n197\t\n198\t    def info(self):\n199\t        return {\"files\": sorted({c[\"file\"] for c in self.chunks}, key=lambda f: (f != \"README.md\", f)),\n200\t                \"chunks\": len(self.chunks), \"model\": config.EMBED_MODEL, \"built\": self.built}\n201\t\n202\t    def nearest(self, vector, top, keep=lambda chunk: True):\n203\t        \"\"\"Ближайшие по косинусу фрагменты, которые проходят фильтр keep, — с близостью. Можно передать\n204\t        несколько векторов запроса: у фрагмента берётся лучшая близость.\"\"\"\n205\t        if sel