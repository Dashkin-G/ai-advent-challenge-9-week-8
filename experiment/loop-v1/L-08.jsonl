{"type":"assistant","message":{"id":"msg_4ec52937-2dec-9bee-b26f-a71d3c7cd0a5","type":"message","role":"assistant","model":"qwen3.5-122b-a10b","content":[{"type":"tool_use","id":"toolu_831ee9df4f0f4b5098e50176","name":"Edit","input":{"replace_all":false,"file_path":"C:\\Users\\USER\\AppData\\Local\\Temp\\claude-rules\\loop-v1\\tests\\test_rag.py","old_string":"\"\"\"Тесты app/rag.py: нарезка документации и кода на фрагменты для RAG.\"\"\"\nimport unittest\n\nfrom app import rag","new_string":"\"\"\"Тесты app/rag.py: нарезка документации и кода на фрагменты для RAG.\"\"\"\nimport json\nimport tempfile\nimport unittest\nfrom pathlib import Path\n\nfrom app import config, rag\n\n\nclass RagCorruptedCacheTest(unittest.TestCase):\n    \"\"\"Битый кэш embeddings.json не роняет /help — векторы пересчитываются заново.\"\"\"\n\n    def test_empty_cache_file(self):\n        \"\"\"Пустой файл кэша считается как отсутствие кэша.\"\"\"\n        with tempfile.TemporaryDirectory() as data_dir:\n            cache_path = Path(data_dir) / \"test.json\"\n            cache_path.write_text(\"\", encoding=\"utf-8\")\n            idx = rag.Index(\"test\")\n            idx.cache = cache_path\n            # Без заглушки llm.embed упадёт с ConnectError — это нормально, важно что не JSONDecodeError\n            import asyncio\n            from app import llm\n            async def test():\n                try:\n                    await idx.build({\"x.md\": \"# Hi\"})\n                except llm.LLMError:\n                    pass  # Ollama не запущен — ожидаемо\n                self.assertIsNotNone(idx.built)\n            asyncio.run(test())\n\n    def test_malformed_json_cache(self):\n        \"\"\"Битый JSON в кэше — пересчёт всех векторов.\"\"\"\n        with tempfile.TemporaryDirectory() as data_dir:\n            cache_path = Path(data_dir) / \"test.json\"\n            cache_path.write_text('{\"abc\": [1, 2', encoding=\"utf-8\")  # битый JSON\n            idx = rag.Index(\"test\")\n            idx.cache = cache_path\n            # Проверим что Index не падает при чтении\n            self.assertTrue(idx.cache.exists())\n            content = idx.cache.read_text(encoding=\"utf-8\")\n            with self.assertRaises(json.JSONDecodeError):\n                json.loads(content)  # сырой парсинг всё ещё выдаёт ошибку\n            # Но внутри build ошибка обрабатывается\n            import asyncio\n            from app import llm\n            async def test():\n                try:\n                    await idx.build({\"x.md\": \"# Hi\"})\n                except llm.LLMError:\n                    pass\n                self.assertIsNotNone(idx.built)\n            asyncio.run(test())"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":9327,"output_tokens":0},"context_management":null},"parent_tool_use_id":"toolu_f314b66e8b3f44258a064d60","agent_id":"ac2f7a8c593eedad7","session_id":"335d1da6-e083-458b-b92e-1ca24c19c17b","uuid":"1ddcec4b-4195-4093-bdab-245010941238","timestamp":"2026-10-24T22:56:46.216Z","subagent_type":"bug-fix","task_description":"Fix broken embedding cache"}
