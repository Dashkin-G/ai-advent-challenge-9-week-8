{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_82a1a2f9028e468ab5f8f38a","type":"tool_result","content":"1\t\"\"\"Тесты app/rag.py: нарезка документации и кода на фрагменты для RAG.\"\"\"\n2\timport unittest\n3\t\n4\tfrom app import rag\n5\t\n6\t\n7\tclass RagSplitDocsTest(unittest.TestCase):\n8\t    \"\"\"Функция split_docs разбивает Markdown на фрагменты по заголовкам.\"\"\"\n9\t\n10\t    def test_split_simple(self):\n11\t        \"\"\"Простой документ с одним разделом.\"\"\"\n12\t        text = \"# README\\n\\n## Запуск\\n\\nКоманда uvicorn\"\n13\t        chunks = list(rag.split_docs('README.md', text))\n14\t        self.assertEqual(len(chunks), 1)\n15\t        self.assertEqual(chunks[0]['file'], 'README.md')\n16\t        self.assertEqual(chunks[0]['title'], 'Запуск')\n17\t        self.assertEqual(chunks[0]['text'], 'Команда uvicorn')\n18\t        self.assertEqual(chunks[0]['kind'], 'docs')\n19\t\n20\t    def test_split_nested_headings(self):\n21\t        \"\"\"Вложенные заголовки формируют составной заголовок фрагмента.\"\"\"\n22\t        text = \"# README\\n\\n## Руководство\\n\\n### Установка\\n\\npip install pkg\"\n23\t        chunks = list(rag.split_docs('README.md', text))\n24\t        self.assertEqual(len(chunks), 1)\n25\t        self.assertEqual(chunks[0]['title'], 'Руководство › Установка')\n26\t        self.assertEqual(chunks[0]['text'], 'pip install pkg')\n27\t\n28\t    def test_split_code_blocks(self):\n29\t        \"\"\"Блоки кода не обрабатываются как заголовки.\"\"\"\n30\t        text = \"\"\"# README\n31\t\n32\t## Пример\n33\t\n34\t```python\n35\tdef hello():\n36\t    pass\n37\t```\n38\t\"\"\"\n39\t        chunks = list(rag.split_docs('README.md', text))\n40\t        self.assertEqual(len(chunks), 1)\n41\t        self.assertIn('def hello():', chunks[0]['text'])\n42\t\n43\t\n44\tclass RagSplitCodeTest(unittest.TestCase):\n45\t    \"\"\"Функция split_code разбивает Python на фрагменты по функциям и классам.\"\"\"\n46\t\n47\t    def test_split_function(self):\n48\t        \"\"\"Функция идёт целиком с номерами строк.\"\"\"\n49\t        text = \"def hello():\\n    print('hello')\"\n50\t        chunks = list(rag.split_code('app/test.py', text))\n51\t        self.assertEqual(len(chunks), 1)\n52\t        self.assertEqual(chunks[0]['title'], 'hello()')\n53\t        self.assertEqual(chunks[0]['lines'], [1, 2])\n54\t        self.assertEqual(chunks[0]['kind'], 'code')\n55\t\n56\t    def test_split_class(self):\n57\t        \"\"\"Класс идёт целиком.\"\"\"\n58\t        text = \"class Test:\\n    pass\"\n59\t        chunks = list(rag.split_code('app/test.py', text))\n60\t        self.assertEqual(len(chunks), 1)\n61\t        self.assertEqual(chunks[0]['title'], 'class Test')\n62\t        self.assertEqual(chunks[0]['lines'], [1, 2])\n63\t\n64\t    def test_split_multiple_functions(self):\n65\t        \"\"\"Несколько функций — отдельные фрагменты.\"\"\"\n66\t        text = \"def a():\\n    pass\\n\\ndef b():\\n    return True\"\n67\t        chunks = list(rag.split_code('app/test.py', text))\n68\t        self.assertEqual(len(chunks), 2)\n69\t        self.assertEqual(chunks[0]['title'], 'a()')\n70\t        self.assertEqual(chunks[1]['title'], 'b()')\n71\t\n72\t\n73\tclass RagSourceTest(unittest.TestCase):\n74\t    \"\"\"Функция source форматирует ссылку на фрагмент.\"\"\"\n75\t\n76\t    def test_source_docs(self):\n77\t        \"\"\"Документация без номеров строк.\"\"\"\n78\t        chunk = {'file': 'README.md', 'title': 'Запуск', 'kind': 'docs'}\n79\t        self.assertEqual(rag.source(chunk), 'README.md › Запуск')\n80\t\n81\t    def test_source_code_with_lines(self):\n82\t        \"\"\"Код с номерами строк.\"\"\"\n83\t        chunk = {'file': 'app/main.py', 'title': 'answer()', 'kind': 'code', 'lines': [10, 25]}\n84\t        self.assertEqual(rag.source(chunk), 'app/main.py › answer(), строки 10–25')\n85\t\n86\t\n87\tclass RagSplitTest(unittest.TestCase):\n88\t    \"\"\"Функция split выбирает режим по расширению файла.\"\"\"\n89\t\n90\t    def test_split_py_uses_code(self):\n91\t        \"\"\"Python файлы разбиваются через split_code.\"\"\"\n92\t        text = \"def f():\\n    pass\"\n93\t        chunks = list(rag.split('app/test.py', text))\n94\t        self.assertEqual(chunks[0]['kind'], 'code')\n95\t\n96\t    def test_split_md_uses_docs(self):\n97\t        \"\"\"Markdown файлы разбиваются через split_docs.\"\"\"\n98\t        text = \"# Title\\n\\nText\"\n99\t        chunks = list(rag.split('README.md', text))\n100\t        self.assertEqual(chunks[0]['kind'], 'docs')\n101\t\n102\t\n103\tif __name__ == '__main__':\n104\t    unittest.main()\n105\t"}]},"parent_tool_use_id":"toolu_f314b66e8b3f44258a064d60","agent_id":"ac2f7a8c593eedad7","session_id":"335d1da6-e083-458b-b92e-1ca24c19c17b","uuid":"a35fb1ed-0bc2-47a7-a40b-e643fc3d7c44","timestamp":"2026-10-24T22:56:16.612Z","tool_result_meta":[{"id":"toolu_82a1a2f9028e468ab5f8f38a","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"bug-fix","task_description":"Fix broken embedding cache"}
