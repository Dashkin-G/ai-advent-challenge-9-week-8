unk), 'README.md › Запуск')\n\n    def test_source_code_with_lines(self):\n        \"\"\"Код с номерами строк.\"\"\"\n        chunk = {'file': 'app/main.py', 'title': 'answer()', 'kind': 'code', 'lines': [10, 25]}\n        self.assertEqual(rag.source(chunk), 'app/main.py › answer(), строки 10–25')\n\n\nclass RagSplitTest(unittest.TestCase):\n    \"\"\"Функция split выбирает режим по расширению файла.\"\"\"\n\n    def test_split_py_uses_code(self):\n        \"\"\"Python файлы разбиваются через split_code.\"\"\"\n        text = \"def f():\\n    pass\"\n        chunks = list(rag.split('app/test.py', text))\n        self.assertEqual(chunks[0]['kind'], 'code')\n\n    def test_split_md_uses_docs(self):\n        \"\"\"Markdown файлы разбиваются через split_docs.\"\"\"\n        text = \"# Title\\n\\nText\"\n        chunks = list(rag.split('README.md', text))\n        self.assertEqual(chunks[0]['kind'], 'docs')\n\n\nclass RagValidCacheTest(unittest.TestCase):\n    \"\"\"Целый кэш embeddings.json работает без пересчёта векторов.\"\"\"\n\n    def test_valid_cache_reads_without_error(self):\n        \"\"\"Правильный JSON в кэше читается без ошибки.\"\"\"\n        import asyncio\n        from app import llm\n        with tempfile.TemporaryDirectory() as data_dir:\n            cache_path = Path(data_dir) / \"test.json\"\n            valid_cache = {\"abc\": [0.1, 0.2, 0.3], \"def\": [0.4, 0.5, 0.6]}\n            cache_path.write_text(json.dumps(valid_cache), encoding=\"utf-8\")\n            idx = rag.Index(\"test\")\n            idx.cache = cache_path\n            # Проверяем что JSON читается корректно\n            content = idx.cache.read_text(encoding=\"utf-8\")\n            parsed = json.loads(content)\n            self.assertEqual(parsed, valid_cache)\n            # Проверяем что build не падает с валидным кэшем\n            original_embed = llm.embed\n            async def fake_embed(texts):\n                return [[0.0] * 3 for _ in texts]\n            llm.embed = fake_emb