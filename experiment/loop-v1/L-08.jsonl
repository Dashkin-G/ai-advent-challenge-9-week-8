"\"\n        import asyncio\n        from app import llm\n        with tempfile.TemporaryDirectory() as data_dir:\n            cache_path = Path(data_dir) / \"test.json\"\n            valid_cache = {\"abc\": [0.1, 0.2, 0.3], \"def\": [0.4, 0.5, 0.6]}\n            cache_path.write_text(json.dumps(valid_cache), encoding=\"utf-8\")\n            idx = rag.Index(\"test\")\n            idx.cache = cache_path\n            # Проверяем что JSON читается корректно\n            content = idx.cache.read_text(encoding=\"utf-8\")\n            parsed = json.loads(content)\n            self.assertEqual(parsed, valid_cache)\n            # Проверяем что build не падает с валидным кэшем\n            original_embed = llm.embed\n            async def fake_embed(texts):\n                return [[0.0] * 3 for _ in texts]\n            llm.embed = fake_embed\n            try:\n                async def test():\n                    await idx.build({\"x.md\": \"# Hi\"})\n                    self.assertIsNotNone(idx.built)\n                asyncio.run(test())\n            finally:\n                llm.embed = original_embed"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":9414,"output_tokens":0},"context_management":null},"parent_tool_use_id":"toolu_f314b66e8b3f44258a064d60","agent_id":"ac2f7a8c593eedad7","session_id":"335d1da6-e083-458b-b92e-1ca24c19c17b","uuid":"f76f7692-1aad-4291-b140-6143ec977502","timestamp":"2026-10-24T22:58:51.767Z","subagent_type":"bug-fix","task_description":"Fix broken embedding cache"}
