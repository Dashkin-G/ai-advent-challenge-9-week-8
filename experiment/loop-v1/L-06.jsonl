{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_93e6b0b2002848e58986dc90","type":"tool_result","content":"1\t\"\"\"Команда /help: контекст проекта по MCP → поиск по документации → ответ локальной модели.\"\"\"\n2\timport json\n3\timport time\n4\t\n5\tfrom mcp import Client\n6\t\n7\tfrom app import config, llm, rag\n8\t\n9\tSYSTEM = \"\"\"Ты — ассистент разработчика проекта ml-student-dropout. Отвечай по-русски, коротко: 2–5 предложений или список.\n10\tОпирайся только на «Контекст проекта» и «Фрагменты документации».\n11\tПосле утверждения из документации ставь ссылку на фрагмент — его заголовок в квадратных скобках, например [docs/model.md › Причины риска].\n12\tПро ветку, изменения и файлы отвечай по контексту проекта.\n13\tЕсли ответа нет ни там, ни там — так и скажи: «В документации этого нет».\n14\tКоманды, пути, имена файлов и полей пиши в `обратных кавычках`.\"\"\"\n15\t\n16\tOVERVIEW = \"Что это за проект, как он устроен и как его запустить?\"\n17\tCHANGES = (\"измен\", \"правк\", \"поменя\", \"diff\", \"дифф\")  # вопрос про правки — нужен ещё и diff\n18\tGROUPS = {\"изменён\": \"изменены\", \"новый\": \"новые\", \"удалён\": \"удалены\", \"добавлен\": \"добавлены\",\n19\t          \"переименован\": \"переименованы\", \"конфликт\": \"с конфликтом\"}\n20\t\n21\t\n22\tdef parse(text):\n23\t    \"\"\"'/help вопрос' → вопрос; просто '/help' — вопрос о проекте в целом; без /help — None.\"\"\"\n24\t    text = text.strip()\n25\t    if text != \"/help\" and not text.startswith(\"/help \"):\n26\t        return None\n27\t    return text[len(\"/help\"):].strip() or OVERVIEW\n28\t\n29\t\n30\tdef server_info(client):\n31\t    return {\"name\": client.server_info.name if client.server_info else \"?\",\n32\t            \"version\": client.server_info.version if client.server_info else \"\",\n33\t            \"protocol\": client.protocol_version}\n34\t\n35\t\n36\tasync def call(client, calls, name, args):\n37\t    \"\"\"Вызов инструмента MCP: запись с временем и результатом — в calls; вернёт результат или None при ошибке.\"\"\"\n38\t    started = time.perf_counter()\n39\t    result = await client.call_tool(name, args)\n40\t    text = \"\".join(getattr(part, \"text\", \"\") for part in result.content)\n41\t    calls.append({\"tool\": name, \"args\": args, \"ok\": not result.is_error,\n42\t                  \"result\": result.structured_content if result.structured_content is not None else text,\n43\t                  \"ms\": round((time.perf_counter() - started) * 1000)})\n44\t    return calls[-1][\"result\"] if calls[-1][\"ok\"] else None\n45\t\n46\t\n47\tasync def call_tools(plan):\n48\t    \"\"\"Одна сессия MCP: вызовы инструментов по очереди с временем и результатом.\"\"\"\n49\t    calls = []\n50\t    async with Client(config.MCP_URL, read_timeout_seconds=30) as client:\n51\t        server = server_info(client)\n52\t        for name, args in plan:\n53\t            await call(client, calls, name, args)\n54\t    return server, calls\n55\t\n56\t\n57\tdef context_text(calls):\n58\t    \"\"\"Результаты MCP — коротким текстом для модели.\"\"\"\n59\t    got = {c[\"tool\"]: c[\"result\"] for c in calls if c[\"ok\"]}\n60\t    lines = [f\"Проект: {config.PROJECT_DIR.name}\"]\n61\t    if branch := got.get(\"git_branch\"):\n62\t        lines.append(f\"Текущая ветка: {branch['branch']}; ветки: {', '.join(branch['branches'])}; \"\n63\t                     f\"последний коммит: {branch['last_commit']}\")\n64\t    if status := got.get(\"git_status\"):\n65\t        groups = {}\n66\t        for c in status[\"changed\"]:\n67\t            groups.setdefault(GROUPS.get(c[\"status\"], c[\"status\"]), []).append(c[\"path\"])\n68\t        parts = [f\"{name} ({len(paths)}): {', '.join(paths[:12])}{' …' if len(paths) > 12 else ''}\"\n69\t                 for name, paths in groups.items()]\n70\t        lines.append(\"Незакоммиченных изменений нет\" if status[\"clean\"]\n71\t                     else f\"Незакоммиченные изменения — {status['count']} файлов. \" + \"; \".join(parts))\n72\t    if files := got.get(\"list_files\"):\n73\t        lines.append(f\"Файлы проекта ({files['count']}): {', '.join(files['files'])}\")\n74\t    if diff := got.get(\"git_diff\"):\n75\t        lines.append(f\"Diff ({diff['lines']} строк{', начало' if diff['truncated'] else ''}):\\n{diff['diff'] or '(пусто)'}\")\n76\t    return \"\\n\".join(lines)\n77\t\n78\t\n79\tdef messages(question, context, hits):\n80\t    # Неизменная часть — системный промпт и контекст проекта — идёт первой: Ollama кэширует начало промпта\n81\t    fragments = \"\\n\\n\".join(f\"[{h['file']} › {h['title']}]\\n{h['text']}\" for h in hits)\n82\t    user = (f\"Контекст проекта (git, получен через MCP):\\n{context}\\n\\nВопрос: {question}\\n\\n\"\n83\t            f\"Фрагменты документации:\\n\\n{fragments}\\n\\nВопрос: {question}\")\n84\t    return [{\"role\": \"system\", \"content\": SYSTEM}, {\"role\": \"user\", \"content\": user}]\n85\t\n86\t\n87\tasync def answer(question):\n88\t    \"\"\"Шаги ответа событиями: mcp → sources → prompt → text… → done; ошибка — error с номером шага.\"\"\"\n89\t    yield {\"type\": \"question\", \"question\": question}\n90\t\n91\t    step = \"mcp\"\n92\t    try:\n93\t        started = time.perf_counter()\n94\t        plan = [(\"git_branch\", {}), (\"git_status\", {}), (\"list_files\", {})]\n95\t        if any(word in question.lower() for word in CHANGES):\n96\t            plan.append((\"git_diff\", {}))\n97\t        server, calls = await call_tools(plan)\n98\t        context = context_text(calls)\n99\t        yield {\"type\": \"mcp\", \"server\": server, \"calls\": calls, \"seconds\": round(time.perf_counter() - started, 2)}\n100\t\n101\t        step = \"sources\"\n102\t        started = time.perf_counter()\n103\t        hits = await rag.search(question)\n104\t        yield {\"type\": \"sources\", \"hits\": hits, \"index\": rag.info(), \"seconds\": round(time.perf_counter() - started, 2)}\n105\t\n106\t        step = \"answer\"\n107\t        prompt = messages(question, context, hits)\n108\t        yield {\"type\": \"prompt\", \"messages\": prompt, \"chars\": sum(len(m[\"content\"]) for m in prompt)}\n109\t        async for event in llm.chat(prompt):\n110\t            yield event\n111\t    except llm.LLMError as exc:\n112\t        yield {\"type\": \"error\", \"step\": step, \"message\": str(exc)}\n113\t    except Exception as exc:  # MCP, git, файлы — показываем словами, а не падением\n114\t        yield {\"type\": \"error\", \"step\": step, \"message\": reason(exc)}\n115\t\n116\t\n117\tdef reason(exc):\n118\t    \"\"\"Причина ошибки; клиент MCP бросает ExceptionGroup — достаём первую настоящую.\"\"\"\n119\t    while isinstance(exc, BaseExceptionGroup) and exc.exceptions:\n120\t        exc = exc.exceptions[0]\n121\t    return getattr(exc, \"message\", None) or str(exc) or type(exc).__name__\n122\t\n123\t\n124\tasync def project():\n125\t    \"\"\"Шапка страницы: проект и ветка — тоже через MCP.\"\"\"\n126\t    try:\n127\t        _, calls = await call_tools([(\"git_branch\", {})])\n128\t        return {\"name\": config.PROJECT_DIR.name, \"branch\": calls[0][\"result\"][\"branch\"] if calls[0][\"ok\"] else None}\n129\t    except Exception as exc:\n130\t        return {\"name\": config.PROJECT_DIR.name, \"branch\": None, \"error\": reason(exc)}\n131\t\n132\t\n133\tdef dumps(event):\n134\t    return json.dumps(event, ensure_ascii=False) + \"\\n\"\n135\t"}]},"parent_tool_use_id":"toolu_8873eed4691540d584444f92","agent_id":"a9d8e45379f7f076c","session_id":"596fb0ac-c584-4837-83ac-76f96b6f74e2","uuid":"d7cbff8b-222a-4233-a85f-3e9c43e11932","timestamp":"2026-10-24T22:51:15.559Z","tool_result_meta":[{"id":"toolu_93e6b0b2002848e58986dc90","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"general-purpose","task_description":"Find Ollama endpoints"}
