{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0d9ea1ea02e346b886487b6a","type":"tool_result","content":"1\t\"\"\"Ассистент по файлам проекта: задача словами → модель сама вызывает инструменты MCP — ищет, читает, правит\n2\tи создаёт файлы → правки копятся в черновике → diff, который пользователь применяет или отменяет.\"\"\"\n3\timport json\n4\timport time\n5\t\n6\tfrom mcp import Client\n7\t\n8\tfrom app import assistant, config, llm\n9\t\n10\tSYSTEM = \"\"\"Ты — ассистент разработчика проекта ml-student-dropout: сервис на FastAPI и scikit-learn — API в src/api, модель в src/ml, схемы в src/schemas, дашборд в static/, тесты в tests/, документация в README.md и docs/. Задачу выполняешь сам через инструменты: ищешь, читаешь, правишь и создаёшь файлы проекта. Пользователя ни о чём не спрашивай.\n11\tПравила:\n12\t- Начинай с search, а не с чтения файлов целиком. Ищи так, как написано в файлах: имена функций, классов, констант, адреса эндпоинтов, числа, слова из документации; несколько вариантов — в одном запросе через |.\n13\t- read_file — только строки вокруг найденного: start и end по номерам из search.\n14\t- edit_file: old — точная строка из файла без номера, new — она же после правки; каждое место — отдельной правкой. Новый файл — write_file. Правки идут в черновик, на диск их запишет пользователь.\n15\t- Меняй только то, что требует задача. Не выдумывай файлов, функций, чисел и фактов — бери только то, что видел в файлах и git; замеры (время, скорость, проценты) не пересчитывай.\n16\tТиповые задачи:\n17\t- «Где используется X» — search по всем вариантам имени (функция, класс, эндпоинт, русское название) и перечисли каждое место.\n18\t- «Обнови документацию по изменениям в коде» — git_diff; по строкам «-» и «+» пойми, что было и что стало. Документация пишет значения, а не имена констант: поменялось число или строка — search прежнего значения по всему проекту. Поправь в README.md и docs/ каждое место с прежним значением, другие места не трогай. Перед отчётом — search прежнего значения ещё раз: в документации его не осталось.\n19\t- «Составь CHANGELOG по истории» — git_log с oldest_first=true, затем write_file: «# Журнал изменений» и по строке на коммит в том же порядке — «- дата — что изменилось (хеш)», например «- дд.мм.гггг — Добавлена выгрузка отчёта в CSV (1a2b3c4)». Даты — как в git_log. Что изменилось — по сообщению и файлам коммита, по-русски своими словами; у общего сообщения вроде «init commit» — какие части сервиса появились, словами, без путей; термины вроде pull request и CI не переводи. Без других заголовков, списков файлов и чисел строк.\n20\tКогда задача выполнена, ответь без вызова инструментов: коротко по-русски, что нашёл (`файл:строка`) и что изменил — только правки, которые прошли.\"\"\"\n21\t\n22\t# Что получает модель; apply_draft и discard_draft зовёт только код — по кнопке пользователя\n23\tMODEL_TOOLS = {\"files\": [\"list_files\", \"read_file\", \"search\", \"edit_file\", \"write_file\"],\n24\t               \"git\": [\"git_status\", \"git_diff\", \"git_log\"]}\n25\tMAX_STEPS = 12  # ходов модели; дальше — просим подвести итог\n26\tOPTIONS = {\"num_ctx\": 16384, \"num_predict\": 1500, \"seed\": 7}  # разговор с файлами длинный; seed — та же задача, тот же путь\n27\tBLOCKS = {\"text\", \"diff\"}  # текст файла и diff модель получает как есть, а не строкой JSON\n28\tFINISH = \"Шаги закончились. Не вызывай инструменты — коротко отчитайся: что нашёл и что изменил.\"\n29\t# 4B-модель пропускает проверку из промпта; после правок код один раз просит её сам — что искать, решает модель\n30\tCHECK = (\"Перед отчётом проверь себя: search того, что было до правки, по всему проекту — не осталось ли его в \"\n31\t         \"документации. Осталось — поправь. Потом дай итоговый отчёт: что нашёл (`файл:строка`) и что изменил.\")\n32\t\n33\t\n34\tdef spec(tool):\n35\t    \"\"\"Инструмент MCP → функция для Ollama; заголовки из JSON Schema модели не нужны — лишние токены.\"\"\"\n36\t    def clean(node):\n37\t        if isinstance(node, dict):\n38\t            return {k: clean(v) for k, v in node.items() if not (k == \"title\" and isinstance(v, str))}\n39\t        return node\n40\t    return {\"type\": \"function\",\n41\t            \"function\": {\"name\": tool.name, \"description\": tool.description, \"parameters\": clean(tool.input_schema)}}\n42\t\n43\t\n44\tdef for_model(result):\n45\t    \"\"\"Результат инструмента — текстом: файл, совпадения и diff — строками как есть, список записей — по строке\n46\t    на запись. В JSON кавычки экранируются, и модель копирует \\\\\" в правку, а по вложенному JSON 4B-модель\n47\t    теряет порядок записей.\"\"\"\n48\t    if not isinstance(result, dict):\n49\t        return str(result)\n50\t    head, blocks = {}, []\n51\t    for key, value in result.items():\n52\t        if key in BLOCKS and isinstance(value, str):\n53\t            blocks.append(value)\n54\t        elif isinstance(value, list) and value and all(isinstance(v, str) for v in value):\n55\t            blocks.append(\"\\n\".join(value))\n56\t        elif isinstance(value, list) and value and all(isinstance(v, dict) for v in value):\n57\t            blocks.append(\"\\n\".join(\" · \".join(f\"{k}: {', '.join(map(str, v)) if isinstance(v, list) else v}\"\n58\t                                               for k, v in item.items()) for item in value))\n59\t        else:\n60\t            head[key] = value\n61\t    return \"\\n\".join([json.dumps(head, ensure_ascii=False), *blocks])\n62\t\n63\t\n64\tasync def turn(messages, tools=None):\n65\t    \"\"\"Один ход модели: текст потоком, в конце — {\"type\": \"turn\"} с текстом, вызовами и счётчиками.\"\"\"\n66\t    text, calls, counters = \"\", [], {}\n67\t    async for event in llm.chat(messages, options=OPTIONS, tools=tools):\n68\t        if event[\"type\"] == \"text\":\n69\t            text += event[\"text\"]\n70\t            yield event\n71\t        elif event[\"type\"] == \"tool_calls\":\n72\t            calls += event[\"calls\"]\n73\t        else:\n74\t            counters = event\n75\t    yield {\"type\": \"turn\", \"text\": text, \"calls\": calls, \"llm\": counters}\n76\t\n77\t\n78\tasync def run(goal):\n79\t    \"\"\"Работа над задачей событиями: goal → context → (thinking → text… → step)… → [check → ещё шаги] → report →\n80\t    draft → done; ошибка — error.\"\"\"\n81\t    yield {\"type\": \"goal\", \"goal\": goal}\n82\t    started, step = time.perf_counter(), 0\n83\t    try:\n84\t        async with Client(config.FILES_MCP_URL, read_timeout_seconds=60) as files, \\\n85\t                Client(config.MCP_URL, read_timeout_seconds=60) as git:\n86\t            await files.call_tool(\"discard_draft\", {})  # неприменённые правки прошлой задачи сюда не смешиваем\n87\t            servers = {\"files\": files, \"git\": git}\n88\t\n89\t            # контекст зовёт код: ветка, изменения и список файлов — чтобы модель не гадала пути\n90\t            calls = []\n91\t            await assistant.call(git, calls, \"git_branch\", {})\n92\t            await assistant.call(git, calls, \"git_status\", {})\n93\t            await assistant.call(files, calls, \"list_files\", {})\n94\t            owners, specs, tools = {}, [], []\n95\t            for name, client in servers.items():\n96\t                for tool in (await client.list_tools()).tools:\n97\t                    if tool.name in MODEL_TOOLS[name]:\n98\t                        owners[tool.name] = name\n99\t                        specs.append(spec(tool))\n100\t                        tools.append({\"name\": tool.name, \"server\": name, \"description\": tool.description})\n101\t            messages = [{\"role\": \"system\", \"content\": SYSTEM},\n102\t                        {\"role\": \"user\", \"content\": f\"{assistant.context_text(calls)}\\n\\nЗадача: {goal}\"}]\n103\t            yield {\"type\": \"context\", \"calls\": calls, \"tools\": tools, \"prompt\": messages,\n104\t                   \"servers\": {name: assistant.server_info(client) for name, client in servers.items()},\n105\t                   \"seconds\": round(time.perf_counter() - started, 2)}\n106\t            # вызов → его запись: 4B-модель иногда повторяет тот же вызов. Ключ — с версией черновика: после\n107\t            # правки те же чтение и поиск дают новое, и проверить себя модели можно\n108\t            seen, version, checked = {}, 0, False\n109\t            while True:\n110\t                step += 1\n111\t                last = step > MAX_STEPS\n112\t                if last:\n113\t                    messages.append({\"role\": \"user\", \"content\": FINISH})\n114\t                yield {\"type\": \"thinking\", \"step\": step}\n115\t                async for event in turn(messages, None if last else specs):\n116\t                    if event[\"type\"] == \"text\":\n117\t                        yield event\n118\t                    else:\n119\t                        reply = event\n120\t                messages.append({\"role\": \"assistant\", \"content\": reply[\"text\"],\n121\t                                 **({\"tool_calls\": reply[\"calls\"]} if reply[\"calls\"] else {})})\n122\t                if not reply[\"calls\"]:\n123\t                    edited = any(r[\"ok\"] and r[\"tool\"] == \"edit_file\" for r in seen.values())\n124\t                    if edited and not checked and not last:\n125\t                        checked = True\n126\t                        messages.append({\"role\": \"user\", \"content\": CHECK})\n127\t                        yield {\"type\": \"check\", \"step\": step, \"text\": reply[\"text\"], \"llm\": reply[\"llm\"]}\n128\t                        continue\n129\t                    yield {\"type\": \"report\", \"step\": step, \"text\": reply[\"text\"], \"llm\": reply[\"llm\"]}\n130\t                    break\n131\t\n132\t                done = []\n133\t                for call in reply[\"calls\"]:\n134\t                    name, args = call[\"function\"][\"name\"], call[\"function\"].get(\"arguments\") or {}\n135\t                    key = json.dumps([name, args, version], sort_keys=True, ensure_ascii=False)\n136\t                    if name not in owners:\n137\t                        done.append({\"tool\": name, \"args\": args, \"ok\": False, \"result\": f\"Инструмента {name} нет\", \"ms\": 0})\n138\t                    elif key in seen:\n139\t                        before = seen[key]\n140\t                        done.append({\"tool\": name, \"args\": args, \"ok\": False, \"ms\": 0, \"result\":\n141\t                                     \"Этот вызов уже был, его результат выше. Сделай другой шаг или закончи.\" if before[\"ok\"]\n142\t                                     else f\"Этот вызов уже был и не прошёл: {before['result']} Исправь аргументы или закончи.\"})\n143\t                    else:\n144\t                        await assistant.call(servers[owners[name]], done, name, args)\n145\t                        done[-1][\"server\"] = owners[name]\n146\t                        seen[key] = done[-1]\n147\t                        version += done[-1][\"ok\"] and name in (\"edit_file\", \"write_file\")\n148\t                    messages.append({\"role\": \"tool\", \"tool_name\": name, \"content\": for_model(done[-1][\"result\"])})\n149\t                yield {\"type\": \"step\", \"step\": step, \"thought\": reply[\"text\"], \"calls\": done, \"llm\": reply[\"llm\"]}\n150\t\n151\t            draft = (await files.call_tool(\"draft_diff\", {})).structured_content\n152\t            yield {\"type\": \"draft\", **draft}\n153\t        yield {\"type\": \"done\", \"steps\": step, \"seconds\": round(time.perf_counter() - started, 1)}\n154\t    except llm.LLMError as exc:\n155\t        yield {\"type\": \"error\", \"step\": step, \"message\": str(exc)}\n156\t    except Exception as exc:  # MCP, git, файлы — словами, а не падением\n157\t        yield {\"type\": \"error\", \"step\": step, \"message\": assistant.reason(exc)}\n158\t\n159\t\n160\tasync def apply():\n161\t    \"\"\"Записать черновик в проект — по кнопке пользователя; git status после записи показывает, что файлы\n162\t    правда изменились.\"\"\"\n163\t    calls = []\n164\t    async with Client(config.FILES_MCP_URL, read_timeout_seconds=60) as files:\n165\t        written = await assistant.call(files, calls, \"apply_draft\", {})\n166\t    async with Client(config.MCP_URL, read_timeout_seconds=60) as git:\n167\t        status = await assistant.call(git, calls, \"git_status\", {})\n168\t    return {\"written\": written, \"status\": status, \"calls\": calls}\n169\t\n170\t\n171\tasync def discard():\n172\t    async with Client(config.FILES_MCP_URL, read_timeout_seconds=60) as files:\n173\t        return (await files.call_tool(\"discard_draft\", {})).structured_content\n174\t"}]},"parent_tool_use_id":"toolu_8873eed4691540d584444f92","agent_id":"a9d8e45379f7f076c","session_id":"596fb0ac-c584-4837-83ac-76f96b6f74e2","uuid":"f922554a-9ec0-4f01-99dc-64108d9cfcff","timestamp":"2026-10-24T22:51:23.478Z","tool_result_meta":[{"id":"toolu_0d9ea1ea02e346b886487b6a","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"general-purpose","task_description":"Find Ollama endpoints"}
