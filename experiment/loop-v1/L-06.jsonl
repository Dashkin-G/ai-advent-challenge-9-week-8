{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_d1ec3221a2204478ba64ad5d","type":"tool_result","content":"1\t\"\"\"Ассистент поддержки: обращение и клиент из CRM по MCP → поиск по FAQ и документации → ответ клиенту.\"\"\"\n2\timport asyncio\n3\timport json\n4\timport time\n5\t\n6\tfrom mcp import Client\n7\t\n8\tfrom app import assistant, config, llm, rag\n9\t\n10\tSYSTEM = \"\"\"Ты — ассистент поддержки сервиса «Риск отчисления студентов». Пишешь ответ клиенту от имени поддержки: по-русски, на «вы», начни с обращения по имени клиента из CRM; коротко — 3–6 предложений или список шагов.\n11\tОпирайся только на «Данные из CRM» и «Фрагменты базы знаний». Фрагменты найдены поиском и бывают не по теме: бери только те, что отвечают на вопрос клиента.\n12\tЕсли причина видна в технических данных обращения или в профиле клиента — назови её конкретно: поле, значение, текст ошибки, команду — и скажи, что сделать. Прошлые обращения упоминай, только если они о той же проблеме.\n13\tУчитывай, кто клиент и как он работает с сервисом: дашборд — простыми словами и кнопками страницы; API или Docker — полями, запросами и командами. Если сделать нужное клиент сам не может, а в профиле сказано, кто ведёт сервис, — подскажи, к кому обратиться.\n14\tПосле утверждения из базы знаний ставь ссылку на фрагмент — его заголовок в квадратных скобках, например [FAQ › Что значит ошибка 422?].\n15\tНе придумывай полей, команд, настроек, кнопок и эндпоинтов, которых нет во фрагментах и данных CRM. Если ответа нет — так и скажи и пообещай передать вопрос разработчикам.\n16\tПоля, команды и адреса пиши в `обратных кавычках`.\"\"\"\n17\t\n18\tNO_TICKET = \"Обращения нет: вопрос о продукте без данных клиента — отвечай без обращения по имени.\"\n19\t\n20\tindex = rag.Index(\"support-embeddings\")  # FAQ поддержки + README и docs/ проекта\n21\t_lock = asyncio.Lock()  # сборка при старте и первый вопрос не считают векторы дважды\n22\t\n23\t\n24\tasync def ensure_index():\n25\t    \"\"\"База знаний актуальна: поменяли FAQ или документацию — пересчитываются векторы только новых фрагментов.\"\"\"\n26\t    async with _lock:\n27\t        texts = {\"FAQ\": config.FAQ.read_text(encoding=\"utf-8\")}\n28\t        texts.update({p.relative_to(config.PROJECT_DIR).as_posix(): p.read_text(encoding=\"utf-8\") for p in rag.files()})\n29\t        await index.build(texts)\n30\t        return index.info()\n31\t\n32\t\n33\tasync def queue():\n34\t    \"\"\"Очередь обращений для страницы — тоже через MCP.\"\"\"\n35\t    started, calls = time.perf_counter(), []\n36\t    try:\n37\t        async with Client(config.CRM_MCP_URL, read_timeout_seconds=30) as client:\n38\t            server = assistant.server_info(client)\n39\t            found = await assistant.call(client, calls, \"list_tickets\", {})\n40\t    except Exception as exc:\n41\t        return {\"error\": assistant.reason(exc)}\n42\t    if found is None:\n43\t        return {\"error\": calls[0][\"result\"]}\n44\t    return {\"server\": server, \"tickets\": found[\"tickets\"], \"ms\": round((time.perf_counter() - started) * 1000)}\n45\t\n46\t\n47\tasync def crm(ticket_id):\n48\t    \"\"\"Одна сессия MCP: обращение, затем его клиент — с временем и результатом каждого вызова.\"\"\"\n49\t    calls = []\n50\t    async with Client(config.CRM_MCP_URL, read_timeout_seconds=30) as client:\n51\t        server = assistant.server_info(client)\n52\t        ticket = await assistant.call(client, calls, \"get_ticket\", {\"ticket_id\": ticket_id})\n53\t        user = await assistant.call(client, calls, \"get_user\", {\"user_id\": ticket[\"user_id\"]}) if ticket else None\n54\t    return server, calls, ticket, user\n55\t\n56\t\n57\tdef context_text(ticket, user):\n58\t    \"\"\"Клиент и обращение — коротким текстом для модели.\"\"\"\n59\t    lines = [f\"Клиент: {user['name']} — {user['role']}, {user['org']}. \"\n60\t             f\"Работает с сервисом через {user['channel']}: {user['setup']}.\"]\n61\t    if user.get(\"notes\"):\n62\t        lines.append(f\"Заметки поддержки: {user['notes']}\")\n63\t    if past := [t for t in user[\"tickets\"] if t[\"id\"] != ticket[\"id\"]]:\n64\t        lines.append(\"Прошлые обращения: \" + \"; \".join(\n65\t            f\"{t['id']} «{t['subject']}» — {t['status']}\" + (f\": {t['resolution']}\" if t.get(\"resolution\") else \"\")\n66\t            for t in past))\n67\t    lines.append(f\"Обращение {ticket['id']} «{ticket['subject']}» — {ticket['status']}, \"\n68\t                 f\"приоритет {ticket['priority']}, {ticket['created']}.\")\n69\t    lines.append(f\"Сообщение клиента: {ticket['message']}\")\n70\t    if ticket[\"technical\"]:\n71\t        lines.append(\"Технические данные обращения:\")\n72\t        lines += [f\"- {k}: {v if isinstance(v, str) else json.dumps(v, ensure_ascii=False)}\"\n73\t                  for k, v in ticket[\"technical\"].items()]\n74\t    return \"\\n\".join(lines)\n75\t\n76\t\n77\tdef queries(question, ticket):\n78\t    \"\"\"Запросы к базе знаний: вопрос и тексты ошибок сервиса из обращения — каждый отдельно. Сообщение клиента\n79\t    в запрос не идёт: длинный текст размывает вектор, и нужный раздел FAQ уходит с первого места.\"\"\"\n80\t    errors = [v[\"details\"] for v in (ticket or {}).get(\"technical\", {}).values()\n81\t              if isinstance(v, dict) and v.get(\"details\")]\n82\t    return list(dict.fromkeys([question, *errors]))\n83\t\n84\t\n85\tdef messages(question, context, hits):\n86\t    fragments = \"\\n\\n\".join(f\"[{rag.source(h)}]\\n{h['text']}\" for h in hits)\n87\t    crm_part = f\"Данные из CRM (получены через MCP):\\n{context}\" if context else NO_TICKET\n88\t    user = f\"{crm_part}\\n\\nВопрос: {question}\\n\\nФрагменты базы знаний:\\n\\n{fragments}\\n\\nВопрос: {question}\"\n89\t    return [{\"role\": \"system\", \"content\": SYSTEM}, {\"role\": \"user\", \"content\": user}]\n90\t\n91\t\n92\tasync def answer(ticket_id, question):\n93\t    \"\"\"Шаги ответа событиями: mcp (если выбрано обращение) → sources → prompt → text… → done;\n94\t    ошибка — error с шагом.\"\"\"\n95\t    yield {\"type\": \"question\", \"question\": question, \"ticket_id\": ticket_id}\n96\t    step = \"mcp\"\n97\t    try:\n98\t        ticket = context = None\n99\t        if ticket_id:\n100\t            started = time.perf_counter()\n101\t            server, calls, ticket, user = await crm(ticket_id)\n102\t            yield {\"type\": \"mcp\", \"server\": server, \"calls\": calls, \"seconds\": round(time.perf_counter() - started, 2)}\n103\t            if not user:\n104\t                yield {\"type\": \"error\", \"step\": step, \"message\": next(c[\"result\"] for c in calls if not c[\"ok\"])}\n105\t                return\n106\t            context = context_text(ticket, user)\n107\t\n108\t        step = \"sources\"\n109\t        started = time.perf_counter()\n110\t        await ensure_index()\n111\t        asked = queries(question, ticket)\n112\t        hits = index.nearest(await llm.embed(asked), config.TOP)\n113\t        yield {\"type\": \"sources\", \"hits\": hits, \"queries\": asked, \"index\": index.info(),\n114\t               \"seconds\": round(time.perf_counter() - started, 2)}\n115\t\n116\t        step = \"answer\"\n117\t        prompt = messages(question, context, hits)\n118\t        yield {\"type\": \"prompt\", \"messages\": prompt, \"chars\": sum(len(m[\"content\"]) for m in prompt)}\n119\t        async for event in llm.chat(prompt, options={\"seed\": 42}):  # то же обращение — тот же ответ\n120\t            yield event\n121\t    except llm.LLMError as exc:\n122\t        yield {\"type\": \"error\", \"step\": step, \"message\": str(exc)}\n123\t    except Exception as exc:  # MCP, файл CRM — показываем словами, а не падением\n124\t        yield {\"type\": \"error\", \"step\": step, \"message\": assistant.reason(exc)}\n125\t"}]},"parent_tool_use_id":"toolu_8873eed4691540d584444f92","agent_id":"a9d8e45379f7f076c","session_id":"596fb0ac-c584-4837-83ac-76f96b6f74e2","uuid":"448cd8f2-89a1-452d-96be-e113c28cb883","timestamp":"2026-10-24T22:51:16.234Z","tool_result_meta":[{"id":"toolu_d1ec3221a2204478ba64ad5d","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"general-purpose","task_description":"Find Ollama endpoints"}
