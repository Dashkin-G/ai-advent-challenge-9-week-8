{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_22c622aa656d4bbfbe8bb45e","type":"tool_result","content":"1\t\"\"\"Ассистент разработчика и поддержки: страница /help, место оператора поддержки /support, работа с файлами\n2\tпроекта /files, MCP-серверы git на /mcp/git, CRM на /mcp/crm и файлов на /mcp/files.\"\"\"\n3\timport asyncio\n4\timport logging\n5\tfrom contextlib import asynccontextmanager\n6\t\n7\timport uvicorn\n8\tfrom fastapi import FastAPI, HTTPException\n9\tfrom fastapi.responses import FileResponse, StreamingResponse\n10\tfrom pydantic import BaseModel\n11\t\n12\tfrom app import assistant, config, crm_mcp, files, files_mcp, git_mcp, llm, rag, support\n13\t\n14\tlogging.basicConfig(level=logging.INFO)\n15\tlogger = logging.getLogger(__name__)\n16\t\n17\tPAGE = config.ROOT / \"static\" / \"index.html\"\n18\tSUPPORT_PAGE = config.ROOT / \"static\" / \"support.html\"\n19\tFILES_PAGE = config.ROOT / \"static\" / \"files.html\"\n20\t\n21\t\n22\tasync def warm_up():\n23\t    \"\"\"Векторы документации и базы знаний, модель — при старте, чтобы первый вопрос не ждал.\"\"\"\n24\t    try:\n25\t        logger.info(\"Индекс документации: %s\", await rag.ensure_index())\n26\t        logger.info(\"База знаний поддержки: %s\", await support.ensure_index())\n27\t        await llm.load()\n28\t        logger.info(\"Модель %s загружена в память\", config.MODEL)\n29\t    except Exception as exc:\n30\t        logger.warning(\"Подготовка не завершена: %s\", exc)\n31\t\n32\t\n33\t@asynccontextmanager\n34\tasync def lifespan(app):\n35\t    # у смонтированных приложений MCP свой lifespan не запускается — менеджеры сессий поднимаем здесь\n36\t    async with git_mcp.server.session_manager.run(), crm_mcp.server.session_manager.run(), \\\n37\t            files_mcp.server.session_manager.run():\n38\t        task = asyncio.create_task(warm_up())\n39\t        yield\n40\t        task.cancel()\n41\t\n42\t\n43\tapp = FastAPI(title=\"Ассистент разработчика и поддержки\", lifespan=lifespan)\n44\tapp.mount(\"/mcp/git\", git_mcp.server.streamable_http_app(streamable_http_path=\"/\"))\n45\tapp.mount(\"/mcp/crm\", crm_mcp.server.streamable_http_app(streamable_http_path=\"/\"))\n46\tapp.mount(\"/mcp/files\", files_mcp.server.streamable_http_app(streamable_http_path=\"/\"))\n47\t\n48\t\n49\tclass Command(BaseModel):\n50\t    text: str\n51\t\n52\t\n53\tclass Question(BaseModel):\n54\t    question: str\n55\t    ticket_id: str | None = None\n56\t\n57\t\n58\tclass Task(BaseModel):\n59\t    goal: str\n60\t\n61\t\n62\t@app.get(\"/\", include_in_schema=False)\n63\tasync def page():\n64\t    return FileResponse(PAGE)\n65\t\n66\t\n67\t@app.get(\"/support\", include_in_schema=False)\n68\tasync def support_page():\n69\t    return FileResponse(SUPPORT_PAGE)\n70\t\n71\t\n72\t@app.get(\"/files\", include_in_schema=False)\n73\tasync def files_page():\n74\t    return FileResponse(FILES_PAGE)\n75\t\n76\t\n77\t@app.get(\"/api/status\")\n78\tasync def status():\n79\t    ollama, project = await asyncio.gather(llm.status(), assistant.project())\n80\t    return {\"project\": {**project, \"path\": str(config.PROJECT_DIR)}, \"ollama\": ollama,\n81\t            \"model\": config.MODEL, \"embed_model\": config.EMBED_MODEL, \"docs\": rag.info()}\n82\t\n83\t\n84\t@app.post(\"/api/help\")\n85\tasync def help_command(command: Command):\n86\t    question = assistant.parse(command.text)\n87\t    if question is None:\n88\t        raise HTTPException(status_code=400, detail=\"Команда ассистента: /help <вопрос о проекте>\")\n89\t\n90\t    async def stream():\n91\t        async for event in assistant.answer(question):\n92\t            yield assistant.dumps(event)\n93\t\n94\t    return StreamingResponse(stream(), media_type=\"application/x-ndjson\")\n95\t\n96\t\n97\t@app.get(\"/api/support/status\")\n98\tasync def support_status():\n99\t    ollama, crm = await asyncio.gather(llm.status(), support.queue())\n100\t    return {\"ollama\": ollama, \"model\": config.MODEL, \"embed_model\": config.EMBED_MODEL,\n101\t            \"kb\": support.index.info(), \"crm\": crm}\n102\t\n103\t\n104\t@app.post(\"/api/support/answer\")\n105\tasync def support_answer(body: Question):\n106\t    question = body.question.strip()\n107\t    if not question:\n108\t        raise HTTPException(status_code=400, detail=\"Напишите вопрос клиента\")\n109\t\n110\t    async def stream():\n111\t        async for event in support.answer(body.ticket_id, question):\n112\t            yield assistant.dumps(event)\n113\t\n114\t    return StreamingResponse(stream(), media_type=\"application/x-ndjson\")\n115\t\n116\t\n117\t@app.post(\"/api/files/run\")\n118\tasync def files_run(task: Task):\n119\t    goal = task.goal.strip()\n120\t    if not goal:\n121\t        raise HTTPException(status_code=400, detail=\"Напишите задачу: что найти, обновить или создать\")\n122\t\n123\t    async def stream():\n124\t        async for event in files.run(goal):\n125\t            yield assistant.dumps(event)\n126\t\n127\t    return StreamingResponse(stream(), media_type=\"application/x-ndjson\")\n128\t\n129\t\n130\t@app.post(\"/api/files/apply\")\n131\tasync def files_apply():\n132\t    return await files.apply()\n133\t\n134\t\n135\t@app.post(\"/api/files/discard\")\n136\tasync def files_discard():\n137\t    return await files.discard()\n138\t\n139\t\n140\tif __name__ == \"__main__\":\n141\t    uvicorn.run(app, host=config.HOST, port=config.PORT)\n142\t"}]},"parent_tool_use_id":"toolu_35db1da27faf427b8eb4179b","agent_id":"aa68d4d51e45ee9fa","session_id":"42fbc804-1cc2-4c84-ae83-30b8484c170a","uuid":"c5dbb8b9-3bbe-446b-871d-6b321d503f73","timestamp":"2026-10-24T22:48:03.633Z","tool_result_meta":[{"id":"toolu_22c622aa656d4bbfbe8bb45e","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"bug-fix","task_description":"Fix validation errors L-05"}
