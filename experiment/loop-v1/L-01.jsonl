{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_e270b4fc563347cfae58e7aa","type":"tool_result","content":"1\t\"\"\"MCP-сервер CRM поддержки: клиенты сервиса и их обращения из JSON-файла. Только чтение.\"\"\"\n2\timport json\n3\tfrom typing import Annotated, Any\n4\t\n5\tfrom mcp.server.mcpserver import MCPServer\n6\tfrom mcp.server.mcpserver.exceptions import ToolError\n7\tfrom pydantic import Field\n8\t\n9\tfrom app import config\n10\t\n11\tserver = MCPServer(\n12\t    name=\"crm\",\n13\t    version=\"1.0.0\",\n14\t    instructions=\"CRM поддержки сервиса «Риск отчисления студентов»: клиенты — сотрудники вузов — и их обращения \"\n15\t                 \"с техническими данными: запрос, ответ сервиса, лог. Инструменты только читают, ничего не меняют.\",\n16\t)\n17\t\n18\tCLOSED = {\"решён\"}\n19\t\n20\t\n21\tdef load():\n22\t    # файл читается на каждый вызов: правки CRM видны без перезапуска\n23\t    return json.loads(config.CRM_FILE.read_text(encoding=\"utf-8\"))\n24\t\n25\t\n26\tdef find(items, item_id, what):\n27\t    for item in items:\n28\t        if item[\"id\"] == item_id.strip().upper():\n29\t            return item\n30\t    raise ToolError(f\"{what} {item_id} нет в CRM\")\n31\t\n32\t\n33\t@server.tool()\n34\tdef list_tickets(\n35\t    include_closed: Annotated[bool, Field(description=\"Показать и решённые обращения\")] = False,\n36\t) -> dict[str, Any]:\n37\t    \"\"\"Очередь обращений, новые сверху: номер, тема, сообщение клиента, статус, приоритет, дата и клиент.\"\"\"\n38\t    crm = load()\n39\t    users = {u[\"id\"]: u for u in crm[\"users\"]}\n40\t    tickets = [{**{k: t[k] for k in (\"id\", \"subject\", \"message\", \"status\", \"priority\", \"created\")},\n41\t                \"user\": {k: users[t[\"user_id\"]][k] for k in (\"id\", \"name\", \"org\")}}\n42\t               for t in crm[\"tickets\"] if include_closed or t[\"status\"] not in CLOSED]\n43\t    tickets.sort(key=lambda t: t[\"created\"], reverse=True)\n44\t    return {\"count\": len(tickets), \"tickets\": tickets}\n45\t\n46\t\n47\t@server.tool()\n48\tdef get_ticket(ticket_id: Annotated[str, Field(description=\"Номер обращения, например T-1041\")]) -> dict[str, Any]:\n49\t    \"\"\"Обращение целиком: сообщение клиента, статус, приоритет и технические данные — запрос, ответ сервиса, лог.\"\"\"\n50\t    return find(load()[\"tickets\"], ticket_id, \"Обращения\")\n51\t\n52\t\n53\t@server.tool()\n54\tdef get_user(user_id: Annotated[str, Field(description=\"Номер клиента, например U-01\")]) -> dict[str, Any]:\n55\t    \"\"\"Клиент: вуз, роль, как работает с сервисом, заметки поддержки и все его обращения с решениями.\"\"\"\n56\t    crm = load()\n57\t    user = find(crm[\"users\"], user_id, \"Клиента\")\n58\t    tickets = [{k: t[k] for k in (\"id\", \"subject\", \"status\", \"created\", \"resolution\") if k in t}\n59\t               for t in crm[\"tickets\"] if t[\"user_id\"] == user[\"id\"]]\n60\t    return {**user, \"tickets\": tickets}\n61\t"}]},"parent_tool_use_id":null,"session_id":"ab5b12f4-809f-4593-8934-b60119f8c04f","uuid":"6e666c94-3db3-493a-8702-f6780329655c","timestamp":"2026-10-24T22:43:22.828Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\USER\\AppData\\Local\\Temp\\claude-rules\\loop-v1\\app\\crm_mcp.py","content":"\"\"\"MCP-сервер CRM поддержки: клиенты сервиса и их обращения из JSON-файла. Только чтение.\"\"\"\nimport json\nfrom typing import Annotated, Any\n\nfrom mcp.server.mcpserver import MCPServer\nfrom mcp.server.mcpserver.exceptions import ToolError\nfrom pydantic import Field\n\nfrom app import config\n\nserver = MCPServer(\n    name=\"crm\",\n    version=\"1.0.0\",\n    instructions=\"CRM поддержки сервиса «Риск отчисления студентов»: клиенты — сотрудники вузов — и их обращения \"\n                 \"с техническими данными: запрос, ответ сервиса, лог. Инструменты только читают, ничего не меняют.\",\n)\n\nCLOSED = {\"решён\"}\n\n\ndef load():\n    # файл читается на каждый вызов: правки CRM видны без перезапуска\n    return json.loads(config.CRM_FILE.read_text(encoding=\"utf-8\"))\n\n\ndef find(items, item_id, what):\n    for item in items:\n        if item[\"id\"] == item_id.strip().upper():\n            return item\n    raise ToolError(f\"{what} {item_id} нет в CRM\")\n\n\n@server.tool()\ndef list_tickets(\n    include_closed: Annotated[bool, Field(description=\"Показать и решённые обращения\")] = False,\n) -> dict[str, Any]:\n    \"\"\"Очередь обращений, новые сверху: номер, тема, сообщение клиента, статус, приоритет, дата и клиент.\"\"\"\n    crm = load()\n    users = {u[\"id\"]: u for u in crm[\"users\"]}\n    tickets = [{**{k: t[k] for k in (\"id\", \"subject\", \"message\", \"status\", \"priority\", \"created\")},\n                \"user\": {k: users[t[\"user_id\"]][k] for k in (\"id\", \"name\", \"org\")}}\n               for t in crm[\"tickets\"] if include_closed or t[\"status\"] not in CLOSED]\n    tickets.sort(key=lambda t: t[\"created\"], reverse=True)\n    return {\"count\": len(tickets), \"tickets\": tickets}\n\n\n@server.tool()\ndef get_ticket(ticket_id: Annotated[str, Field(description=\"Номер обращения, например T-1041\")]) -> dict[str, Any]:\n    \"\"\"Обращение целиком: сообщение клиента, статус, приоритет и технические данные — запрос, ответ сервиса, лог.\"\"\"\n    return find(load()[\"tickets\"], ticket_id, \"Обращения\")\n\n\n@server.tool()\ndef get_user(user_id: Annotated[str, Field(description=\"Номер клиента, например U-01\")]) -> dict[str, Any]:\n    \"\"\"Клиент: вуз, роль, как работает с сервисом, заметки поддержки и все его обращения с решениями.\"\"\"\n    crm = load()\n    user = find(crm[\"users\"], user_id, \"Клиента\")\n    tickets = [{k: t[k] for k in (\"id\", \"subject\", \"status\", \"created\", \"resolution\") if k in t}\n               for t in crm[\"tickets\"] if t[\"user_id\"] == user[\"id\"]]\n    return {**user, \"tickets\": tickets}\n","numLines":61,"startLine":1,"totalLines":61}},"tool_result_meta":[{"id":"toolu_e270b4fc563347cfae58e7aa","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
