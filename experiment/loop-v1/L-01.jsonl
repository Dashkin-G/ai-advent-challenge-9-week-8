{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_5061a60649c64dcd914405dc","type":"tool_result","content":"1\t\"\"\"MCP-сервер CRM поддержки: клиенты сервиса и их обращения из JSON-файла. Только чтение.\"\"\"\n2\timport json\n3\tfrom typing import Annotated, Any\n4\t\n5\tfrom mcp.server.mcpserver import MCPServer\n6\tfrom mcp.server.mcpserver.exceptions import ToolError\n7\tfrom pydantic import Field\n8\t\n9\tfrom app import config\n10\t\n11\tserver = MCPServer(\n12\t    name=\"crm\",\n13\t    version=\"1.0.0\",\n14\t    instructions=\"CRM поддержки сервиса «Риск отчисления студентов»: клиенты — сотрудники вузов — и их обращения \"\n15\t                 \"с техническими данными: запрос, ответ сервиса, лог. Инструменты только читают, ничего не меняют.\",\n16\t)\n17\t\n18\tCLOSED = {\"решён\"}\n19\t\n20\t\n21\tdef load():\n22\t    # файл читается на каждый вызов: правки CRM видны без перезапуска\n23\t    return json.loads(config.CRM_FILE.read_text(encoding=\"utf-8\"))\n24\t\n25\t\n26\tdef find(items, item_id, what):\n27\t    normalized = item_id.strip().upper()  # для поиска и ошибки\n28\t    for item in items:\n29\t        if item[\"id\"] == normalized:\n30\t            return item\n31\t    raise ToolError(f\"{what} {normalized} нет в CRM\")\n32\t\n33\t\n34\t@server.tool()\n35\tdef list_tickets(\n36\t    include_closed: Annotated[bool, Field(description=\"Показать и решённые обращения\")] = False,\n37\t) -> dict[str, Any]:\n38\t    \"\"\"Очередь обращений, новые сверху: номер, тема, сообщение клиента, статус, приоритет, дата и клиент.\"\"\"\n39\t    crm = load()\n40\t    users = {u[\"id\"]: u for u in crm[\"users\"]}\n41\t    tickets = [{**{k: t[k] for k in (\"id\", \"subject\", \"message\", \"status\", \"priority\", \"created\")},\n42\t                \"user\": {k: users[t[\"user_id\"]][k] for k in (\"id\", \"name\", \"org\")}}\n43\t               for t in crm[\"tickets\"] if include_closed or t[\"status\"] not in CLOSED]\n44\t    tickets.sort(key=lambda t: t[\"created\"], reverse=True)\n45\t    return {\"count\": len(tickets), \"tickets\": tickets}\n46\t\n47\t\n48\t@server.tool()\n49\tdef get_ticket(ticket_id: Annotated[str, Field(description=\"Номер обращения, например T-1041\")]) -> dict[str, Any]:\n50\t    \"\"\"Обращение целиком: сообщение клиента, статус, приоритет и технические данные — запрос, ответ сервиса, лог.\"\"\"\n51\t    return find(load()[\"tickets\"], ticket_id, \"Обращения\")\n52\t\n53\t\n54\t@server.tool()\n55\tdef get_user(user_id: Annotated[str, Field(description=\"Номер клиента, например U-01\")]) -> dict[str, Any]:\n56\t    \"\"\"Клиент: вуз, роль, как работает с сервисом, заметки поддержки и все его обращения с решениями.\"\"\"\n57\t    crm = load()\n58\t    user = find(crm[\"users\"], user_id, \"Клиента\")\n59\t    tickets = [{k: t[k] for k in (\"id\", \"subject\", \"status\", \"created\", \"resolution\") if k in t}\n60\t               for t in crm[\"tickets\"] if t[\"user_id\"] == user[\"id\"]]\n61\t    return {**user, \"tickets\": tickets}\n62\t"}]},"parent_tool_use_id":null,"session_id":"ab5b12f4-809f-4593-8934-b60119f8c04f","uuid":"444e8d83-b300-446c-b3f4-985debfe5206","timestamp":"2026-10-24T22:43:52.798Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\USER\\AppData\\Local\\Temp\\claude-rules\\loop-v1\\app\\crm_mcp.py","content":"\"\"\"MCP-сервер CRM поддержки: клиенты сервиса и их обращения из JSON-файла. Только чтение.\"\"\"\nimport json\nfrom typing import Annotated, Any\n\nfrom mcp.server.mcpserver import MCPServer\nfrom mcp.server.mcpserver.exceptions import ToolError\nfrom pydantic import Field\n\nfrom app import config\n\nserver = MCPServer(\n    name=\"crm\",\n    version=\"1.0.0\",\n    instructions=\"CRM поддержки сервиса «Риск отчисления студентов»: клиенты — сотрудники вузов — и их обращения \"\n                 \"с техническими данными: запрос, ответ сервиса, лог. Инструменты только читают, ничего не меняют.\",\n)\n\nCLOSED = {\"решён\"}\n\n\ndef load():\n    # файл читается на каждый вызов: правки CRM видны без перезапуска\n    return json.loads(config.CRM_FILE.read_text(encoding=\"utf-8\"))\n\n\ndef find(items, item_id, what):\n    normalized = item_id.strip().upper()  # для поиска и ошибки\n    for item in items:\n        if item[\"id\"] == normalized:\n            return item\n    raise ToolError(f\"{what} {normalized} нет в CRM\")\n\n\n@server.tool()\ndef list_tickets(\n    include_closed: Annotated[bool, Field(description=\"Показать и решённые обращения\")] = False,\n) -> dict[str, Any]:\n    \"\"\"Очередь обращений, новые сверху: номер, тема, сообщение клиента, статус, приоритет, дата и клиент.\"\"\"\n    crm = load()\n    users = {u[\"id\"]: u for u in crm[\"users\"]}\n    tickets = [{**{k: t[k] for k in (\"id\", \"subject\", \"message\", \"status\", \"priority\", \"created\")},\n                \"user\": {k: users[t[\"user_id\"]][k] for k in (\"id\", \"name\", \"org\")}}\n               for t in crm[\"tickets\"] if include_closed or t[\"status\"] not in CLOSED]\n    tickets.sort(key=lambda t: t[\"created\"], reverse=True)\n    return {\"count\": len(tickets), \"tickets\": tickets}\n\n\n@server.tool()\ndef get_ticket(ticket_id: Annotated[str, Field(description=\"Номер обращения, например T-1041\")]) -> dict[str, Any]:\n    \"\"\"Обращение целиком: сообщение клиента, статус, приоритет и технические данные — запрос, ответ сервиса, лог.\"\"\"\n    return find(load()[\"tickets\"], ticket_id, \"Обращения\")\n\n\n@server.tool()\ndef get_user(user_id: Annotated[str, Field(description=\"Номер клиента, например U-01\")]) -> dict[str, Any]:\n    \"\"\"Клиент: вуз, роль, как работает с сервисом, заметки поддержки и все его обращения с решениями.\"\"\"\n    crm = load()\n    user = find(crm[\"users\"], user_id, \"Клиента\")\n    tickets = [{k: t[k] for k in (\"id\", \"subject\", \"status\", \"created\", \"resolution\") if k in t}\n               for t in crm[\"tickets\"] if t[\"user_id\"] == user[\"id\"]]\n    return {**user, \"tickets\": tickets}\n","numLines":62,"startLine":1,"totalLines":62}},"tool_result_meta":[{"id":"toolu_5061a60649c64dcd914405dc","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
