{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_b109b4e101de48b28def66e8","type":"tool_result","content":"1\t\"\"\"MCP-сервер CRM поддержки: клиенты сервиса и их обращения из JSON-файла. Только чтение.\"\"\"\n2\timport json\n3\tfrom typing import Annotated, Any\n4\t\n5\tfrom mcp.server.mcpserver import MCPServer\n6\tfrom mcp.server.mcpserver.exceptions import ToolError\n7\tfrom pydantic import Field\n8\t\n9\tfrom app import config\n10\t\n11\tserver = MCPServer(\n12\t    name=\"crm\",\n13\t    version=\"1.0.0\",\n14\t    instructions=\"CRM поддержки сервиса «Риск отчисления студентов»: клиенты — сотрудники вузов — и их обращения \"\n15\t                 \"с техническими данными: запрос, ответ сервиса, лог. Инструменты только читают, ничего не меняют.\",\n16\t)\n17\t\n18\tCLOSED = {\"решён\"}\n19\t\n20\t\n21\tdef load():\n22\t    # файл читается на каждый вызов: правки CRM видны без перезапуска\n23\t    return json.loads(config.CRM_FILE.read_text(encoding=\"utf-8\"))\n24\t\n25\t\n26\tdef find(items, item_id, what):\n27\t    normalized = item_id.strip().upper()  # для поиска и ошибки\n28\t    for item in items:\n29\t        if item[\"id\"] == normalized:\n30\t            return item\n31\t    raise ToolError(f\"{what} {normalized} нет в CRM\")\n32\t\n33\t\n34\t@server.tool()\n35\tdef list_tickets(\n36\t    include_closed: Annotated[bool, Field(description=\"Показать и решённые обращения\")] = False,\n37\t) -> dict[str, Any]:\n38\t    \"\"\"Очередь обращений, новые сверху: номер, тема, сообщение клиента, статус, приоритет, дата и клиент.\"\"\"\n39\t    crm = load()\n40\t    users = {u[\"id\"]: u for u in crm[\"users\"]}\n41\t    tickets = [{**{k: t[k] for k in (\"id\", \"subject\", \"message\", \"status\", \"priority\", \"created\")},\n42\t                \"user\": {k: users[t[\"user_id\"]][k] for k in (\"id\", \"name\", \"org\")}}\n43\t               for t in crm[\"tickets\"] if include_closed or t[\"status\"] not in CLOSED]\n44\t    tickets.sort(key=lambda t: t[\"created\"], reverse=True)\n45\t    return {\"count\": len(tickets), \"tickets\": tickets}\n46\t\n47\t\n48\t@server.tool()\n49\tdef get_ticket(ticket_id: Annotated[str, Field(description=\"Номер обращения, например T-1041\")]) -> dict[str, Any]:\n50\t    \"\"\"Обращение целиком: сообщение клиента, статус, приоритет и технические данные — запрос, ответ сервиса, лог.\"\"\"\n51\t    return find(load()[\"tickets\"], ticket_id, \"Обращения\")\n52\t\n53\t\n54\t@server.tool()\n55\tdef get_user(user_id: Annotated[str, Field(description=\"Номер клиента, например U-01\")]) -> dict[str, Any]:\n56\t    \"\"\"Клиент: вуз, роль, как работает с сервисом, заметки поддержки и все его обращения с решениями.\"\"\"\n57\t    crm = load()\n58\t    user = find(crm[\"users\"], user_id, \"Клиента\")\n59\t    tickets = [{k: t[k] for k in (\"id\", \"subject\", \"status\", \"created\", \"resolution\") if k in t}\n60\t               for t in crm[\"tickets\"] if t[\"user_id\"] == user[\"id\"]]\n61\t    return {**user, \"tickets\": tickets}\n62\t"}]},"parent_tool_use_id":"toolu_c9dc51e631784c02b78923c3","agent_id":"ab3889a62f051a443","session_id":"ab5b12f4-809f-4593-8934-b60119f8c04f","uuid":"114b0680-5ad1-46bd-a384-b066b62f3a08","timestamp":"2026-10-24T22:43:33.932Z","tool_result_meta":[{"id":"toolu_b109b4e101de48b28def66e8","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"bug-fix","task_description":"Fix CRM error message formatting"}
