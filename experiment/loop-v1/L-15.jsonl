{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_f907b32f0a454e90af99da6f","type":"tool_result","content":"1\t\"\"\"Ревью pull request: изменения — через MCP-сервер git, контекст — RAG по коду и документации основной\n2\tветки, текст — локальная модель в роли двух ревьюеров: кода и архитектуры.\n3\tЗапуск: python -m app.review --base main --head feature/x.\"\"\"\n4\timport argparse\n5\timport ast\n6\timport asyncio\n7\timport fnmatch\n8\timport json\n9\timport logging\n10\timport os\n11\timport re\n12\timport sys\n13\timport time\n14\tfrom itertools import zip_longest\n15\tfrom pathlib import Path\n16\t\n17\tfrom mcp import Client\n18\t\n19\tfrom app import assistant, config, git_mcp, llm, rag\n20\t\n21\tMAX_DIFF = 600  # строк diff в промпт: больше локальная модель читает минутами\n22\tQUERY = 1200  # знаков добавленных строк файла в поисковый запрос\n23\tTOP_DOCS, TOP_CODE = 3, 4  # разделов документации и фрагментов кода в промпт\n24\tSECTION = 1800  # раздел документации длиннее — в промпт идёт только найденный фрагмент\n25\t# промпт ревью в 4 раза длиннее, чем у /help; seed — один и тот же PR получает одно и то же ревью\n26\tOPTIONS = {\"num_ctx\": 12288, \"num_predict\": 1200, \"seed\": 7}\n27\tHUNK = re.compile(r\"^@@ -\\d+(?:,\\d+)? \\+(\\d+)(?:,\\d+)? @@ ?(.*)\")\n28\t\n29\tCOMMON = \"\"\"Тебе дают список изменённых файлов, {context} из основной ветки и diff: число в начале строки — номер строки в новой версии файла, + — строка добавлена, - — удалена.\n30\tОдна проблема — одно замечание, даже если она видна в нескольких строках. file и line — путь и номер строки из diff; problem — что не так и к чему приведёт, одно-два предложения; fix — как исправить; source — заголовок фрагмента из квадратных скобок, если замечание на него опирается, иначе пустая строка.\n31\tНе выдумывай: нечего сказать — пустой список. Два точных замечания лучше пяти сомнительных.\n32\tПо-русски и коротко. Код — в `обратных кавычках`.\"\"\"\n33\t\n34\tCODE = \"\"\"Ты — опытный ревьюер кода проекта {project}. Ищешь в pull request ошибки.\n35\tПройди по каждой новой или изменённой функции в diff и проверь: что будет при пустом входе, нуле, None, слишком большом входе; где деление, индекс или ключ словаря могут упасть; какое исключение дойдёт до пользователя ошибкой 500; верна ли логика по сравнению с похожим кодом проекта. Прежде чем написать о баге, найди строку, где он случится, и убедись, что проверки там нет — ни в самой функции, ни раньше: в схеме входных данных или в коде, который её вызывает; в problem назови вход, при котором он случится.\n36\tПотом — каких тестов и проверок входных данных не хватает.\n37\tkind: bug — потенциальный баг (что-то упадёт или посчитается неверно), recommendation — рекомендация (тест, проверка, упрощение). summary — одно предложение: что добавляет или меняет pull request.\n38\tАрхитектуру и документацию не оценивай — это делает другой ревьюер.\n39\t\"\"\" + COMMON\n40\t\n41\tARCHITECTURE = \"\"\"Ты — архитектор проекта {project}. Проверяешь, согласуется ли pull request с устройством проекта и его документацией.\n42\tfindings — для каждого изменённого модуля сверь с документацией его импорты и обязанности: не появилась ли зависимость, которой у модуля быть не должно; в том ли модуле код; нет ли дублирования того, что в проекте уже есть.\n43\tdocs — отдельно о документации. По оглавлению найди разделы, которые описывают то, что меняет pull request: API, модули, поведение. Если pull request это меняет, а документация в нём не менялась, в files — файлы этих разделов, в why — какие разделы и что в них теперь не так, в source — заголовок фрагмента, где это видно, или пустая строка. Документация в порядке — files пустой. О документации пиши только в docs.\n44\tОшибки в коде не ищи — это делает другой ревьюер.\n45\t\"\"\" + COMMON\n46\t\n47\tFIELDS = {\"file\": {\"type\": \"string\"}, \"line\": {\"type\": \"integer\"}, \"problem\": {\"type\": \"string\"},\n48\t          \"fix\": {\"type\": \"string\"}, \"source\": {\"type\": \"string\"}}\n49\t\n50\t\n51\tdef findings(top, **extra):\n52\t    \"\"\"JSON Schema списка замечаний: Ollama не даст модели отойти от неё.\"\"\"\n53\t    item = {\"type\": \"object\", \"required\": [*extra, *FIELDS], \"properties\": {**extra, **FIELDS}}\n54\t    return {\"type\": \"array\", \"items\": item, \"maxItems\": top}\n55\t\n56\t\n57\tCODE_SCHEMA = {\"type\": \"object\", \"required\": [\"summary\", \"findings\"], \"properties\": {\n58\t    \"summary\": {\"type\": \"string\"},\n59\t    \"findings\": findings(5, kind={\"type\": \"string\", \"enum\": [\"bug\", \"recommendation\"]})}}\n60\tARCHITECTURE_SCHEMA = {\"type\": \"object\", \"required\": [\"findings\", \"docs\"], \"properties\": {\n61\t    \"findings\": findings(3),\n62\t    \"docs\": {\"type\": \"object\", \"required\": [\"files\", \"why\", \"source\"], \"properties\": {\n63\t        \"files\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}, \"maxItems\": 3},\n64\t        \"why\": {\"type\": \"string\"}, \"source\": {\"type\": \"string\"}}}}}\n65\t\n66\tindex = rag.Index(\"review-embeddings\")  # документация и код основной ветки\n67\t\n68\t\n69\tdef log(text):\n70\t    print(text, file=sys.stderr, flush=True)\n71\t\n72\t\n73\tdef short(ref):\n74\t    return ref[:7] if re.fullmatch(r\"[0-9a-f]{40}\", ref) else ref\n75\t\n76\t\n77\tdef number(x, digits=1):\n78\t    return f\"{x:,.{digits}f}\".replace(\",\", \" \").replace(\".\", \",\")\n79\t\n80\t\n81\tFILES, CHUNKS, TOKENS = (\"файл\", \"файла\", \"файлов\"), (\"фрагмент\", \"фрагмента\", \"фрагментов\"), (\"токен\", \"токена\", \"токенов\")\n82\t\n83\t\n84\tdef count(n, words):\n85\t    \"\"\"«1 файл», «3 файла», «12 файлов».\"\"\"\n86\t    one, few, many = words\n87\t    word = one if n % 10 == 1 and n % 100 != 11 else few if 2 <= n % 10 <= 4 and not 12 <= n % 100 <= 14 else many\n88\t    return f\"{number(n, 0)} {word}\"\n89\t\n90\t\n91\tdef matches(path, patterns):\n92\t    return any(fnmatch.fnmatch(path, p) for p in patterns)\n93\t\n94\t\n95\tasync def collect(base, head):\n96\t    \"\"\"① Изменения PR и файлы основной ветки для RAG — одна сессия с MCP-сервером git в этом же процессе.\"\"\"\n97\t    calls = []\n98\t    async with Client(git_mcp.server) as client:\n99\t        async def call(tool, **args):\n100\t            calls.append(tool)\n101\t            result = await client.call_tool(tool, args)\n102\t            if result.is_error:\n103\t                raise RuntimeError(\"\".join(getattr(part, \"text\", \"\") for part in result.content))\n104\t            return result.structured_content\n105\t\n106\t        pr = await call(\"pr_files\", base=base, head=head)\n107\t        diff = await call(\"pr_diff\", base=base, head=head)\n108\t        listed = await call(\"list_files\", ref=base)\n109\t        wanted = [f for f in listed[\"files\"] if matches(f, config.DOCS + config.CODE)]\n110\t        texts = {f: (await call(\"read_file\", path=f, ref=base))[\"text\"] for f in wanted}\n111\t        # новые версии изменённых файлов кода — ради их импортов: в diff начала файла часто нет\n112\t        heads = {f[\"path\"]: (await call(\"read_file\", path=f[\"path\"], ref=head))[\"text\"] for f in pr[\"files\"]\n113\t                 if f[\"status\"] != \"удалён\" and matches(f[\"path\"], config.CODE)}\n114\t    return pr, diff, texts, heads, calls\n115\t\n116\t\n117\tdef imports(text):\n118\t    \"\"\"Последняя строка начала модуля — описания и импортов; 0 — если файл начинается не с них.\"\"\"\n119\t    try:\n120\t        nodes = ast.parse(text).body\n121\t    except SyntaxError:\n122\t        return 0\n123\t    end = 0\n124\t    for node in nodes:\n125\t        is_doc = isinstance(node, ast.Expr) and isinstance(node.value, ast.Constant)\n126\t        if not (is_doc or isinstance(node, (ast.Import, ast.ImportFrom))):\n127\t            break\n128\t        end = node.end_lineno\n129\t    return end\n130\t\n131\t\n132\tdef parse(diff):\n133\t    \"\"\"Unified diff → {путь: {\"lines\": строки с номерами новой версии, \"added\": добавленные строки,\n134\t    \"numbers\": номера, которые видит модель}}. Содержимое удалённых файлов пропускается.\"\"\"\n135\t    files, current, header, new = {}, None, True, 0\n136\t    for line in diff.splitlines():\n137\t        if line.startswith(\"diff --git \"):\n138\t            current, header = None, True\n139\t        elif header and line.startswith(\"+++ \"):\n140\t            path = line[4:].rstrip(\"\\t\")\n141\t            current = None if path == \"/dev/null\" else files.setdefault(\n142\t                path[2:], {\"lines\": [], \"added\": [], \"numbers\": set()})\n143\t        elif line.startswith(\"@@\") and (hunk := HUNK.match(line)):\n144\t            header, new = False, int(hunk.group(1))\n145\t            if current is not None:\n146\t                current[\"lines\"].append(f\"@@ {hunk.group(2)}\".rstrip())\n147\t        elif header or current is None:\n148\t            continue\n149\t        elif line.startswith((\"+\", \" \")):\n150\t            mark, text = line[0], line[1:]\n151\t            current[\"lines\"].append(f\"{new:>4} {mark} {text}\")\n152\t            current[\"numbers\"].add(new)\n153\t            if mark == \"+\":\n154\t                current[\"added\"].append(text)\n155\t            new += 1\n156\t        elif line.startswith(\"-\"):\n157\t            current[\"lines\"].append(f\"     - {line[1:]}\")\n158\t    return files\n159\t\n160\t\n161\tdef with_imports(parsed, heads):\n162\t    \"\"\"У файла кода, чей diff не начинается с первой строки, в начало — его импорты: без них модель\n163\t    «не видит» импорт и пишет, что его нет.\"\"\"\n164\t    for path, text in heads.items():\n165\t        item = parsed.get(path)\n166\t        if item and item[\"lines\"] and 1 not in item[\"numbers\"] and (end := imports(text)):\n167\t            top = text.splitlines()[:end]\n168\t            item[\"lines\"][:0] = [\"@@ начало файла\"] + [f\"{n:>4}   {line}\" for n, line in enumerate(top, 1)]\n169\t            item[\"numbers\"].update(range(1, end + 1))\n170\t\n171\t\n172\tdef diff_text(files, parsed):\n173\t    \"\"\"Diff для промпта: файл за файлом, пока не кончится запас в MAX_DIFF строк.\"\"\"\n174\t    out, budget = [], MAX_DIFF\n175\t    for f in files:\n176\t        lines = parsed.get(f[\"path\"], {}).get(\"lines\", [])\n177\t        if f[\"status\"] == \"удалён\" or not lines:\n178\t            out.append(f\"### {f['path']} — {f['status'] if f['status'] == 'удалён' else 'без текстовых изменений'}\")\n179\t            continue\n180\t        shown = lines[:budget]\n181\t        out += [f\"### {f['path']}\", *shown]\n182\t        if len(shown) < len(lines):\n183\t            out.append(f\"… ещё {len(lines) - len(shown)} строк diff не поместились\")\n184\t        budget -= len(shown)\n185\t    return \"\\n\".join(out)\n186\t\n187\t\n188\tdef pick(vectors, kind, top):\n189\t    \"\"\"Лучший фрагмент по каждому запросу, потом второй… — без повторов. У документации заголовок\n190\t    фрагмента — раздел, и раздел, разрезанный на части, попадает в промпт целиком.\"\"\"\n191\t    ranked = [index.nearest(vector, top, keep=lambda chunk: chunk[\"kind\"] == kind) for vector in vectors]\n192\t    found = {}\n193\t    for hits in zip_longest(*ranked):\n194\t        for hit in filter(None, hits):\n195\t            if len(found) < top:\n196\t                found.setdefault(rag.source(hit), hit)\n197\t    if kind == \"docs\":\n198\t        for key, hit in found.items():\n199\t            whole = \"\\n\\n\".join(c[\"text\"] for c in index.chunks if c[\"kind\"] == \"docs\" and rag.source(c) == key)\n200\t            if len(whole) <= SECTION:\n201\t                found[key] = {**hit, \"text\": whole}\n202\t    return list(found.values())\n203\t\n204\t\n205\tdef contents():\n206\t    \"\"\"Оглавление документации: файл — его разделы по порядку. С ним ревьюер видит, где что описано,\n207\t    даже если поиск принёс не те разделы.\"\"\"\n208\t    titles = {}\n209\t    for chunk in index.chunks:\n210\t        if chunk[\"kind\"] == \"docs\":\n211\t            titles.setdefault(chunk[\"file\"], {}).setdefault(chunk[\"title\"])\n212\t    return \"\\n\".join(f\"{file}: {' · '.join(found)}\" for file, found in titles.items())\n213\t\n214\t\n215\tdef message(title, pr, hits, diff, what, task, docs=None):\n216\t    \"\"\"Промпт ревьюера; docs — изменённые в PR файлы документации: ревьюеру архитектуры — с оглавлением.\"\"\"\n217\t    listed = \"\\n\".join(f\"- {f['path']} ({f['status']}, +{f['added']} −{f['deleted']})\" for f in pr[\"files\"])\n218\t    note = \"\" if docs is None else (f\"\\nДокументация в pull request: {', '.join(docs) or 'не менялась'}\\n\\n\"\n219\t                                    f\"Оглавление документации проекта:\\n{contents()}\")\n220\t    fragments = \"\\n\\n\".join(f\"[{rag.source(h)}]\\n{h['text']}\" for h in hits) or \"(ничего не нашлось)\"\n221\t    text = (f\"Pull request: {title or '(без заголовка)'}\\n\"\n222\t            f\"Изменённые файлы ({len(pr['files'])}, +{pr['added']} −{pr['deleted']}):\\n{listed}{note}\\n\\n\"\n223\t            f\"{what} из основной ветки:\\n\\n{fragments}\\n\\nDiff:\\n\\n{diff}\\n\\nЗадание: {task}\")\n224\t    # модель цитирует код дословно, а двойная кавычка внутри ответа-JSON закрывает строку, и замечание\n225\t    # обрывается на полуслове; для Python одинарные кавычки — то же самое\n226\t    return text.replace('\"', \"'\")\n227\t\n228\t\n229\tasync def ask(system, user, schema):\n230\t    \"\"\"Один ревьюер: ответ модели строго по JSON Schema и счётчики.\"\"\"\n231\t    answer, counters = \"\", {}\n232\t    prompt = [{\"role\": \"system\", \"content\": system}, {\"role\": \"user\", \"content\": user}]\n233\t    async for event in llm.chat(prompt, options=OPTIONS, schema=schema):\n234\t        if event[\"type\"] == \"text\":\n235\t            answer += event[\"text\"]\n236\t        else:\n237\t            counters = event\n238\t    try:\n239\t        return json.loads(answer), counters\n240\t    except json.JSONDecodeError:\n241\t        raise llm.LLMError(f\"Модель вернула не JSON — ответ оборвался на {count(counters.get('tokens', 0), TOKENS)}?\")\n242\t\n243\t\n244\tdef repeats_docs(finding, stale):\n245\t    \"\"\"Замечание советует дописать документацию, которая уже отмечена устаревшей.\"\"\"\n246\t    return \"документац\" in finding[\"fix\"].lower() or any(s in finding[\"problem\"] + finding[\"fix\"] for s in stale)\n247\t\n248\t\n249\tasync def review(base, head, title=\"\"):\n250\t    \"\"\"① изменения через MCP → ② RAG → ③ ревьюер кода → ④ ревьюер архитектуры. Возвращает Markdown.\"\"\"\n251\t    started = time.perf_counter()\n252\t    pr, diff, texts, heads, calls = await collect(base, head)\n253\t    files = pr[\"files\"]\n254\t    if not files:\n255\t        return f\"### AI-ревью\\n\\nИзменений между `{short(base)}` и `{short(head)}` нет.\\n\"\n256\t    parsed = parse(diff[\"diff\"])\n257\t    tools = \", \".join(dict.fromkeys(f\"{t} ×{calls.count(t)}\" if calls.count(t) > 1 else t for t in calls))\n258\t    log(f\"① изменения — MCP git ({tools}): {count(len(files), FILES)}, +{pr['added']} −{pr['deleted']} · \"\n259\t        f\"{number(time.perf_counter() - started)} с\")\n260\t\n261\t    started = time.perf_counter()\n262\t    await index.build(texts)\n263\t    # на каждый изменённый файл три запроса: что о модуле сказано в документации; какая документация\n264\t    # ближе к новым строкам; какой код проекта ближе к ним (у фрагментов кода в векторе есть путь)\n265\t    changed = [(path, \"\\n\".join(item[\"added\"])[:QUERY]) for path, item in parsed.items() if item[\"added\"]]\n266\t    queries = [q for path, added in changed for q in (f\"Модуль {path}: за что отвечает и о чём знает\", added,\n267\t                                                      f\"{path}\\n{added}\")]\n268\t    vectors = await llm.embed(queries) if queries else []\n269\t    docs = pick([v for i, v in enumerate(vectors) if i % 3 < 2], \"docs\", TOP_DOCS)\n270\t    code = pick(vectors[2::3], \"code\", TOP_CODE)\n271\t    log(f\"② RAG по коду и документации {short(base)}: {count(len(index.chunks), CHUNKS)}, \"\n272\t        f\"новых векторов {index.built['embedded']} · {number(time.perf_counter() - started)} с\")\n273\t    for hit in code + docs:\n274\t        log(f\"   {rag.source(hit)} · {number(hit['score'], 2)}\")\n275\t\n276\t    with_imports(parsed, heads)\n277\t    diff = diff_text(files, parsed)\n278\t    project = config.PROJECT_DIR.name\n279\t    # ревьюеру кода diff документации не нужен — только удлиняет промпт\n280\t    code_diff = diff_text([f for f in files if not matches(f[\"path\"], config.DOCS)], parsed)\n281\t    found, counters = await ask(\n282\t        CODE.format(project=project, context=\"фрагменты кода проекта\"),\n283\t        message(title, pr, code, code_diff, \"Фрагменты кода проекта\", \"найди потенциальные баги и дай рекомендации.\"),\n284\t        CODE_SCHEMA)\n285\t    log(f\"③ ревьюер кода — {config.MODEL}: {spent(counters)}\")\n286\t    flagged, counters2 = await ask(\n287\t        ARCHITECTURE.format(project=project, context=\"разделы документации проекта\"),\n288\t        message(title, pr, docs, diff, \"Разделы документации проекта\",\n289\t                \"найди архитектурные проблемы и проверь, не устарела ли документация.\",\n290\t                [f[\"path\"] for f in files if matches(f[\"path\"], config.DOCS)]),\n291\t        ARCHITECTURE_SCHEMA)\n292\t    log(f\"④ ревьюер архитектуры — {config.MODEL}: {spent(counters2)}\")\n293\t\n294\t    # устаревшая документация — файлы, которые есть в основной ветке и не менялись в PR;\n295\t    # если она нашлась, замечание с советом дописать документацию — повтор\n296\t    stale = [f for f in dict.fromkeys(flagged[\"docs\"][\"files\"]) if f in texts and f not in parsed]\n297\t    architecture = [f for f in flagged[\"findings\"] if not (stale and repeats_docs(f, stale))]\n298\t    if stale:\n299\t        architecture.append({\"file\": stale[0], \"line\": 0,\n300\t                             \"problem\": flagged[\"docs\"][\"why\"] or \"Документация не обновлена под изменения.\",\n301\t                             \"fix\": \"обновить \" + \", \".join(f\"`{f}`\" for f in stale) + \".\",\n302\t                             \"source\": flagged[\"docs\"][\"source\"]})\n303\t    sections = {\"Потенциальные баги\": [f for f in found[\"findings\"] if f[\"kind\"] == \"bug\"],\n304\t                \"Архитектурные проблемы\": architecture,\n305\t                \"Рекомендации\": [f for f in found[\"findings\"] if f[\"kind\"] == \"recommendation\"]}\n306\t    return render(found[\"summary\"], sections, pr, parsed, texts, code + docs, tools, [counters, counters2], base)\n307\t\n308\t\n309\tdef where(item, pr, parsed, texts):\n310\t    \"\"\"Ссылка на место замечания. Номер строки — только если модель видела его в diff;\n311\t    на GitHub — ссылка на файл в коммите PR.\"\"\"\n312\t    path, line = item[\"file\"].strip(\"` \").split(\":\")[0], item[\"line\"]\n313\t    if path not in parsed and path not in texts:\n314\t        return None\n315\t    line = line if line in parsed.get(path, {}).get(\"numbers\", ()) else None\n316\t    label = f\"{path}:{line}\" if line else path\n317\t    repo = os.getenv(\"GITHUB_REPOSITORY\")\n318\t    if not repo:\n319\t        return f\"`{label}`\"\n320\t    url = f\"{os.getenv('GITHUB_SERVER_URL', 'https://github.com')}/{repo}/blob/{pr['head_sha']}/{path}\"\n321\t    return f\"[`{label}`]({url}{f'#L{line}' if line else ''})\"\n322\t\n323\t\n324\tdef spent(counters):\n325\t    return (f\"промпт {count(counters['prompt'], TOKENS)} — {number(counters['reading'])} с, \"\n326\t            f\"ответ {count(counters['tokens'], TOKENS)} — {number(counters['writing'])} с\")\n327\t\n328\t\n329\tdef render(summary, sections, pr, parsed, texts, hits, tools, counters, base):\n330\t    out = [f\"### AI-ревью · {config.MODEL}\", \"\", f\"**Что делает PR.** {summary}\"]\n331\t    sources = [rag.source(h) for h in hits]\n332\t    for title, items in sections.items():\n333\t        out += [\"\", f\"#### {title}\", \"\"]\n334\t        if not items:\n335\t            out.append(\"Не найдено.\")\n336\t        for n, item in enumerate(items, 1):\n337\t            place = where(item, pr, parsed, texts)\n338\t            # основание — только «файл › раздел» из фрагментов, которые модель правда видела в промпте\n339\t            source = item[\"source\"].strip(\"[]` \")\n340\t            seen = \"›\" in source and any(s.startswith(source) or source.startswith(s) for s in sources)\n341\t            out.append(f\"{n}. {place + ' — ' if place else ''}{item['problem']}  \")\n342\t            out.append(f\"   **Исправить:** {item['fix']}\" + (f\"  \\n   *Основание: {source}*\" if seen else \"\"))\n343\t    fragments = \" · \".join(f\"`{rag.source(h)}` {number(h['score'], 2)}\" for h in hits)\n344\t    model = \"; \".join(f\"{who} — {spent(c)}\" for who, c in zip((\"ревьюер кода\", \"ревьюер архитектуры\"), counters))\n345\t    out += [\"\", \"<details><summary>Как получено ревью</summary>\", \"\",\n346\t            f\"- **Изменения** — MCP-сервер git ({tools}): {count(len(pr['files']), FILES)}, \"\n347\t            f\"+{pr['added']} −{pr['deleted']}.\",\n348\t            f\"- **Контекст** — RAG по коду и документации `{short(base)}`: {count(len(index.chunks), CHUNKS)}, \"\n349\t            f\"в промпт — {len(hits)}: {fragments}.\",\n350\t            f\"- **Модель** — {config.MODEL} в Ollama: {model}.\",\n351\t            \"\", \"</details>\"]\n352\t    return \"\\n\".join(out) + \"\\n\"\n353\t\n354\t\n355\tdef main():\n356\t    parser = argparse.ArgumentParser(description=\"Ревью pull request локальной моделью\")\n357\t    parser.add_argument(\"--repo\", default=str(config.PROJECT_DIR), help=\"папка git-репозитория проекта\")\n358\t    parser.add_argument(\"--base\", default=\"main\", help=\"ветка или коммит, куда вливается PR\")\n359\t    parser.add_argument(\"--head\", default=\"HEAD\", help=\"ветка или коммит с изменениями\")\n360\t    parser.add_argument(\"--title\", default=\"\", help=\"заголовок PR\")\n361\t    parser.add_argument(\"--out\", help=\"файл для ревью в Markdown; без него — на экран\")\n362\t    args = parser.parse_args()\n363\t    config.PROJECT_DIR = Path(args.repo).resolve()\n364\t    logging.getLogger(\"httpx2\").setLevel(logging.WARNING)  # MCP SDK включает INFO — без строк о каждом запросе\n365\t    try:\n366\t        text = asyncio.run(review(args.base, args.head, args.title))\n367\t    except Exception as exc:  # причина словами — её видно в логе задания\n368\t        log(f\"Ревью не получилось: {assistant.reason(exc)}\")\n369\t        sys.exit(1)\n370\t    if args.out:\n371\t        Path(args.out).write_text(text, encoding=\"utf-8\")\n372\t    else:\n373\t        sys.stdout.write(text)\n374\t\n375\t\n376\tif __name__ == \"__main__\":\n377\t    main()\n378\t"}]},"parent_tool_use_id":"toolu_24d7322b62c04bcbb5a98437","agent_id":"ae3daf2b90e517538","session_id":"a0cbb2ff-87e0-4f3c-9448-a9a7b9327929","uuid":"86beb01e-9b7f-41c4-ba22-d9733bbd436a","timestamp":"2026-10-24T23:13:36.916Z","tool_result_meta":[{"id":"toolu_f907b32f0a454e90af99da6f","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"general-purpose","task_description":"Research file write functions"}
