{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_2243d39f2b9d4d9481b3e596","type":"tool_result","content":"1\t\"\"\"Ассистент разработчика и поддержки: страница /help, место оператора поддержки /support, работа с файлами\n2\tпроекта /files, MCP-серверы git на /mcp/git, CRM на /mcp/crm и файлов на /mcp/files.\"\"\"\n3\timport asyncio\n4\timport logging\n5\tfrom contextlib import asynccontextmanager\n6\t\n7\timport uvicorn\n8\tfrom fastapi import FastAPI, HTTPException, Request\n9\tfrom fastapi.exceptions import RequestValidationError\n10\tfrom fastapi.responses import FileResponse, JSONResponse, StreamingResponse\n11\tfrom pydantic import BaseModel\n12\t\n13\tfrom app import assistant, config, crm_mcp, files, files_mcp, git_mcp, llm, rag, support\n14\t\n15\tlogging.basicConfig(level=logging.INFO)\n16\tlogger = logging.getLogger(__name__)\n17\t\n18\tPAGE = config.ROOT / \"static\" / \"index.html\"\n19\tSUPPORT_PAGE = config.ROOT / \"static\" / \"support.html\"\n20\tFILES_PAGE = config.ROOT / \"static\" / \"files.html\"\n21\t\n22\t\n23\tasync def warm_up():\n24\t    \"\"\"Векторы документации и базы знаний, модель — при старте, чтобы первый вопрос не ждал.\"\"\"\n25\t    try:\n26\t        logger.info(\"Индекс документации: %s\", await rag.ensure_index())\n27\t        logger.info(\"База знаний поддержки: %s\", await support.ensure_index())\n28\t        await llm.load()\n29\t        logger.info(\"Модель %s загружена в память\", config.MODEL)\n30\t    except Exception as exc:\n31\t        logger.warning(\"Подготовка не завершена: %s\", exc)\n32\t\n33\t\n34\t@asynccontextmanager\n35\tasync def lifespan(app):\n36\t    # у смонтированных приложений MCP свой lifespan не запускается — менеджеры сессий поднимаем здесь\n37\t    async with git_mcp.server.session_manager.run(), crm_mcp.server.session_manager.run(), \\\n38\t            files_mcp.server.session_manager.run():\n39\t        task = asyncio.create_task(warm_up())\n40\t        yield\n41\t        task.cancel()\n42\t\n43\t\n44\tapp = FastAPI(title=\"Ассистент разработчика и поддержки\", lifespan=lifespan)\n45\tapp.mount(\"/mcp/git\", git_mcp.server.streamable_http_app(streamable_http_path=\"/\"))\n46\tapp.mount(\"/mcp/crm\", crm_mcp.server.streamable_http_app(streamable_http_path=\"/\"))\n47\tapp.mount(\"/mcp/files\", files_mcp.server.streamable_http_app(streamable_http_path=\"/\"))\n48\t\n49\t\n50\tclass Command(BaseModel):\n51\t    text: str\n52\t\n53\t\n54\tclass Question(BaseModel):\n55\t    question: str\n56\t    ticket_id: str | None = None\n57\t\n58\t\n59\tclass Task(BaseModel):\n60\t    goal: str\n61\t\n62\t\n63\t@app.get(\"/\", include_in_schema=False)\n64\tasync def page():\n65\t    \"\"\"Страница помощника разработчика.\"\"\"\n66\t    return FileResponse(PAGE)\n67\t\n68\t\n69\t@app.get(\"/support\", include_in_schema=False)\n70\tasync def support_page():\n71\t    \"\"\"Страница поддержки оператора.\"\"\"\n72\t    return FileResponse(SUPPORT_PAGE)\n73\t\n74\t\n75\t@app.get(\"/files\", include_in_schema=False)\n76\tasync def files_page():\n77\t    \"\"\"Страница работы с файлами проекта.\"\"\"\n78\t    return FileResponse(FILES_PAGE)\n79\t\n80\t\n81\t@app.get(\"/api/status\")\n82\tasync def status():\n83\t    \"\"\"Статус Ollama, документации и проекта.\"\"\"\n84\t    ollama, project = await asyncio.gather(llm.status(), assistant.project())\n85\t    return {\"project\": {**project, \"path\": str(config.PROJECT_DIR)}, \"ollama\": ollama,\n86\t            \"model\": config.MODEL, \"embed_model\": config.EMBED_MODEL, \"docs\": rag.info()}\n87\t\n88\t\n89\t@app.post(\"/api/help\")\n90\tasync def help_command(command: Command):\n91\t    \"\"\"Ответ ассистента на вопрос о проекте.\"\"\"\n92\t    question = assistant.parse(command.text)\n93\t    if question is None:\n94\t        raise HTTPException(status_code=400, detail=\"Команда ассистента: /help <вопрос о проекте>\")\n95\t\n96\t    async def stream():\n97\t        async for event in assistant.answer(question):\n98\t            yield assistant.dumps(event)\n99\t\n100\t    return StreamingResponse(stream(), media_type=\"application/x-ndjson\")\n101\t\n102\t\n103\t@app.get(\"/api/support/status\")\n104\tasync def support_status():\n105\t    \"\"\"Статус Ollama, базы знаний и очереди поддержки.\"\"\"\n106\t    ollama, crm = await asyncio.gather(llm.status(), support.queue())\n107\t    return {\"ollama\": ollama, \"model\": config.MODEL, \"embed_model\": config.EMBED_MODEL,\n108\t            \"kb\": support.index.info(), \"crm\": crm}\n109\t\n110\t\n111\t@app.post(\"/api/support/answer\")\n112\tasync def support_answer(body: Question):\n113\t    \"\"\"Ответ поддержки клиенту по обращению.\"\"\"\n114\t    question = body.question.strip()\n115\t    if not question:\n116\t        raise HTTPException(status_code=400, detail=\"Напишите вопрос клиента\")\n117\t\n118\t    async def stream():\n119\t        async for event in support.answer(body.ticket_id, question):\n120\t            yield assistant.dumps(event)\n121\t\n122\t    return StreamingResponse(stream(), media_type=\"application/x-ndjson\")\n123\t\n124\t\n125\t@app.post(\"/api/files/run\")\n126\tasync def files_run(task: Task):\n127\t    \"\"\"Выполнить задачу по работе с файлами проекта.\"\"\"\n128\t    goal = task.goal.strip()\n129\t    if not goal:\n130\t        raise HTTPException(status_code=400, detail=\"Напишите задачу: что найти, обновить или создать\")\n131\t\n132\t    async def stream():\n133\t        async for event in files.run(goal):\n134\t            yield assistant.dumps(event)\n135\t\n136\t    return StreamingResponse(stream(), media_type=\"application/x-ndjson\")\n137\t\n138\t\n139\t@app.post(\"/api/files/apply\")\n140\tasync def files_apply():\n141\t    \"\"\"Применить черновик изменений файлов проекта.\"\"\"\n142\t    return await files.apply()\n143\t\n144\t\n145\t@app.post(\"/api/files/discard\")\n146\tasync def files_discard():\n147\t    \"\"\"Отменить черновик изменений файлов проекта.\"\"\"\n148\t    return await files.discard()\n149\t\n150\t\n151\t@app.get(\"/api/search\")\n152\tasync def search_api(q: str, top: int = config.TOP):\n153\t    \"\"\"Поиск по документации без модели ответа.\"\"\"\n154\t    query = q.strip()\n155\t    if not query:\n156\t        raise HTTPException(status_code=400, detail=\"Напишите запрос для поиска\")\n157\t    if top < 1 or top > 10:\n158\t        raise HTTPException(status_code=400, detail=\"top должен быть от 1 до 10\")\n159\t\n160\t    try:\n161\t        result = await rag.search_docs(query, top)\n162\t        return result\n163\t    except llm.LLMError as exc:\n164\t        raise HTTPException(status_code=503, detail=str(exc))\n165\t\n166\t\n167\t@app.exception_handler(RequestValidationError)\n168\tasync def validation_error_handler(request: Request, exc: RequestValidationError):\n169\t    \"\"\"Перевод ошибок валидации FastAPI в 400 с русским текстом.\"\"\"\n170\t    errors = exc.errors()\n171\t    # Извлекаем имя поля из пути (location)\n172\t    field_name = None\n173\t    for err in errors:\n174\t        loc = err.get(\"loc\", [])\n175\t        if len(loc) > 1:\n176\t            field_name = loc[1]  # 'body' -> 'text' или 'question' или 'goal'\n177\t            break\n178\t    if not field_name:\n179\t        return JSONResponse(\n180\t            status_code=400,\n181\t            content={\"detail\": \"Неверный формат запроса\"}\n182\t        )\n183\t    # Русские описания полей\n184\t    field_desc = {\n185\t        \"text\": \"Команда ассистента: /help <вопрос о проекте>\",\n186\t        \"question\": \"Напишите вопрос клиента\",\n187\t        \"goal\": \"Напишите задачу: что найти, обновить или создать\"\n188\t    }\n189\t    return JSONResponse(\n190\t        status_code=400,\n191\t        content={\"detail\": field_desc.get(field_name, f\"Поле '{field_name}' неверно\")}\n192\t    )\n193\t\n194\t\n195\tif __name__ == \"__main__\":\n196\t    uvicorn.run(app, host=config.HOST, port=config.PORT)\n197\t"}]},"parent_tool_use_id":null,"session_id":"0c06fc14-9b38-4c21-afdc-d00dd052f4ed","uuid":"be32bf76-a8e2-4b2c-88ca-d47f3ae4d06d","timestamp":"2026-10-24T23:08:20.435Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\USER\\AppData\\Local\\Temp\\claude-rules\\loop-v1\\app\\main.py","content":"\"\"\"Ассистент разработчика и поддержки: страница /help, место оператора поддержки /support, работа с файлами\nпроекта /files, MCP-серверы git на /mcp/git, CRM на /mcp/crm и файлов на /mcp/files.\"\"\"\nimport asyncio\nimport logging\nfrom contextlib import asynccontextmanager\n\nimport uvicorn\nfrom fastapi import FastAPI, HTTPException, Request\nfrom fastapi.exceptions import RequestValidationError\nfrom fastapi.responses import FileResponse, JSONResponse, StreamingResponse\nfrom pydantic import BaseModel\n\nfrom app import assistant, config, crm_mcp, files, files_mcp, git_mcp, llm, rag, support\n\nlogging.basicConfig(level=logging.INFO)\nlogger = logging.getLogger(__name__)\n\nPAGE = config.ROOT / \"static\" / \"index.html\"\nSUPPORT_PAGE = config.ROOT / \"static\" / \"support.html\"\nFILES_PAGE = config.ROOT / \"static\" / \"files.html\"\n\n\nasync def warm_up():\n    \"\"\"Векторы документации и базы знаний, модель — при старте, чтобы первый вопрос не ждал.\"\"\"\n    try:\n        logger.info(\"Индекс документации: %s\", await rag.ensure_index())\n        logger.info(\"База знаний поддержки: %s\", await support.ensure_index())\n        await llm.load()\n        logger.info(\"Модель %s загружена в память\", config.MODEL)\n    except Exception as exc:\n        logger.warning(\"Подготовка не завершена: %s\", exc)\n\n\n@asynccontextmanager\nasync def lifespan(app):\n    # у смонтированных приложений MCP свой lifespan не запускается — менеджеры сессий поднимаем здесь\n    async with git_mcp.server.session_manager.run(), crm_mcp.server.session_manager.run(), \\\n            files_mcp.server.session_manager.run():\n        task = asyncio.create_task(warm_up())\n        yield\n        task.cancel()\n\n\napp = FastAPI(title=\"Ассистент разработчика и поддержки\", lifespan=lifespan)\napp.mount(\"/mcp/git\", git_mcp.server.streamable_http_app(streamable_http_path=\"/\"))\napp.mount(\"/mcp/crm\", crm_mcp.server.streamable_http_app(streamable_http_path=\"/\"))\napp.mount(\"/mcp/files\", files_mcp.server.streamable_http_app(streamable_http_path=\"/\"))\n\n\nclass Command(BaseModel):\n    text: str\n\n\nclass Question(BaseModel):\n    question: str\n    ticket_id: str | None = None\n\n\nclass Task(BaseModel):\n    goal: str\n\n\n@app.get(\"/\", include_in_schema=False)\nasync def page():\n    \"\"\"Страница помощника разработчика.\"\"\"\n    return FileResponse(PAGE)\n\n\n@app.get(\"/support\", include_in_schema=False)\nasync def support_page():\n    \"\"\"Страница поддержки оператора.\"\"\"\n    return FileResponse(SUPPORT_PAGE)\n\n\n@app.get(\"/files\", include_in_schema=False)\nasync def files_page():\n    \"\"\"Страница работы с файлами проекта.\"\"\"\n    return FileResponse(FILES_PAGE)\n\n\n@app.get(\"/api/status\")\nasync def status():\n    \"\"\"Статус Ollama, документации и проекта.\"\"\"\n    ollama, project = await asyncio.gather(llm.status(), assistant.project())\n    return {\"project\": {**project, \"path\": str(config.PROJECT_DIR)}, \"ollama\": ollama,\n            \"model\": config.MODEL, \"embed_model\": config.EMBED_MODEL, \"docs\": rag.info()}\n\n\n@app.post(\"/api/help\")\nasync def help_command(command: Command):\n    \"\"\"Ответ ассистента на вопрос о проекте.\"\"\"\n    question = assistant.parse(command.text)\n    if question is None:\n        raise HTTPException(status_code=400, detail=\"Команда ассистента: /help <вопрос о проекте>\")\n\n    async def stream():\n        async for event in assistant.answer(question):\n            yield assistant.dumps(event)\n\n    return StreamingResponse(stream(), media_type=\"application/x-ndjson\")\n\n\n@app.get(\"/api/support/status\")\nasync def support_status():\n    \"\"\"Статус Ollama, базы знаний и очереди поддержки.\"\"\"\n    ollama, crm = await asyncio.gather(llm.status(), support.queue())\n    return {\"ollama\": ollama, \"model\": config.MODEL, \"embed_model\": config.EMBED_MODEL,\n            \"kb\": support.index.info(), \"crm\": crm}\n\n\n@app.post(\"/api/support/answer\")\nasync def support_answer(body: Question):\n    \"\"\"Ответ поддержки клиенту по обращению.\"\"\"\n    question = body.question.strip()\n    if not question:\n        raise HTTPException(status_code=400, detail=\"Напишите вопрос клиента\")\n\n    async def stream():\n        async for event in support.answer(body.ticket_id, question):\n            yield assistant.dumps(event)\n\n    return StreamingResponse(stream(), media_type=\"application/x-ndjson\")\n\n\n@app.post(\"/api/files/run\")\nasync def files_run(task: Task):\n    \"\"\"Выполнить задачу по работе с файлами проекта.\"\"\"\n    goal = task.goal.strip()\n    if not goal:\n        raise HTTPException(status_code=400, detail=\"Напишите задачу: что найти, обновить или создать\")\n\n    async def stream():\n        async for event in files.run(goal):\n            yield assistant.dumps(event)\n\n    return StreamingResponse(stream(), media_type=\"application/x-ndjson\")\n\n\n@app.post(\"/api/files/apply\")\nasync def files_apply():\n    \"\"\"Применить черновик изменений файлов проекта.\"\"\"\n    return await files.apply()\n\n\n@app.post(\"/api/files/discard\")\nasync def files_discard():\n    \"\"\"Отменить черновик изменений файлов проекта.\"\"\"\n    return await files.discard()\n\n\n@app.get(\"/api/search\")\nasync def search_api(q: str, top: int = config.TOP):\n    \"\"\"Поиск по документации без модели ответа.\"\"\"\n    query = q.strip()\n    if not query:\n        raise HTTPException(status_code=400, detail=\"Напишите запрос для поиска\")\n    if top < 1 or top > 10:\n        raise HTTPException(status_code=400, detail=\"top должен быть от 1 до 10\")\n\n    try:\n        result = await rag.search_docs(query, top)\n        return result\n    except llm.LLMError as exc:\n        raise HTTPException(status_code=503, detail=str(exc))\n\n\n@app.exception_handler(RequestValidationError)\nasync def validation_error_handler(request: Request, exc: RequestValidationError):\n    \"\"\"Перевод ошибок валидации FastAPI в 400 с русским текстом.\"\"\"\n    errors = exc.errors()\n    # Извлекаем имя поля из пути (location)\n    field_name = None\n    for err in errors:\n        loc = err.get(\"loc\", [])\n        if len(loc) > 1:\n            field_name = loc[1]  # 'body' -> 'text' или 'question' или 'goal'\n            break\n    if not field_name:\n        return JSONResponse(\n            status_code=400,\n            content={\"detail\": \"Неверный формат запроса\"}\n        )\n    # Русские описания полей\n    field_desc = {\n        \"text\": \"Команда ассистента: /help <вопрос о проекте>\",\n        \"question\": \"Напишите вопрос клиента\",\n        \"goal\": \"Напишите задачу: что найти, обновить или создать\"\n    }\n    return JSONResponse(\n        status_code=400,\n        content={\"detail\": field_desc.get(field_name, f\"Поле '{field_name}' неверно\")}\n    )\n\n\nif __name__ == \"__main__\":\n    uvicorn.run(app, host=config.HOST, port=config.PORT)\n","numLines":197,"startLine":1,"totalLines":197}},"tool_result_meta":[{"id":"toolu_2243d39f2b9d4d9481b3e596","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
