{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_29e23271f9174de0ac5a708b","type":"tool_result","content":"1\t\"\"\"MCP-сервер CRM поддержки: клиенты сервиса и их обращения из JSON-файла. Только чтение.\"\"\"\n2\timport json\n3\tfrom typing import Annotated, Any\n4\t\n5\tfrom mcp.server.mcpserver import MCPServer\n6\tfrom mcp.server.mcpserver.exceptions import ToolError\n7\tfrom pydantic import Field\n8\t\n9\tfrom app import config\n10\t\n11\tserver = MCPServer(\n12\t    name=\"crm\",\n13\t    version=\"1.0.0\",\n14\t    instructions=\"CRM поддержки сервиса «Риск отчисления студентов»: клиенты — сотрудники вузов — и их обращения \"\n15\t                 \"с техническими данными: запрос, ответ сервиса, лог. Инструменты только читают, ничего не меняют.\",\n16\t)\n17\t\n18\tCLOSED = {\"решён\"}\n19\t\n20\t\n21\tdef load():\n22\t    # файл читается на каждый вызов: правки CRM видны без перезапуска\n23\t    return json.loads(config.CRM_FILE.read_text(encoding=\"utf-8\"))\n24\t\n25\t\n26\tdef find(items, item_id, what):\n27\t    normalized = item_id.strip().upper()  # для поиска и ошибки\n28\t    for item in items:\n29\t        if item[\"id\"] == normalized:\n30\t            return item\n31\t    raise ToolError(f\"{what} {normalized} нет в CRM\")\n32\t\n33\t\n34\t@server.tool()\n35\tdef list_tickets(\n36\t    include_closed: Annotated[bool, Field(description=\"Показать и решённые обращения\")] = False,\n37\t) -> dict[str, Any]:\n38\t    \"\"\"Очередь обращений, новые сверху: номер, тема, сообщение клиента, статус, приоритет, дата и клиент.\"\"\"\n39\t    crm = load()\n40\t    users = {u[\"id\"]: u for u in crm[\"users\"]}\n41\t    tickets = [{**{k: t[k] for k in (\"id\", \"subject\", \"message\", \"status\", \"priority\", \"created\")},\n42\t                \"user\": {k: users[t[\"user_id\"]][k] for k in (\"id\", \"name\", \"org\")}}\n43\t               for t in crm[\"tickets\"] if include_closed or t[\"status\"] not in CLOSED]\n44\t    tickets.sort(key=lambda t: t[\"created\"], reverse=True)\n45\t    return {\"count\": len(tickets), \"tickets\": tickets}\n46\t\n47\t\n48\t@server.tool()\n49\tdef get_ticket(ticket_id: Annotated[str, Field(description=\"Номер обращения, например T-1041\")]) -> dict[str, Any]:\n50\t    \"\"\"Обращение целиком: сообщение клиента, статус, приоритет и технические данные — запрос, ответ сервиса, лог.\"\"\"\n51\t    return find(load()[\"tickets\"], ticket_id, \"Обращения\")\n52\t\n53\t\n54\t@server.tool()\n55\tdef get_user(user_id: Annotated[str, Field(description=\"Номер клиента, например U-01\")]) -> dict[str, Any]:\n56\t    \"\"\"Клиент: вуз, роль, как работает с сервисом, заметки поддержки и все его обращения с решениями.\"\"\"\n57\t    crm = load()\n58\t    user = find(crm[\"users\"], user_id, \"Клиента\")\n59\t    tickets = [{k: t[k] for k in (\"id\", \"subject\", \"status\", \"created\", \"resolution\") if k in t}\n60\t               for t in crm[\"tickets\"] if t[\"user_id\"] == user[\"id\"]]\n61\t    return {**user, \"tickets\": tickets}\n62\t\n63\t\n64\t@server.tool()\n65\tdef find_tickets(\n66\t    query: Annotated[str, Field(description=\"Запрос для поиска: номер, тема, сообщение или имя клиента\")] = \"\",\n67\t) -> dict[str, Any]:\n68\t    \"\"\"Обращения по запросу: поиск без учёта регистра по номеру, теме, сообщению, имени клиента и вузу.\"\"\"\n69\t    normalized = query.strip()\n70\t    if not normalized:\n71\t        raise ToolError(\"Введите запрос для поиска\")\n72\t\n73\t    crm = load()\n74\t    users = {u[\"id\"]: u for u in crm[\"users\"]}\n75\t    q = normalized.lower()\n76\t\n77\t    found = []\n78\t    for t in crm[\"tickets\"]:\n79\t        user = users[t[\"user_id\"]]\n80\t        text = (\n81\t            f\"{t['id']} {t['subject']} {t['message']} {user['name']} {user['org']}\".lower()\n82\t        )\n83\t        if q in text:\n84\t            found.append({\n85\t                **{k: t[k] for k in (\"id\", \"subject\", \"message\", \"status\", \"priority\", \"created\")},\n86\t                \"user\": {k: user[k] for k in (\"id\", \"name\", \"org\")},\n87\t            })\n88\t\n89\t    found.sort(key=lambda t: t[\"created\"], reverse=True)\n90\t    return {\"count\": len(found), \"tickets\": found}\n91\t"}]},"parent_tool_use_id":null,"session_id":"0c06fc14-9b38-4c21-afdc-d00dd052f4ed","uuid":"8982ec93-3418-4557-bd6f-5dc569860c3b","timestamp":"2026-10-24T23:08:23.320Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\USER\\AppData\\Local\\Temp\\claude-rules\\loop-v1\\app\\crm_mcp.py","content":"\"\"\"MCP-сервер CRM поддержки: клиенты сервиса и их обращения из JSON-файла. Только чтение.\"\"\"\nimport json\nfrom typing import Annotated, Any\n\nfrom mcp.server.mcpserver import MCPServer\nfrom mcp.server.mcpserver.exceptions import ToolError\nfrom pydantic import Field\n\nfrom app import config\n\nserver = MCPServer(\n    name=\"crm\",\n    version=\"1.0.0\",\n    instructions=\"CRM поддержки сервиса «Риск отчисления студентов»: клиенты — сотрудники вузов — и их обращения \"\n                 \"с техническими данными: запрос, ответ сервиса, лог. Инструменты только читают, ничего не меняют.\",\n)\n\nCLOSED = {\"решён\"}\n\n\ndef load():\n    # файл читается на каждый вызов: правки CRM видны без перезапуска\n    return json.loads(config.CRM_FILE.read_text(encoding=\"utf-8\"))\n\n\ndef find(items, item_id, what):\n    normalized = item_id.strip().upper()  # для поиска и ошибки\n    for item in items:\n        if item[\"id\"] == normalized:\n            return item\n    raise ToolError(f\"{what} {normalized} нет в CRM\")\n\n\n@server.tool()\ndef list_tickets(\n    include_closed: Annotated[bool, Field(description=\"Показать и решённые обращения\")] = False,\n) -> dict[str, Any]:\n    \"\"\"Очередь обращений, новые сверху: номер, тема, сообщение клиента, статус, приоритет, дата и клиент.\"\"\"\n    crm = load()\n    users = {u[\"id\"]: u for u in crm[\"users\"]}\n    tickets = [{**{k: t[k] for k in (\"id\", \"subject\", \"message\", \"status\", \"priority\", \"created\")},\n                \"user\": {k: users[t[\"user_id\"]][k] for k in (\"id\", \"name\", \"org\")}}\n               for t in crm[\"tickets\"] if include_closed or t[\"status\"] not in CLOSED]\n    tickets.sort(key=lambda t: t[\"created\"], reverse=True)\n    return {\"count\": len(tickets), \"tickets\": tickets}\n\n\n@server.tool()\ndef get_ticket(ticket_id: Annotated[str, Field(description=\"Номер обращения, например T-1041\")]) -> dict[str, Any]:\n    \"\"\"Обращение целиком: сообщение клиента, статус, приоритет и технические данные — запрос, ответ сервиса, лог.\"\"\"\n    return find(load()[\"tickets\"], ticket_id, \"Обращения\")\n\n\n@server.tool()\ndef get_user(user_id: Annotated[str, Field(description=\"Номер клиента, например U-01\")]) -> dict[str, Any]:\n    \"\"\"Клиент: вуз, роль, как работает с сервисом, заметки поддержки и все его обращения с решениями.\"\"\"\n    crm = load()\n    user = find(crm[\"users\"], user_id, \"Клиента\")\n    tickets = [{k: t[k] for k in (\"id\", \"subject\", \"status\", \"created\", \"resolution\") if k in t}\n               for t in crm[\"tickets\"] if t[\"user_id\"] == user[\"id\"]]\n    return {**user, \"tickets\": tickets}\n\n\n@server.tool()\ndef find_tickets(\n    query: Annotated[str, Field(description=\"Запрос для поиска: номер, тема, сообщение или имя клиента\")] = \"\",\n) -> dict[str, Any]:\n    \"\"\"Обращения по запросу: поиск без учёта регистра по номеру, теме, сообщению, имени клиента и вузу.\"\"\"\n    normalized = query.strip()\n    if not normalized:\n        raise ToolError(\"Введите запрос для поиска\")\n\n    crm = load()\n    users = {u[\"id\"]: u for u in crm[\"users\"]}\n    q = normalized.lower()\n\n    found = []\n    for t in crm[\"tickets\"]:\n        user = users[t[\"user_id\"]]\n        text = (\n            f\"{t['id']} {t['subject']} {t['message']} {user['name']} {user['org']}\".lower()\n        )\n        if q in text:\n            found.append({\n                **{k: t[k] for k in (\"id\", \"subject\", \"message\", \"status\", \"priority\", \"created\")},\n                \"user\": {k: user[k] for k in (\"id\", \"name\", \"org\")},\n            })\n\n    found.sort(key=lambda t: t[\"created\"], reverse=True)\n    return {\"count\": len(found), \"tickets\": found}\n","numLines":91,"startLine":1,"totalLines":91}},"tool_result_meta":[{"id":"toolu_29e23271f9174de0ac5a708b","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"id":"msg_3c53e778-9193-9624-a044-71df24e6b246","type":"message","role":"assistant","model":"qwen3.5-122b-a10b","content":[{"type":"tool_use","id":"toolu_1b30aa3e0ef24f83bd395844","name":"Read","input":{"file_path":"C:\\Users\\USER\\AppData\\Local\\Temp\\claude-rules\\loop-v1\\app\\files_mcp.py"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":14119,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"0c06fc14-9b38-4c21-afdc-d00dd052f4ed","uuid":"196aafb7-837d-46a4-ab98-eb82b46c3682","timestamp":"2026-10-24T23:08:24.218Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_1b30aa3e0ef24f83bd395844","type":"tool_result","content":"1\t\"\"\"MCP-сервер files: чтение, поиск, правка и создание файлов проекта. Правки копятся в черновике: чтение и\n2\tпоиск их уже видят, а на диск их записывает apply_draft — после того как человек посмотрел diff.\"\"\"\n3\timport difflib\n4\timport re\n5\tfrom typing import Annotated, Any\n6\t\n7\tfrom mcp.server.mcpserver import MCPServer\n8\tfrom mcp.server.mcpserver.exceptions import ToolError\n9\tfrom pydantic import Field\n10\t\n11\tfrom app import config, git_mcp\n12\t\n13\tserver = MCPServer(\n14\t    name=\"files\",\n15\t    version=\"1.0.0\",\n16\t    instructions=\"Файлы проекта, с которым работает ассистент: список, чтение с номерами строк, поиск по всем \"\n17\t                 \"файлам, правка и создание. Правки копятся в черновике и видны при чтении и поиске; на диск их \"\n18\t                 \"записывает apply_draft, отменяет discard_draft.\",\n19\t)\n20\t\n21\tREAD_LINES = 80  # строк за один read_file: файл целиком раздувает промпт локальной модели\n22\tMATCHES = 60  # совпадений поиска в ответе\n23\tNUMBERED = re.compile(r\"^\\d+\\| ?\", re.M)  # так read_file нумерует строки\n24\tFilePath = Annotated[str, Field(description=\"Файл внутри проекта, например docs/api.md\")]\n25\t\n26\tdraft = {}  # путь → текст файла с правками; на диске пока прежний\n27\t\n28\t\n29\tdef _rel(path):\n30\t    \"\"\"Путь относительно проекта; за пределы проекта и в .git — нельзя.\"\"\"\n31\t    full = (config.PROJECT_DIR / path.strip().replace(\"\\\\\", \"/\").lstrip(\"/\")).resolve()\n32\t    if not full.is_relative_to(config.PROJECT_DIR) or full == config.PROJECT_DIR:\n33\t        raise ToolError(f\"{path}: путь вне проекта\")\n34\t    rel = full.relative_to(config.PROJECT_DIR).as_posix()\n35\t    if rel.split(\"/\")[0] == \".git\":\n36\t        raise ToolError(f\"{path}: папка .git недоступна\")\n37\t    return rel\n38\t\n39\t\n40\tdef _disk(rel):\n41\t    \"\"\"Текст файла на диске, переводы строк — \\\\n; None — файла нет.\"\"\"\n42\t    file = config.PROJECT_DIR / rel\n43\t    if not file.is_file():\n44\t        return None\n45\t    try:\n46\t        return file.read_text(encoding=\"utf-8\")\n47\t    except UnicodeDecodeError:\n48\t        raise ToolError(f\"{rel}: не текстовый файл\")\n49\t\n50\t\n51\tdef _text(rel):\n52\t    text = draft[rel] if rel in draft else _disk(rel)\n53\t    if text is None:\n54\t        raise ToolError(f\"{rel}: такого файла нет — посмотрите list_files или search\")\n55\t    return text\n56\t\n57\t\n58\tdef _files(path=\"\"):\n59\t    \"\"\"Файлы проекта без игнорируемых git и новые файлы черновика.\"\"\"\n60\t    prefix = _rel(path) if path.strip(\" ./\") else \"\"  # «.» и «/» — весь проект\n61\t    found = set(git_mcp.git(\"ls-files\", \"--cached\", \"--others\", \"--exclude-standard\", \"--\", prefix or \".\").splitlines())\n62\t    found |= {rel for rel in draft if not prefix or rel == prefix or rel.startswith(prefix + \"/\")}\n63\t    return sorted(found)\n64\t\n65\t\n66\tdef _plain(text):\n67\t    \"\"\"Модель иногда копирует строки из read_file вместе с номерами — номера убираем.\"\"\"\n68\t    text = text.replace(\"\\r\\n\", \"\\n\")\n69\t    if all(NUMBERED.match(line) for line in text.split(\"\\n\") if line):\n70\t        text = NUMBERED.sub(\"\", text)\n71\t    return text\n72\t\n73\t\n74\tdef _find(text, old):\n75\t    \"\"\"Вхождения old: точные, а если их нет — без учёта пробелов и переводов строк: модель склеивает строки\n76\t    абзаца в одну.\"\"\"\n77\t    if text.count(old):\n78\t        return [old] * text.count(old)\n79\t    return [m.group(0) for m in re.finditer(r\"\\s+\".join(map(re.escape, old.split())), text)]\n80\t\n81\t\n82\tdef _respace(found, new):\n83\t    \"\"\"Переносы строк в замене — там же, где в файле, если слов столько же.\"\"\"\n84\t    gaps, words = re.findall(r\"\\s+\", found), new.split()\n85\t    if len(words) != len(gaps) + 1:\n86\t        return new.strip()\n87\t    return words[0] + \"\".join(gap + word for gap, word in zip(gaps, words[1:]))\n88\t\n89\t\n90\tdef _diff(rel, old, new, context=3):\n91\t    return \"\\n\".join(difflib.unified_diff(old.splitlines() if old is not None else [], new.splitlines(),\n92\t                                          \"/dev/null\" if old is None else f\"a/{rel}\", f\"b/{rel}\",\n93\t                                          n=context, lineterm=\"\"))\n94\t\n95\t\n96\tdef _counts(diff):\n97\t    lines = diff.splitlines()[2:]  # без заголовков --- и +++\n98\t    return {\"added\": sum(line.startswith(\"+\") for line in lines),\n99\t            \"removed\": sum(line.startswith(\"-\") for line in lines)}\n100\t\n101\t\n102\t@server.tool()\n103\tdef list_files(\n104\t    path: Annotated[str, Field(description=\"Папка внутри проекта, например docs; пусто — весь проект\")] = \"\",\n105\t) -> dict[str, Any]:\n106\t    \"\"\"Файлы проекта: отслеживаемые git и новые, без игнорируемых (.venv, data, models), вместе с файлами,\n107\t    созданными в черновике.\"\"\"\n108\t    files = _files(path)\n109\t    return {\"path\": path or \".\", \"count\": len(files), \"files\": files}\n110\t\n111\t\n112\t@server.tool()\n113\tdef read_file(\n114\t    path: FilePath,\n115\t    start: Annotated[int, Field(ge=1, description=\"Первая строка\")] = 1,\n116\t    end: Annotated[int, Field(ge=0, description=\"Последняя строка; 0 — следующие 80 строк\")] = 0,\n117\t) -> dict[str, Any]:\n118\t    \"\"\"Текст файла с номерами строк, вместе с правками черновика. За раз — до 80 строк: читайте кусок\n119\t    вокруг строк, найденных search.\"\"\"\n120\t    rel = _rel(path)\n121\t    lines = _text(rel).splitlines()\n122\t    if lines and start > len(lines):\n123\t        raise ToolError(f\"В {rel} всего {len(lines)} строк\")\n124\t    end = min(len(lines), end or start + READ_LINES - 1, start + READ_LINES - 1)\n125\t    return {\"path\": rel, \"lines\": len(lines), \"from\": start, \"to\": end, \"draft\": rel in draft,\n126\t            \"text\": \"\\n\".join(f\"{n}| {lines[n - 1]}\" for n in range(start, end + 1))}\n127\t\n128\t\n129\t@server.tool()\n130\tdef search(\n131\t    query: Annotated[str, Field(description=\"Что искать, без учёта регистра; несколько вариантов — через |\")],\n132\t    path: Annotated[str, Field(description=\"Папка или файл; пусто — весь проект\")] = \"\",\n133\t) -> dict[str, Any]:\n134\t    \"\"\"Поиск по всем текстовым файлам проекта, вместе с правками черновика: файл, номер строки и сама строка.\"\"\"\n135\t    words = [word.strip().lower() for word in query.split(\"|\") if word.strip()]\n136\t    if not words:\n137\t        raise ToolError(\"Пустой запрос\")\n138\t    matches, files = [], set()\n139\t    for rel in _files(path):\n140\t        try:\n141\t            text = _text(rel)\n142\t        except ToolError:  # двоичный файл\n143\t            continue\n144\t        for n, line in enumerate(text.splitlines(), 1):\n145\t            if any(word in line.lower() for word in words):\n146\t                matches.append(f\"{rel}:{n}: {line.strip()[:200]}\")\n147\t                files.add(rel)\n148\t    return {\"query\": query, \"count\": len(matches), \"files\": len(files), \"truncated\": len(matches) > MATCHES,\n149\t            \"matches\": matches[:MATCHES]}\n150\t\n151\t\n152\t@server.tool()\n153\tdef edit_file(\n154\t    path: FilePath,\n155\t    old: Annotated[str, Field(description=\"Точный текст из файла, который заменить; встречается в файле один раз\")],\n156\t    new: Annotated[str, Field(description=\"Текст на его место\")],\n157\t) -> dict[str, Any]:\n158\t    \"\"\"Заменить кусок файла. Правка идёт в черновик, на диск её записывает пользователь.\"\"\"\n159\t    rel = _rel(path)\n160\t    text = _text(rel)\n161\t    old, new = _plain(old), _plain(new)\n162\t    found = _find(text, old) if old.strip() else []\n163\t    if not found:\n164\t        raise ToolError(f\"В {rel} нет такого текста: прочитайте нужные строки read_file и скопируйте их точно, \"\n165\t                        \"без номеров строк\")\n166\t    if len(found) > 1:\n167\t        raise ToolError(f\"Этот текст встречается в {rel} {len(found)} раз(а) — добавьте соседние строки, \"\n168\t                        \"чтобы он был один\")\n169\t    if found[0] != old:\n170\t        new = _respace(found[0], new)\n171\t    if found[0] == new:\n172\t        raise ToolError(\"new совпадает с old — правка ничего не меняет\")\n173\t    changed = text.replace(found[0], new, 1)\n174\t    draft[rel] = changed\n175\t    diff = _diff(rel, text, changed, context=1)\n176\t    return {\"path\": rel, **_counts(diff), \"diff\": diff}\n177\t\n178\t\n179\t@server.tool()\n180\tdef write_file(\n181\t    path: Annotated[str, Field(description=\"Путь нового файла, например CHANGELOG.md\")],\n182\t    content: Annotated[str, Field(description=\"Полный текст файла\")],\n183\t) -> dict[str, Any]:\n184\t    \"\"\"Создать новый файл — в черновике. Существующий файл меняйте через edit_file.\"\"\"\n185\t    rel = _rel(path)\n186\t    if rel in draft or (config.PROJECT_DIR / rel).exists():\n187\t        raise ToolError(f\"{rel} уже есть — меняйте его через edit_file\")\n188\t    draft[rel] = content.replace(\"\\r\\n\", \"\\n\").rstrip(\"\\n\") + \"\\n\"\n189\t    return {\"path\": rel, \"lines\": draft[rel].count(\"\\n\"), \"created\": True}\n190\t\n191\t\n192\t@server.tool()\n193\tdef draft_diff() -> dict[str, Any]:\n194\t    \"\"\"Все правки черновика: unified diff каждого файла против диска и сколько строк добавлено и удалено.\"\"\"\n195\t    files = []\n196\t    for rel in sorted(draft):\n197\t        old = _disk(rel)\n198\t        if draft[rel] == old:\n199\t            continue\n200\t        diff = _diff(rel, old, draft[rel])\n201\t        files.append({\"path\": rel, \"status\": \"новый\" if old is None else \"изменён\", **_counts(diff), \"diff\": diff})\n202\t    return {\"files\": files, \"added\": sum(f[\"added\"] for f in files), \"removed\": sum(f[\"removed\"] for f in files)}\n203\t\n204\t\n205\t@server.tool()\n206\tdef apply_draft() -> dict[str, Any]:\n207\t    \"\"\"Записать правки черновика в файлы проекта и очистить черновик.\"\"\"\n208\t    written = []\n209\t    for rel, text in sorted(draft.items()):\n210\t        file = config.PROJECT_DIR / rel\n211\t        # переводы строк — как были у файла: с core.autocrlf в рабочей папке бывают и CRLF, и LF\n212\t        newline = \"\\r\\n\" if file.is_file() and b\"\\r\\n\" in file.read_bytes() else \"\\n\"\n213\t        file.parent.mkdir(parents=True, exist_ok=True)\n214\t        file.write_text(text, encoding=\"utf-8\", newline=newline)\n215\t        written.append(rel)\n216\t    draft.clear()\n217\t    return {\"written\": written, \"count\": len(written)}\n218\t\n219\t\n220\t@server.tool()\n221\tdef discard_draft() -> dict[str, Any]:\n222\t    \"\"\"Отменить все правки черновика.\"\"\"\n223\t    count = len(draft)\n224\t    draft.clear()\n225\t    return {\"discarded\": count}\n226\t"}]},"parent_tool_use_id":null,"session_id":"0c06fc14-9b38-4c21-afdc-d00dd052f4ed","uuid":"0905c50c-c1fa-48f6-b5c9-1f5868633502","timestamp":"2026-10-24T23:08:24.229Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\USER\\AppData\\Local\\Temp\\claude-rules\\loop-v1\\app\\files_mcp.py","content":"\"\"\"MCP-сервер files: чтение, поиск, правка и создание файлов проекта. Правки копятся в черновике: чтение и\nпоиск их уже видят, а на диск их записывает apply_draft — после того как человек посмотрел diff.\"\"\"\nimport difflib\nimport re\nfrom typing import Annotated, Any\n\nfrom mcp.server.mcpserver import MCPServer\nfrom mcp.server.mcpserver.exceptions import ToolError\nfrom pydantic import Field\n\nfrom app import config, git_mcp\n\nserver = MCPServer(\n    name=\"files\",\n    version=\"1.0.0\",\n    instructions=\"Файлы проекта, с которым работает ассистент: список, чтение с номерами строк, поиск по всем \"\n                 \"файлам, правка и создание. Правки копятся в черновике и видны при чтении и поиске; на диск их \"\n                 \"записывает apply_draft, отменяет discard_draft.\",\n)\n\nREAD_LINES = 80  # строк за один read_file: файл целиком раздувает промпт локальной модели\nMATCHES = 60  # совпадений поиска в ответе\nNUMBERED = re.compile(r\"^\\d+\\| ?\", re.M)  # так read_file нумерует строки\nFilePath = Annotated[str, Field(description=\"Файл внутри проекта, например docs/api.md\")]\n\ndraft = {}  # путь → текст файла с правками; на диске пока прежний\n\n\ndef _rel(path):\n    \"\"\"Путь относительно проекта; за пределы проекта и в .git — нельзя.\"\"\"\n    full = (config.PROJECT_DIR / path.strip().replace(\"\\\\\", \"/\").lstrip(\"/\")).resolve()\n    if not full.is_relative_to(config.PROJECT_DIR) or full == config.PROJECT_DIR:\n        raise ToolError(f\"{path}: путь вне проекта\")\n    rel = full.relative_to(config.PROJECT_DIR).as_posix()\n    if rel.split(\"/\")[0] == \".git\":\n        raise ToolError(f\"{path}: папка .git недоступна\")\n    return rel\n\n\ndef _disk(rel):\n    \"\"\"Текст файла на диске, переводы строк — \\\\n; None — файла нет.\"\"\"\n    file = config.PROJECT_DIR / rel\n    if not file.is_file():\n        return None\n    try:\n        return file.read_text(encoding=\"utf-8\")\n    except UnicodeDecodeError:\n        raise ToolError(f\"{rel}: не текстовый файл\")\n\n\ndef _text(rel):\n    text = draft[rel] if rel in draft else _disk(rel)\n    if text is None:\n        raise ToolError(f\"{rel}: такого файла нет — посмотрите list_files или search\")\n    return text\n\n\ndef _files(path=\"\"):\n    \"\"\"Файлы проекта без игнорируемых git и новые файлы черновика.\"\"\"\n    prefix = _rel(path) if path.strip(\" ./\") else \"\"  # «.» и «/» — весь проект\n    found = set(git_mcp.git(\"ls-files\", \"--cached\", \"--others\", \"--exclude-standard\", \"--\", prefix or \".\").splitlines())\n    found |= {rel for rel in draft if not prefix or rel == prefix or rel.startswith(prefix + \"/\")}\n    return sorted(found)\n\n\ndef _plain(text):\n    \"\"\"Модель иногда копирует строки из read_file вместе с номерами — номера убираем.\"\"\"\n    text = text.replace(\"\\r\\n\", \"\\n\")\n    if all(NUMBERED.match(line) for line in text.split(\"\\n\") if line):\n        text = NUMBERED.sub(\"\", text)\n    return text\n\n\ndef _find(text, old):\n    \"\"\"Вхождения old: точные, а если их нет — без учёта пробелов и переводов строк: модель склеивает строки\n    абзаца в одну.\"\"\"\n    if text.count(old):\n        return [old] * text.count(old)\n    return [m.group(0) for m in re.finditer(r\"\\s+\".join(map(re.escape, old.split())), text)]\n\n\ndef _respace(found, new):\n    \"\"\"Переносы строк в замене — там же, где в файле, если слов столько же.\"\"\"\n    gaps, words = re.findall(r\"\\s+\", found), new.split()\n    if len(words) != len(gaps) + 1:\n        return new.strip()\n    return words[0] + \"\".join(gap + word for gap, word in zip(gaps, words[1:]))\n\n\ndef _diff(rel, old, new, context=3):\n    return \"\\n\".join(difflib.unified_diff(old.splitlines() if old is not None else [], new.splitlines(),\n                                          \"/dev/null\" if old is None else f\"a/{rel}\", f\"b/{rel}\",\n                                          n=context, lineterm=\"\"))\n\n\ndef _counts(diff):\n    lines = diff.splitlines()[2:]  # без заголовков --- и +++\n    return {\"added\": sum(line.startswith(\"+\") for line in lines),\n            \"removed\": sum(line.startswith(\"-\") for line in lines)}\n\n\n@server.tool()\ndef list_files(\n    path: Annotated[str, Field(description=\"Папка внутри проекта, например docs; пусто — весь проект\")] = \"\",\n) -> dict[str, Any]:\n    \"\"\"Файлы проекта: отслеживаемые git и новые, без игнорируемых (.venv, data, models), вместе с файлами,\n    созданными в черновике.\"\"\"\n    files = _files(path)\n    return {\"path\": path or \".\", \"count\": len(files), \"files\": files}\n\n\n@server.tool()\ndef read_file(\n    path: FilePath,\n    start: Annotated[int, Field(ge=1, description=\"Первая строка\")] = 1,\n    end: Annotated[int, Field(ge=0, description=\"Последняя строка; 0 — следующие 80 строк\")] = 0,\n) -> dict[str, Any]:\n    \"\"\"Текст файла с номерами строк, вместе с правками черновика. За раз — до 80 строк: читайте кусок\n    вокруг строк, найденных search.\"\"\"\n    rel = _rel(path)\n    lines = _text(rel).splitlines()\n    if lines and start > len(lines):\n        raise ToolError(f\"В {rel} всего {len(lines)} строк\")\n    end = min(len(lines), end or start + READ_LINES - 1, start + READ_LINES - 1)\n    return {\"path\": rel, \"lines\": len(lines), \"from\": start, \"to\": end, \"draft\": rel in draft,\n            \"text\": \"\\n\".join(f\"{n}| {lines[n - 1]}\" for n in range(start, end + 1))}\n\n\n@server.tool()\ndef search(\n    query: Annotated[str, Field(description=\"Что искать, без учёта регистра; несколько вариантов — через |\")],\n    path: Annotated[str, Field(description=\"Папка или файл; пусто — весь проект\")] = \"\",\n) -> dict[str, Any]:\n    \"\"\"Поиск по всем текстовым файлам проекта, вместе с правками черновика: файл, номер строки и сама строка.\"\"\"\n    words = [word.strip().lower() for word in query.split(\"|\") if word.strip()]\n    if not words:\n        raise ToolError(\"Пустой запрос\")\n    matches, files = [], set()\n    for rel in _files(path):\n        try:\n            text = _text(rel)\n        except ToolError:  # двоичный файл\n            continue\n        for n, line in enumerate(text.splitlines(), 1):\n            if any(word in line.lower() for word in words):\n                matches.append(f\"{rel}:{n}: {line.strip()[:200]}\")\n                files.add(rel)\n    return {\"query\": query, \"count\": len(matches), \"files\": len(files), \"truncated\": len(matches) > MATCHES,\n            \"matches\": matches[:MATCHES]}\n\n\n@server.tool()\ndef edit_file(\n    path: FilePath,\n    old: Annotated[str, Field(description=\"Точный текст из файла, который заменить; встречается в файле один раз\")],\n    new: Annotated[str, Field(description=\"Текст на его место\")],\n) -> dict[str, Any]:\n    \"\"\"Заменить кусок файла. Правка идёт в черновик, на диск её записывает пользователь.\"\"\"\n    rel = _rel(path)\n    text = _text(rel)\n    old, new = _plain(old), _plain(new)\n    found = _find(text, old) if old.strip() else []\n    if not found:\n        raise ToolError(f\"В {rel} нет такого текста: прочитайте нужные строки read_file и скопируйте их точно, \"\n                        \"без номеров строк\")\n    if len(found) > 1:\n        raise ToolError(f\"Этот текст встречается в {rel} {len(found)} раз(а) — добавьте соседние строки, \"\n                        \"чтобы он был один\")\n    if found[0] != old:\n        new = _respace(found[0], new)\n    if found[0] == new:\n        raise ToolError(\"new совпадает с old — правка ничего не меняет\")\n    changed = text.replace(found[0], new, 1)\n    draft[rel] = changed\n    diff = _diff(rel, text, changed, context=1)\n    return {\"path\": rel, **_counts(diff), \"diff\": diff}\n\n\n@server.tool()\ndef write_file(\n    path: Annotated[str, Field(description=\"Путь нового файла, например CHANGELOG.md\")],\n    content: Annotated[str, Field(description=\"Полный текст файла\")],\n) -> dict[str, Any]:\n    \"\"\"Создать новый файл — в черновике. Существующий файл меняйте через edit_file.\"\"\"\n    rel = _rel(path)\n    if rel in draft or (config.PROJECT_DIR / rel).exists():\n        raise ToolError(f\"{rel} уже есть — меняйте его через edit_file\")\n    draft[rel] = content.replace(\"\\r\\n\", \"\\n\").rstrip(\"\\n\") + \"\\n\"\n    return {\"path\": rel, \"lines\": draft[rel].count(\"\\n\"), \"created\": True}\n\n\n@server.tool()\ndef draft_diff() -> dict[str, Any]:\n    \"\"\"Все правки черновика: unified diff каждого файла против диска и сколько строк добавлено и удалено.\"\"\"\n    files = []\n    for rel in sorted(draft):\n        old = _disk(rel)\n        if draft[rel] == old:\n            continue\n        diff = _diff(rel, old, draft[rel])\n        files.append({\"path\": rel, \"status\": \"новый\" if old is None else \"изменён\", **_counts(diff), \"diff\": diff})\n    return {\"files\": files, \"added\": sum(f[\"added\"] for f in files), \"removed\": sum(f[\"removed\"] for f in files)}\n\n\n@server.tool()\ndef apply_draft() -> dict[str, Any]:\n    \"\"\"Записать правки черновика в файлы проекта и очистить черновик.\"\"\"\n    written = []\n    for rel, text in sorted(draft.items()):\n        file = config.PROJECT_DIR / rel\n        # переводы строк — как были у файла: с core.autocrlf в рабочей папке бывают и CRLF, и LF\n        newline = \"\\r\\n\" if file.is_file() and b\"\\r\\n\" in file.read_bytes() else \"\\n\"\n        file.parent.mkdir(parents=True, exist_ok=True)\n        file.write_text(text, encoding=\"utf-8\", newline=newline)\n        written.append(rel)\n    draft.clear()\n    return {\"written\": written, \"count\": len(written)}\n\n\n@server.tool()\ndef discard_draft() -> dict[str, Any]:\n    \"\"\"Отменить все правки черновика.\"\"\"\n    count = len(draft)\n    draft.clear()\n    return {\"discarded\": count}\n","numLines":226,"startLine":1,"totalLines":226}},"tool_result_meta":[{"id":"toolu_1b30aa3e0ef24f83bd395844","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
