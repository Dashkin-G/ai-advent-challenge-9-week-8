+@app.get("/api/search")
+async def search(q: str, top: int = config.TOP):
+    """Поиск по документации проекта без модели — q обязателен, top по умолчанию как /help (не больше 10)."""
+    if not q.strip():
+        raise HTTPException(status_code=400, detail="Укажите запрос в параметре q")
+    if top < 1:
+        raise HTTPException(status_code=400, detail="top должен быть больше 0")
+    top = min(top, 10)
+
+    step = "search"
+    try:
+        started = time.perf_counter()
+        hits = await rag.search(q, top=top)
+        seconds = round(time.perf_counter() - started, 2)
+    except FileNotFoundError as exc:
+        raise HTTPException(status_code=400, detail=str(exc))
+    except llm.LLMError as exc:
+        raise HTTPException(status_code=400, detail=str(exc))
+
+    return {
+        "query": q,
+        "top": top,
+        "seconds": seconds,
+        "hits": [
+            {
+                "file": hit["file"],
+                "title": hit["title"],
+                "score": hit["score"],
+                "text": hit["text"],
+                "kind": hit["kind"],
+            }
+            for hit in hits
+        ],
+    }
