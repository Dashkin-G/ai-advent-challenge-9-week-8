+"""Тесты app/rag.py: нарезка документации и кода на фрагменты."""
+import unittest
+
+from app import rag
+
+
+class RagSplitTest(unittest.TestCase):
+    def test_split_docs_heading(self):
+        """Разбивает Markdown по заголовкам."""
+        text = '# README\n\n## Запуск\n\nКоманда uvicorn'
+        chunks = list(rag.split_docs('README.md', text))
+        self.assertEqual(len(chunks), 1)
+        self.assertEqual(chunks[0]['title'], 'Запуск')
+        self.assertEqual(chunks[0]['text'], 'Команда uvicorn')
+        self.assertEqual(chunks[0]['kind'], 'docs')
+
+    def test_split_code_function(self):
+        """Функция целиком — один фрагмент с номерами строк."""
+        code = 'def hello():\n    return 42'
+        chunks = list(rag.split_code('app/test.py', code))
+        self.assertEqual(len(chunks), 1)
+        self.assertEqual(chunks[0]['title'], 'hello()')
+        self.assertEqual(chunks[0]['lines'], [1, 2])
+        self.assertEqual(chunks[0]['kind'], 'code')
+
+    def test_split_code_class(self):
+        """Класс целиком — один фрагмент."""
+        code = 'class Index:\n    def build(self):\n        pass'
+        chunks = list(rag.split_code('app/rag.py', code))
+        self.assertEqual(len(chunks), 1)
+        self.assertEqual(chunks[0]['title'], 'class Index')
+        self.assertEqual(chunks[0]['lines'], [1, 3])
+
+    def test_source(self):
+        """source формирует заголовок для ссылки."""
+        chunk = {'file': 'README.md', 'title': 'Запуск'}
+        self.assertEqual(rag.source(chunk), 'README.md › Запуск')
+
+    def test_source_with_lines(self):
+        """У кода включаются номера строк."""
+        chunk = {'file': 'app/test.py', 'title': 'hello()', 'lines': [1, 5]}
+        self.assertEqual(rag.source(chunk), 'app/test.py › hello(), строки 1–5')
+
+
+if __name__ == '__main__':
+    unittest.main()
