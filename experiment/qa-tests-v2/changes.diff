+"""Тесты app/files.py: подготовка инструментов и результата для модели."""
+import unittest
+
+from app import files
+
+
+class FilesTest(unittest.TestCase):
+    def test_spec(self):
+        """Создаёт описание инструмента для Ollama без заголовков JSON Schema."""
+        tool = type('Tool', (), {
+            'name': 'list_files',
+            'description': 'Файлы проекта',
+            'input_schema': {'type': 'object', 'title': 'Schema'}
+        })()
+        result = files.spec(tool)
+        self.assertEqual(result['type'], 'function')
+        self.assertEqual(result['function']['name'], 'list_files')
+        self.assertNotIn('title', result['function'])
+        self.assertNotIn('title', result['function']['parameters'])
+
+    def test_for_model_dict(self):
+        """Dict передаётся как JSON."""
+        result = files.for_model({'count': 5})
+        self.assertIn('"count": 5', result)
+
+    def test_for_model_list_strings(self):
+        """Список строк выводится построчно."""
+        result = files.for_model({'count': 5, 'files': ['a.py', 'b.py']})
+        lines = result.split('\n')
+        self.assertIn('a.py', lines)
+        self.assertIn('b.py', lines)
+
+    def test_for_model_list_dicts(self):
+        """Список dicts выводится через разделитель."""
+        result = files.for_model([{'id': 'T-1', 'subject': 'Ошибка'}, {'id': 'T-2', 'subject': 'Вопрос'}])
+        self.assertIn('T-1', result)
+        self.assertIn('T-2', result)
+
+
+if __name__ == '__main__':
+    unittest.main()
