+"""Тесты app/support.py: контекст обращения и запросы к базе знаний."""
+import unittest
+
+from app import support
+
+
+class SupportTest(unittest.TestCase):
+    def test_context_text(self):
+        """Формирует текст клиента и обращения для промпта."""
+        ticket = {'id': 'T-1041', 'subject': 'Ошибка', 'status': 'open', 'priority': 'high',
+                  'created': '2026-10-20', 'message': 'Не запускается', 'technical': {}}
+        user = {'name': 'Иван', 'role': 'разработчик', 'org': 'Компания', 'channel': 'API',
+                'setup': 'Docker', 'notes': '', 'tickets': []}
+        result = support.context_text(ticket, user)
+        self.assertIn('Клиент: Иван', result)
+        self.assertIn('приоритет high', result)
+        self.assertIn('Сообщение клиента: Не запускается', result)
+
+    def test_context_text_with_past_tickets(self):
+        """Включает прошлые обращения клиента в текст контекста."""
+        ticket = {'id': 'T-1041', 'subject': 'Ошибка', 'status': 'open', 'priority': 'high',
+                  'created': '2026-10-20', 'message': 'Не запускается', 'technical': {}}
+        user = {'name': 'Иван', 'role': 'разработчик', 'org': 'Компания', 'channel': 'API',
+                'setup': 'Docker', 'notes': '', 'tickets': [
+                    {'id': 'T-1000', 'subject': 'Проблема', 'status': 'closed', 'resolution': 'Закончено'}
+                ]}
+        result = support.context_text(ticket, user)
+        self.assertIn('Прошлые обращения', result)
+        self.assertIn('T-1000', result)
+        self.assertIn('Закончено', result)
+
+    def test_queries(self):
+        """Запросы включают вопрос и технические ошибки из обращения."""
+        question = 'Почему 422?'
+        ticket = {'technical': {'body: validation error': {'details': 'body: ошибка'}}}
+        result = support.queries(question, ticket)
+        self.assertEqual(result, ['Почему 422?', 'body: ошибка'])
+
+    def test_queries_no_errors(self):
+        """Без технических данных — только вопрос."""
+        result = support.queries('Как запустить?', None)
+        self.assertEqual(result, ['Как запустить?'])
+
+
+if __name__ == '__main__':
+    unittest.main()
