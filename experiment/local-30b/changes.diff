+#!/usr/bin/env python3
+"""Test script for the new /api/search endpoint."""
+
+import os
+import tempfile
+from fastapi.testclient import TestClient
+
+# Set up environment variables for testing
+os.environ['PROJECT_DIR'] = '../ml-student-dropout'
+os.environ['DATA_DIR'] = tempfile.mkdtemp()
+
+# Import after setting env vars
+from app import llm, main
+
+async def fake_embed(texts):
+    return [[float(len(t) % 7 + 1), 1.0] + [0.0] * 1022 for t in texts]
+
+# Replace the embed function with a fake one for testing
+llm.embed = fake_embed
+
+def test_search_endpoint():
+    client = TestClient(main.app)
+
+    # Test valid search
+    response = client.get('/api/search', params={'q': 'как запустить'})
+    print(f"Status code: {response.status_code}")
+    print(f"Response: {response.json()}")
+
+    # Test with top parameter
+    response = client.get('/api/search', params={'q': 'запуск', 'top': 5})
+    print(f"Status code with top=5: {response.status_code}")
+    print(f"Response with top=5: {response.json()}")
+
+    # Test empty query (should fail)
+    response = client.get('/api/search', params={'q': ''})
+    print(f"Status code with empty query: {response.status_code}")
+    print(f"Response with empty query: {response.json()}")
+
+if __name__ == "__main__":
+    test_search_endpoint()
