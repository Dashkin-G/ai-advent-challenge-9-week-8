{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_66c9c4a963224cc9b0b2d705","type":"tool_result","content":"1\t\"\"\"MCP-сервер CRM поддержки: клиенты сервиса и их обращения из JSON-файла. Только чтение.\"\"\"\n2\timport json\n3\tfrom typing import Annotated, Any\n4\t\n5\tfrom mcp.server.mcpserver import MCPServer\n6\tfrom mcp.server.mcpserver.exceptions import ToolError\n7\tfrom pydantic import Field\n8\t\n9\tfrom app import config\n10\t\n11\tserver = MCPServer(\n12\t    name=\"crm\",\n13\t    version=\"1.0.0\",\n14\t    instructions=\"CRM поддержки сервиса «Риск отчисления студентов»: клиенты — сотрудники вузов — и их обращения \"\n15\t                 \"с техническими данными: запрос, ответ сервиса, лог. Инструменты только читают, ничего не меняют.\",\n16\t)\n17\t\n18\tCLOSED = {\"решён\"}\n19\t\n20\t\n21\tdef load():\n22\t    # файл читается на каждый вызов: правки CRM видны без перезапуска\n23\t    return json.loads(config.CRM_FILE.read_text(encoding=\"utf-8\"))\n24\t\n25\t\n26\tdef find(items, item_id, what):\n27\t    for item in items:\n28\t        if item[\"id\"] == item_id.strip().upper():\n29\t            return item\n30\t    raise ToolError(f\"{what} {item_id} нет в CRM\")\n31\t\n32\t\n33\t@server.tool()\n34\tdef list_tickets(\n35\t    include_closed: Annotated[bool, Field(description=\"Показать и решённые обращения\")] = False,\n36\t) -> dict[str, Any]:\n37\t    \"\"\"Очередь обращений, новые сверху: номер, тема, сообщение клиента, статус, приоритет, дата и клиент.\"\"\"\n38\t    crm = load()\n39\t    users = {u[\"id\"]: u for u in crm[\"users\"]}\n40\t    tickets = [{**{k: t[k] for k in (\"id\", \"subject\", \"message\", \"status\", \"priority\", \"created\")},\n41\t                \"user\": {k: users[t[\"user_id\"]][k] for k in (\"id\", \"name\", \"org\")}}\n42\t               for t in crm[\"tickets\"] if include_closed or t[\"status\"] not in CLOSED]\n43\t    tickets.sort(key=lambda t: t[\"created\"], reverse=True)\n44\t    return {\"count\": len(tickets), \"tickets\": tickets}\n45\t\n46\t\n47\t@server.tool()\n48\tdef get_ticket(ticket_id: Annotated[str, Field(description=\"Номер обращения, например T-1041\")]) -> dict[str, Any]:\n49\t    \"\"\"Обращение целиком: сообщение клиента, статус, приоритет и технические данные — запрос, ответ сервиса, лог.\"\"\"\n50\t    return find(load()[\"tickets\"], ticket_id, \"Обращения\")\n51\t\n52\t\n53\t@server.tool()\n54\tdef get_user(user_id: Annotated[str, Field(description=\"Номер клиента, например U-01\")]) -> dict[str, Any]:\n55\t    \"\"\"Клиент: вуз, роль, как работает с сервисом, заметки поддержки и все его обращения с решениями.\"\"\"\n56\t    crm = load()\n57\t    user = find(crm[\"users\"], user_id, \"Клиента\")\n58\t    tickets = [{k: t[k] for k in (\"id\", \"subject\", \"status\", \"created\", \"resolution\") if k in t}\n59\t               for t in crm[\"tickets\"] if t[\"user_id\"] == user[\"id\"]]\n60\t    return {**user, \"tickets\": tickets}\n61\t"}]},"parent_tool_use_id":"toolu_28eba6b0009248ca85f11109","agent_id":"a5ea2d0274a1bf7ad","session_id":"bba2e00a-b808-4fc7-a153-892f03500aa4","uuid":"c12f3e06-6b74-4069-9114-91920645b20d","timestamp":"2026-10-24T23:20:56.489Z","tool_result_meta":[{"id":"toolu_66c9c4a963224cc9b0b2d705","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"bug-fix","task_description":"Fix CRM error formatting"}
