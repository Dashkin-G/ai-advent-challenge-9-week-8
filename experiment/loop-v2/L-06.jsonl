ask.cancel()\n42\t\n43\t\n44\tapp = FastAPI(title=\"Ассистент разработчика и поддержки\", lifespan=lifespan)\n45\t\n46\t\n47\t@app.exception_handler(RequestValidationError)\n48\tasync def validation_exception_handler(request: Request, exc: RequestValidationError):\n49\t    \"\"\"Преобразует ошибки валидации FastAPI в 400 с русским текстом.\"\"\"\n50\t    errors = exc.errors()\n51\t    detail = \"Ошибка валидации\"\n52\t\n53\t    for error in errors:\n54\t        loc = error.get(\"loc\", [])\n55\t        # body > text | body > question | body > goal\n56\t        if len(loc) >= 2 and loc[0] == \"body\":\n57\t            field = loc[1]\n58\t            if field == \"text\":\n59\t                detail = \"Поле text требуется и должно быть строкой\"\n60\t            elif field == \"question\":\n61\t                detail = \"Поле question требуется и должно быть строкой\"\n62\t            elif field == \"goal\":\n63\t                detail = \"Поле goal требуется и должно быть строкой\"\n64\t            break\n65\t\n66\t    return JSONResponse(status_code=400, content={\"detail\": detail})\n67\t\n68\t\n69\tapp.mount(\"/mcp/git\", git_mcp.server.streamable_http_app(streamable_http_path=\"/\"))\n70\tapp.mount(\"/mcp/crm\", crm_mcp.server.streamable_http_app(streamable_http_path=\"/\"))\n71\tapp.mount(\"/mcp/files\", files_mcp.server.streamable_http_app(streamable_http_path=\"/\"))\n72\t\n73\t\n74\tclass Command(BaseModel):\n75\t    text: str\n76\t\n77\t\n78\tclass Question(BaseModel):\n79\t    question: str\n80\t    ticket_id: str | None = None\n81\t\n82\t\n83\tclass Task(BaseModel):\n84\t    goal: str\n85\t\n86\t\n87\t@app.get(\"/\", include_in_schema=False)\n88\tasync def page():\n89\t    return FileResponse(PAGE)\n90\t\n91\t\n92\t@app.get(\"/support\", include_in_schema=False)\n93\tasync def support_page():\n94\t    return FileResponse(SUPPORT_PAGE)\n95\t\n96\t\n97\t@app.get(\"/files\", include_in_schema=False)\n98\tasync def files_page():\n99\t    return FileResponse(FILES_PAGE)\n100\t\n101\t\n102\t@app.get(\"/api/status\")\n103\tasync def status():\n104\t    ollama, project = await asyncio.gather(llm.status(), assistant.project())\n105\t    return {\"project\": {**project, \"path\": str(config.PROJECT_DIR)}, \"ollama\": ollama,\n106\t            \"model\": config.MODEL, \"embed_model\": config.EMBED_MODEL, \"docs\": rag.info()}\n107\t\n108\t\n109\t@app.post(\"/api/help\")\n110\tasync def help_command(command: Command):\n111\t    question = assistant.parse(command.text)\n112\t    if question is None:\n113\t        raise HTTPException(status_code=400, detail=\"Команда ассистента: /help <вопрос о проекте>\")\n114\t\n115\t    async def stream():\n116\t        async for event in assistant.answer(question):\n117\t            yield assistant.dumps(event)\n118\t\n119\t    return StreamingResponse(stream(), media_type=\"application/x-ndjson\")\n120\t\n121\t\n122\t@app.get(\"/api/support/status\")\n123\tasync def support_status():\n124\t    ollama, crm = await asyncio.gather(llm.status(), support.queue())\n125\t    return {\"ollama\": ollama, \"model\": config.MODEL, \"embed_model\": config.EMBED_MODEL,\n126\t            \"kb\": support.index.info(), \"crm\": crm}\n127\t\n128\t\n129\t@app.post(\"/api/support/answer\")\n130\tasync def support_answer(body: Question):\n131\t    question = body.question.strip()\n132\t    if not question:\n133\t        raise HTTPException(status_code=400, detail=\"Напишите вопрос клиента\")\n134\t\n135\t    async def stream():\n136\t        async for event in support.answer(body.ticket_id, question):\n137\t            yield assistant.dumps(event)\n138\t\n139\t    return StreamingResponse(stream(), media_type=\"application/x-ndjson\")\n140\t\n141\t\n142\t@app.post(\"/api/files/run\")\n143\tasync def files_run(task: Task):\n144\t    goal = task.goal.strip()\n145\t    if not goal:\n146\t        raise HTTPException(status_code=400, detail=\"Напишите задачу: что найти, обновить или создать\")\n147\t\n148\t    async def stream():\n149\t        async for event in files.run(goal):\n150\t            yield assistant.dumps(event)\n151\t\n152\t    return StreamingResponse(stream(), media_type=\"application/x-ndjson\")\n153\t\n154\t\n155\t@app.post(\"/api/files/apply\")\n156\tasync def files_apply():\n157\t    return await files.apply()\n158\t\n159\t\n160\t@app.post(\"/api/files/discard\")\n161\tasync def files_discard():\n162\t    return await files.discard()\n163\t\n164\t\n165\tif __name__ == \"__main__\":\n166\t    uvicorn.run(app, host=config.HOST, port=config.PORT)\n167\t"}]},"parent_tool_use_id":null,"session_id":"72844ed0-45c6-440c-9d05-d908f65aefbe","uuid":"1b0a6ec3-cd7d-4c5a-aa02-2de89eca2858","timestamp":"2026-10-24T23:29:52.072Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\USER\\AppData\\Local\\Temp\\claude-rules\\loop-v2\\app\\main.py","content":"\"\"\"Ассистент разработчика и поддержки: страница /help, место оператора поддержки /support, работа с файлами\nпроекта /files, MCP-серверы git на /mcp/git, CRM на /mcp/crm и файлов на /mcp/files.\"\"\"\nimport asyncio\nimport logging\nfrom contextlib import asynccontextmanager\n\nimport uvicorn\nfrom fastapi import FastAPI, HTTPException, Request\nfrom fastapi.exceptions import RequestValidationError\nfrom fastapi.responses import FileResponse, JSONResponse, StreamingResponse\nfrom pydantic import BaseModel\n\nfrom app import assistant, config, crm_mcp, files, files_mcp, git_mcp, llm, rag, support\n\nlogging.basicConfig(level=logging.INFO)\nlogger = logging.getLogger(__name__)\n\nPAGE = config.ROOT / \"static\" / \"index.html\"\nSUPPORT_PAGE = config.ROOT / \"static\" / \"support.html\"\nFILES_PAGE = config.ROOT / \"static\" / \"files.html\"\n\n\nasync def warm_up():\n    \"\"\"Векторы документации и базы знаний, модель — при старте, чтобы первый вопрос не ждал.\"\"\"\n    try:\n        logger.info(\"Индекс документации: %s\", await rag.ensure_index())\n        logger.info(\"База знаний поддержки: %s\", await support.ensure_index())\n        await llm.load()\n        logger.info(\"Модель %s загружена в память\", config.MODEL)\n    except Exception as exc:\n        logger.warning(\"Подготовка не завершена: %s\", exc)\n\n\n@asynccontextmanager\nasync def lifespan(app):\n    # у смонтированных приложений MCP свой lifespan не запускается — менеджеры сессий поднимаем здесь\n    async with git_mcp.server.session_manager.run(), crm_mcp.server.session_manager.run(), \\\n            files_mcp.server.session_manager.run():\n        task = asyncio.create_task(warm_up())\n        yield\n        task.cancel()\n\n\napp = FastAPI(title=\"Ассистент разработчика и поддержки\", lifespan=lifespan)\n\n\n@app.exception_handler(RequestValidationError)\nasync def validation_exception_handler(request: Request, exc: RequestValidationError):\n    \"\"\"Преобразует ошибки валидации FastAPI в 400 с русским текстом.\"\"\"\n    errors = exc.errors()\n    detail = \"Ошибка валидации\"\n\n    for error in errors:\n        loc = error.get(\"loc\", [])\n        # body > text | body > question | body > goal\n        if len(loc) >= 2 and loc[0] == \"body\":\n            field = loc[1]\n            if field == \"text\":\n                detail = \"Поле text требуется и должно быть строкой\"\n            elif field == \"question\":\n                detail = \"Поле question требуется и должно быть строкой\"\n            elif field == \"goal\":\n                detail = \"Поле goal требуется и должно быть строкой\"\n            break\n\n    return JSONResponse(status_code=400, content={\"detail\": detail})\n\n\napp.mount(\"/mcp/git\", git_mcp.server.streamable_http_app(streamable_http_path=\"/\"))\napp.mount(\"/mcp/crm\", crm_mcp.server.streamable_http_app(streamable_http_path=\"/\"))\napp.mount(\"/mcp/files\", files_mcp.server.streamable_http_app(streamable_http_path=\"/\"))\n\n\nclass Command(BaseModel):\n    text: str\n\n\nclass Question(BaseModel):\n    question: str\n    ticket_id: str | None = None\n\n\nclass Task(BaseModel):\n    goal: str\n\n\n@app.get(\"/\", include_in_schema=False)\nasync def page():\n    return FileResponse(PAGE)\n\n\n@app.get(\"/support\", include_in_schema=False)\nasync def support_page():\n    return FileResponse(SUPPORT_PAGE)\n\n\n@app.get(\"/files\", include_in_schema=False)\nasync def files_page():\n    return FileResponse(FILES_PAGE)\n\n\n@app.get(\"/api/status\")\nasync def status():\n    ollama, project = await asyncio.gather(llm.status(), assistant.project())\n    return {\"project\": {**project, \"path\": str(config.PROJECT_DIR)}, \"ollama\": ollama,\n            \"model\": config.MODEL, \"embed_model\": config.EMBED_MODEL, \"docs\": rag.info()}\n\n\n@app.post(\"/api/help\")\nasync def help_command(command: Command):\n    question = assistant.parse(command.text)\n    if question is None:\n        raise HTTPException(status_code=400, detail=\"Команда ассистента: /help <вопрос о проекте>\")\n\n    async def stream():\n        async for event in assistant.answer(question):\n            yield assistant.dumps(event)\n\n    return StreamingResponse(stream(), media_type=\"application/x-ndjson\")\n\n\n@app.get(\"/api/support/status\")\nasync def support_status():\n    ollama, crm = await asyncio.gather(llm.status(), support.queue())\n    return {\"ollama\": ollama, \"model\": config.MODEL, \"embed_model\": config.EMBED_MODEL,\n            \"kb\": support.index.info(), \"crm\": crm}\n\n\n@app.post(\"/api/support/answer\")\nasync def support_answer(body: Question):\n    question = body.question.strip()\n    if not question:\n        raise HTTPException(status_code=400, detail=\"Напишите вопрос клиента\")\n\n    async def stream():\n        async for event in support.answer(body.ticket_id, question):\n            yield assistant.dumps(event)\n\n    return StreamingResponse(stream(), media_type=\"application/x-ndjson\")\n\n\n@app.post(\"/api/files/run\")\nasync def files_run(task: Task):\n    goal = task.goal.strip()\n    if not goal:\n        raise HTTPException(status_code=400, detail=\"Напишите задачу: что найти, обновить или создать\")\n\n    async def stream():\n        async for event in files.run(goal):\n            yield assistant.dumps(event)\n\n    return StreamingResponse(stream(), media_type=\"application/x-ndjson\")\n\n\n@app.post(\"/api/files/apply\")\nasync def files_apply():\n    return await files.apply()\n\n\n@app.post(\"/api/files/discard\")\nasync def files_discard():\n    return await files.discard()\n\n\nif __name__ == \"__main__\":\n    uvicorn.run(app, host=config.HOST, port=config.PORT)\n","numLines":167,"startLine":1,"totalLines":167}},"tool_result_meta":[{"id":"toolu_7506d94a69e844d5952fd78d","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
