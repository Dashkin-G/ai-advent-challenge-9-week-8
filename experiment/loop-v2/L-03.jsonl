а русском')\n\n# Тест 4: пробелы → ToolError\ntry:\n    find_tickets('   ')\n    assert False, 'Не вызвана ToolError'\nexcept ToolError as e:\n    assert str(e) == 'Введите текст поиска'\nprint('Тест 4 пройден: пробелы → ToolError')\n\n# Тест 5: инструмент виден в list_tools()\ntools = server.list_tools()\ntool_names = [t['name'] for t in tools]\nassert 'find_tickets' in tool_names, f'find_tickets нет в {tool_names}'\nprint('Тест 5 пройден: find_tickets виден в list_tools()')\n\nprint('Все тесты пройдены!')\n\"","description":"Test find_tickets function"}}],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":0,"requested":{"background":0,"foreground":0,"unset":0},"started_in_background":0,"max_depth":0,"spawned_by_subagents":0,"completed":0,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{}},"safety_stops":0,"is_error":false,"num_turns":15,"subtype":"success","api_error_status":null,"result":"**L-03**, профиль «фича»: добавлен инструмент `find_tickets` в CRM MCP-сервер, все проверки пройдены, закоммичено.","ttft_ms":3203,"type":"result","duration_ms":63384,"uuid":"6024e8c3-cba3-4ecf-9cbe-0d48aaaebd2e","ttft_stream_ms":2930,"time_to_request_ms":146,"first_content_frame_ms":2930,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"qwen3.5-122b-a10b":{"inputTokens":283273,"outputTokens":3971,"cacheReadInputTokens":0,"cacheCreationInputTokens":0,"webSearchRequests":0,"costUSD":1.5156399999999999,"contextWindow":200000,"maxOutputTokens":32000,"thinkingTokens":0,"canonicalModel":"qwen3.5-122b-a10b","provider":"firstParty","costBasis":"unknown"}}}
