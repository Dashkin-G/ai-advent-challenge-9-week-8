\"org\", \"\")).lower()\n        )\n        if query_norm in text:\n            found.append({\n                **{k: t[k] for k in (\"id\", \"subject\", \"message\", \"status\", \"priority\", \"created\")},\n                \"user\": {k: user[k] for k in (\"id\", \"name\", \"org\")}\n            })\n    found.sort(key=lambda t: t[\"created\"], reverse=True)\n    return {\"count\": len(found), \"tickets\": found}\n\n\n@server.tool()\ndef get_user(user_id: Annotated[str, Field(description=\"Номер клиента, например U-01\")]) -> dict[str, Any]:\n    \"\"\"Клиент: вуз, роль, как работает с сервисом, заметки поддержки и все его обращения с решениями.\"\"\"\n    crm = load()\n    user = find(crm[\"users\"], user_id, \"Клиента\")\n    tickets = [{k: t[k] for k in (\"id\", \"subject\", \"status\", \"created\", \"resolution\") if k in t}\n               for t in crm[\"tickets\"] if t[\"user_id\"] == user[\"id\"]]\n    return {**user, \"tickets\": tickets}","originalFile":"\"\"\"MCP-сервер CRM поддержки: клиенты сервиса и их обращения из JSON-файла. Только чтение.\"\"\"\nimport json\nfrom typing import Annotated, Any\n\nfrom mcp.server.mcpserver import MCPServer\nfrom mcp.server.mcpserver.exceptions import ToolError\nfrom pydantic import Field\n\nfrom app import config\n\nserver = MCPServer(\n    name=\"crm\",\n    version=\"1.0.0\",\n    instructions=\"CRM поддержки сервиса «Риск отчисления студентов»: клиенты — сотрудники вузов — и их обращения \"\n                 \"с техническими данными: запрос, ответ сервиса, лог. Инструменты только читают, ничего не меняют.\",\n)\n\nCLOSED = {\"решён\"}\n\n\ndef load():\n    # файл читается на каждый вызов: правки CRM видны без перезапуска\n    return json.loads(config.CRM_FILE.read_text(encoding=\"utf-8\"))\n\n\ndef find(items, item_id, what):\n    \"\"\"Поиск по ID; возвращает элемент или ToolError с нормализованным номером.\"\"\"\n    item_id_norm = item_id.strip().upper()\n    for item in items:\n        if item[\"id\"] == item_id_norm:\n            return item\n    raise ToolError(f\"{what} {item_id_norm} нет в CRM\")\n\n\n@server.tool()\ndef list_tickets(\n    include_closed: Annotated[bool, Field(description=\"Показать и решённые обращения\")] = False,\n) -> dict[str, Any]:\n    \"\"\"Очередь обращений, новые сверху: номер, тема, сообщение клиента, статус, приоритет, дата и клиент.\"\"\"\n    crm = load()\n    users = {u[\"id\"]: u for u in crm[\"users\"]}\n    tickets = [{**{k: t[k] for k in (\"id\", \"subject\", \"message\", \"status\", \"priority\", \"created\")},\n                \"user\": {k: users[t[\"user_id\"]][k] for k in (\"id\", \"name\", \"org\")}}\n               for t in crm[\"tickets\"] if include_closed or t[\"status\"] not in CLOSED]\n    tickets.sort(key=lambda t: t[\"created\"], reverse=True)\n    return {\"count\": len(tickets), \"tickets\": tickets}\n\n\n@server.tool()\ndef get_ticket(ticket_id: Annotated[str, Field(description=\"Номер обращения, например T-1041\")]) -> dict[str, Any]:\n    \"\"\"Обращение целиком: сообщение клиента, статус, приоритет и технические данные — запрос, ответ сервиса, лог.\"\"\"\n    return find(load()[\"tickets\"], ticket_id, \"Обращения\")\n\n\n@server.tool()\ndef get_user(user_id: Annotated[str, Field(description=\"Номер клиента, например U-01\")]) -> dict[str, Any]:\n    \"\"\"Клиент: вуз, роль, как работает с сервисом, заметки поддержки и все его обращения с решениями.\"\"\"\n    crm = load()\n    user = find(crm[\"users\"], user_id, \"Клиента\")\n    tickets = [{k: t[k] for k in (\"id\", \"subject\", \"status\", \"created\", \"resolution\") if k in t}\n               for t in crm[\"tickets\"] if t[\"user_id\"] == user[\"id\"]]\n    return {**user, \"tickets\": tickets}\n","structuredPatch":[{"oldStart":53,"oldLines":6,"newStart":53,"newLines":36,"lines":[" "," "," @server.tool()","+def find_tickets(","+    query: Annotated[str, Field(description=\"Текст поиска: номер, тема, сообщение, имя клиента или вуз\")] = \"\",","+) -> dict[str, Any]:","+    \"\"\"Ищет обращения без учёта регистра по номеру, теме, сообщению, имени клиента и вузу; новые сверху.\"\"\"","+    query_norm = query.strip().lower()","+    if not query_norm:","+        raise ToolError(\"Введите текст поиска\")","+","+    crm = load()","+    users = {u[\"id\"]: u for u in crm[\"users\"]}","+    found = []","+    for t in crm[\"tickets\"]:","+        user = users.get(t[\"user_id\"], {})","+        text = (","+            str(t[\"id\"]).lower() + \" \" +","+            str(t.get(\"subject\", \"\")).lower() + \" \" +","+            str(t.get(\"message\", \"\")).lower() + \" \" +","+            str(user.get(\"name\", \"\")).lower() + \" \" +","+            str(user.get(\"org\", \"\")).lower()","+        )","+        if query_norm in text:","+            found.append({","+                **{k: t[k] for k in (\"id\", \"subject\", \"message\", \"status\", \"priority\", \"created\")},","+                \"user\": {k: user[k] for k in (\"id\", \"name\", \"org\")}","+            })","+    found.sort(key=lambda t: t[\"created\"], reverse=True)","+    return {\"count\": len(found), \"tickets\": found}","+","+","+@server.tool()"," def get_user(user_id: Annotated[str, Field(description=\"Номер клиента, например U-01\")]) -> dict[str, Any]:","     \"\"\"Клиент: вуз, роль, как работает с сервисом, заметки поддержки и все его обращения с решениями.\"\"\"","     crm = load()"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_489c97108cd041ad908ed2b2","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
