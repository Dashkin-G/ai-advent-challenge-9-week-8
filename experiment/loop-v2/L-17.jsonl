\"role\": \"разработчик\", \"org\": \"Компания X\",\n39\t                \"channel\": \"API\", \"setup\": \"Docker\", \"notes\": \"\", \"tickets\": []}\n40\t        result = support.context_text(ticket, user)\n41\t        expected = (\"Клиент: Иван — разработчик, Компания X. Работает с сервисом через API: Docker.\\n\"\n42\t                    \"Обращение T-1041 «Ошибка» — new, приоритет high, 2026-10-21.\\n\"\n43\t                    \"Сообщение клиента: Не работает\")\n44\t        self.assertEqual(result, expected)\n45\t\n46\t    def test_context_with_notes(self):\n47\t        \"\"\"Заметки поддержки включаются в контекст.\"\"\"\n48\t        ticket = {\"id\": \"T-1\", \"subject\": \"Q\", \"status\": \"new\", \"priority\": \"low\",\n49\t                  \"created\": \"2026-01-01\", \"message\": \"M\", \"technical\": {}}\n50\t        user = {\"name\": \"Анна\", \"role\": \"аналитик\", \"org\": \"Org Y\",\n51\t                \"channel\": \"дашборд\", \"setup\": \"браузер\", \"notes\": \"Важный клиент\", \"tickets\": []}\n52\t        result = support.context_text(ticket, user)\n53\t        self.assertIn(\"Заметки поддержки: Важный клиент\", result)\n54\t\n55\t    def test_context_with_past_tickets(self):\n56\t        \"\"\"Прошлые обращения перечисляются с результатами.\"\"\"\n57\t        ticket = {\"id\": \"T-2\", \"subject\": \"Новое\", \"status\": \"open\", \"priority\": \"medium\",\n58\t                  \"created\": \"2026-10-22\", \"message\": \"Msg\", \"technical\": {}}\n59\t        user = {\"name\": \"Петр\", \"role\": \"user\", \"org\": \"Org\",\n60\t                \"channel\": \"API\", \"setup\": \"curl\", \"notes\": \"\", \"tickets\": [\n61\t                    {\"id\": \"T-1\", \"subject\": \"Старое\", \"status\": \"closed\", \"resolution\": \"fixed\"}\n62\t                ]}\n63\t        result = support.context_text(ticket, user)\n64\t        self.assertIn(\"Прошлые обращения: T-1 «Старое» — closed: fixed\", result)\n65\t\n66\t\n67\tclass SupportMessagesTest(unittest.TestCase):\n68\t    \"\"\"Функция messages формирует промпт для LLM.\"\"\"\n69\t\n70\t    def test_messages_structure(self):\n71\t        \"\"\"Промпт содержит системную роль, данные CRM, фрагменты и вопрос.\"\"\"\n72\t        hits = [{\"file\": \"README.md\", \"title\": \"Запуск\", \"text\": \"# Запуск\\nКоманда uvicorn\"}]\n73\t        result = support.messages(\"Как запустить?\", \"Контекст\", hits)\n74\t        self.assertEqual(len(result), 2)\n75\t        self.assertEqual(result[0][\"role\"], \"system\")\n76\t        self.assertEqual(result[1][\"role\"], \"user\")\n77\t\n78\t    def test_messages_fragments(self):\n79\t        \"\"\"Фрагменты форматированы как [файл › заголовок] текст.\"\"\"\n80\t        hits = [{\"file\": \"docs/guide.md\", \"title\": \"API\", \"text\": \"Эндпоинт /api\"}]\n81\t        messages = support.messages(\"Вопрос\", None, hits)\n82\t        user_content = messages[1][\"content\"]\n83\t        self.assertIn(\"[docs/guide.md › API]\", user_content)\n84\t        self.assertIn(\"Эндпоинт /api\", user_content)\n85\t\n86\t    def test_messages_no_ticket(self):\n87\t        \"\"\"Без обращения используется заглушка NO_TICKET.\"\"\"\n88\t        result = support.messages(\"Вопрос\", None, [])\n89\t        self.assertIn(\"Обращения нет:\", result[1][\"content\"])\n90\t\n91\t\n92\tif __name__ == \"__main__\":\n93\t    unittest.main()\n94\t"}]},"parent_tool_use_id":null,"session_id":"fffbca5d-a4c3-4efa-bc6d-5681b14577e3","uuid":"ab22c619-27ac-4f7a-b0c2-3ba93475a0ab","timestamp":"2026-10-24T23:55:55.712Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\USER\\AppData\\Local\\Temp\\claude-rules\\loop-v2\\tests\\test_support.py","content":"\"\"\"Тесты app/support.py: формирование запросов к базе знаний и промпта для ответа поддержки.\"\"\"\nimport unittest\n\nfrom app import support\n\n\nclass SupportQueriesTest(unittest.TestCase):\n    \"\"\"Функция queries формирует запросы для поиска в базе знаний.\"\"\"\n\n    def test_queries_with_errors(self):\n        \"\"\"Запросы включают вопрос клиента и тексты ошибок из технических данных.\"\"\"\n        ticket = {\"technical\": {\"body\": {\"error\": \"валидация\", \"details\": \"body: ошибка\"}}}\n        result = support.queries(\"Почему 422?\", ticket)\n        self.assertEqual(result, [\"Почему 422?\", \"body: ошибка\"])\n\n    def test_queries_without_errors(self):\n        \"\"\"Без технических данных — только вопрос клиента.\"\"\"\n        result = support.queries(\"Как работает дашборд?\", None)\n        self.assertEqual(result, [\"Как работает дашборд?\"])\n\n    def test_queries_deduplication(self):\n        \"\"\"Повторяющиеся ошибки идут один раз.\"\"\"\n        ticket = {\"technical\": {\n            \"body\": {\"details\": \"ошибка\"},\n            \"query\": {\"details\": \"ошибка\"}\n        }}\n        result = support.queries(\"Вопрос\", ticket)\n        self.assertEqual(result, [\"Вопрос\", \"ошибка\"])\n\n\nclass SupportContextTextTest(unittest.TestCase):\n    \"\"\"Функция context_text формирует текст обращения для промпта.\"\"\"\n\n    def test_context_basic(self):\n        \"\"\"Базовый контекст с клиентом и обращением.\"\"\"\n        ticket = {\"id\": \"T-1041\", \"subject\": \"Ошибка\", \"status\": \"new\", \"priority\": \"high\",\n                  \"created\": \"2026-10-21\", \"message\": \"Не работает\", \"technical\": {}}\n        user = {\"name\": \"Иван\", \"role\": \"разработчик\", \"org\": \"Компания X\",\n                \"channel\": \"API\", \"setup\": \"Docker\", \"notes\": \"\", \"tickets\": []}\n        result = support.context_text(ticket, user)\n        expected = (\"Клиент: Иван — разработчик, Компания X. Работает с сервисом через API: Docker.\\n\"\n                    \"Обращение T-1041 «Ошибка» — new, приоритет high, 2026-10-21.\\n\"\n                    \"Сообщение клиента: Не работает\")\n        self.assertEqual(result, expected)\n\n    def test_context_with_notes(self):\n        \"\"\"Заметки поддержки включаются в контекст.\"\"\"\n        ticket = {\"id\": \"T-1\", \"subject\": \"Q\", \"status\": \"new\", \"priority\": \"low\",\n                  \"created\": \"2026-01-01\", \"message\": \"M\", \"technical\": {}}\n        user = {\"name\": \"Анна\", \"role\": \"аналитик\", \"org\": \"Org Y\",\n                \"channel\": \"дашборд\", \"setup\": \"браузер\", \"notes\": \"Важный клиент\", \"tickets\": []}\n        result = support.context_text(ticket, user)\n        self.assertIn(\"Заметки поддержки: Важный клиент\", result)\n\n    def test_context_with_past_tickets(self):\n        \"\"\"Прошлые обращения перечисляются с результатами.\"\"\"\n        ticket = {\"id\": \"T-2\", \"subject\": \"Новое\", \"status\": \"open\", \"priority\": \"medium\",\n                  \"created\": \"2026-10-22\", \"message\": \"Msg\", \"technical\": {}}\n        user = {\"name\": \"Петр\", \"role\": \"user\", \"org\": \"Org\",\n                \"channel\": \"API\", \"setup\": \"curl\", \"notes\": \"\", \"tickets\": [\n                    {\"id\": \"T-1\", \"subject\": \"Старое\", \"status\": \"closed\", \"resolution\": \"fixed\"}\n                ]}\n        result = support.context_text(ticket, user)\n        self.assertIn(\"Прошлые обращения: T-1 «Старое» — closed: fixed\", result)\n\n\nclass SupportMessagesTest(unittest.TestCase):\n    \"\"\"Функция messages формирует промпт для LLM.\"\"\"\n\n    def test_messages_structure(self):\n        \"\"\"Промпт содержит системную роль, данные CRM, фрагменты и вопрос.\"\"\"\n        hits = [{\"file\": \"README.md\", \"title\": \"Запуск\", \"text\": \"# Запуск\\nКоманда uvicorn\"}]\n        result = support.messages(\"Как запустить?\", \"Контекст\", hits)\n        self.assertEqual(len(result), 2)\n        self.assertEqual(result[0][\"role\"], \"system\")\n        self.assertEqual(result[1][\"role\"], \"user\")\n\n    def test_messages_fragments(self):\n        \"\"\"Фрагменты форматированы как [файл › заголовок] текст.\"\"\"\n