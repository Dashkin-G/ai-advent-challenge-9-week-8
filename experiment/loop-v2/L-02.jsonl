{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_d8d497cd3c7e43178570ae81","type":"tool_result","content":"1\t\"\"\"Ревью pull request: изменения — через MCP-сервер git, контекст — RAG по коду и документации основной\n2\tветки, текст — локальная модель в роли двух ревьюеров: кода и архитектуры.\n3\tЗапуск: python -m app.review --base main --head feature/x.\"\"\"\n4\timport argparse\n5\timport ast\n6\timport asyncio\n7\timport fnmatch\n8\timport json\n9\timport logging\n10\timport os\n11\timport re\n12\timport sys\n13\timport time\n14\tfrom itertools import zip_longest\n15\tfrom pathlib import Path\n16\t\n17\tfrom mcp import Client\n18\t\n19\tfrom app import config, git_mcp, llm, rag\n20\tfrom app.assistant import reason\n21\t\n22\tMAX_DIFF = 600  # строк diff в промпт: больше локальная модель читает минутами\n23\tQUERY = 1200  # знаков добавленных строк файла в поисковый запрос\n24\tTOP_DOCS, TOP_CODE = 3, 4  # разделов документации и фрагментов кода в промпт\n25\tSECTION = 1800  # раздел документации длиннее — в промпт идёт только найденный фрагмент\n26\t# промпт ревью в 4 раза длиннее, чем у /help; seed — один и тот же PR получает одно и то же ревью\n27\tOPTIONS = {\"num_ctx\": 12288, \"num_predict\": 1200, \"seed\": 7}\n28\tHUNK = re.compile(r\"^@@ -\\d+(?:,\\d+)? \\+(\\d+)(?:,\\d+)? @@ ?(.*)\")\n29\t\n30\tCOMMON = \"\"\"Тебе дают список изменённых файлов, {context} из основной ветки и diff: число в начале строки — номер строки в новой версии файла, + — строка добавлена, - — удалена.\n31\tОдна проблема — одно замечание, даже если она видна в нескольких строках. file и line — путь и номер строки из diff; problem — что не так и к чему приведёт, одно-два предложения; fix — как исправить; source — заголовок фрагмента из квадратных скобок, если замечание на него опирается, иначе пустая строка.\n32\tНе выдумывай: нечего сказать — пустой список. Два точных замечания лучше пяти сомнительных.\n33\tПо-русски и коротко. Код — в `обратных кавычках`.\"\"\"\n34\t\n35\tCODE = \"\"\"Ты — опытный ревьюер кода проекта {project}. Ищешь в pull request ошибки.\n36\tПройди по каждой новой или изменённой функции в diff и проверь: что будет при пустом входе, нуле, None, слишком большом входе; где деление, индекс или ключ словаря могут упасть; какое исключение дойдёт до пользователя ошибкой 500; верна ли логика по сравнению с похожим кодом проекта. Прежде чем написать о баге, найди строку, где он случится, и убедись, что проверки там нет — ни в самой функции, ни раньше: в схеме входных данных или в коде, который её вызывает; в problem назови вход, при котором он случится.\n37\tПотом — каких тестов и проверок входных данных не хватает.\n38\tkind: bug — потенциальный баг (что-то упадёт или посчитается неверно), recommendation — рекомендация (тест, проверка, упрощение). summary — одно предложение: что добавляет или меняет pull request.\n39\tАрхитектуру и документацию не оценивай — это делает другой ревьюер.\n40\t\"\"\" + COMMON\n41\t\n42\tARCHITECTURE = \"\"\"Ты — архитектор проекта {project}. Проверяешь, согласуется ли pull request с устройством проекта и его документацией.\n43\tfindings — для каждого изменённого модуля сверь с документацией его импорты и обязанности: не появилась ли зависимость, которой у модуля быть не должно; в том ли модуле код; нет ли дублирования того, что в проекте уже есть.\n44\tdocs — отдельно о документации. По оглавлению найди разделы, которые описывают то, что меняет pull request: API, модули, поведение. Если pull request это меняет, а документация в нём не менялась, в files — файлы этих разделов, в why — какие разделы и что в них теперь не так, в source — заголовок фрагмента, где это видно, или пустая строка. Документация в порядке — files пустой. О документации пиши только в docs.\n45\tОшибки в коде не ищи — это делает другой ревьюер.\n46\t\"\"\" + COMMON\n47\t\n48\tFIELDS = {\"file\": {\"type\": \"string\"}, \"line\": {\"type\": \"integer\"}, \"problem\": {\"type\": \"string\"},\n49\t          \"fix\": {\"type\": \"string\"}, \"source\": {\"type\": \"string\"}}\n50\t\n51\t\n52\tdef findings(top, **extra):\n53\t    \"\"\"JSON Schema списка замечаний: Ollama не даст модели отойти от неё.\"\"\"\n54\t    item = {\"type\": \"object\", \"required\": [*extra, *FIELDS], \"properties\": {**extra, **FIELDS}}\n55\t    return {\"type\": \"array\", \"items\": item, \"maxItems\": top}\n56\t\n57\t\n58\tCODE_SCHEMA = {\"type\": \"object\", \"required\": [\"summary\", \"findings\"], \"properties\": {\n59\t    \"summary\": {\"type\": \"string\"},\n60\t    \"findings\": findings(5, kind={\"type\": \"string\", \"enum\": [\"bug\", \"recommendation\"]})}}\n61\tARCHITECTURE_SCHEMA = {\"type\": \"object\", \"required\": [\"findings\", \"docs\"], \"properties\": {\n62\t    \"findings\": findings(3),\n63\t    \"docs\": {\"type\": \"object\", \"required\": [\"files\", \"why\", \"source\"], \"properties\": {\n64\t        \"files\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}, \"maxItems\": 3},\n65\t        \"why\": {\"type\": \"string\"}, \"source\": {\"type\": \"string\"}}}}}\n66\t\n67\tindex = rag.Index(\"review-embeddings\")  # документация и код основной ветки\n68\t\n69\t\n70\tdef log(text):\n71\t    print(text, file=sys.stderr, flush=True)\n72\t\n73\t\n74\tdef short(ref):\n75\t    return ref[:7] if re.fullmatch(r\"[0-9a-f]{40}\", ref) else ref\n76\t\n77\t\n78\tdef number(x, digits=1):\n79\t    return f\"{x:,.{digits}f}\".replace(\",\", \" \").replace(\".\", \",\")\n80\t\n81\t\n82\tFILES, CHUNKS, TOKENS = (\"файл\", \"файла\", \"файлов\"), (\"фрагмент\", \"фрагмента\", \"фрагментов\"), (\"токен\", \"токена\", \"токенов\")\n83\t\n84\t\n85\tdef count(n, words):\n86\t    \"\"\"«1 файл», «3 файла», «12 файлов».\"\"\"\n87\t    one, few, many = words\n88\t    word = one if n % 10 == 1 and n % 100 != 11 else few if 2 <= n % 10 <= 4 and not 12 <= n % 100 <= 14 else many\n89\t    return f\"{number(n, 0)} {word}\"\n90\t\n91\t\n92\tdef matches(path, patterns):\n93\t    return any(fnmatch.fnmatch(path, p) for p in patterns)\n94\t\n95\t\n96\tasync def collect(base, head):\n97\t    \"\"\"① Изменения PR и файлы основной ветки для RAG — одна сессия с MCP-сервером git в этом же процессе.\"\"\"\n98\t    calls = []\n99\t    async with Client(git_mcp.server) as client:\n100\t        async def call(tool, **args):\n101\t            calls.append(tool)\n102\t            result = await client.call_tool(tool, args)\n103\t            if result.is_error:\n104\t                raise RuntimeError(\"\".join(getattr(part, \"text\", \"\") for part in result.content))\n105\t            return result.structured_content\n106\t\n107\t        pr = await call(\"pr_files\", base=base, head=head)\n108\t        diff = await call(\"pr_diff\", base=base, head=head)\n109\t        listed = await call(\"list_files\", ref=base)\n110\t        wanted = [f for f in listed[\"files\"] if matches(f, config.DOCS + config.CODE)]\n111\t        texts = {f: (await call(\"read_file\", path=f, ref=base))[\"text\"] for f in wanted}\n112\t        # новые версии изменённых файлов кода — ради их импортов: в diff начала файла часто нет\n113\t        heads = {f[\"path\"]: (await call(\"read_file\", path=f[\"path\"], ref=head))[\"text\"] for f in pr[\"files\"]\n114\t                 if f[\"status\"] != \"удалён\" and matches(f[\"path\"], config.CODE)}\n115\t    return pr, diff, texts, heads, calls\n116\t\n117\t\n118\tdef imports(text):\n119\t    \"\"\"Последняя строка начала модуля — описания и импортов; 0 — если файл начинается не с них.\"\"\"\n120\t    try:\n121\t        nodes = ast.parse(text).body\n122\t    except SyntaxError:\n123\t        return 0\n124\t    end = 0\n125\t    for node in nodes:\n126\t        is_doc = isinstance(node, ast.Expr) and isinstance(node.value, ast.Constant)\n127\t        if not (is_doc or isinstance(node, (ast.Import, ast.ImportFrom))):\n128\t            break\n129\t        end = node.end_lineno\n130\t    return end\n131\t\n132\t\n133\tdef parse(diff):\n134\t    \"\"\"Unified diff → {путь: {\"lines\": строки с номерами новой версии, \"added\": добавленные строки,\n135\t    \"numbers\": номера, которые видит модель}}. Содержимое удалённых файлов пропускается.\"\"\"\n136\t    files, current, header, new = {}, None, True, 0\n137\t    for line in diff.splitlines():\n138\t        if line.startswith(\"diff --git \"):\n139\t            current, header = None, True\n140\t        elif header and line.startswith(\"+++ \"):\n141\t            path = line[4:].rstrip(\"\\t\")\n142\t            current = None if path == \"/dev/null\" else files.setdefault(\n143\t                path[2:], {\"lines\": [], \"added\": [], \"numbers\": set()})\n144\t        elif line.startswith(\"@@\") and (hunk := HUNK.match(line)):\n145\t            header, new = False, int(hunk.group(1))\n146\t            if current is not None:\n147\t                current[\"lines\"].append(f\"@@ {hunk.group(2)}\".rstrip())\n148\t        elif header or current is None:\n149\t            continue\n150\t        elif line.startswith((\"+\", \" \")):\n151\t            mark, text = line[0], line[1:]\n152\t            current[\"lines\"].append(f\"{new:>4} {mark} {text}\")\n153\t            current[\"numbers\"].add(new)\n154\t            if mark == \"+\":\n155\t                current[\"added\"].append(text)\n156\t            new += 1\n157\t        elif line.startswith(\"-\"):\n158\t            current[\"lines\"].append(f\"     - {line[1:]}\")\n159\t    return files\n160\t\n161\t\n162\tdef with_imports(parsed, heads):\n163\t    \"\"\"У файла кода, чей diff не начинается с первой строки, в начало — его импорты: без них модель\n164\t    «не видит» импорт и пишет, что его нет.\"\"\"\n165\t    for path, text in heads.items():\n166\t        item = parsed.get(path)\n167\t        if item and item[\"lines\"] and 1 not in item[\"numbers\"] and (end := imports(text)):\n168\t            top = text.splitlines()[:end]\n169\t            item[\"lines\"][:0] = [\"@@ начало файла\"] + [f\"{n:>4}   {line}\" for n, line in enumerate(top, 1)]\n170\t            item[\"numbers\"].update(range(1, end + 1))\n171\t\n172\t\n173\tdef diff_text(files, parsed):\n174\t    \"\"\"Diff для промпта: файл за файлом, пока не кончится запас в MAX_DIFF строк.\"\"\"\n175\t    out, budget = [], MAX_DIFF\n176\t    for f in files:\n177\t        lines = parsed.get(f[\"path\"], {}).get(\"lines\", [])\n178\t        if f[\"status\"] == \"удалён\" or not lines:\n179\t            out.append(f\"### {f['path']} — {f['status'] if f['status'] == 'удалён' else 'без текстовых изменений'}\")\n180\t            continue\n181\t        shown = lines[:budget]\n182\t        out += [f\"### {f['path']}\", *shown]\n183\t        if len(shown) < len(lines):\n184\t            out.append(f\"… ещё {len(lines) - len(shown)} строк diff не поместились\")\n185\t        budget -= len(shown)\n186\t    return \"\\n\".join(out)\n187\t\n188\t\n189\tdef pick(vectors, kind, top):\n190\t    \"\"\"Лучший фрагмент по каждому запросу, потом второй… — без повторов. У документации заголовок\n191\t    фрагмента — раздел, и раздел, разрезанный на части, попадает в промпт целиком.\"\"\"\n192\t    ranked = [index.nearest(vector, top, keep=lambda chunk: chunk[\"kind\"] == kind) for vector in vectors]\n193\t    found = {}\n194\t    for hits in zip_longest(*ranked):\n195\t        for hit in filter(None, hits):\n196\t            if len(found) < top:\n197\t                found.setdefault(rag.source(hit), hit)\n198\t    if kind == \"docs\":\n199\t        for key, hit in found.items():\n200\t            whole = \"\\n\\n\".join(c[\"text\"] for c in index.chunks if c[\"kind\"] == \"docs\" and rag.source(c) == key)\n201\t            if len(whole) <= SECTION:\n202\t                found[key] = {**hit, \"text\": whole}\n203\t    return list(found.values())\n204\t\n205\t\n206\tdef contents():\n207\t    \"\"\"Оглавление документации: файл — его разделы по порядку. С ним ревьюер видит, где что описано,\n208\t    даже если поиск принёс не те разделы.\"\"\"\n209\t    titles = {}\n210\t    for chunk in index.chunks:\n211\t        if chunk[\"kind\"] == \"docs\":\n212\t            titles.setdefault(chunk[\"file\"], {}).setdefault(chunk[\"title\"])\n213\t    return \"\\n\".join(f\"{file}: {' · '.join(found)}\" for file, found in titles.items())\n214\t\n215\t\n216\tdef message(title, pr, hits, diff, what, task, docs=None):\n217\t    \"\"\"Промпт ревьюера; docs — изменённые в PR файлы документации: ревьюеру архитектуры — с оглавлением.\"\"\"\n218\t    listed = \"\\n\".join(f\"- {f['path']} ({f['status']}, +{f['added']} −{f['deleted']})\" for f in pr[\"files\"])\n219\t    note = \"\" if docs is None else (f\"\\nДокументация в pull request: {', '.join(docs) or 'не менялась'}\\n\\n\"\n220\t                                    f\"Оглавление документации проекта:\\n{contents()}\")\n221\t    fragments = \"\\n\\n\".join(f\"[{rag.source(h)}]\\n{h['text']}\" for h in hits) or \"(ничего не нашлось)\"\n222\t    text = (f\"Pull request: {title or '(без заголовка)'}\\n\"\n223\t            f\"Изменённые файлы ({len(pr['files'])}, +{pr['added']} −{pr['deleted']}):\\n{listed}{note}\\n\\n\"\n224\t            f\"{what} из основной ветки:\\n\\n{fragments}\\n\\nDiff:\\n\\n{diff}\\n\\nЗадание: {task}\")\n225\t    # модель цитирует код дословно, а двойная кавычка внутри ответа-JSON закрывает строку, и замечание\n226\t    # обрывается на полуслове; для Python одинарные кавычки — то же самое\n227\t    return text.replace('\"', \"'\")\n228\t\n229\t\n230\tasync def ask(system, user, schema):\n231\t    \"\"\"Один ревьюер: ответ модели строго по JSON Schema и счётчики.\"\"\"\n232\t    answer, counters = \"\", {}\n233\t    prompt = [{\"role\": \"system\", \"content\": system}, {\"role\": \"user\", \"content\": user}]\n234\t    async for event in llm.chat(prompt, options=OPTIONS, schema=schema):\n235\t        if event[\"type\"] == \"text\":\n236\t            answer += event[\"text\"]\n237\t        else:\n238\t            counters = event\n239\t    try:\n240\t        return json.loads(answer), counters\n241\t    except json.JSONDecodeError:\n242\t        raise llm.LLMError(f\"Модель вернула не JSON — ответ оборвался на {count(counters.get('tokens', 0), TOKENS)}?\")\n243\t\n244\t\n245\tdef repeats_docs(finding, stale):\n246\t    \"\"\"Замечание советует дописать документацию, которая уже отмечена устаревшей.\"\"\"\n247\t    return \"документац\" in finding[\"fix\"].lower() or any(s in finding[\"problem\"] + finding[\"fix\"] for s in stale)\n248\t\n249\t\n250\tasync def review(base, head, title=\"\"):\n251\t    \"\"\"① изменения через MCP → ② RAG → ③ ревьюер кода → ④ ревьюер архитектуры. Возвращает Markdown.\"\"\"\n252\t    started = time.perf_counter()\n253\t    pr, diff, texts, heads, calls = await collect(base, head)\n254\t    files = pr[\"files\"]\n255\t    if not files:\n256\t        return f\"### AI-ревью\\n\\nИзменений между `{short(base)}` и `{short(head)}` нет.\\n\"\n257\t    parsed = parse(diff[\"diff\"])\n258\t    tools = \", \".join(dict.fromkeys(f\"{t} ×{calls.count(t)}\" if calls.count(t) > 1 else t for t in calls))\n259\t    log(f\"① изменения — MCP git ({tools}): {count(len(files), FILES)}, +{pr['added']} −{pr['deleted']} · \"\n260\t        f\"{number(time.perf_counter() - started)} с\")\n261\t\n262\t    started = time.perf_counter()\n263\t    await index.build(texts)\n264\t    # на каждый изменённый файл три запроса: что о модуле сказано в документации; какая документация\n265\t    # ближе к новым строкам; какой код проекта ближе к ним (у фрагментов кода в векторе есть путь)\n266\t    changed = [(path, \"\\n\".join(item[\"added\"])[:QUERY]) for path, item in parsed.items() if item[\"added\"]]\n267\t    queries = [q for path, added in changed for q in (f\"Модуль {path}: за что отвечает и о чём знает\", added,\n268\t                                                      f\"{path}\\n{added}\")]\n269\t    vectors = await llm.embed(queries) if queries else []\n270\t    docs = pick([v for i, v in enumerate(vectors) if i % 3 < 2], \"docs\", TOP_DOCS)\n271\t    code = pick(vectors[2::3], \"code\", TOP_CODE)\n272\t    log(f\"② RAG по коду и документации {short(base)}: {count(len(index.chunks), CHUNKS)}, \"\n273\t        f\"новых векторов {index.built['embedded']} · {number(time.perf_counter() - started)} с\")\n274\t    for hit in code + docs:\n275\t        log(f\"   {rag.source(hit)} · {number(hit['score'], 2)}\")\n276\t\n277\t    with_imports(parsed, heads)\n278\t    diff = diff_text(files, parsed)\n279\t    project = config.PROJECT_DIR.name\n280\t    # ревьюеру кода diff документации не нужен — только удлиняет промпт\n281\t    code_diff = diff_text([f for f in files if not matches(f[\"path\"], config.DOCS)], parsed)\n282\t    found, counters = await ask(\n283\t        CODE.format(project=project, context=\"фрагменты кода проекта\"),\n284\t        message(title, pr, code, code_diff, \"Фрагменты кода проекта\", \"найди потенциальные баги и дай рекомендации.\"),\n285\t        CODE_SCHEMA)\n286\t    log(f\"③ ревьюер кода — {config.MODEL}: {spent(counters)}\")\n287\t    flagged, counters2 = await ask(\n288\t        ARCHITECTURE.format(project=project, context=\"разделы документации проекта\"),\n289\t        message(title, pr, docs, diff, \"Разделы документации проекта\",\n290\t                \"найди архитектурные проблемы и проверь, не устарела ли документация.\",\n291\t                [f[\"path\"] for f in files if matches(f[\"path\"], config.DOCS)]),\n292\t        ARCHITECTURE_SCHEMA)\n293\t    log(f\"④ ревьюер архитектуры — {config.MODEL}: {spent(counters2)}\")\n294\t\n295\t    # устаревшая документация — файлы, которые есть в основной ветке и не менялись в PR;\n296\t    # если она нашлась, замечание с советом дописать документацию — повтор\n297\t    stale = [f for f in dict.fromkeys(flagged[\"docs\"][\"files\"]) if f in texts and f not in parsed]\n298\t    architecture = [f for f in flagged[\"findings\"] if not (stale and repeats_docs(f, stale))]\n299\t    if stale:\n300\t        architecture.append({\"file\": stale[0], \"line\": 0,\n301\t                             \"problem\": flagged[\"docs\"][\"why\"] or \"Документация не обновлена под изменения.\",\n302\t                             \"fix\": \"обновить \" + \", \".join(f\"`{f}`\" for f in stale) + \".\",\n303\t                             \"source\": flagged[\"docs\"][\"source\"]})\n304\t    sections = {\"Потенциальные баги\": [f for f in found[\"findings\"] if f[\"kind\"] == \"bug\"],\n305\t                \"Архитектурные проблемы\": architecture,\n306\t                \"Рекомендации\": [f for f in found[\"findings\"] if f[\"kind\"] == \"recommendation\"]}\n307\t    return render(found[\"summary\"], sections, pr, parsed, texts, code + docs, tools, [counters, counters2], base)\n308\t\n309\t\n310\tdef where(item, pr, parsed, texts):\n311\t    \"\"\"Ссылка на место замечания. Номер строки — только если модель видела его в diff;\n312\t    на GitHub — ссылка на файл в коммите PR.\"\"\"\n313\t    path, line = item[\"file\"].strip(\"` \").split(\":\")[0], item[\"line\"]\n314\t    if path not in parsed and path not in texts:\n315\t        return None\n316\t    line = line if line in parsed.get(path, {}).get(\"numbers\", ()) else None\n317\t    label = f\"{path}:{line}\" if line else path\n318\t    repo = os.getenv(\"GITHUB_REPOSITORY\")\n319\t    if not repo:\n320\t        return f\"`{label}`\"\n321\t    url = f\"{os.getenv('GITHUB_SERVER_URL', 'https://github.com')}/{repo}/blob/{pr['head_sha']}/{path}\"\n322\t    return f\"[`{label}`]({url}{f'#L{line}' if line else ''})\"\n323\t\n324\t\n325\tdef spent(counters):\n326\t    return (f\"промпт {count(counters['prompt'], TOKENS)} — {number(counters['reading'])} с, \"\n327\t            f\"ответ {count(counters['tokens'], TOKENS)} — {number(counters['writing'])} с\")\n328\t\n329\t\n330\tdef render(summary, sections, pr, parsed, texts, hits, tools, counters, base):\n331\t    out = [f\"### AI-ревью · {config.MODEL}\", \"\", f\"**Что делает PR.** {summary}\"]\n332\t    sources = [rag.source(h) for h in hits]\n333\t    for title, items in sections.items():\n334\t        out += [\"\", f\"#### {title}\", \"\"]\n335\t        if not items:\n336\t            out.append(\"Не найдено.\")\n337\t        for n, item in enumerate(items, 1):\n338\t            place = where(item, pr, parsed, texts)\n339\t            # основание — только «файл › раздел» из фрагментов, которые модель правда видела в промпте\n340\t            source = item[\"source\"].strip(\"[]` \")\n341\t            seen = \"›\" in source and any(s.startswith(source) or source.startswith(s) for s in sources)\n342\t            out.append(f\"{n}. {place + ' — ' if place else ''}{item['problem']}  \")\n343\t            out.append(f\"   **Исправить:** {item['fix']}\" + (f\"  \\n   *Основание: {source}*\" if seen else \"\"))\n344\t    fragments = \" · \".join(f\"`{rag.source(h)}` {number(h['score'], 2)}\" for h in hits)\n345\t    model = \"; \".join(f\"{who} — {spent(c)}\" for who, c in zip((\"ревьюер кода\", \"ревьюер архитектуры\"), counters))\n346\t    out += [\"\", \"<details><summary>Как получено ревью</summary>\", \"\",\n347\t            f\"- **Изменения** — MCP-сервер git ({tools}): {count(len(pr['files']), FILES)}, \"\n348\t            f\"+{pr['added']} −{pr['deleted']}.\",\n349\t            f\"- **Контекст** — RAG по коду и документации `{short(base)}`: {count(len(index.chunks), CHUNKS)}, \"\n350\t            f\"в промпт — {len(hits)}: {fragments}.\",\n351\t            f\"- **Модель** — {config.MODEL} в Ollama: {model}.\",\n352\t            \"\", \"</details>\"]\n353\t    return \"\\n\".join(out) + \"\\n\"\n354\t\n355\t\n356\tdef main():\n357\t    parser = argparse.ArgumentParser(description=\"Ревью pull request локальной моделью\")\n358\t    parser.add_argument(\"--repo\", default=str(config.PROJECT_DIR), help=\"папка git-репозитория проекта\")\n359\t    parser.add_argument(\"--base\", default=\"main\", help=\"ветка или коммит, куда вливается PR\")\n360\t    parser.add_argument(\"--head\", default=\"HEAD\", help=\"ветка или коммит с изменениями\")\n361\t    parser.add_argument(\"--title\", default=\"\", help=\"заголовок PR\")\n362\t    parser.add_argument(\"--out\", help=\"файл для ревью в Markdown; без него — на экран\")\n363\t    args = parser.parse_args()\n364\t    config.PROJECT_DIR = Path(args.repo).resolve()\n365\t    logging.getLogger(\"httpx2\").setLevel(logging.WARNING)  # MCP SDK включает INFO — без строк о каждом запросе\n366\t    try:\n367\t        text = asyncio.run(review(args.base, args.head, args.title))\n368\t    except Exception as exc:  # причина словами — её видно в логе задания\n369\t        log(f\"Ревью не получилось: {reason(exc)}\")\n370\t        sys.exit(1)\n371\t    if args.out:\n372\t        Path(args.out).write_text(text, encoding=\"utf-8\")\n373\t    else:\n374\t        sys.stdout.write(text)\n375\t\n376\t\n377\tif __name__ == \"__main__\":\n378\t    main()\n379\t"}]},"parent_tool_use_id":null,"session_id":"c3948310-f5c5-4c14-84fa-341a6519e6f6","uuid":"9a0afd2a-23e0-4243-80e8-1bade8dc6a3a","timestamp":"2026-10-24T23:22:33.043Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\USER\\AppData\\Local\\Temp\\claude-rules\\loop-v2\\app\\review.py","content":"\"\"\"Ревью pull request: изменения — через MCP-сервер git, контекст — RAG по коду и документации основной\nветки, текст — локальная модель в роли двух ревьюеров: кода и архитектуры.\nЗапуск: python -m app.review --base main --head feature/x.\"\"\"\nimport argparse\nimport ast\nimport asyncio\nimport fnmatch\nimport json\nimport logging\nimport os\nimport re\nimport sys\nimport time\nfrom itertools import zip_longest\nfrom pathlib import Path\n\nfrom mcp import Client\n\nfrom app import config, git_mcp, llm, rag\nfrom app.assistant import reason\n\nMAX_DIFF = 600  # строк diff в промпт: больше локальная модель читает минутами\nQUERY = 1200  # знаков добавленных строк файла в поисковый запрос\nTOP_DOCS, TOP_CODE = 3, 4  # разделов документации и фрагментов кода в промпт\nSECTION = 1800  # раздел документации длиннее — в промпт идёт только найденный фрагмент\n# промпт ревью в 4 раза длиннее, чем у /help; seed — один и тот же PR получает одно и то же ревью\nOPTIONS = {\"num_ctx\": 12288, \"num_predict\": 1200, \"seed\": 7}\nHUNK = re.compile(r\"^@@ -\\d+(?:,\\d+)? \\+(\\d+)(?:,\\d+)? @@ ?(.*)\")\n\nCOMMON = \"\"\"Тебе дают список изменённых файлов, {context} из основной ветки и diff: число в начале строки — номер строки в новой версии файла, + — строка добавлена, - — удалена.\nОдна проблема — одно замечание, даже если она видна в нескольких строках. file и line — путь и номер строки из diff; problem — что не так и к чему приведёт, одно-два предложения; fix — как исправить; source — заголовок фрагмента из квадратных скобок, если замечание на него опирается, иначе пустая строка.\nНе выдумывай: нечего сказать — пустой список. Два точных замечания лучше пяти сомнительных.\nПо-русски и коротко. Код — в `обратных кавычках`.\"\"\"\n\nCODE = \"\"\"Ты — опытный ревьюер кода проекта {project}. Ищешь в pull request ошибки.\nПройди по каждой новой или изменённой функции в diff и проверь: что будет при пустом входе, нуле, None, слишком большом входе; где деление, индекс или ключ словаря могут упасть; какое исключение дойдёт до пользователя ошибкой 500; верна ли логика по сравнению с похожим кодом проекта. Прежде чем написать о баге, найди строку, где он случится, и убедись, что проверки там нет — ни в самой функции, ни раньше: в схеме входных данных или в коде, который её вызывает; в problem назови вход, при котором он случится.\nПотом — каких тестов и проверок входных данных не хватает.\nkind: bug — потенциальный баг (что-то упадёт или посчитается неверно), recommendation — рекомендация (тест, проверка, упрощение). summary — одно предложение: что добавляет или меняет pull request.\nАрхитектуру и документацию не оценивай — это делает другой ревьюер.\n\"\"\" + COMMON\n\nARCHITECTURE = \"\"\"Ты — архитектор проекта {project}. Проверяешь, согласуется ли pull request с устройством проекта и его документацией.\nfindings — для каждого изменённого модуля сверь с документацией его импорты и обязанности: не появилась ли зависимость, которой у модуля быть не должно; в том ли модуле код; нет ли дублирования того, что в проекте уже есть.\ndocs — отдельно о документации. По оглавлению найди разделы, которые описывают то, что меняет pull request: API, модули, поведение. Если pull request это меняет, а документация в нём не менялась, в files — файлы этих разделов, в why — какие разделы и что в них теперь не так, в source — заголовок фрагмента, где это видно, или пустая строка. Документация в порядке — files пустой. О документации пиши только в docs.\nОшибки в коде не ищи — это делает другой ревьюер.\n\"\"\" + COMMON\n\nFIELDS = {\"file\": {\"type\": \"string\"}, \"line\": {\"type\": \"integer\"}, \"problem\": {\"type\": \"string\"},\n          \"fix\": {\"type\": \"string\"}, \"source\": {\"type\": \"string\"}}\n\n\ndef findings(top, **extra):\n    \"\"\"JSON Schema списка замечаний: Ollama не даст модели отойти от неё.\"\"\"\n    item = {\"type\": \"object\", \"required\": [*extra, *FIELDS], \"properties\": {**extra, **FIELDS}}\n    return {\"type\": \"array\", \"items\": item, \"maxItems\": top}\n\n\nCODE_SCHEMA = {\"type\": \"object\", \"required\": [\"summary\", \"findings\"], \"properties\": {\n    \"summary\": {\"type\": \"string\"},\n    \"findings\": findings(5, kind={\"type\": \"string\", \"enum\": [\"bug\", \"recommendation\"]})}}\nARCHITECTURE_SCHEMA = {\"type\": \"object\", \"required\": [\"findings\", \"docs\"], \"properties\": {\n    \"findings\": findings(3),\n    \"docs\": {\"type\": \"object\", \"required\": [\"files\", \"why\", \"source\"], \"properties\": {\n        \"files\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}, \"maxItems\": 3},\n        \"why\": {\"type\": \"string\"}, \"source\": {\"type\": \"string\"}}}}}\n\nindex = rag.Index(\"review-embeddings\")  # документация и код основной ветки\n\n\ndef log(text):\n    print(text, file=sys.stderr, flush=True)\n\n\ndef short(ref):\n    return ref[:7] if re.fullmatch(r\"[0-9a-f]{40}\", ref) else ref\n\n\ndef number(x, digits=1):\n    return f\"{x:,.{digits}f}\".replace(\",\", \" \").replace(\".\", \",\")\n\n\nFILES, CHUNKS, TOKENS = (\"файл\", \"файла\", \"файлов\"), (\"фрагмент\", \"фрагмента\", \"фрагментов\"), (\"токен\", \"токена\", \"токенов\")\n\n\ndef count(n, words):\n    \"\"\"«1 файл», «3 файла», «12 файлов».\"\"\"\n    one, few, many = words\n    word = one if n % 10 == 1 and n % 100 != 11 else few if 2 <= n % 10 <= 4 and not 12 <= n % 100 <= 14 else many\n    return f\"{number(n, 0)} {word}\"\n\n\ndef matches(path, patterns):\n    return any(fnmatch.fnmatch(path, p) for p in patterns)\n\n\nasync def collect(base, head):\n    \"\"\"① Изменения PR и файлы основной ветки для RAG — одна сессия с MCP-сервером git в этом же процессе.\"\"\"\n    calls = []\n    async with Client(git_mcp.server) as client:\n        async def call(tool, **args):\n            calls.append(tool)\n            result = await client.call_tool(tool, args)\n            if result.is_error:\n                raise RuntimeError(\"\".join(getattr(part, \"text\", \"\") for part in result.content))\n            return result.structured_content\n\n        pr = await call(\"pr_files\", base=base, head=head)\n        diff = await call(\"pr_diff\", base=base, head=head)\n        listed = await call(\"list_files\", ref=base)\n        wanted = [f for f in listed[\"files\"] if matches(f, config.DOCS + config.CODE)]\n        texts = {f: (await call(\"read_file\", path=f, ref=base))[\"text\"] for f in wanted}\n        # новые версии изменённых файлов кода — ради их импортов: в diff начала файла часто нет\n        heads = {f[\"path\"]: (await call(\"read_file\", path=f[\"path\"], ref=head))[\"text\"] for f in pr[\"files\"]\n                 if f[\"status\"] != \"удалён\" and matches(f[\"path\"], config.CODE)}\n    return pr, diff, texts, heads, calls\n\n\ndef imports(text):\n    \"\"\"Последняя строка начала модуля — описания и импортов; 0 — если файл начинается не с них.\"\"\"\n    try:\n        nodes = ast.parse(text).body\n    except SyntaxError:\n        return 0\n    end = 0\n    for node in nodes:\n        is_doc = isinstance(node, ast.Expr) and isinstance(node.value, ast.Constant)\n        if not (is_doc or isinstance(node, (ast.Import, ast.ImportFrom))):\n            break\n        end = node.end_lineno\n    return end\n\n\ndef parse(diff):\n    \"\"\"Unified diff → {путь: {\"lines\": строки с номерами новой версии, \"added\": добавленные строки,\n    \"numbers\": номера, которые видит модель}}. Содержимое удалённых файлов пропускается.\"\"\"\n    files, current, header, new = {}, None, True, 0\n    for line in diff.splitlines():\n        if line.startswith(\"diff --git \"):\n            current, header = None, True\n        elif header and line.startswith(\"+++ \"):\n            path = line[4:].rstrip(\"\\t\")\n            current = None if path == \"/dev/null\" else files.setdefault(\n                path[2:], {\"lines\": [], \"added\": [], \"numbers\": set()})\n        elif line.startswith(\"@@\") and (hunk := HUNK.match(line)):\n            header, new = False, int(hunk.group(1))\n            if current is not None:\n                current[\"lines\"].append(f\"@@ {hunk.group(2)}\".rstrip())\n        elif header or current is None:\n            continue\n        elif line.startswith((\"+\", \" \")):\n            mark, text = line[0], line[1:]\n            current[\"lines\"].append(f\"{new:>4} {mark} {text}\")\n            current[\"numbers\"].add(new)\n            if mark == \"+\":\n                current[\"added\"].append(text)\n            new += 1\n        elif line.startswith(\"-\"):\n            current[\"lines\"].append(f\"     - {line[1:]}\")\n    return files\n\n\ndef with_imports(parsed, heads):\n    \"\"\"У файла кода, чей diff не начинается с первой строки, в начало — его импорты: без них модель\n    «не видит» импорт и пишет, что его нет.\"\"\"\n    for path, text in heads.items():\n        item = parsed.get(path)\n        if item and item[\"lines\"] and 1 not in item[\"numbers\"] and (end := imports(text)):\n            top = text.splitlines()[:end]\n            item[\"lines\"][:0] = [\"@@ начало файла\"] + [f\"{n:>4}   {line}\" for n, line in enumerate(top, 1)]\n            item[\"numbers\"].update(range(1, end + 1))\n\n\ndef diff_text(files, parsed):\n    \"\"\"Diff для промпта: файл за файлом, пока не кончится запас в MAX_DIFF строк.\"\"\"\n    out, budget = [], MAX_DIFF\n    for f in files:\n        lines = parsed.get(f[\"path\"], {}).get(\"lines\", [])\n        if f[\"status\"] == \"удалён\" or not lines:\n            out.append(f\"### {f['path']} — {f['status'] if f['status'] == 'удалён' else 'без текстовых изменений'}\")\n            continue\n        shown = lines[:budget]\n        out += [f\"### {f['path']}\", *shown]\n        if len(shown) < len(lines):\n            out.append(f\"… ещё {len(lines) - len(shown)} строк diff не поместились\")\n        budget -= len(shown)\n    return \"\\n\".join(out)\n\n\ndef pick(vectors, kind, top):\n    \"\"\"Лучший фрагмент по каждому запросу, потом второй… — без повторов. У документации заголовок\n    фрагмента — раздел, и раздел, разрезанный на части, попадает в промпт целиком.\"\"\"\n    ranked = [index.nearest(vector, top, keep=lambda chunk: chunk[\"kind\"] == kind) for vector in vectors]\n    found = {}\n    for hits in zip_longest(*ranked):\n        for hit in filter(None, hits):\n            if len(found) < top:\n                found.setdefault(rag.source(hit), hit)\n    if kind == \"docs\":\n        for key, hit in found.items():\n            whole = \"\\n\\n\".join(c[\"text\"] for c in index.chunks if c[\"kind\"] == \"docs\" and rag.source(c) == key)\n            if len(whole) <= SECTION:\n                found[key] = {**hit, \"text\": whole}\n    return list(found.values())\n\n\ndef contents():\n    \"\"\"Оглавление документации: файл — его разделы по порядку. С ним ревьюер видит, где что описано,\n    даже если поиск принёс не те разделы.\"\"\"\n    titles = {}\n    for chunk in index.chunks:\n        if chunk[\"kind\"] == \"docs\":\n            titles.setdefault(chunk[\"file\"], {}).setdefault(chunk[\"title\"])\n    return \"\\n\".join(f\"{file}: {' · '.join(found)}\" for file, found in titles.items())\n\n\ndef message(title, pr, hits, diff, what, task, docs=None):\n    \"\"\"Промпт ревьюера; docs — изменённые в PR файлы документации: ревьюеру архитектуры — с оглавлением.\"\"\"\n    listed = \"\\n\".join(f\"- {f['path']} ({f['status']}, +{f['added']} −{f['deleted']})\" for f in pr[\"files\"])\n    note = \"\" if docs is None else (f\"\\nДокументация в pull request: {', '.join(docs) or 'не менялась'}\\n\\n\"\n                                    f\"Оглавление документации проекта:\\n{contents()}\")\n    fragments = \"\\n\\n\".join(f\"[{rag.source(h)}]\\n{h['text']}\" for h in hits) or \"(ничего не нашлось)\"\n    text = (f\"Pull request: {title or '(без заголовка)'}\\n\"\n            f\"Изменённые файлы ({len(pr['files'])}, +{pr['added']} −{pr['deleted']}):\\n{listed}{note}\\n\\n\"\n            f\"{what} из основной ветки:\\n\\n{fragments}\\n\\nDiff:\\n\\n{diff}\\n\\nЗадание: {task}\")\n    # модель цитирует код дословно, а двойная кавычка внутри ответа-JSON закрывает строку, и замечание\n    # обрывается на полуслове; для Python одинарные кавычки — то же самое\n    return text.replace('\"', \"'\")\n\n\nasync def ask(system, user, schema):\n    \"\"\"Один ревьюер: ответ модели строго по JSON Schema и счётчики.\"\"\"\n    answer, counters = \"\", {}\n    prompt = [{\"role\": \"system\", \"content\": system}, {\"role\": \"user\", \"content\": user}]\n    async for event in llm.chat(prompt, options=OPTIONS, schema=schema):\n        if event[\"type\"] == \"text\":\n            answer += event[\"text\"]\n        else:\n            counters = event\n    try:\n        return json.loads(answer), counters\n    except json.JSONDecodeError:\n        raise llm.LLMError(f\"Модель вернула не JSON — ответ оборвался на {count(counters.get('tokens', 0), TOKENS)}?\")\n\n\ndef repeats_docs(finding, stale):\n    \"\"\"Замечание советует дописать документацию, которая уже отмечена устаревшей.\"\"\"\n    return \"документац\" in finding[\"fix\"].lower() or any(s in finding[\"problem\"] + finding[\"fix\"] for s in stale)\n\n\nasync def review(base, head, title=\"\"):\n    \"\"\"① изменения через MCP → ② RAG → ③ ревьюер кода → ④ ревьюер архитектуры. Возвращает Markdown.\"\"\"\n    started = time.perf_counter()\n    pr, diff, texts, heads, calls = await collect(base, head)\n    files = pr[\"files\"]\n    if not files:\n        return f\"### AI-ревью\\n\\nИзменений между `{short(base)}` и `{short(head)}` нет.\\n\"\n    parsed = parse(diff[\"diff\"])\n    tools = \", \".join(dict.fromkeys(f\"{t} ×{calls.count(t)}\" if calls.count(t) > 1 else t for t in calls))\n    log(f\"① изменения — MCP git ({tools}): {count(len(files), FILES)}, +{pr['added']} −{pr['deleted']} · \"\n        f\"{number(time.perf_counter() - started)} с\")\n\n    started = time.perf_counter()\n    await index.build(texts)\n    # на каждый изменённый файл три запроса: что о модуле сказано в документации; какая документация\n    # ближе к новым строкам; какой код проекта ближе к ним (у фрагментов кода в векторе есть путь)\n    changed = [(path, \"\\n\".join(item[\"added\"])[:QUERY]) for path, item in parsed.items() if item[\"added\"]]\n    queries = [q for path, added in changed for q in (f\"Модуль {path}: за что отвечает и о чём знает\", added,\n                                                      f\"{path}\\n{added}\")]\n    vectors = await llm.embed(queries) if queries else []\n    docs = pick([v for i, v in enumerate(vectors) if i % 3 < 2], \"docs\", TOP_DOCS)\n    code = pick(vectors[2::3], \"code\", TOP_CODE)\n    log(f\"② RAG по коду и документации {short(base)}: {count(len(index.chunks), CHUNKS)}, \"\n        f\"новых векторов {index.built['embedded']} · {number(time.perf_counter() - started)} с\")\n    for hit in code + docs:\n        log(f\"   {rag.source(hit)} · {number(hit['score'], 2)}\")\n\n    with_imports(parsed, heads)\n    diff = diff_text(files, parsed)\n    project = config.PROJECT_DIR.name\n    # ревьюеру кода diff документации не нужен — только удлиняет промпт\n    code_diff = diff_text([f for f in files if not matches(f[\"path\"], config.DOCS)], parsed)\n    found, counters = await ask(\n        CODE.format(project=project, context=\"фрагменты кода проекта\"),\n        message(title, pr, code, code_diff, \"Фрагменты кода проекта\", \"найди потенциальные баги и дай рекомендации.\"),\n        CODE_SCHEMA)\n    log(f\"③ ревьюер кода — {config.MODEL}: {spent(counters)}\")\n    flagged, counters2 = await ask(\n        ARCHITECTURE.format(project=project, context=\"разделы документации проекта\"),\n        message(title, pr, docs, diff, \"Разделы документации проекта\",\n                \"найди архитектурные проблемы и проверь, не устарела ли документация.\",\n                [f[\"path\"] for f in files if matches(f[\"path\"], config.DOCS)]),\n        ARCHITECTURE_SCHEMA)\n    log(f\"④ ревьюер архитектуры — {config.MODEL}: {spent(counters2)}\")\n\n    # устаревшая документация — файлы, которые есть в основной ветке и не менялись в PR;\n    # если она нашлась, замечание с советом дописать документацию — повтор\n    stale = [f for f in dict.fromkeys(flagged[\"docs\"][\"files\"]) if f in texts and f not in parsed]\n    architecture = [f for f in flagged[\"findings\"] if not (stale and repeats_docs(f, stale))]\n    if stale:\n        architecture.append({\"file\": stale[0], \"line\": 0,\n                             \"problem\": flagged[\"docs\"][\"why\"] or \"Документация не обновлена под изменения.\",\n                             \"fix\": \"обновить \" + \", \".join(f\"`{f}`\" for f in stale) + \".\",\n                             \"source\": flagged[\"docs\"][\"source\"]})\n    sections = {\"Потенциальные баги\": [f for f in found[\"findings\"] if f[\"kind\"] == \"bug\"],\n                \"Архитектурные проблемы\": architecture,\n                \"Рекомендации\": [f for f in found[\"findings\"] if f[\"kind\"] == \"recommendation\"]}\n    return render(found[\"summary\"], sections, pr, parsed, texts, code + docs, tools, [counters, counters2], base)\n\n\ndef where(item, pr, parsed, texts):\n    \"\"\"Ссылка на место замечания. Номер строки — только если модель видела его в diff;\n    на GitHub — ссылка на файл в коммите PR.\"\"\"\n    path, line = item[\"file\"].strip(\"` \").split(\":\")[0], item[\"line\"]\n    if path not in parsed and path not in texts:\n        return None\n    line = line if line in parsed.get(path, {}).get(\"numbers\", ()) else None\n    label = f\"{path}:{line}\" if line else path\n    repo = os.getenv(\"GITHUB_REPOSITORY\")\n    if not repo:\n        return f\"`{label}`\"\n    url = f\"{os.getenv('GITHUB_SERVER_URL', 'https://github.com')}/{repo}/blob/{pr['head_sha']}/{path}\"\n    return f\"[`{label}`]({url}{f'#L{line}' if line else ''})\"\n\n\ndef spent(counters):\n    return (f\"промпт {count(counters['prompt'], TOKENS)} — {number(counters['reading'])} с, \"\n            f\"ответ {count(counters['tokens'], TOKENS)} — {number(counters['writing'])} с\")\n\n\ndef render(summary, sections, pr, parsed, texts, hits, tools, counters, base):\n    out = [f\"### AI-ревью · {config.MODEL}\", \"\", f\"**Что делает PR.** {summary}\"]\n    sources = [rag.source(h) for h in hits]\n    for title, items in sections.items():\n        out += [\"\", f\"#### {title}\", \"\"]\n        if not items:\n            out.append(\"Не найдено.\")\n        for n, item in enumerate(items, 1):\n            place = where(item, pr, parsed, texts)\n            # основание — только «файл › раздел» из фрагментов, которые модель правда видела в промпте\n            source = item[\"source\"].strip(\"[]` \")\n            seen = \"›\" in source and any(s.startswith(source) or source.startswith(s) for s in sources)\n            out.append(f\"{n}. {place + ' — ' if place else ''}{item['problem']}  \")\n            out.append(f\"   **Исправить:** {item['fix']}\" + (f\"  \\n   *Основание: {source}*\" if seen else \"\"))\n    fragments = \" · \".join(f\"`{rag.source(h)}` {number(h['score'], 2)}\" for h in hits)\n    model = \"; \".join(f\"{who} — {spent(c)}\" for who, c in zip((\"ревьюер кода\", \"ревьюер архитектуры\"), counters))\n    out += [\"\", \"<details><summary>Как получено ревью</summary>\", \"\",\n            f\"- **Изменения** — MCP-сервер git ({tools}): {count(len(pr['files']), FILES)}, \"\n            f\"+{pr['added']} −{pr['deleted']}.\",\n            f\"- **Контекст** — RAG по коду и документации `{short(base)}`: {count(len(index.chunks), CHUNKS)}, \"\n            f\"в промпт — {len(hits)}: {fragments}.\",\n            f\"- **Модель** — {config.MODEL} в Ollama: {model}.\",\n            \"\", \"</details>\"]\n    return \"\\n\".join(out) + \"\\n\"\n\n\ndef main():\n    parser = argparse.ArgumentParser(description=\"Ревью pull request локальной моделью\")\n    parser.add_argument(\"--repo\", default=str(config.PROJECT_DIR), help=\"папка git-репозитория проекта\")\n    parser.add_argument(\"--base\", default=\"main\", help=\"ветка или коммит, куда вливается PR\")\n    parser.add_argument(\"--head\", default=\"HEAD\", help=\"ветка или коммит с изменениями\")\n    parser.add_argument(\"--title\", default=\"\", help=\"заголовок PR\")\n    parser.add_argument(\"--out\", help=\"файл для ревью в Markdown; без него — на экран\")\n    args = parser.parse_args()\n    config.PROJECT_DIR = Path(args.repo).resolve()\n    logging.getLogger(\"httpx2\").setLevel(logging.WARNING)  # MCP SDK включает INFO — без строк о каждом запросе\n    try:\n        text = asyncio.run(review(args.base, args.head, args.title))\n    except Exception as exc:  # причина словами — её видно в логе задания\n        log(f\"Ревью не получилось: {reason(exc)}\")\n        sys.exit(1)\n    if args.out:\n        Path(args.out).write_text(text, encoding=\"utf-8\")\n    else:\n        sys.stdout.write(text)\n\n\nif __name__ == \"__main__\":\n    main()\n","numLines":379,"startLine":1,"totalLines":379}},"tool_result_meta":[{"id":"toolu_d8d497cd3c7e43178570ae81","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
