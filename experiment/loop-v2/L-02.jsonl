CustomError()\n44\t        self.assertEqual(assistant.reason(exc), 'кастомная ошибка')\n45\t\n46\t\n47\tclass AssistantContextTextTest(unittest.TestCase):\n48\t    \"\"\"Функция context_text форматирует результаты MCP для промпта.\"\"\"\n49\t\n50\t    def test_context_with_branch_and_files(self):\n51\t        \"\"\"Контекст с веткой и списком файлов.\"\"\"\n52\t        calls = [\n53\t            {'tool': 'git_branch', 'ok': True, 'result': {\n54\t                'branch': 'feature/x', 'branches': ['main', 'feature/x'], 'last_commit': 'abc123'\n55\t            }},\n56\t            {'tool': 'list_files', 'ok': True, 'result': {'count': 3, 'files': ['app/main.py', 'README.md', 'tests/test.py']}},\n57\t        ]\n58\t        result = assistant.context_text(calls)\n59\t        self.assertIn('Проект:', result)\n60\t        self.assertIn('Текущая ветка: feature/x', result)\n61\t        self.assertIn('Файлы проекта (3)', result)\n62\t\n63\t    def test_context_clean_status(self):\n64\t        \"\"\"Чистое рабочее дерево без изменений.\"\"\"\n65\t        calls = [\n66\t            {'tool': 'git_branch', 'ok': True, 'result': {'branch': 'main', 'branches': ['main'], 'last_commit': 'def456'}},\n67\t            {'tool': 'git_status', 'ok': True, 'result': {'clean': True, 'count': 0, 'changed': []}},\n68\t        ]\n69\t        result = assistant.context_text(calls)\n70\t        self.assertIn('Незакоммиченных изменений нет', result)\n71\t\n72\t    def test_context_changed_files(self):\n73\t        \"\"\"Изменённые файлы группируются по статусу.\"\"\"\n74\t        calls = [\n75\t            {'tool': 'git_status', 'ok': True, 'result': {\n76\t                'clean': False, 'count': 3, 'changed': [\n77\t                    {'status': 'изменён', 'path': 'app/main.py'},\n78\t                    {'status': 'новый', 'path': 'tests/new.py'},\n79\t                    {'status': 'удалён', 'path': 'old.py'}\n80\t                ]\n81\t            }},\n82\t        ]\n83\t        result = assistant.context_text(calls)\n84\t        self.assertIn('изменены', result)\n85\t        self.assertIn('новые', result)\n86\t        self.assertIn('удалены', result)\n87\t\n88\t\n89\tclass AssistantMessagesTest(unittest.TestCase):\n90\t    \"\"\"Функция messages формирует промпт для LLM.\"\"\"\n91\t\n92\t    def test_messages_structure(self):\n93\t        \"\"\"Промпт содержит системный ролевик и пользовательский запрос.\"\"\"\n94\t        hits = [{'file': 'README.md', 'title': 'Введение', 'text': 'Краткое описание'}]\n95\t        result = assistant.messages('Вопрос?', 'Контекст git', hits)\n96\t        self.assertEqual(len(result), 2)\n97\t        self.assertEqual(result[0]['role'], 'system')\n98\t        self.assertEqual(result[1]['role'], 'user')\n99\t\n100\t    def test_messages_with_fragments(self):\n101\t        \"\"\"Фрагменты вставляются между контекстом и вопросом.\"\"\"\n102\t        hits = [{'file': 'docs/api.md', 'title': 'Эндпоинты', 'text': '/api/help'}]\n103\t        messages = assistant.messages('Как помочь?', 'Git info', hits)\n104\t        user_content = messages[1]['content']\n105\t        self.assertIn('Контекст проекта', user_content)\n106\t        self.assertIn('[docs/api.md › Эндпоинты]', user_content)\n107\t        self.assertIn('/api/help', user_content)\n108\t\n109\t\n110\tif __name__ == '__main__':\n111\t    unittest.main()\n112\t"}]},"parent_tool_use_id":null,"session_id":"c3948310-f5c5-4c14-84fa-341a6519e6f6","uuid":"ad6c0890-44f5-4e9d-b4e2-bb466a709020","timestamp":"2026-10-24T23:22:38.752Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\USER\\AppData\\Local\\Temp\\claude-rules\\loop-v2\\tests\\test_assistant.py","content":"\"\"\"Тесты app/assistant.py: парсинг команды /help и формирование промпта.\"\"\"\nimport unittest\n\nfrom app import assistant\n\n\nclass AssistantParseTest(unittest.TestCase):\n    \"\"\"Функция parse разбирает команду /help.\"\"\"\n\n    def test_parse_help_only(self):\n        \"\"\"Просто /help — общий вопрос о проекте.\"\"\"\n        result = assistant.parse('/help')\n        self.assertEqual(result, 'Что это за проект, как он устроен и как его запустить?')\n\n    def test_parse_help_with_question(self):\n        \"\"\"'/help вопрос' — только вопрос.\"\"\"\n        result = assistant.parse('/help Как запустить сервис?')\n        self.assertEqual(result, 'Как запустить сервис?')\n\n    def test_parse_without_help(self):\n        \"\"\"Без /help — None.\"\"\"\n        self.assertIsNone(assistant.parse('любой вопрос'))\n        self.assertIsNone(assistant.parse(''))\n\n    def test_parse_strips_whitespace(self):\n        \"\"\"Пробелы вокруг команды отбрасываются.\"\"\"\n        self.assertEqual(assistant.parse('  /help  '), 'Что это за проект, как он устроен и как его запустить?')\n        self.assertEqual(assistant.parse('/help  Тест  '), 'Тест')\n\n\nclass AssistantReasonTest(unittest.TestCase):\n    \"\"\"Функция reason извлекает сообщение из ошибки.\"\"\"\n\n    def test_reason_simple_exception(self):\n        \"\"\"Обычное исключение — сообщение по str.\"\"\"\n        exc = Exception('ошибка подключения')\n        self.assertEqual(assistant.reason(exc), 'ошибка подключения')\n\n    def test_reason_with_message_attr(self):\n        \"\"\"Исключение с атрибутом message.\"\"\"\n        class CustomError(Exception):\n            message = 'кастомная ошибка'\n        exc = CustomError()\n        self.assertEqual(assistant.reason(exc), 'кастомная ошибка')\n\n\nclass AssistantContextTextTest(unittest.TestCase):\n    \"\"\"Функция context_text форматирует результаты MCP для промпта.\"\"\"\n\n    def test_context_with_branch_and_files(self):\n        \"\"\"Контекст с веткой и списком файлов.\"\"\"\n        calls = [\n            {'tool': 'git_branch', 'ok': True, 'result': {\n                'branch': 'feature/x', 'branches': ['main', 'feature/x'], 'last_commit': 'abc123'\n            }},\n            {'tool': 'list_files', 'ok': True, 'result': {'count': 3, 'files': ['app/main.py', 'README.md', 'tests/test.py']}},\n        ]\n        result = assistant.context_text(calls)\n        self.assertIn('Проект:', result)\n        self.assertIn('Текущая ветка: feature/x', result)\n        self.assertIn('Файлы проекта (3)', result)\n\n    def test_context_clean_status(self):\n        \"\"\"Чистое рабочее дерево без изменений.\"\"\"\n        calls = [\n            {'tool': 'git_branch', 'ok': True, 'result': {'branch': 'main', 'branches': ['main'], 'last_commit': 'def456'}},\n            {'tool': 'git_status', 'ok': True, 'result': {'clean': True, 'count': 0, 'changed': []}},\n        ]\n        result = assistant.context_text(calls)\n        self.assertIn('Незакоммиченных изменений нет', result)\n\n    def test_context_changed_files(self):\n        \"\"\"Изменённые файлы группируются по статусу.\"\"\"\n        calls = [\n            {'tool': 'git_status', 'ok': True, 'result': {\n                'clean': False, 'count': 3, 'changed': [\n                    {'status': 'изменён', 'path': 'app/main.py'},\n                    {'status': 'новый', 'path': 'tests/new.py'},\n                    {'status': 'удалён', 'path': 'old.py'}\n                ]\n            }},\n        ]\n        result = assistant.context_text(calls)\n        self.assertIn('изменены', result)\n        self.assertIn('новые', result)\n        self.assertIn('удалены', result)\n\n\nclass AssistantMessagesTest(unittest.TestCase):\n    \"\"\"Функция messages формирует промпт для LLM.\"\"\"\n\n    def test_messages_structure(self):\n        \"\"\"Промпт содержит системный ролевик и пользовательский запрос.\"\"\"\n        hits = [{'file': 'README.md', 'title': 'Введение', 'text': 'Краткое описание'}]\n        result = assistant.messages('Вопрос?', 'Контекст git', hits)\n        self.assertEqual(len(result), 2)\n        self.assertEqual(result[0]['role'], 'system')\n        self.assertEqual(result[1]['role'], 'user')\n\n    def test_messages_with_fragments(self):\n        \"\"\"Фрагменты вставляются между контекстом и вопросом.\"\"\"\n        hits = [{'file': 'docs/api.md', 'title': 'Эндпоинты', 'text': '/api/help'}]\n        messages = assistant.messages('Как помочь?', 'Git info', hits)\n        user_content = messages[1]['content']\n        self.assertIn('Контекст проекта', user_content)\n        self.assertIn('[docs/api.md › Эндпоинты]', user_content)\n        self.assertIn('/api/help', user_content)\n\n\nif __name__ == '__main__':\n    unittest.main()\n","numLines":112,"startLine":1,"totalLines":112}},"tool_result_meta":[{"id":"toolu_f8caeca341444836a8b570b5","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
