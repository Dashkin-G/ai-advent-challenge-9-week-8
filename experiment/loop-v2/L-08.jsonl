{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_c80b1fc2462f4145916dab76","type":"tool_result","content":"1\t\"\"\"RAG по проекту: документация — фрагменты по заголовкам, код Python — по функциям и классам;\n2\tвекторы bge-m3, поиск по косинусу.\"\"\"\n3\timport ast\n4\timport asyncio\n5\timport hashlib\n6\timport json\n7\timport re\n8\timport time\n9\t\n10\timport numpy as np\n11\t\n12\tfrom app import config, llm\n13\t\n14\tMAX = 900  # знаков во фрагменте документации: короче промпт — быстрее отвечает локальная модель\n15\tMAX_CODE = 1500  # знаков во фрагменте кода: функция обычно помещается целиком\n16\tHEADING = re.compile(r\"^(#{1,3})\\s+(.+?)\\s*$\")\n17\t\n18\t\n19\tdef files():\n20\t    \"\"\"Файлы документации проекта по порядку: README, потом docs/.\"\"\"\n21\t    found = []\n22\t    for pattern in config.DOCS:\n23\t        found += sorted(config.PROJECT_DIR.glob(pattern))\n24\t    return found\n25\t\n26\t\n27\tdef _sections(text):\n28\t    \"\"\"(заголовки над разделом, текст раздела); строки внутри ``` заголовками не считаются.\"\"\"\n29\t    trail, body, in_code = [], [], False\n30\t    for line in text.splitlines():\n31\t        if line.startswith(\"```\"):\n32\t            in_code = not in_code\n33\t        heading = None if in_code else HEADING.match(line)\n34\t        if heading:\n35\t            if \"\\n\".join(body).strip():\n36\t                yield trail, \"\\n\".join(body).strip()\n37\t            trail = trail[:len(heading.group(1)) - 1] + [heading.group(2)]\n38\t            body = []\n39\t        else:\n40\t            body.append(line)\n41\t    if \"\\n\".join(body).strip():\n42\t        yield trail, \"\\n\".join(body).strip()\n43\t\n44\t\n45\tdef _blocks(body):\n46\t    \"\"\"Абзацы; блок кода и таблица — целиком.\"\"\"\n47\t    found, current, in_code = [], [], False\n48\t    for line in body.splitlines():\n49\t        if line.startswith(\"```\"):\n50\t            in_code = not in_code\n51\t        if line.strip() or in_code:\n52\t            current.append(line)\n53\t        elif current:\n54\t            found.append(\"\\n\".join(current))\n55\t            current = []\n56\t    if current:\n57\t        found.append(\"\\n\".join(current))\n58\t    return found\n59\t\n60\t\n61\tdef _pieces(block):\n62\t    \"\"\"Блок длиннее MAX — по строкам; у таблицы в каждой части повторяется шапка.\"\"\"\n63\t    if len(block) <= MAX:\n64\t        return [block]\n65\t    lines = block.splitlines()\n66\t    head = lines[:2] if lines[0].startswith(\"|\") else []\n67\t    pieces, current = [], []\n68\t    for line in lines[len(head):]:\n69\t        if current and len(\"\\n\".join(head + current + [line])) > MAX:\n70\t            pieces.append(\"\\n\".join(head + current))\n71\t            current = []\n72\t        current.append(line)\n73\t    pieces.append(\"\\n\".join(head + current))\n74\t    return pieces\n75\t\n76\t\n77\tdef split_docs(file, text):\n78\t    \"\"\"Фрагменты Markdown: {\"file\", \"title\", \"text\", \"kind\"}; title — заголовки без названия документа.\"\"\"\n79\t    for trail, body in _sections(text):\n80\t        title = \" › \".join(trail[1:] or trail[:1])\n81\t        current = \"\"\n82\t        for block in _blocks(body):\n83\t            for piece in _pieces(block):\n84\t                # короткое начало (вступление к списку) не отрываем от продолжения\n85\t                if len(current) >= MAX // 3 and len(current) + len(piece) + 2 > MAX:\n86\t                    yield {\"file\": file, \"title\": title, \"text\": current, \"kind\": \"docs\"}\n87\t                    current = \"\"\n88\t                current = f\"{current}\\n\\n{piece}\" if current else piece\n89\t        if current:\n90\t            yield {\"file\": file, \"title\": title, \"text\": current, \"kind\": \"docs\"}\n91\t\n92\t\n93\tdef _label(node):\n94\t    \"\"\"Название верхнеуровневого узла Python для заголовка фрагмента.\"\"\"\n95\t    if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):\n96\t        return f\"{node.name}()\"\n97\t    if isinstance(node, ast.ClassDef):\n98\t        return f\"class {node.name}\"\n99\t    if isinstance(node, (ast.Import, ast.ImportFrom)):\n100\t        return \"импорты\"\n101\t    if isinstance(node, (ast.Assign, ast.AnnAssign, ast.AugAssign)):\n102\t        return \", \".join(ast.unparse(t) for t in getattr(node, \"targets\", None) or [node.target])\n103\t    if isinstance(node, ast.Expr) and isinstance(node.value, ast.Constant) and isinstance(node.value.value, str):\n104\t        return \"описание модуля\"\n105\t    return \"код модуля\"\n106\t\n107\t\n108\tdef split_code(file, text):\n109\t    \"\"\"Фрагменты Python: функция или класс целиком, импорты и константы между ними — вместе; комментарий\n110\t    над узлом — с ним. У фрагмента — номера строк: на них ссылается ревью.\"\"\"\n111\t    lines = text.splitlines()\n112\t    try:\n113\t        nodes = ast.parse(text).body\n114\t    except SyntaxError:\n115\t        nodes = []\n116\t    groups, start = [], 1  # [названия, первая строка, последняя строка, отдельный ли узел]\n117\t    for node in nodes:\n118\t        whole = isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef))\n119\t        last = groups[-1] if groups else None\n120\t        if last and not whole and not last[3] and len(\"\\n\".join(lines[last[1] - 1:node.end_lineno])) <= MAX_CODE:\n121\t            last[0].append(_label(node))\n122\t            last[2] = node.end_lineno\n123\t        else:\n124\t            groups.append([[_label(node)], start, node.end_lineno, whole])\n125\t        start = node.end_lineno + 1\n126\t    if not groups and lines:\n127\t        groups.append([[\"код модуля\"], 1, len(lines), False])\n128\t    for labels, first, end, _ in groups:\n129\t        while first < end and not lines[first - 1].strip():\n130\t            first += 1\n131\t        title = \", \".join(dict.fromkeys(labels))\n132\t        piece = first\n133\t        for n in range(first, end + 1):  # длинный фрагмент — по строкам\n134\t            if n > piece and len(\"\\n\".join(lines[piece - 1:n])) > MAX_CODE:\n135\t                yield {\"file\": file, \"title\": title, \"text\": \"\\n\".join(lines[piece - 1:n - 1]),\n136\t                       \"kind\": \"code\", \"lines\": [piece, n - 1]}\n137\t                piece = n\n138\t        yield {\"file\": file, \"title\": title, \"text\": \"\\n\".join(lines[piece - 1:end]), \"kind\": \"code\",\n139\t               \"lines\": [piece, end]}\n140\t\n141\t\n142\tdef split(file, text):\n143\t    return split_code(file, text) if file.endswith(\".py\") else split_docs(file, text)\n144\t\n145\t\n146\tdef source(chunk):\n147\t    \"\"\"Заголовок фрагмента для промпта и ссылок: файл › раздел, у кода — ещё строки.\"\"\"\n148\t    lines = f\", строки {chunk['lines'][0]}–{chunk['lines'][1]}\" if chunk.get(\"lines\") else \"\"\n149\t    return f\"{chunk['file']} › {chunk['title']}{lines}\"\n150\t\n151\t\n152\tdef _key(chunk):\n153\t    return hashlib.sha256(f\"{config.EMBED_MODEL}|{chunk['file']}|{chunk['title']}|{chunk['text']}\".encode()).hexdigest()\n154\t\n155\t\n156\tdef _embedded(chunk):\n157\t    \"\"\"Текст для вектора; у кода — с путём файла: запросы ревью тоже начинаются с пути.\"\"\"\n158\t    if chunk[\"kind\"] == \"code\":\n159\t        return f\"{chunk['file']} › {chunk['title']}\\n\\n{chunk['text']}\"\n160\t    return f\"{chunk['title']}\\n\\n{chunk['text']}\"\n161\t\n162\t\n163\tclass Index:\n164\t    \"\"\"Фрагменты и их векторы. Векторы кэшируются в data/<cache>.json: поменялись файлы —\n165\t    пересчитываются только новые фрагменты.\"\"\"\n166\t\n167\t    def __init__(self, cache):\n168\t        self.cache = config.DATA_DIR / f\"{cache}.json\"\n169\t        self.fingerprint, self.chunks, self.matrix, self.built = None, [], None, None\n170\t\n171\t    async def build(self, texts):\n172\t        \"\"\"texts — {путь: текст}.\"\"\"\n173\t        fingerprint = hashlib.sha256(json.dumps(texts, sort_keys=True).encode()).hexdigest()\n174\t        if fingerprint == self.fingerprint:\n175\t            return\n176\t        started = time.perf_counter()\n177\t        chunks = [chunk for file, text in texts.items() for chunk in split(file, text)]\n178\t        if self.cache.exists():\n179\t            try:\n180\t                cache = json.loads(self.cache.read_text(encoding=\"utf-8\"))\n181\t            except json.JSONDecodeError:\n182\t                cache = {}  # битый кэш — пересчитать векторы\n183\t        else:\n184\t            cache = {}\n185\t        keys = [_key(chunk) for chunk in chunks]\n186\t        missing = [i for i, key in enumerate(keys) if key not in cache]\n187\t        if missing:\n188\t            vectors = await llm.embed([_embedded(chunks[i]) for i in missing])\n189\t            cache.update({keys[i]: vector for i, vector in zip(missing, vectors)})\n190\t            self.cache.parent.mkdir(parents=True, exist_ok=True)\n191\t            self.cache.write_text(json.dumps({key: cache[key] for key in keys}), encoding=\"utf-8\")  # только живые\n192\t        matrix = None\n193\t        if keys:\n194\t            matrix = np.array([cache[key] for key in keys], dtype=np.float32)\n195\t            matrix /= np.linalg.norm(matrix, axis=1, keepdims=True)\n196\t        self.fingerprint, self.chunks, self.matrix = fingerprint, chunks, matrix\n197\t        self.built = {\"embedded\": len(missing), \"seconds\": round(time.perf_counter() - started, 2)}\n198\t\n199\t    def info(self):\n200\t        return {\"files\": sorted({c[\"file\"] for c in self.chunks}, key=lambda f: (f != \"README.md\", f)),\n201\t                \"chunks\": len(self.chunks), \"model\": config.EMBED_MODEL, \"built\": self.built}\n202\t\n203\t    def nearest(self, vector, top, keep=lambda chunk: True):\n204\t        \"\"\"Ближайшие по косинусу фрагменты, которые проходят фильтр keep, — с близостью. Можно передать\n205\t        несколько векторов запроса: у фрагмента берётся лучшая близость.\"\"\"\n206\t        if self.matrix is None:\n207\t            return []\n208\t        queries = np.atleast_2d(np.array(vector, dtype=np.float32))\n209\t        scores = (self.matrix @ (queries / np.linalg.norm(queries, axis=1, keepdims=True)).T).max(axis=1)\n210\t        found = []\n211\t        for i in np.argsort(-scores):\n212\t            if len(found) == top:\n213\t                break\n214\t            if keep(self.chunks[i]):\n215\t                found.append({**self.chunks[i], \"score\": round(float(scores[i]), 3)})\n216\t        return found\n217\t\n218\t\n219\tdocs = Index(\"embeddings\")  # /help: README и docs/ из рабочей папки проекта\n220\t_lock = asyncio.Lock()  # сборка при старте и первый /help не считают векторы дважды\n221\t\n222\t\n223\tasync def ensure_index():\n224\t    \"\"\"Индекс документации актуален: поменяли файлы — пересчитываются векторы только новых фрагментов.\"\"\"\n225\t    async with _lock:\n226\t        paths = files()\n227\t        if not paths:\n228\t            raise FileNotFoundError(f\"В {config.PROJECT_DIR} нет README.md и docs/ — проверьте PROJECT_DIR\")\n229\t        await docs.build({p.relative_to(config.PROJECT_DIR).as_posix(): p.read_text(encoding=\"utf-8\") for p in paths})\n230\t        return docs.info()\n231\t\n232\t\n233\tdef info():\n234\t    return docs.info()\n235\t\n236\t\n237\tasync def search(question, top=config.TOP):\n238\t    \"\"\"Ближайшие по смыслу фрагменты документации — по косинусу векторов bge-m3.\"\"\"\n239\t    await ensure_index()\n240\t    return docs.nearest((await llm.embed([question]))[0], top)\n241\t"}]},"parent_tool_use_id":null,"session_id":"c987f8d8-6e8b-484f-8341-16c15075746b","uuid":"0f1e7341-5a6f-402a-b479-1aaaaf03abba","timestamp":"2026-10-24T23:33:42.596Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\USER\\AppData\\Local\\Temp\\claude-rules\\loop-v2\\app\\rag.py","content":"\"\"\"RAG по проекту: документация — фрагменты по заголовкам, код Python — по функциям и классам;\nвекторы bge-m3, поиск по косинусу.\"\"\"\nimport ast\nimport asyncio\nimport hashlib\nimport json\nimport re\nimport time\n\nimport numpy as np\n\nfrom app import config, llm\n\nMAX = 900  # знаков во фрагменте документации: короче промпт — быстрее отвечает локальная модель\nMAX_CODE = 1500  # знаков во фрагменте кода: функция обычно помещается целиком\nHEADING = re.compile(r\"^(#{1,3})\\s+(.+?)\\s*$\")\n\n\ndef files():\n    \"\"\"Файлы документации проекта по порядку: README, потом docs/.\"\"\"\n    found = []\n    for pattern in config.DOCS:\n        found += sorted(config.PROJECT_DIR.glob(pattern))\n    return found\n\n\ndef _sections(text):\n    \"\"\"(заголовки над разделом, текст раздела); строки внутри ``` заголовками не считаются.\"\"\"\n    trail, body, in_code = [], [], False\n    for line in text.splitlines():\n        if line.startswith(\"```\"):\n            in_code = not in_code\n        heading = None if in_code else HEADING.match(line)\n        if heading:\n            if \"\\n\".join(body).strip():\n                yield trail, \"\\n\".join(body).strip()\n            trail = trail[:len(heading.group(1)) - 1] + [heading.group(2)]\n            body = []\n        else:\n            body.append(line)\n    if \"\\n\".join(body).strip():\n        yield trail, \"\\n\".join(body).strip()\n\n\ndef _blocks(body):\n    \"\"\"Абзацы; блок кода и таблица — целиком.\"\"\"\n    found, current, in_code = [], [], False\n    for line in body.splitlines():\n        if line.startswith(\"```\"):\n            in_code = not in_code\n        if line.strip() or in_code:\n            current.append(line)\n        elif current:\n            found.append(\"\\n\".join(current))\n            current = []\n    if current:\n        found.append(\"\\n\".join(current))\n    return found\n\n\ndef _pieces(block):\n    \"\"\"Блок длиннее MAX — по строкам; у таблицы в каждой части повторяется шапка.\"\"\"\n    if len(block) <= MAX:\n        return [block]\n    lines = block.splitlines()\n    head = lines[:2] if lines[0].startswith(\"|\") else []\n    pieces, current = [], []\n    for line in lines[len(head):]:\n        if current and len(\"\\n\".join(head + current + [line])) > MAX:\n            pieces.append(\"\\n\".join(head + current))\n            current = []\n        current.append(line)\n    pieces.append(\"\\n\".join(head + current))\n    return pieces\n\n\ndef split_docs(file, text):\n    \"\"\"Фрагменты Markdown: {\"file\", \"title\", \"text\", \"kind\"}; title — заголовки без названия документа.\"\"\"\n    for trail, body in _sections(text):\n        title = \" › \".join(trail[1:] or trail[:1])\n        current = \"\"\n        for block in _blocks(body):\n            for piece in _pieces(block):\n                # короткое начало (вступление к списку) не отрываем от продолжения\n                if len(current) >= MAX // 3 and len(current) + len(piece) + 2 > MAX:\n                    yield {\"file\": file, \"title\": title, \"text\": current, \"kind\": \"docs\"}\n                    current = \"\"\n                current = f\"{current}\\n\\n{piece}\" if current else piece\n        if current:\n            yield {\"file\": file, \"title\": title, \"text\": current, \"kind\": \"docs\"}\n\n\ndef _label(node):\n    \"\"\"Название верхнеуровневого узла Python для заголовка фрагмента.\"\"\"\n    if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):\n        return f\"{node.name}()\"\n    if isinstance(node, ast.ClassDef):\n        return f\"class {node.name}\"\n    if isinstance(node, (ast.Import, ast.ImportFrom)):\n        return \"импорты\"\n    if isinstance(node, (ast.Assign, ast.AnnAssign, ast.AugAssign)):\n        return \", \".join(ast.unparse(t) for t in getattr(node, \"targets\", None) or [node.target])\n    if isinstance(node, ast.Expr) and isinstance(node.value, ast.Constant) and isinstance(node.value.value, str):\n        return \"описание модуля\"\n    return \"код модуля\"\n\n\ndef split_code(file, text):\n    \"\"\"Фрагменты Python: функция или класс целиком, импорты и константы между ними — вместе; комментарий\n    над узлом — с ним. У фрагмента — номера строк: на них ссылается ревью.\"\"\"\n    lines = text.splitlines()\n    try:\n        nodes = ast.parse(text).body\n    except SyntaxError:\n        nodes = []\n    groups, start = [], 1  # [названия, первая строка, последняя строка, отдельный ли узел]\n    for node in nodes:\n        whole = isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef))\n        last = groups[-1] if groups else None\n        if last and not whole and not last[3] and len(\"\\n\".join(lines[last[1] - 1:node.end_lineno])) <= MAX_CODE:\n            last[0].append(_label(node))\n            last[2] = node.end_lineno\n        else:\n            groups.append([[_label(node)], start, node.end_lineno, whole])\n        start = node.end_lineno + 1\n    if not groups and lines:\n        groups.append([[\"код модуля\"], 1, len(lines), False])\n    for labels, first, end, _ in groups:\n        while first < end and not lines[first - 1].strip():\n            first += 1\n        title = \", \".join(dict.fromkeys(labels))\n        piece = first\n        for n in range(first, end + 1):  # длинный фрагмент — по строкам\n            if n > piece and len(\"\\n\".join(lines[piece - 1:n])) > MAX_CODE:\n                yield {\"file\": file, \"title\": title, \"text\": \"\\n\".join(lines[piece - 1:n - 1]),\n                       \"kind\": \"code\", \"lines\": [piece, n - 1]}\n                piece = n\n        yield {\"file\": file, \"title\": title, \"text\": \"\\n\".join(lines[piece - 1:end]), \"kind\": \"code\",\n               \"lines\": [piece, end]}\n\n\ndef split(file, text):\n    return split_code(file, text) if file.endswith(\".py\") else split_docs(file, text)\n\n\ndef source(chunk):\n    \"\"\"Заголовок фрагмента для промпта и ссылок: файл › раздел, у кода — ещё строки.\"\"\"\n    lines = f\", строки {chunk['lines'][0]}–{chunk['lines'][1]}\" if chunk.get(\"lines\") else \"\"\n    return f\"{chunk['file']} › {chunk['title']}{lines}\"\n\n\ndef _key(chunk):\n    return hashlib.sha256(f\"{config.EMBED_MODEL}|{chunk['file']}|{chunk['title']}|{chunk['text']}\".encode()).hexdigest()\n\n\ndef _embedded(chunk):\n    \"\"\"Текст для вектора; у кода — с путём файла: запросы ревью тоже начинаются с пути.\"\"\"\n    if chunk[\"kind\"] == \"code\":\n        return f\"{chunk['file']} › {chunk['title']}\\n\\n{chunk['text']}\"\n    return f\"{chunk['title']}\\n\\n{chunk['text']}\"\n\n\nclass Index:\n    \"\"\"Фрагменты и их векторы. Векторы кэшируются в data/<cache>.json: поменялись файлы —\n    пересчитываются только новые фрагменты.\"\"\"\n\n    def __init__(self, cache):\n        self.cache = config.DATA_DIR / f\"{cache}.json\"\n        self.fingerprint, self.chunks, self.matrix, self.built = None, [], None, None\n\n    async def build(self, texts):\n        \"\"\"texts — {путь: текст}.\"\"\"\n        fingerprint = hashlib.sha256(json.dumps(texts, sort_keys=True).encode()).hexdigest()\n        if fingerprint == self.fingerprint:\n            return\n        started = time.perf_counter()\n        chunks = [chunk for file, text in texts.items() for chunk in split(file, text)]\n        if self.cache.exists():\n            try:\n                cache = json.loads(self.cache.read_text(encoding=\"utf-8\"))\n            except json.JSONDecodeError:\n                cache = {}  # битый кэш — пересчитать векторы\n        else:\n            cache = {}\n        keys = [_key(chunk) for chunk in chunks]\n        missing = [i for i, key in enumerate(keys) if key not in cache]\n        if missing:\n            vectors = await llm.embed([_embedded(chunks[i]) for i in missing])\n            cache.update({keys[i]: vector for i, vector in zip(missing, vectors)})\n            self.cache.parent.mkdir(parents=True, exist_ok=True)\n            self.cache.write_text(json.dumps({key: cache[key] for key in keys}), encoding=\"utf-8\")  # только живые\n        matrix = None\n        if keys:\n            matrix = np.array([cache[key] for key in keys], dtype=np.float32)\n            matrix /= np.linalg.norm(matrix, axis=1, keepdims=True)\n        self.fingerprint, self.chunks, self.matrix = fingerprint, chunks, matrix\n        self.built = {\"embedded\": len(missing), \"seconds\": round(time.perf_counter() - started, 2)}\n\n    def info(self):\n        return {\"files\": sorted({c[\"file\"] for c in self.chunks}, key=lambda f: (f != \"README.md\", f)),\n                \"chunks\": len(self.chunks), \"model\": config.EMBED_MODEL, \"built\": self.built}\n\n    def nearest(self, vector, top, keep=lambda chunk: True):\n        \"\"\"Ближайшие по косинусу фрагменты, которые проходят фильтр keep, — с близостью. Можно передать\n        несколько векторов запроса: у фрагмента берётся лучшая близость.\"\"\"\n        if self.matrix is None:\n            return []\n        queries = np.atleast_2d(np.array(vector, dtype=np.float32))\n        scores = (self.matrix @ (queries / np.linalg.norm(queries, axis=1, keepdims=True)).T).max(axis=1)\n        found = []\n        for i in np.argsort(-scores):\n            if len(found) == top:\n                break\n            if keep(self.chunks[i]):\n                found.append({**self.chunks[i], \"score\": round(float(scores[i]), 3)})\n        return found\n\n\ndocs = Index(\"embeddings\")  # /help: README и docs/ из рабочей папки проекта\n_lock = asyncio.Lock()  # сборка при старте и первый /help не считают векторы дважды\n\n\nasync def ensure_index():\n    \"\"\"Индекс документации актуален: поменяли файлы — пересчитываются векторы только новых фрагментов.\"\"\"\n    async with _lock:\n        paths = files()\n        if not paths:\n            raise FileNotFoundError(f\"В {config.PROJECT_DIR} нет README.md и docs/ — проверьте PROJECT_DIR\")\n        await docs.build({p.relative_to(config.PROJECT_DIR).as_posix(): p.read_text(encoding=\"utf-8\") for p in paths})\n        return docs.info()\n\n\ndef info():\n    return docs.info()\n\n\nasync def search(question, top=config.TOP):\n    \"\"\"Ближайшие по смыслу фрагменты документации — по косинусу векторов bge-m3.\"\"\"\n    await ensure_index()\n    return docs.nearest((await llm.embed([question]))[0], top)\n","numLines":241,"startLine":1,"totalLines":241}},"tool_result_meta":[{"id":"toolu_c80b1fc2462f4145916dab76","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
