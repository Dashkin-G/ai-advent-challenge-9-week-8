{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_b6e33627190e493997595771","type":"tool_result","content":"1\t\"\"\"RAG по проекту: документация — фрагменты по заголовкам, код Python — по функциям и классам;\n2\tвекторы bge-m3, поиск по косинусу.\"\"\"\n3\timport ast\n4\timport asyncio\n5\timport hashlib\n6\timport json\n7\timport re\n8\timport time\n9\t\n10\timport numpy as np\n11\t\n12\tfrom app import config, llm\n13\t\n14\tMAX = 900  # знаков во фрагменте документации: короче промпт — быстрее отвечает локальная модель\n15\tMAX_CODE = 1500  # знаков во фрагменте кода: функция обычно помещается целиком\n16\tHEADING = re.compile(r\"^(#{1,3})\\s+(.+?)\\s*$\")\n17\t\n18\t\n19\tdef files():\n20\t    \"\"\"Файлы документации проекта по порядку: README, потом docs/.\"\"\"\n21\t    found = []\n22\t    for pattern in config.DOCS:\n23\t        found += sorted(config.PROJECT_DIR.glob(pattern))\n24\t    return found\n25\t\n26\t\n27\tdef _sections(text):\n28\t    \"\"\"(заголовки над разделом, текст раздела); строки внутри ``` заголовками не считаются.\"\"\"\n29\t    trail, body, in_code = [], [], False\n30\t    for line in text.splitlines():\n31\t        if line.startswith(\"```\"):\n32\t            in_code = not in_code\n33\t        heading = None if in_code else HEADING.match(line)\n34\t        if heading:\n35\t            if \"\\n\".join(body).strip():\n36\t                yield trail, \"\\n\".join(body).strip()\n37\t            trail = trail[:len(heading.group(1)) - 1] + [heading.group(2)]\n38\t            body = []\n39\t        else:\n40\t            body.append(line)\n41\t    if \"\\n\".join(body).strip():\n42\t        yield trail, \"\\n\".join(body).strip()\n43\t\n44\t\n45\tdef _blocks(body):\n46\t    \"\"\"Абзацы; блок кода и таблица — целиком.\"\"\"\n47\t    found, current, in_code = [], [], False\n48\t    for line in body.splitlines():\n49\t        if line.startswith(\"```\"):\n50\t            in_code = not in_code\n51\t        if line.strip() or in_code:\n52\t            current.append(line)\n53\t        elif current:\n54\t            found.append(\"\\n\".join(current))\n55\t            current = []\n56\t    if current:\n57\t        found.append(\"\\n\".join(current))\n58\t    return found\n59\t\n60\t\n61\tdef _pieces(block):\n62\t    \"\"\"Блок длиннее MAX — по строкам; у таблицы в каждой части повторяется шапка.\"\"\"\n63\t    if len(block) <= MAX:\n64\t        return [block]\n65\t    lines = block.splitlines()\n66\t    head = lines[:2] if lines[0].startswith(\"|\") else []\n67\t    pieces, current = [], []\n68\t    for line in lines[len(head):]:\n69\t        if current and len(\"\\n\".join(head + current + [line])) > MAX:\n70\t            pieces.append(\"\\n\".join(head + current))\n71\t            current = []\n72\t        current.append(line)\n73\t    pieces.append(\"\\n\".join(head + current))\n74\t    return pieces\n75\t\n76\t\n77\tdef split_docs(file, text):\n78\t    \"\"\"Фрагменты Markdown: {\"file\", \"title\", \"text\", \"kind\"}; title — заголовки без названия документа.\"\"\"\n79\t    for trail, body in _sections(text):\n80\t        title = \" › \".join(trail[1:] or trail[:1])\n81\t        current = \"\"\n82\t        for block in _blocks(body):\n83\t            for piece in _pieces(block):\n84\t                # короткое начало (вступление к списку) не отрываем от продолжения\n85\t                if len(current) >= MAX // 3 and len(current) + len(piece) + 2 > MAX:\n86\t                    yield {\"file\": file, \"title\": title, \"text\": current, \"kind\": \"docs\"}\n87\t                    current = \"\"\n88\t                current = f\"{current}\\n\\n{piece}\" if current else piece\n89\t        if current:\n90\t            yield {\"file\": file, \"title\": title, \"text\": current, \"kind\": \"docs\"}\n91\t\n92\t\n93\tdef _label(node):\n94\t    \"\"\"Название верхнеуровневого узла Python для заголовка фрагмента.\"\"\"\n95\t    if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef)):\n96\t        return f\"{node.name}()\"\n97\t    if isinstance(node, ast.ClassDef):\n98\t        return f\"class {node.name}\"\n99\t    if isinstance(node, (ast.Import, ast.ImportFrom)):\n100\t        return \"импорты\"\n101\t    if isinstance(node, (ast.Assign, ast.AnnAssign, ast.AugAssign)):\n102\t        return \", \".join(ast.unparse(t) for t in getattr(node, \"targets\", None) or [node.target])\n103\t    if isinstance(node, ast.Expr) and isinstance(node.value, ast.Constant) and isinstance(node.value.value, str):\n104\t        return \"описание модуля\"\n105\t    return \"код модуля\"\n106\t\n107\t\n108\tdef split_code(file, text):\n109\t    \"\"\"Фрагменты Python: функция или класс целиком, импорты и константы между ними — вместе; комментарий\n110\t    над узлом — с ним. У фрагмента — номера строк: на них ссылается ревью.\"\"\"\n111\t    lines = text.splitlines()\n112\t    try:\n113\t        nodes = ast.parse(text).body\n114\t    except SyntaxError:\n115\t        nodes = []\n116\t    groups, start = [], 1  # [названия, первая строка, последняя строка, отдельный ли узел]\n117\t    for node in nodes:\n118\t        whole = isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef))\n119\t        last = groups[-1] if groups else None\n120\t        if last and not whole and not last[3] and len(\"\\n\".join(lines[last[1] - 1:node.end_lineno])) <= MAX_CODE:\n121\t            last[0].append(_label(node))\n122\t            last[2] = node.end_lineno\n123\t        else:\n124\t            groups.append([[_label(node)], start, node.end_lineno, whole])\n125\t        start = node.end_lineno + 1\n126\t    if not groups and lines:\n127\t        groups.append([[\"код модуля\"], 1, len(lines), False])\n128\t    for labels, first, end, _ in groups:\n129\t        while first < end and not lines[first - 1].strip():\n130\t            first += 1\n131\t        title = \", \".join(dict.fromkeys(labels))\n132\t        piece = first\n133\t        for n in range(first, end + 1):  # длинный фрагмент — по строкам\n134\t            if n > piece and len(\"\\n\".join(lines[piece - 1:n])) > MAX_CODE:\n135\t                yield {\"file\": file, \"title\": title, \"text\": \"\\n\".join(lines[piece - 1:n - 1]),\n136\t                       \"kind\": \"code\", \"lines\": [piece, n - 1]}\n137\t                piece = n\n138\t        yield {\"file\": file, \"title\": title, \"text\": \"\\n\".join(lines[piece - 1:end]), \"kind\": \"code\",\n139\t               \"lines\": [piece, end]}\n140\t\n141\t\n142\tdef split(file, text):\n143\t    return split_code(file, text) if file.endswith(\".py\") else split_docs(file, text)\n144\t\n145\t\n146\tdef source(chunk):\n147\t    \"\"\"Заголовок фрагмента для промпта и ссылок: файл › раздел, у кода — ещё строки.\"\"\"\n148\t    lines = f\", строки {chunk['lines'][0]}–{chunk['lines'][1]}\" if chunk.get(\"lines\") else \"\"\n149\t    return f\"{chunk['file']} › {chunk['title']}{lines}\"\n150\t\n151\t\n152\tdef _key(chunk):\n153\t    return hashlib.sha256(f\"{config.EMBED_MODEL}|{chunk['file']}|{chunk['title']}|{chunk['text']}\".encode()).hexdigest()\n154\t\n155\t\n156\tdef _embedded(chunk):\n157\t    \"\"\"Текст для вектора; у кода — с путём файла: запросы ревью тоже начинаются с пути.\"\"\"\n158\t    if chunk[\"kind\"] == \"code\":\n159\t        return f\"{chunk['file']} › {chunk['title']}\\n\\n{chunk['text']}\"\n160\t    return f\"{chunk['title']}\\n\\n{chunk['text']}\"\n161\t\n162\t\n163\tclass Index:\n164\t    \"\"\"Фрагменты и их векторы. Векторы кэшируются в data/<cache>.json: поменялись файлы —\n165\t    пересчитываются только новые фрагменты.\"\"\"\n166\t\n167\t    def __init__(self, cache):\n168\t        self.cache = config.DATA_DIR / f\"{cache}.json\"\n169\t        self.fingerprint, self.chunks, self.matrix, self.built = None, [], None, None\n170\t\n171\t    async def build(self, texts):\n172\t        \"\"\"texts — {путь: текст}.\"\"\"\n173\t        fingerprint = hashlib.sha256(json.dumps(texts, sort_