e_result":{"type":"text","file":{"filePath":"C:\\Users\\USER\\AppData\\Local\\Temp\\claude-rules\\loop-v2\\app\\config.py","content":"\"\"\"Настройки ассистента: какой проект он объясняет, где Ollama и какие модели.\"\"\"\nimport os\nfrom pathlib import Path\n\nROOT = Path(__file__).parent.parent\n\n# Проект, о котором отвечает ассистент: его документация и git\nPROJECT_DIR = Path(os.getenv(\"PROJECT_DIR\", ROOT.parent / \"ml-student-dropout\")).resolve()\nDOCS = [\"README.md\", \"docs/*.md\"]\nCODE = [\"*.py\"]  # код проекта — в RAG ревью вместе с документацией\n\n# Поддержка: база знаний и CRM — JSON с клиентами и их обращениями\nFAQ = ROOT / \"support\" / \"faq.md\"\nCRM_FILE = Path(os.getenv(\"CRM_FILE\", ROOT / \"support\" / \"crm.json\"))\n\nOLLAMA_URL = os.getenv(\"OLLAMA_URL\", \"http://127.0.0.1:11434\")\nMODEL = os.getenv(\"MODEL\", \"qwen3.5:4b\")\nEMBED_MODEL = os.getenv(\"EMBED_MODEL\", \"bge-m3\")\nTOP = int(os.getenv(\"TOP\", \"3\"))  # фрагментов документации в промпт\n\nHOST = os.getenv(\"HOST\", \"127.0.0.1\")\nPORT = int(os.getenv(\"PORT\", \"8001\"))  # 8000 обычно занят самим ML-проектом\n# Для внутреннего обращения MCP используем localhost независимо от HOST (0.0.0.0 нельзя использовать как клиентский адрес)\n_mcp_host = \"127.0.0.1\" if HOST == \"0.0.0.0\" else HOST\nMCP_URL = f\"http://{_mcp_host}:{PORT}/mcp/git/\"\nCRM_MCP_URL = f\"http://{_mcp_host}:{PORT}/mcp/crm/\"\nFILES_MCP_URL = f\"http://{_mcp_host}:{PORT}/mcp/files/\"\nDATA_DIR = Path(os.getenv(\"DATA_DIR\", ROOT / \"data\"))\n\n# Запросы к себе (MCP) и к Ollama — мимо системного прокси\nos.environ[\"NO_PROXY\"] = \",\".join(filter(None, [os.getenv(\"NO_PROXY\"), \"127.0.0.1\", \"localhost\"]))\n","numLines":32,"startLine":1,"totalLines":32}},"tool_result_meta":[{"id":"toolu_2b2946eecf9d47dba9d27697","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
