{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_457377c8340245a297fb8203","type":"tool_result","content":"1\t\"\"\"Тесты app/support.py: формирование запросов к базе знаний и промпта для ответа поддержки.\"\"\"\n2\timport unittest\n3\t\n4\tfrom app import support\n5\t\n6\t\n7\tclass SupportQueriesTest(unittest.TestCase):\n8\t    \"\"\"Функция queries формирует запросы для поиска в базе знаний.\"\"\"\n9\t\n10\t    def test_queries_with_errors(self):\n11\t        \"\"\"Запросы включают вопрос клиента и тексты ошибок из технических данных.\"\"\"\n12\t        ticket = {'technical': {'body': {'error': 'валидация', 'details': 'body: ошибка'}}}\n13\t        result = support.queries('Почему 422?', ticket)\n14\t        self.assertEqual(result, ['Почему 422?', 'body: ошибка'])\n15\t\n16\t    def test_queries_without_errors(self):\n17\t        \"\"\"Без технических данных — только вопрос клиента.\"\"\"\n18\t        result = support.queries('Как работает дашборд?', None)\n19\t        self.assertEqual(result, ['Как работает дашборд?'])\n20\t\n21\t    def test_queries_deduplication(self):\n22\t        \"\"\"Повторяющиеся ошибки идут один раз.\"\"\"\n23\t        ticket = {'technical': {\n24\t            'body': {'details': 'ошибка'},\n25\t            'query': {'details': 'ошибка'}\n26\t        }}\n27\t        result = support.queries('Вопрос', ticket)\n28\t        self.assertEqual(result, ['Вопрос', 'ошибка'])\n29\t\n30\t\n31\tclass SupportContextTextTest(unittest.TestCase):\n32\t    \"\"\"Функция context_text формирует текст обращения для промпта.\"\"\"\n33\t\n34\t    def test_context_basic(self):\n35\t        \"\"\"Базовый контекст с клиентом и обращением.\"\"\"\n36\t        ticket = {'id': 'T-1041', 'subject': 'Ошибка', 'status': 'new', 'priority': 'high',\n37\t                  'created': '2026-10-21', 'message': 'Не работает', 'technical': {}}\n38\t        user = {'name': 'Иван', 'role': 'разработчик', 'org': 'Компания X',\n39\t                'channel': 'API', 'setup': 'Docker', 'notes': '', 'tickets': []}\n40\t        result = support.context_text(ticket, user)\n41\t        expected = (\"Клиент: Иван — разработчик, Компания X. Работает с сервисом через API: Docker.\\n\"\n42\t                    \"Обращение T-1041 «Ошибка» — new, приоритет high, 2026-10-21.\\n\"\n43\t                    \"Сообщение клиента: Не работает\")\n44\t        self.assertEqual(result, expected)\n45\t\n46\t    def test_context_with_notes(self):\n47\t        \"\"\"Заметки поддержки включаются в контекст.\"\"\"\n48\t        ticket = {'id': 'T-1', 'subject': 'Q', 'status': 'new', 'priority': 'low',\n49\t                  'created': '2026-01-01', 'message': 'M', 'technical': {}}\n50\t        user = {'name': 'Анна', 'role': 'аналитик', 'org': 'Org Y',\n51\t                'channel': 'дашборд', 'setup': 'браузер', 'notes': 'Важный клиент', 'tickets': []}\n52\t        result = support.context_text(ticket, user)\n53\t        self.assertIn('Заметки поддержки: Важный клиент', result)\n54\t\n55\t    def test_context_with_past_tickets(self):\n56\t        \"\"\"Прошлые обращения перечисляются с результатами.\"\"\"\n57\t        ticket = {'id': 'T-2', 'subject': 'Новое', 'status': 'open', 'priority': 'medium',\n58\t                  'created': '2026-10-22', 'message': 'Msg', 'technical': {}}\n59\t        user = {'name': 'Петр', 'role': 'user', 'org': 'Org',\n60\t                'channel': 'API', 'setup': 'curl', 'notes': '', 'tickets': [\n61\t                    {'id': 'T-1', 'subject': 'Старое', 'status': 'closed', 'resolution': 'fixed'}\n62\t                ]}\n63\t        result = support.context_text(ticket, user)\n64\t        self.assertIn('Прошлые обращения: T-1 «Старое» — closed: fixed', result)\n65\t\n66\t\n67\tclass SupportMessagesTest(unittest.TestCase):\n68\t    \"\"\"Функция messages формирует промпт для LLM.\"\"\"\n69\t\n70\t    def test_messages_structure(self):\n71\t        \"\"\"Промпт содержит системную роль, данные CRM, фрагменты и вопрос.\"\"\"\n72\t        hits = [{'file': 'README.md', 'title': 'Запуск', 'text': '# Запуск\\nКоманда uvicorn'}]\n73\t        result = support.messages('Как запустить?', 'Контекст', hits)\n74\t        self.assertEqual(len(result), 2)\n75\t        self.assertEqual(result[0]['role'], 'system')\n76\t        self.assertEqual(result[1]['role'], 'user')\n77\t\n78\t    def test_messages_fragments(self):\n79\t        \"\"\"Фрагменты форматированы как [файл › заголовок] текст.\"\"\"\n80\t        hits = [{'file': 'docs/guide.md', 'title': 'API', 'text': 'Эндпоинт /api'}]\n81\t        messages = support.messages('Вопрос', None, hits)\n82\t        user_content = messages[1]['content']\n83\t        self.assertIn('[docs/guide.md › API]', user_content)\n84\t        self.assertIn('Эндпоинт /api', user_content)\n85\t\n86\t    def test_messages_no_ticket(self):\n87\t        \"\"\"Без обращения используется заглушка NO_TICKET.\"\"\"\n88\t        result = support.messages('Вопрос', None, [])\n89\t        self.assertIn('Обращения нет:', result[1]['content'])\n90\t\n91\t\n92\tif __name__ == '__main__':\n93\t    unittest.main()\n94\t"}]},"parent_tool_use_id":"toolu_11bcfcaf24e84d0daf0c4086","agent_id":"a94a5ef29ea31e09d","session_id":"ed1f51e5-1483-4cbe-ab30-3d2c1fcf155e","uuid":"36bb3edc-776f-488a-91ad-461beffdfeb5","timestamp":"2026-10-24T23:34:55.398Z","tool_result_meta":[{"id":"toolu_457377c8340245a297fb8203","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"qa","task_description":"Написать тесты CRM MCP"}
