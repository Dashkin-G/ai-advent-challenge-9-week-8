2:00:00'},\n    ]\n}\ntemp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\njson.dump(crm_data, temp, ensure_ascii=False)\ntemp.close()\n\n# Проверяем что новые сверху (T-1003 должен быть первым)\nfrom app import crm_mcp, config\n\nwith patch.object(config, 'CRM_FILE', Path(temp.name)):\n    result = crm_mcp.list_tickets()\n\nassert result['tickets'][0]['id'] == 'T-1003', f'Ожидался T-1003 первым, got {result[\\\"tickets\\\"][0][\\\"id\\\"]}'\nprint('Test list_tickets new first: OK')\n\n# Проверка что get_ticket нормализует номер\ntry:\n    with patch.object(config, 'CRM_FILE', Path(temp.name)):\n        crm_mcp.get_ticket(' t-9999 ')\n    assert False, 'Должен был быть ToolError'\nexcept Exception as e:\n    assert str(e) == 'Обращения T-9999 нет в CRM', f'Неправильная ошибка: {e}'\n    print('Test get_ticket not found normalized: OK')\n\nos.unlink(temp.name)\nprint('All assertions passed!')\n\"","description":"Verify test coverage for sorting and normalization"}}],"terminal_reason":"completed","fast_mode_state":"off","fast_mode_disabled_reason":"sdk_opt_in_required","subagent_stats":{"spawned":1,"requested":{"background":0,"foreground":0,"unset":1},"started_in_background":1,"max_depth":1,"spawned_by_subagents":0,"completed":1,"failed":0,"killed":{"parent":0,"user":0,"system":0},"refused":{"depth_limit":0,"concurrency_limit":0,"budget":0},"by_type":{"qa":1}},"safety_stops":0,"is_error":false,"num_turns":46,"subtype":"success","api_error_status":null,"result":"Задача выполнена:\n\n**L-09. Тесты MCP-сервера CRM | профиль qa (тесты кода) | сделана — 17 тестов created в tests/test_crm_mcp.py, все проверки пройдены.**","ttft_ms":2648,"type":"result","duration_ms":242284,"uuid":"6e2e936d-1c0b-4166-8195-4d762cc100b7","ttft_stream_ms":2386,"time_to_request_ms":154,"first_content_frame_ms":2386,"queued_turn_count":0,"result_index":0,"model_usage_since_last_result":{"qwen3.5-122b-a10b":{"inputTokens":1770712,"outputTokens":20037,"cacheReadInputTokens":0