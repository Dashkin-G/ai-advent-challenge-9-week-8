{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_dfc91f2783614e678aa55179","type":"tool_result","content":"1\t\"\"\"MCP-сервер CRM поддержки: клиенты сервиса и их обращения из JSON-файла. Только чтение.\"\"\"\n2\timport json\n3\tfrom typing import Annotated, Any\n4\t\n5\tfrom mcp.server.mcpserver import MCPServer\n6\tfrom mcp.server.mcpserver.exceptions import ToolError\n7\tfrom pydantic import Field\n8\t\n9\tfrom app import config\n10\t\n11\tserver = MCPServer(\n12\t    name=\"crm\",\n13\t    version=\"1.0.0\",\n14\t    instructions=\"CRM поддержки сервиса «Риск отчисления студентов»: клиенты — сотрудники вузов — и их обращения \"\n15\t                 \"с техническими данными: запрос, ответ сервиса, лог. Инструменты только читают, ничего не меняют.\",\n16\t)\n17\t\n18\tCLOSED = {\"решён\"}\n19\t\n20\t\n21\tdef load():\n22\t    # файл читается на каждый вызов: правки CRM видны без перезапуска\n23\t    return json.loads(config.CRM_FILE.read_text(encoding=\"utf-8\"))\n24\t\n25\t\n26\tdef find(items, item_id, what):\n27\t    \"\"\"Поиск по ID; возвращает элемент или ToolError с нормализованным номером.\"\"\"\n28\t    item_id_norm = item_id.strip().upper()\n29\t    for item in items:\n30\t        if item[\"id\"] == item_id_norm:\n31\t            return item\n32\t    raise ToolError(f\"{what} {item_id_norm} нет в CRM\")\n33\t\n34\t\n35\t@server.tool()\n36\tdef list_tickets(\n37\t    include_closed: Annotated[bool, Field(description=\"Показать и решённые обращения\")] = False,\n38\t) -> dict[str, Any]:\n39\t    \"\"\"Очередь обращений, новые сверху: номер, тема, сообщение клиента, статус, приоритет, дата и клиент.\"\"\"\n40\t    crm = load()\n41\t    users = {u[\"id\"]: u for u in crm[\"users\"]}\n42\t    tickets = [{**{k: t[k] for k in (\"id\", \"subject\", \"message\", \"status\", \"priority\", \"created\")},\n43\t                \"user\": {k: users[t[\"user_id\"]][k] for k in (\"id\", \"name\", \"org\")}}\n44\t               for t in crm[\"tickets\"] if include_closed or t[\"status\"] not in CLOSED]\n45\t    tickets.sort(key=lambda t: t[\"created\"], reverse=True)\n46\t    return {\"count\": len(tickets), \"tickets\": tickets}\n47\t\n48\t\n49\t@server.tool()\n50\tdef get_ticket(ticket_id: Annotated[str, Field(description=\"Номер обращения, например T-1041\")]) -> dict[str, Any]:\n51\t    \"\"\"Обращение целиком: сообщение клиента, статус, приоритет и технические данные — запрос, ответ сервиса, лог.\"\"\"\n52\t    return find(load()[\"tickets\"], ticket_id, \"Обращения\")\n53\t\n54\t\n55\t@server.tool()\n56\tdef find_tickets(\n57\t    query: Annotated[str, Field(description=\"Текст поиска: номер, тема, сообщение, имя клиента или вуз\")] = \"\",\n58\t) -> dict[str, Any]:\n59\t    \"\"\"Ищет обращения без учёта регистра по номеру, теме, сообщению, имени клиента и вузу; новые сверху.\"\"\"\n60\t    query_norm = query.strip().lower()\n61\t    if not query_norm:\n62\t        raise ToolError(\"Введите текст поиска\")\n63\t\n64\t    crm = load()\n65\t    users = {u[\"id\"]: u for u in crm[\"users\"]}\n66\t    found = []\n67\t    for t in crm[\"tickets\"]:\n68\t        user = users.get(t[\"user_id\"], {})\n69\t        text = (\n70\t            str(t[\"id\"]).lower() + \" \" +\n71\t            str(t.get(\"subject\", \"\")).lower() + \" \" +\n72\t            str(t.get(\"message\", \"\")).lower() + \" \" +\n73\t            str(user.get(\"name\", \"\")).lower() + \" \" +\n74\t            str(user.get(\"org\", \"\")).lower()\n75\t        )\n76\t        if query_norm in text:\n77\t            found.append({\n78\t                **{k: t[k] for k in (\"id\", \"subject\", \"message\", \"status\", \"priority\", \"created\")},\n79\t                \"user\": {k: user[k] for k in (\"id\", \"name\", \"org\")}\n80\t            })\n81\t    found.sort(key=lambda t: t[\"created\"], reverse=True)\n82\t    return {\"count\": len(found), \"tickets\": found}\n83\t\n84\t\n85\t@server.tool()\n86\tdef get_user(user_id: Annotated[str, Field(description=\"Номер клиента, например U-01\")]) -> dict[str, Any]:\n87\t    \"\"\"Клиент: вуз, роль, как работает с сервисом, заметки поддержки и все его обращения с решениями.\"\"\"\n88\t    crm = load()\n89\t    user = find(crm[\"users\"], user_id, \"Клиента\")\n90\t    tickets = [{k: t[k] for k in (\"id\", \"subject\", \"status\", \"created\", \"resolution\") if k in t}\n91\t               for t in crm[\"tickets\"] if t[\"user_id\"] == user[\"id\"]]\n92\t    return {**user, \"tickets\": tickets}\n93\t"}]},"parent_tool_use_id":null,"session_id":"ed1f51e5-1483-4cbe-ab30-3d2c1fcf155e","uuid":"6237cb16-c62d-4824-9439-b3227c87afa8","timestamp":"2026-10-24T23:34:49.777Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\USER\\AppData\\Local\\Temp\\claude-rules\\loop-v2\\app\\crm_mcp.py","content":"\"\"\"MCP-сервер CRM поддержки: клиенты сервиса и их обращения из JSON-файла. Только чтение.\"\"\"\nimport json\nfrom typing import Annotated, Any\n\nfrom mcp.server.mcpserver import MCPServer\nfrom mcp.server.mcpserver.exceptions import ToolError\nfrom pydantic import Field\n\nfrom app import config\n\nserver = MCPServer(\n    name=\"crm\",\n    version=\"1.0.0\",\n    instructions=\"CRM поддержки сервиса «Риск отчисления студентов»: клиенты — сотрудники вузов — и их обращения \"\n                 \"с техническими данными: запрос, ответ сервиса, лог. Инструменты только читают, ничего не меняют.\",\n)\n\nCLOSED = {\"решён\"}\n\n\ndef load():\n    # файл читается на каждый вызов: правки CRM видны без перезапуска\n    return json.loads(config.CRM_FILE.read_text(encoding=\"utf-8\"))\n\n\ndef find(items, item_id, what):\n    \"\"\"Поиск по ID; возвращает элемент или ToolError с нормализованным номером.\"\"\"\n    item_id_norm = item_id.strip().upper()\n    for item in items:\n        if item[\"id\"] == item_id_norm:\n            return item\n    raise ToolError(f\"{what} {item_id_norm} нет в CRM\")\n\n\n@server.tool()\ndef list_tickets(\n    include_closed: Annotated[bool, Field(description=\"Показать и решённые обращения\")] = False,\n) -> dict[str, Any]:\n    \"\"\"Очередь обращений, новые сверху: номер, тема, сообщение клиента, статус, приоритет, дата и клиент.\"\"\"\n    crm = load()\n    users = {u[\"id\"]: u for u in crm[\"users\"]}\n    tickets = [{**{k: t[k] for k in (\"id\", \"subject\", \"message\", \"status\", \"priority\", \"created\")},\n                \"user\": {k: users[t[\"user_id\"]][k] for k in (\"id\", \"name\", \"org\")}}\n               for t in crm[\"tickets\"] if include_closed or t[\"status\"] not in CLOSED]\n    tickets.sort(key=lambda t: t[\"created\"], reverse=True)\n    return {\"count\": len(tickets), \"tickets\": tickets}\n\n\n@server.tool()\ndef get_ticket(ticket_id: Annotated[str, Field(description=\"Номер обращения, например T-1041\")]) -> dict[str, Any]:\n    \"\"\"Обращение целиком: сообщение клиента, статус, приоритет и технические данные — запрос, ответ сервиса, лог.\"\"\"\n    return find(load()[\"tickets\"], ticket_id, \"Обращения\")\n\n\n@server.tool()\ndef find_tickets(\n    query: Annotated[str, Field(description=\"Текст поиска: номер, тема, сообщение, имя клиента или вуз\")] = \"\",\n) -> dict[str, Any]:\n    \"\"\"Ищет обращения без учёта регистра по номеру, теме, сообщению, имени клиента и вузу; новые сверху.\"\"\"\n    query_norm = query.strip().lower()\n    if not query_norm:\n        raise ToolError(\"Введите текст поиска\")\n\n    crm = load()\n    users = {u[\"id\"]: u for u in crm[\"users\"]}\n    found = []\n    for t in crm[\"tickets\"]:\n        user = users.get(t[\"user_id\"], {})\n        text = (\n            str(t[\"id\"]).lower() + \" \" +\n            str(t.get(\"subject\", \"\")).lower() + \" \" +\n            str(t.get(\"message\", \"\")).lower() + \" \" +\n            str(user.get(\"name\", \"\")).lower() + \" \" +\n            str(user.get(\"org\", \"\")).lower()\n        )\n        if query_norm in text:\n            found.append({\n                **{k: t[k] for k in (\"id\", \"subject\", \"message\", \"status\", \"priority\", \"created\")},\n                \"user\": {k: user[k] for k in (\"id\", \"name\", \"org\")}\n            })\n    found.sort(key=lambda t: t[\"created\"], reverse=True)\n    return {\"count\": len(found), \"tickets\": found}\n\n\n@server.tool()\ndef get_user(user_id: Annotated[str, Field(description=\"Номер клиента, например U-01\")]) -> dict[str, Any]:\n    \"\"\"Клиент: вуз, роль, как работает с сервисом, заметки поддержки и все его обращения с решениями.\"\"\"\n    crm = load()\n    user = find(crm[\"users\"], user_id, \"Клиента\")\n    tickets = [{k: t[k] for k in (\"id\", \"subject\", \"status\", \"created\", \"resolution\") if k in t}\n               for t in crm[\"tickets\"] if t[\"user_id\"] == user[\"id\"]]\n    return {**user, \"tickets\": tickets}\n","numLines":93,"startLine":1,"totalLines":93}},"tool_result_meta":[{"id":"toolu_dfc91f2783614e678aa55179","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
