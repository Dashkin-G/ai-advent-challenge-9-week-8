 'CRM_FILE', new=tempfile.NamedTemporaryFile(suffix='.json', delete=False))","+    def test_find_by_name(self):","+        \"\"\"Поиск по имени «ветров» → T-1041, T-1033 в таком порядке.\"\"\"","+        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)","+        json.dump(self.crm_data, temp, ensure_ascii=False)","+        temp.close()"," ","-    def test_search_by_user_name(self):","-        \"\"\"Находит тикет по имени клиента.\"\"\"","-        with patch.object(config, \"CRM_FILE\", self.crm_file):","-            result = crm_mcp.find_tickets(\"иван\")","-        self.assertEqual(result[\"count\"], 1)","+        with patch.object(crm_mcp.config, 'CRM_FILE', temp.name):","+            result = crm_mcp.find_tickets(\"ветров\")","+","+        self.assertEqual(result[\"count\"], 2)","         self.assertEqual(result[\"tickets\"][0][\"id\"], \"T-1041\")","+        self.assertEqual(result[\"tickets\"][1][\"id\"], \"T-1033\")","+        os.unlink(temp.name)"," ","-    def test_search_by_ticket_number(self):","-        \"\"\"Находит тикет по номеру без учёта регистра.\"\"\"","-        with patch.object(config, \"CRM_FILE\", self.crm_file):","-            result = crm_mcp.find_tickets(\"t-1042\")","+    @patch.object(crm_mcp.config, 'CRM_FILE', new=tempfile.NamedTemporaryFile(suffix='.json', delete=False))","+    def test_find_by_ticket_number(self):","+        \"\"\"Поиск по номеру «t-1045» → только T-1045.\"\"\"","+        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)","+        json.dump(self.crm_data, temp, ensure_ascii=False)","+        temp.close()","+","+        with patch.object(crm_mcp.config, 'CRM_FILE', temp.name):","+            result = crm_mcp.find_tickets(\"t-1045\")","+","         self.assertEqual(result[\"count\"], 1)","-        self.assertEqual(result[\"tickets\"][0][\"id\"], \"T-1042\")","+        self.assertEqual(result[\"tickets\"][0][\"id\"], \"T-1045\")","+        os.unlink(temp.name)"," ","-    def test_empty_query_raises_error(self):","-        \"\"\"ToolError при пустом запросе поиска.\"\"\"","-        with patch.object(config, \"CRM_FILE\", self.crm_file):","-            with self.assertRaises(ToolError):","+    @patch.object(crm_mcp.config, 'CRM_FILE', new=tempfile.NamedTemporaryFile(suffix='.json', delete=False))","+    def test_find_empty_query(self):","+        \"\"\"Пустой запрос — ToolError.\"\"\"","+        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)","+        json.dump(self.crm_data, temp, ensure_ascii=False)","+        temp.close()","+","+        with patch.object(crm_mcp.config, 'CRM_FILE', temp.name):","+            with self.assertRaises(ToolError) as ctx:","                 crm_mcp.find_tickets(\"\")"," ","+        self.assertEqual(str(ctx.exception), \"Введите текст поиска\")","+        os.unlink(temp.name)"," ","+    @patch.object(crm_mcp.config, 'CRM_FILE', new=tempfile.NamedTemporaryFile(suffix='.json', delete=False))","+    def test_find_whitespace_only(self):","+        \"\"\"Одни пробелы — ToolError.\"\"\"","+        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)","+        json.dump(self.crm_data, temp, ensure_ascii=False)","+        temp.close()","+","+        with patch.object(crm_mcp.config, 'CRM_FILE', temp.name):","+            with self.assertRaises(ToolError) as ctx:","+                crm_mcp.find_tickets(\"   \")","+","+        self.assertEqual(str(ctx.exception), \"Введите текст поиска\")","+        os.unlink(temp.name)","+","+    @patch.object(crm_mcp.config, 'CRM_FILE', new=tempfile.NamedTemporaryFile(suffix='.json', delete=False))","+    def test_find_newest_first(self):","+        \"\"\"Результаты сортированы новыми сверху.\"\"\"","+        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)","+        json.dump(self.crm_data, temp, ensure_ascii=False)","+        temp.close()","+","+        with patch.object(crm_mcp.config, 'CRM_FILE', temp.name):","+            result = crm_mcp.find_tickets(\"и\")  # попадёт в Иван и МГУ","+","+        # T-1041 (01-05) раньше T-1033 (01-03)","+        if len(result[\"tickets\"]) >= 2:","+            self.assertEqual(result[\"tickets\"][0][\"id\"], \"T-1041\")","+            self.assertEqual(result[\"tickets\"][1][\"id\"], \"T-1033\")","+        os.unlink(temp.name)","+","+"," if __name__ == '__main__':","     unittest.main()"]}],"originalFile":"\"\"\"Тесты app/crm_mcp.py: инструменты CRM поддержки — очередь тикетов, поиск, клиенты.\"\"\"\nimport json\nimport tempfile\nimport unittest\nfrom pathlib import Path\nfrom unittest.mock import patch\n\nfrom mcp.server.mcpserver.exceptions import ToolError\n\nfrom app import config, crm_mcp\n\n\nclass ListTicketsTest(unittest.TestCase):\n    \"\"\"list_tickets возвращает открытые тикеты новые сверху; с include_closed — все.\"\"\"\n\n    def setUp(self):\n        \"\"\"Подготовка временного CRM файла.\"\"\"\n        self.crm_data = {\n            \"users\": [\n                {\"id\": \"U-01\", \"name\": \"Иван\", \"org\": \"Вуз А\"},\n                {\"id\": \"U-02\", \"name\": \"Анна\", \"org\": \"Вуз Б\"}\n            ],\n            \"tickets\": [\n                {\"id\": \"T-1041\", \"subject\": \"Ошибка 422\", \"message\": \"Не работает API\",\n                 \"status\": \"new\", \"priority\": \"high\", \"created\": \"2026-10-20\", \"user_id\": \"U-01\"},\n                {\"id\": \"T-1042\", \"subject\": \"Вопрос по RAG\", \"message\": \"Как настроить?\",\n                 \"status\": \"open\", \"priority\": \"medium\", \"created\": \"2026-10-21\", \"user_id\": \"U-02\"},\n                {\"id\": \"T-1043\", \"subject\": \"Решённый\", \"message\": \"Была проблема\",\n                 \"status\": \"решён\", \"priority\": \"low\", \"created\": \"2026-10-19\", \"user_id\": \"U-01\"}\n            ]\n        }\n        self.tmp_dir = tempfile.TemporaryDirectory()\n        self.crm_file = Path(self.tmp_dir.name) / \"crm.json\"\n        self.crm_file.write_text(json.dumps(self.crm_data, ensure_ascii=False), encoding=\"utf-8\")\n\n    def tearDown(self):\n        \"\"\"Очистка временной папки.\"\"\"\n        self.tmp_dir.cleanup()\n\n    def test_open_only_newest_first(self):\n        \"\"\"Открытые тикеты идут новыми сверху без решённых.\"\"\"\n        with patch.object(config, \"CRM_FILE\", self.crm_file):\n            result = crm_mcp.list_tickets()\n        self.assertEqual(result[\"count\"], 2)\n        ids_order = [t[\"id\"] for t in result[\"tickets\"]]\n        self.assertEqual(ids_order, [\"T-1042\", \"T-1041\"])\n\n    def test_include_closed_all_tickets(self):\n        \"\"\"С include_closed=True показаны все тикеты включая решённые.\"\"\"\n        with patch.object(config, \"CRM_FILE\", self.crm_file):\n            result = crm_mcp.list_tickets(include_closed=True)\n        self.assertEqual(result[\"count\"], 3)\n        ids = [t[\"id\"] for t in result[\"tickets\"]]\n        self.assertIn(\"T-1043\", ids)\n\n    def test_ticket_contains_user_info(self):\n        \"\"\"Каждый тикет содержит информацию о клиенте.\"\"\"\n        with patch.object(config, \"CRM_FILE\", self.crm_file):\n            result = crm_mcp.list_tickets()\n        first_ticket = result[\"tickets\"][0]\n        self.assertEqual(first_ticket[\"user\"][\"name\"], \"Анна\")\n        self.assertEqual(first_ticket[\"user\"][\"org\"], \"Вуз Б\")\n\n\nclass GetTicketTest(unittest.TestCase):\n    \"\"\"get_ticket находит обращение по номеру;ToolError если нет такого.\"\"\"\n\n    def setUp(self):\n        \"\"\"Подготовка временного CRM файла.\"\"\"\n        self.crm_data = {\n            \"users\": [{\"id\": \"U-01\", \"name\": \"Иван\", \"org\": \"Вуз А\"}],\n            \"tickets\": [\n                {\"id\": \"T-1041\", \"subject\": \"Ошибка 422\", \"message\": \"Не работает\",\n                 \"status\": \"new\", \"priority\": \"high\", \"created\": \"2026-10-20\", \"user_id\": \"U-01\",\n                 \"request\": \"POST /api\", \"response\": \"422\", \"log\": \"validation error\"}\n            ]\n        }\n        self.tmp_dir = tempfile.TemporaryDirectory()\n        self.crm_file = Path(self.tmp_dir.name) / \"crm.json\"\n        self.crm_file.write_text(json.dumps(self.crm_data, ensure_ascii=False), encoding=\"utf-8\")\n\n    def tearDown(self):\n        \"\"\"Очистка временной папки.\"\"\"\n        self.tmp_dir.cleanup()\n\n    def test_find_by_exact_id(self):\n        \"\"\"Находит тикет по точному номеру.\"\"\"\n        with patch.object(config, \"CRM_FILE\", self.crm_file):\n            result = crm_mcp.get_ticket(\"T-1041\")\n        self.assertEqual(result[\"id\"], \"T-1041\")\n        self.assertEqual(result[\"subject\"], \"Ошибка 422\")\n\n    def test_normalize_case_and_spaces(self):\n        \"\"\"Нормализует номер к верхнему регистру без пробелов.\"\"\"\n        with patch.object(config, \"CRM_FILE\", self.crm_file):\n            result = crm_mcp.get_ticket(\"  t-1041  \")\n        self.assertEqual(result[\"id\"], \"T-1041\")\n\n    def test_not_found_raises_tool_error(self):\n        \"\"\"ToolError если тикета с таким номером нет.\"\"\"\n        with patch.object(config, \"CRM_FILE\", self.crm_file):\n            with self.assertRaises(ToolError) as ctx:\n                crm_mcp.get_ticket(\"T-9999\")\n        self.assertIn(\"T-9999\", str(ctx.exception))\n\n\nclass GetUserTest(unittest.TestCase):\n    \"\"\"get_user находит клиента;ToolError если нет такого.\"\"\"\n\n    def setUp(self):\n        \"\"\"Подготовка временного CRM файла.\"\"\"\n        self.crm_data = {\n            \"users\": [\n                {\"id\": \"U-01\", \"name\": \"Иван\", \"org\": \"Вуз А\", \"role\": \"разработчик\",\n                 \"channel\": \"API\", \"setup\": \"Docker\", \"notes\": \"\"},\n                {\"id\": \"U-02\", \"name\": \"Анна\", \"org\": \"Вуз Б\", \"role\": \"аналитик\",\n                 \"channel\": \"дашборд\", \"setup\": \"браузер\", \"notes\": \"VIP\"}\n            ],\n            \"tickets\": [\n                {\"id\": \"T-1041\", \"subject\": \"Ошибка\", \"status\": \"new\",\n                 \"created\": \"2026-10-20\", \"resolution\": \"\", \"user_id\": \"U-01\"},\n                {\"id\": \"T-1042\", \"subject\": \"Вопрос\", \"status\": \"решён\",\n                 \"created\": \"2026-10-19\", \"resolution\": \"fixed\", \"user_id\": \"U-01\"}\n            ]\n        }\n        self.tmp_dir = tempfile.TemporaryDirectory()\n        self.crm_file = Path(self.tmp_dir.name) / \"crm.json\"\n        self.crm_file.write_text(json.dumps(self.crm_data, ensure_ascii=False), encoding=\"utf-8\")\n\n    def tearDown(self):\n        \"\"\"Очистка временной папки.\"\"\"\n        self.tmp_dir.cleanup()\n\n    def test_find_by_exact_id(self):\n        \"\"\"Находит клиента по точному номеру.\"\"\"\n        with patch.object(config, \"CRM_FILE\", self.crm_file):\n            result = crm_mcp.get_user(\"U-01\")\n        self.assertEqual(result[\"id\"], \"U-01\")\n        self.assertEqual(result[\"name\"], \"Иван\")\n\n    def test_normalize_case_and_spaces(self):\n        \"\"\"Нормализует номер к верхнему регистру без пробелов.\"\"\"\n        with patch.object(config, \"CRM_FILE\", self.crm_file):\n            result = crm_mcp.get_user(\"  u-01  \")\n        self.assertEqual(result[\"id\"], \"U-01\")\n\n    def test_not_found_raises_tool_error(self):\n        \"\"\"ToolError если клиента с таким номером нет.\"\"\"\n        with patch.object(config, \"CRM_FILE\", self.crm_file):\n            with self.assertRaises(ToolError) as ctx:\n                crm_mcp.get_user(\"U-9999\")\n        self.assertIn(\"U-9999\", str(ctx.exception))\n\n    def test_user_has_their_tickets(self):\n        \"\"\"Клиент получает список своих обращений.\"\"\"\n        with patch.object(config, \"CRM_FILE\", self.crm_file):\n            result = crm_mcp.get_user(\"U-01\")\n        ticket_ids = [t[\"id\"] for t in result[\"tickets\