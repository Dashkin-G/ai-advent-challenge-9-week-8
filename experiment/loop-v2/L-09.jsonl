elf.assertEqual(result[\"tickets\"][0][\"id\"], \"T-1003\")\n        self.assertEqual(result[\"tickets\"][1][\"id\"], \"T-1001\")\n        os.unlink(temp.name)","originalFile":"\"\"\"Тесты app/crm_mcp.py: list_tickets, get_ticket, get_user, find_tickets.\"\"\"\nimport json\nimport tempfile\nimport unittest\nfrom pathlib import Path\nfrom unittest.mock import patch\n\nfrom mcp.server.mcpserver.exceptions import ToolError\n\nfrom app import crm_mcp\n\n\nclass TestListTickets(unittest.TestCase):\n    \"\"\"list_tickets возвращает открытые обращения новыми сверху; include_closed=True — все.\"\"\"\n\n    def setUp(self):\n        \"\"\"Подготовка временного CRM-файла.\"\"\"\n        self.crm_data = {\n            \"users\": [\n                {\"id\": \"U-01\", \"name\": \"Иван Петров\", \"org\": \"МГУ\"},\n                {\"id\": \"U-02\", \"name\": \"Анна Сидорова\", \"org\": \"СПбГУ\"},\n            ],\n            \"tickets\": [\n                {\"id\": \"T-1001\", \"user_id\": \"U-01\", \"subject\": \"Проблема 1\", \"message\": \"Сообщение 1\",\n                 \"status\": \"открыт\", \"priority\": \"высокий\", \"created\": \"2024-01-01T10:00:00\"},\n                {\"id\": \"T-1002\", \"user_id\": \"U-02\", \"subject\": \"Проблема 2\", \"message\": \"Сообщение 2\",\n                 \"status\": \"решён\", \"priority\": \"средний\", \"created\": \"2024-01-02T11:00:00\"},\n                {\"id\": \"T-1003\", \"user_id\": \"U-01\", \"subject\": \"Проблема 3\", \"message\": \"Сообщение 3\",\n                 \"status\": \"открыт\", \"priority\": \"низкий\", \"created\": \"2024-01-03T12:00:00\"},\n            ]\n        }\n        self.temp_file = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, self.temp_file, ensure_ascii=False)\n        self.temp_file.close()\n\n    def tearDown(self):\n        \"\"\"Удаление временного файла.\"\"\"\n        import os\n        os.unlink(self.temp_file.name)\n\n    @patch.object(crm_mcp.config, 'CRM_FILE', new=tempfile.NamedTemporaryFile(suffix='.json', delete=False))\n    def test_list_tickets_only_open_newest_first(self):\n        \"\"\"Без include_closed — только открытые, новые сверху: T-1003, T-1001.\"\"\"\n        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, temp, ensure_ascii=False)\n        temp.close()\n\n        with patch.object(crm_mcp.config, 'CRM_FILE', temp.name):\n            result = crm_mcp.list_tickets()\n\n        self.assertEqual(result[\"count\"], 2)\n        self.assertEqual(result[\"tickets\"][0][\"id\"], \"T-1003\")\n        self.assertEqual(result[\"tickets\"][1][\"id\"], \"T-1001\")\n        os.unlink(temp.name)\n\n    @patch.object(crm_mcp.config, 'CRM_FILE', new=tempfile.NamedTemporaryFile(suffix='.json', delete=False))\n    def test_list_tickets_include_closed(self):\n        \"\"\"С include_closed=True — все обращения, новые сверху: T-1003, T-1002, T-1001.\"\"\"\n        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, temp, ensure_ascii=False)\n        temp.close()\n\n        with patch.object(crm_mcp.config, 'CRM_FILE', temp.name):\n            result = crm_mcp.list_tickets(include_closed=True)\n\n        self.assertEqual(result[\"count\"], 3)\n        self.assertEqual(result[\"tickets\"][0][\"id\"], \"T-1003\")\n        self.assertEqual(result[\"tickets\"][1][\"id\"], \"T-1002\")\n        self.assertEqual(result[\"tickets\"][2][\"id\"], \"T-1001\")\n        os.unlink(temp.name)\n\n    @patch.object(crm_mcp.config, 'CRM_FILE', new=tempfile.NamedTemporaryFile(suffix='.json', delete=False))\n    def test_list_tickets_user_info(self):\n        \"\"\"Каждое обращение содержит user с id, name, org.\"\"\"\n        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, temp, ensure_ascii=False)\n        temp.close()\n\n        with patch.object(crm_mcp.config, 'CRM_FILE', temp.name):\n            result = crm_mcp.list_tickets()\n\n        ticket = result[\"tickets\"][0]\n        self.assertIn(\"user\", ticket)\n        self.assertEqual(ticket[\"user\"][\"id\"], \"U-01\")\n        self.assertEqual(ticket[\"user\"][\"name\"], \"Иван Петров\")\n        self.assertEqual(ticket[\"user\"][\"org\"], \"МГУ\")\n        os.unlink(temp.name)\n\n\nclass TestGetTicket(unittest.TestCase):\n    \"\"\"get_ticket находит обращение по номеру без учёта регистра и пробелов.\"\"\"\n\n    def setUp(self):\n        \"\"\"Подготовка временного CRM-файла.\"\"\"\n        self.crm_data = {\n            \"users\": [{\"id\": \"U-01\", \"name\": \"Иван\", \"org\": \"Вуз\"}],\n            \"tickets\": [\n                {\"id\": \"T-1041\", \"user_id\": \"U-01\", \"subject\": \"Тема\", \"message\": \"Сообщение\",\n                 \"status\": \"открыт\", \"priority\": \"высокий\", \"created\": \"2024-01-01T10:00:00\",\n                 \"query\": \"Запрос\", \"response\": \"Ответ\", \"log\": \"Лог\"}\n            ]\n        }\n        self.temp_file = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, self.temp_file, ensure_ascii=False)\n        self.temp_file.close()\n\n    def tearDown(self):\n        \"\"\"Удаление временного файла.\"\"\"\n        import os\n        os.unlink(self.temp_file.name)\n\n    @patch.object(crm_mcp.config, 'CRM_FILE', new=tempfile.NamedTemporaryFile(suffix='.json', delete=False))\n    def test_get_ticket_exact_match(self):\n        \"\"\"Точное совпадение номера: T-1041.\"\"\"\n        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, temp, ensure_ascii=False)\n        temp.close()\n\n        with patch.object(crm_mcp.config, 'CRM_FILE', temp.name):\n            result = crm_mcp.get_ticket(\"T-1041\")\n\n        self.assertEqual(result[\"id\"], \"T-1041\")\n        self.assertEqual(result[\"subject\"], \"Тема\")\n        os.unlink(temp.name)\n\n    @patch.object(crm_mcp.config, 'CRM_FILE', new=tempfile.NamedTemporaryFile(suffix='.json', delete=False))\n    def test_get_ticket_case_insensitive(self):\n        \"\"\"Регистр не важен: t-1041 → T-1041.\"\"\"\n        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, temp, ensure_ascii=False)\n        temp.close()\n\n        with patch.object(crm_mcp.config, 'CRM_FILE', temp.name):\n            result = crm_mcp.get_ticket(\"t-1041\")\n\n        self.assertEqual(result[\"id\"], \"T-1041\")\n        os.unlink(temp.name)\n\n    @patch.object(crm_mcp.config, 'CRM_FILE', new=tempfile.NamedTemporaryFile(suffix='.json', delete=False))\n    def test_get_ticket_whitespace_stripped(self):\n        \"\"\"Пробелы игнорируются: « t-1041 » → T-1041.\"\"\"\n        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, temp, ensure_ascii=False)\n        temp.close()\n\n        with patch.object(crm_mcp.config, 'CRM_FILE', temp.name):\n            result = crm_mcp.get_ticket(\" t-1041 \")\n\n        self.assertEqual(result[\"id\"], \"T-1041\")\n        os.unlink(temp.name)\n\n    @patch.object(crm_mcp.config, 'CRM_FILE', new=tempfile.NamedTemporaryFile(suffix='.json', delete=False))\n    def test_get_ticket_not_found(self):\n        \"\"\"Нет такого номера — ToolError с нормализованным числом T-9999.\"\"\"\n        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, temp, ensure_ascii=False)\n        temp.close()\n\n        with patch.object(crm_mcp.config, 'CRM_FILE', temp.name):\n            with self.assertRaises(ToolError) as ctx:\n                crm_mcp.get_ticket(\" t-9999 \")\n\n        self.assertEqual(str(ctx.exception), \"Обращения T-9999 нет в CRM\")\n        os.unlink(temp.name)\n\n\nclass TestGetUser(unittest.TestCase):\n    \"\"\"get_user находит клиента по номеру без учёта регистра и пробелов.\"\"\"\n\n    def setUp(self):\n        \"\"\"Подготовка временного CRM-файла.\"\"\"\n        self.crm_data = {\n            \"users\": [\n                {\"id\": \"U-01\", \"name\": \"Иван Петров\", \"org\": \"МГУ\", \"role\": \"оператор\",\n                 \"preferred_contact\": \"email\", \"notes\": \"Заметка\"},\n            ],\n            \"tickets\": [\n                {\"id\": \"T-1001\", \"user_id\": \"U-01\", \"subject\": \"Тема 1\", \"status\": \"открыт\",\n                 \"created\": \"2024-01-01T10:00:00\", \"resolution\": \"Решено 1\"},\n                {\"id\": \"T-1002\", \"user_id\": \"U-01\", \"subject\": \"Тема 2\", \"status\": \"решён\",\n                 \"created\": \"2024-01-02T11:00:00\"},\n            ]\n        }\n        self.temp_file = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, self.temp_file, ensure_ascii=False)\n        self.temp_file.close()\n\n    def tearDown(self):\n        \"\"\"Удаление временного файла.\"\"\"\n        import os\n        os.unlink(self.temp_file.name)\n\n    @patch.object(crm_mcp.config, 'CRM_FILE', new=tempfile.NamedTemporaryFile(suffix='.json', delete=False))\n    def test_get_user_exact_match(self):\n        \"\"\"Точное совпадение: U-01.\"\"\"\n        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, temp, ensure_ascii=False)\n        temp.close()\n\n        with patch.object(crm_mcp.config, 'CRM_FILE', temp.name):\n            result = crm_mcp.get_user(\"U-01\")\n\n        self.assertEqual(result[\"id\"], \"U-01\")\n        self.assertEqual(result[\"name\"], \"Иван Петров\")\n        self.assertEqual(result[\"org\"], \"МГУ\")\n        os.unlink(temp.name)\n\n    @patch.object(crm_mcp.config, 'CRM_FILE', new=tempfile.NamedTemporaryFile(suffix='.json', delete=False))\n    def test_get_user_case_insensitive(self):\n        \"\"\"Регистр не важен: u-01 → U-01.\"\"\"\n        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, temp, ensure_ascii=False)\n        temp.close()\n\n        with patch.object(crm_mcp.config, 'CRM_FILE', temp.name):\n            result = crm_mcp.get_user(\"u-01\")\n\n        self.assertEqual(result[\"id\"], \"U-01\")\n        os.unlink(temp.name)\n\n    @patch.object(crm_mcp.config, 'CRM_FILE', new=tempfile.NamedTemporaryFile(suffix='.json', delete=False))\n    def test_get_user_whitespace_stripped(self):\n        \"\"\"Пробелы игнорируются: « u-01 » → U-01.\"\"\"\n        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, temp, ensure_ascii=False)\n        temp.close()\n\n        with patch.object(crm_mcp.config, 'CRM_FILE', temp.name):\n            result = crm_mcp.get_user(\" u-01 \")\n\n        self.assertEqual(result[\"id\"], \"U-01\")\n        os.unlink(temp.name)\n\n    @patch.object(crm_mcp.config, 'CRM_FILE', new=tempfile.NamedTemporaryFile(suffix='.json', delete=False))\n    def test_get_user_not_found(self):\n        \"\"\"Нет такого клиента — ToolError с нормализованным номером U-99.\"\"\"\n        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, temp, ensure_ascii=False)\n        temp.close()\n\n        with patch.object(crm_mcp.config, 'CRM_FILE', temp.name):\n            with self.assertRaises(ToolError) as ctx:\n                crm_mcp.get_user(\" u-99 \")\n\n        self.assertEqual(str(ctx.exception), \"Клиента U-99 нет в CRM\")\n        os.unlink(temp.name)\n\n    @patch.object(crm_mcp.config, 'CRM_FILE', new=tempfile.NamedTemporaryFile(suffix='.json', delete=False))\n    def test_get_user_tickets(self):\n        \"\"\"В ответе есть список обращений пользователя.\"\"\"\n        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, temp, ensure_ascii=False)\n        temp.close()\n\n        with patch.object(crm_mcp.config, 'CRM_FILE', temp.name):\n            result = crm_mcp.get_user(\"U-01\")\n\n        self.assertIn(\"tickets\", result)\n        self.assertEqual(len(result[\"tickets\"]), 2)\n        os.unlink(temp.name)\n\n\nclass TestFindTickets(unittest.TestCase):\n    \"\"\"find_tickets ищет по номеру, теме, сообщению, имени и вузу; новые сверху.\"\"\"\n\n    def setUp(self):\n        \"\"\"Подготовка временного CRM-файла.\"\"\"\n        self.crm_data = {\n            \"users\": [\n                {\"id\": \"U-01\", \"name\": \"Иван Ветров\", \"org\": \"МГУ\"},\n                {\"id\": \"U-02\", \"name\": \"Анна Сидорова\", \"org\": \"СПбГУ\"},\n            ],\n            \"tickets\": [\n                {\"id\": \"T-1041\", \"user_id\": \"U-01\", \"subject\": \"Ошибка входа\", \"message\": \"Не могу войти\",\n                 \"status\": \"открыт\", \"priority\": \"высокий\", \"created\": \"2024-01-05T14:00:00\"},\n                {\"id\": \"T-1033\", \"user_id\": \"U-01\", \"subject\": \"Вопрос по тарифам\", \"message\": \"Как оплатить?\",\n                 \"status\": \"решён\", \"priority\": \"средний\", \"created\": \"2024-01-03T10:00:00\"},\n                {\"id\": \"T-1045\", \"user_id\": \"U-02\", \"subject\": \"Техническая проблема\", \"message\": \"Сломалось всё\",\n                 \"status\": \"открыт\", \"priority\": \"критический\", \"created\": \"2024-01-06T09:00:00\"},\n            ]\n        }\n        self.temp_file = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, self.temp_file, ensure_ascii=False)\n        self.temp_file.close()\n\n    def tearDown(self):\n        \"\"\"Удаление временного файла.\"\"\"\n        import os\n        os.unlink(self.temp_file.name)\n\n    @patch.object(crm_mcp.config, 'CRM_FILE', new=tempfile.NamedTemporaryFile(suffix='.json', delete=False))\n    def test_find_by_name(self):\n        \"\"\"Поиск по имени «ветров» → T-1041, T-1033 в таком порядке.\"\"\"\n        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, temp, ensure_ascii=False)\n        temp.close()\n\n        with patch.object(crm_mcp.config, 'CRM_FILE', temp.name):\n            result = crm_mcp.find_tickets(\"ветров\")\n\n        self.assertEqual(result[\"count\"], 2)\n        self.assertEqual(result[\"tickets\"][0][\"id\"], \"T-1041\")\n        self.assertEqual(result[\"tickets\"][1][\"id\"], \"T-1033\")\n        os.unlink(temp.name)\n\n    @patch.object(crm_mcp.config, 'CRM_FILE', new=tempfile.NamedTemporaryFile(suffix='.json', delete=False))\n    def test_find_by_ticket_number(self):\n        \"\"\"Поиск по номеру «t-1045» → только T-1045.\"\"\"\n        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, temp, ensure_ascii=False)\n        temp.close()\n\n        with patch.object(crm_mcp.config, 'CRM_FILE', temp.name):\n            result = crm_mcp.find_tickets(\"t-1045\")\n\n        self.assertEqual(result[\"count\"], 1)\n        self.assertEqual(result[\"tickets\"][0][\"id\"], \"T-1045\")\n        os.unlink(temp.name)\n\n    @patch.object(crm_mcp.config, 'CRM_FILE', new=tempfile.NamedTemporaryFile(suffix='.json', delete=False))\n    def test_find_empty_query(self):\n        \"\"\"Пустой запрос — ToolError.\"\"\"\n        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, temp, ensure_ascii=False)\n        temp.close()\n\n        with patch.object(crm_mcp.config, 'CRM_FILE', temp.name):\n            with self.assertRaises(ToolError) as ctx:\n                crm_mcp.find_tickets(\"\")\n\n        self.assertEqual(str(ctx.exception), \"Введите текст поиска\")\n        os.unlink(temp.name)\n\n    @patch.object(crm_mcp.config, 'CRM_FILE', new=tempfile.NamedTemporaryFile(suffix='.json', delete=False))\n    def test_find_whitespace_only(self):\n        \"\"\"Одни пробелы — ToolError.\"\"\"\n        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, temp, ensure_ascii=False)\n        temp.close()\n\n        with patch.object(crm_mcp.config, 'CRM_FILE', temp.name):\n            with self.assertRaises(ToolError) as ctx:\n                crm_mcp.find_tickets(\"   \")\n\n        self.assertEqual(str(ctx.exception), \"Введите текст поиска\")\n        os.unlink(temp.name)\n\n    @patch.object(crm_mcp.config, 'CRM_FILE', new=tempfile.NamedTemporaryFile(suffix='.json', delete=False))\n    def test_find_newest_first(self):\n        \"\"\"Результаты сортированы новыми сверху.\"\"\"\n        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, temp, ensure_ascii=False)\n        temp.close()\n\n        with patch.object(crm_mcp.config, 'CRM_FILE', temp.name):\n            result = crm_mcp.find_tickets(\"и\")  # попадёт в Иван и МГУ\n\n        # T-1041 (01-05) раньше T-1033 (01-03)\n        if len(result[\"tickets\"]) >= 2:\n            self.assertEqual(result[\"tickets\"][0][\"id\"], \"T-1041\")\n            self.assertEqual(result[\"tickets\"][1][\"id\"], \"T-1033\")\n        os.unlink(temp.name)\n\n\nif __name__ == '__main__':\n    unittest.main()\n","structuredPatch":[{"oldStart":38,"oldLines":14,"newStart":38,"newLines":14,"lines":["         import os","         os.unlink(self.temp_file.name)"," ","-    @patch.object(crm_mcp.config, 'CRM_FILE', new=tempfile.NamedTemporaryFile(suffix='.json', delete=False))","+    @patch.object(crm_mcp.config, 'CRM_FILE', new=Path(tempfile.NamedTemporaryFile(suffix='.json', delete=False).name))","     def test_list_tickets_only_open_newest_first(self):","         \"\"\"Без include_closed — только открытые, новые сверху: T-1003, T-1001.\"\"\"","         temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)","         json