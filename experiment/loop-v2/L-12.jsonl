{"type":"assistant","message":{"id":"msg_e217e299-cea0-9ee9-91de-c084a06ae4e3","type":"message","role":"assistant","model":"qwen3.5-122b-a10b","content":[{"type":"tool_use","id":"toolu_bc16cf9336964ed1a8466f77","name":"Write","input":{"file_path":"C:\\Users\\USER\\AppData\\Local\\Temp\\claude-rules\\loop-v2\\tests\\test_git_empty_repo.py","content":"\"\"\"Тесты app/git_mcp.py на пустом репозитории: git_branch и git_log.\"\"\"\nimport os\nimport subprocess\nimport tempfile\nimport unittest\nfrom pathlib import Path\nfrom unittest.mock import patch\n\nfrom app import config, git_mcp\n\n\nclass TestGitEmptyRepo(unittest.TestCase):\n    \"\"\"git_branch и git_log на пустом репозитории возвращают значения по умолчанию.\"\"\"\n\n    def setUp(self):\n        \"\"\"Создание временного git-репозитория без коммитов.\"\"\"\n        self.temp_dir = tempfile.mkdtemp()\n        subprocess.run([\"git\", \"init\", \"-q\"], cwd=self.temp_dir, check=True)\n        self.original_project_dir = config.PROJECT_DIR\n        config.PROJECT_DIR = Path(self.temp_dir)\n\n    def tearDown(self):\n        \"\"\"Очистка временной папки.\"\"\"\n        import shutil\n        shutil.rmtree(self.temp_dir, ignore_errors=True)\n        config.PROJECT_DIR = self.original_project_dir\n\n    @patch.object(git_mcp, 'git')\n    def test_git_branch_no_commits(self):\n        \"\"\"git_branch на пустом репозитории: branch — имя ветки, last_commit — «коммитов нет».\"\"\"\n        with patch.object(git_mcp, 'git', side_effect=[\n            \"master\\n\",           # branch --show-current\n            \"main\\nfeature\\n\",    # branch --format\n            ToolError(\"fatal: ... no commits yet\"),  # log -1\n        ]):\n            result = git_mcp.git_branch()\n\n        self.assertEqual(result[\"branch\"], \"master\")\n        self.assertEqual(result[\"last_commit\"], \"коммитов нет\")\n\n    def test_git_log_no_commits(self):\n        \"\"\"git_log на пустом репозитории: count 0 и empty commits.\"\"\"\n        with patch.object(git_mcp, 'git', side_effect=ToolError(\"fatal: ... no commits yet\")):\n            result = git_mcp.git_log()\n\n        self.assertEqual(result, {\"count\": 0, \"commits\": []})\n\n\nif __name__ == '__main__':\n    unittest.main()\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":15309,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"2c89cc0e-e853-420b-95de-b23eb454af39","uuid":"b68f595a-2d0f-4d7a-ac8e-2e8233a696a5","timestamp":"2026-10-24T23:45:05.925Z"}
