se)\n        temp.close()\n\n        with patch.object(crm_mcp.config, 'CRM_FILE', Path(temp.name)):\n            result = crm_mcp.get_ticket(\"t-1041\")\n\n        self.assertEqual(result[\"id\"], \"T-1041\")\n        os.unlink(temp.name)\n\n    @patch.object(crm_mcp.config, 'CRM_FILE', new=Path(tempfile.NamedTemporaryFile(suffix='.json', delete=False).name))\n    def test_get_ticket_whitespace_stripped(self):\n        \"\"\"Пробелы игнорируются: « t-1041 » → T-1041.\"\"\"\n        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, temp, ensure_ascii=False)\n        temp.close()\n\n        with patch.object(crm_mcp.config, 'CRM_FILE', Path(temp.name)):\n            result = crm_mcp.get_ticket(\" t-1041 \")\n\n        self.assertEqual(result[\"id\"], \"T-1041\")\n        os.unlink(temp.name)\n\n    @patch.object(crm_mcp.config, 'CRM_FILE', new=Path(tempfile.NamedTemporaryFile(suffix='.json', delete=False).name))\n    def test_get_ticket_not_found(self):\n        \"\"\"Нет такого номера — ToolError с нормализованным числом T-9999.\"\"\"\n        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, temp, ensure_ascii=False)\n        temp.close()\n\n        with patch.object(crm_mcp.config, 'CRM_FILE', Path(temp.name)):\n            with self.assertRaises(ToolError) as ctx:\n                crm_mcp.get_ticket(\" t-9999 \")\n\n        self.assertEqual(str(ctx.exception), \"Обращения T-9999 нет в CRM\")\n        os.unlink(temp.name)\n\n\nclass TestGetUser(unittest.TestCase):\n    \"\"\"get_user находит клиента по номеру без учёта регистра и пробелов.\"\"\"\n\n    def setUp(self):\n        \"\"\"Подготовка временного CRM-файла.\"\"\"\n        self.crm_data = {\n            \"users\": [\n                {\"id\": \"U-01\", \"name\": \"Иван Петров\", \"org\": \"МГУ\", \"role\": \"оператор\",\n                 \"preferred_contact\": \"email\", \"notes\": \"Заметка