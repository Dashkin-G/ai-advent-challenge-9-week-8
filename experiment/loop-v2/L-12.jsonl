     result = git_mcp.git_log()\n\n        self.assertEqual(result, {\"count\": 0, \"commits\": []})\n\n\nif __name__ == '__main__':\n    unittest.main()\n","structuredPatch":[{"oldStart":31,"oldLines":7,"newStart":31,"newLines":7,"lines":["         def side_eff(*args):","             if args == (\"branch\", \"--show-current\"):","                 return \"master\\n\"","-            elif args[0] == \"branch\" and \"--format\" in args:","+            elif args[0] == \"branch\" and any(\"--format\" in str(a) for a in args):","                 return \"main\\nfeature\\n\"","             else:","                 raise ToolError(\"fatal: ... no commits yet\")"]}],"userModified":false,"replaceAll":false},"tool_result_meta":[{"id":"toolu_bf33f0f1d9084e5596efb4d3","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
