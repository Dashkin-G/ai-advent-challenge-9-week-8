FILE', Path(temp.name)):\n230\t            result = crm_mcp.get_user(\" u-01 \")\n231\t\n232\t        self.assertEqual(result[\"id\"], \"U-01\")\n233\t        os.unlink(temp.name)\n234\t\n235\t    @patch.object(crm_mcp.config, 'CRM_FILE', new=Path(tempfile.NamedTemporaryFile(suffix='.json', delete=False).name))\n236\t    def test_get_user_not_found(self):\n237\t        \"\"\"Нет такого клиента — ToolError с нормализованным номером U-99.\"\"\"\n238\t        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n239\t        json.dump(self.crm_data, temp, ensure_ascii=False)\n240\t        temp.close()\n241\t\n242\t        with patch.object(crm_mcp.config, 'CRM_FILE', Path(temp.name)):\n243\t            with self.assertRaises(ToolError) as ctx:\n244\t                crm_mcp.get_user(\" u-99 \")\n245\t\n246\t        self.assertEqual(str(ctx.exception), \"Клиента U-99 нет в CRM\")\n247\t        os.unlink(temp.name)\n248\t\n249\t    @patch.object(crm_mcp.config, 'CRM_FILE', new=Path(tempfile.NamedTemporaryFile(suffix='.json', delete=False).name))\n250\t    def test_get_user_tickets(self):\n251\t        \"\"\"В ответе есть список обращений пользователя.\"\"\"\n252\t        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n253\t        json.dump(self.crm_data, temp, ensure_ascii=False)\n254\t        temp.close()\n255\t\n256\t        with patch.object(crm_mcp.config, 'CRM_FILE', Path(temp.name)):\n257\t            result = crm_mcp.get_user(\"U-01\")\n258\t\n259\t        self.assertIn(\"tickets\", result)\n260\t        self.assertEqual(len(result[\"tickets\"]), 2)\n261\t        os.unlink(temp.name)\n262\t\n263\t\n264\tclass TestFindTickets(unittest.TestCase):\n265\t    \"\"\"find_tickets ищет по номеру, теме, сообщению, имени и вузу; новые сверху.\"\"\"\n266\t\n267\t    def setUp(self):\n268\t        \"\"\"Подготовка временного CRM-файла.\"\"\"\n269\t        self.crm_data = {\n270\t            \"users\": [\n271\t                {\"id\": \"U-01\", \"name\": \"Иван Ветров\", \"org\": \"МГУ\"},\n272\t                {\"id\": \"U-02\", \"name\": \"Анна Сидорова\", \"org\": \"СПбГУ\"},\n273\t            ],\n274\t            \"tickets\": [\n275\t                {\"id\": \"T-1041\", \"user_id\": \"U-01\", \"subject\": \"Ошибка входа\", \"message\": \"Не могу войти\",\n276\t                 \"status\": \"открыт\", \"priority\": \"высокий\", \"created\": \"2024-01-05T14:00:00\"},\n277\t                {\"id\": \"T-1033\", \"user_id\": \"U-01\", \"subject\": \"Вопрос по тарифам\", \"message\": \"Как оплатить?\",\n278\t                 \"status\": \"решён\", \"priority\": \"средний\", \"created\": \"2024-01-03T10:00:00\"},\n279\t                {\"id\": \"T-1045\", \"user_id\": \"U-02\", \"subject\": \"Техническая проблема\", \"message\": \"Сломалось всё\",\n280\t                 \"status\": \"открыт\", \"priority\": \"критический\", \"created\": \"2024-01-06T09:00:00\"},\n281\t            ]\n282\t        }\n283\t        self.temp_file = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n284\t        json.dump(self.crm_data, self.temp_file, ensure_ascii=False)\n285\t        self.temp_file.close()\n286\t\n287\t    def tearDown(self):\n288\t        \"\"\"Удаление временного файла.\"\"\"\n289\t        import os\n290\t        os.unlink(self.temp_file.name)\n291\t\n292\t    @patch.object(crm_mcp.config, 'CRM_FILE', new=Path(tempfile.NamedTemporaryFile(suffix='.json', delete=False).name))\n293\t    def test_find_by_name(self):\n294\t        \"\"\"Поиск по имени «ветров» → T-1041, T-1033 в таком порядке.\"\"\"\n295\t        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n296\t        json.dump(self.crm_data, temp, ensure_ascii=False)\n297\t        temp.close()\n298\t\n299\t        with patch.object(crm_mcp.config, 'CRM_FILE', Path(temp.name)):\n300\t            result = crm_mcp.find_tickets(\"ветров\")\n301\t\n302\t        self.assertEqual(result[\"count\"], 2)\n303\t        self.assertEqual(result[\"tickets\"][0][\"id\"], \"T-1041\")\n304\t        self.assertEqual(result[\"tickets\"][1][\"id\"], \"T-1033\")\n305\t        os.unlink(temp.name)\n306\t\n307\t    @patch.object(crm_mcp.config, 'CRM_FILE', new=Path(tempfile.NamedTemporaryFile(suffix='.json', delete=False).name))\n308\t    def test_find_by_ticket_number(self):\n309\t        \"\"\"Поиск по номеру «t-1045» → только T-1045.\"\"\"\n310\t        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n311\t        json.dump(self.crm_data, temp, ensure_ascii=False)\n312\t        temp.close()\n313\t\n314\t        with patch.object(crm_mcp.config, 'CRM_FILE', Path(temp.name)):\n315\t            result = crm_mcp.find_tickets(\"t-1045\")\n316\t\n317\t        self.assertEqual(result[\"count\"], 1)\n318\t        self.assertEqual(result[\"tickets\"][0][\"id\"], \"T-1045\")\n319\t        os.unlink(temp.name)\n320\t\n321\t    @patch.object(crm_mcp.config, 'CRM_FILE', new=Path(tempfile.NamedTemporaryFile(suffix='.json', delete=False).name))\n322\t    def test_find_empty_query(self):\n323\t        \"\"\"Пустой запрос — ToolError.\"\"\"\n324\t        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n325\t        json.dump(self.crm_data, temp, ensure_ascii=False)\n326\t        temp.close()\n327\t\n328\t        with patch.object(crm_mcp.config, 'CRM_FILE', Path(temp.name)):\n329\t            with self.assertRaises(ToolError) as ctx:\n330\t                crm_mcp.find_tickets(\"\")\n331\t\n332\t        self.assertEqual(str(ctx.exception), \"Введите текст поиска\")\n333\t        os.unlink(temp.name)\n334\t\n335\t    @patch.object(crm_mcp.config, 'CRM_FILE', new=Path(tempfile.NamedTemporaryFile(suffix='.json', delete=False).name))\n336\t    def test_find_whitespace_only(self):\n337\t        \"\"\"Одни пробелы — ToolError.\"\"\"\n338\t        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n339\t        json.dump(self.crm_data, temp, ensure_ascii=False)\n340\t        temp.close()\n341\t\n342\t        with patch.object(crm_mcp.config, 'CRM_FILE', Path(temp.name)):\n343\t            with self.assertRaises(ToolError) as ctx:\n344\t                crm_mcp.find_tickets(\"   \")\n345\t\n346\t        self.assertEqual(str(ctx.exception), \"Введите текст поиска\")\n347\t        os.unlink(temp.name)\n348\t\n349\t    @patch.object(crm_mcp.config, 'CRM_FILE', new=Path(tempfile.NamedTemporaryFile(suffix='.json', delete=False).name))\n350\t    def test_find_newest_first(self):\n351\t        \"\"\"Результаты сортированы новыми сверху.\"\"\"\n352\t        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n353\t        json.dump(self.crm_data, temp, ensure_ascii=False)\n354\t        temp.close()\n355\t\n356\t        with patch.object(crm_mcp.config, 'CRM_FILE', Path(temp.name)):\n357\t            result = crm_mcp.find_tickets(\"ветров\")  # только T-1041 и T-1033\n358\t\n359\t        # T-1041 (01-05) новее чем T-1033 (01-03)\n360\t        self.assertEqual(len(result[\"tickets\"]), 2)\n361\t        self.assertEqual(result[\"tickets\"][0][\"id\"], \"T-1041\")\n362\t        self.assertEqual(result[\"tickets\"][1][\"id\"], \"T-1033\")\n363\t        os.unlink(temp.name)\n364\t\n365\t\n366\tif __name__ == '__main__':\n367\t    unittest.main()\n368\t"}]},"parent_tool_use_id":null,"session_id":"2c89cc0e-e853-420b-95de-b23eb454af39","uuid":"d9637d86-0fe4-4da0-8391-0cbfc4c415bc","timestamp":"2026-10-24T23:44:57.645Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\USER\\AppData\\Local\\Temp\\claude-rules\\loop-v2\\tests\\test_crm_mcp.py","content":"\"\"\"Тесты app/crm_mcp.py: list_tickets, get_ticket, get_user, find_tickets.\"\"\"\nimport json\nimport os\nimport tempfile\nimport unittest\nfrom pathlib import Path\nfrom unittest.mock import patch\n\nfrom mcp.server.mcpserver.exceptions import ToolError\n\nfrom app import crm_mcp\n\n\nclass TestListTickets(unittest.TestCase):\n    \"\"\"list_tickets возвращает открытые обращения новыми сверху; include_closed=True — все.\"\"\"\n\n    def setUp(self):\n        \"\"\"Подготовка временного CRM-файла.\"\"\"\n        self.crm_data = {\n            \"users\": [\n                {\"id\": \"U-01\", \"name\": \"Иван Петров\", \"org\": \"МГУ\"},\n                {\"id\": \"U-02\", \"name\": \"Анна Сидорова\", \"org\": \"СПбГУ\"},\n            ],\n            \"tickets\": [\n                {\"id\": \"T-1001\", \"user_id\": \"U-01\", \"subject\": \"Проблема 1\", \"message\": \"Сообщение 1\",\n                 \"status\": \"открыт\", \"priority\": \"высокий\", \"created\": \"2024-01-01T10:00:00\"},\n                {\"id\": \"T-1002\", \"user_id\": \"U-02\", \"subject\": \"Проблема 2\", \"message\": \"Сообщение 2\",\n                 \"status\": \"решён\", \"priority\": \"средний\", \"created\": \"2024-01-02T11:00:00\"},\n                {\"id\": \"T-1003\", \"user_id\": \"U-01\", \"subject\": \"Проблема 3\", \"message\": \"Сообщение 3\",\n                 \"status\": \"открыт\", \"priority\": \"низкий\", \"created\": \"2024-01-03T12:00:00\"},\n            ]\n        }\n        self.temp_file = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, self.temp_file, ensure_ascii=False)\n        self.temp_file.close()\n\n    def tearDown(self):\n        \"\"\"Удаление временного файла.\"\"\"\n        import os\n        os.unlink(self.temp_file.name)\n\n    @patch.object(crm_mcp.config, 'CRM_FILE', new=Path(tempfile.NamedTemporaryFile(suffix='.json', delete=False).name))\n    def test_list_tickets_only_open_newest_first(self):\n        \"\"\"Без include_closed — только открытые, новые сверху: T-1003, T-1001.\"\"\"\n        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, temp, ensure_ascii=False)\n        temp.close()\n\n        with patch.object(crm_mcp.config, 'CRM_FILE', Path(temp.name)):\n            result = crm_mcp.list_tickets()\n\n        self.assertEqual(result[\"count\"], 2)\n        self.assertEqual(result[\"tickets\"][0][\"id\"], \"T-1003\")\n        self.assertEqual(result[\"tickets\"][1][\"id\"], \"T-1001\")\n        os.unlink(temp.name)\n\n    @patch.object(crm_mcp.config, 'CRM_FILE', new=Path(tempfile.NamedTemporaryFile(suffix='.json', delete=False).name))\n    def test_list_tickets_include_closed(self):\n        \"\"\"С include_closed=True — все обращения, новые сверху: T-1003, T-1002, T-1001.\"\"\"\n        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, temp, ensure_ascii=False)\n        temp.close()\n\n        with patch.object(crm_mcp.config, 'CRM_FILE', Path(temp.name)):\n            result = crm_mcp.list_tickets(include_closed=True)\n\n        self.assertEqual(result[\"count\"], 3)\n        self.assertEqual(result[\"tickets\"][0][\"id\"], \"T-1003\")\n        self.assertEqual(result[\"tickets\"][1][\"id\"], \"T-1002\")\n        self.assertEqual(result[\"tickets\"][2][\"id\"], \"T-1001\")\n        os.unlink(temp.name)\n\n    @patch.object(crm_mcp.config, 'CRM_FILE', new=Path(tempfile.NamedTemporaryFile(suffix='.json', delete=False).name))\n    def test_list_tickets_user_info(self):\n        \"\"\"Каждое обращение содержит user с id, name, org.\"\"\"\n        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, temp, ensure_ascii=False)\n        temp.close()\n\n        with patch.object(crm_mcp.config, 'CRM_FILE', Path(temp.name)):\n            result = crm_mcp.list_tickets()\n\n        ticket = result[\"tickets\"][0]\n        self.assertIn(\"user\", ticket)\n        self.assertEqual(ticket[\"user\"][\"id\"], \"U-01\")\n        self.assertEqual(ticket[\"user\"][\"name\"], \"Иван Петров\")\n        self.assertEqual(ticket[\"user\"][\"org\"], \"МГУ\")\n        os.unlink(temp.name)\n\n\nclass TestGetTicket(unittest.T