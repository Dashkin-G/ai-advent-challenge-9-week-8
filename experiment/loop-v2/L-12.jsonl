{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_eae7cbf6d7f64c18b6abb129","type":"tool_result","content":"1\t\"\"\"MCP-сервер git: ветка, изменения, файлы и diff проекта, история, изменения pull request. Только чтение.\"\"\"\n2\timport subprocess\n3\tfrom typing import Annotated, Any\n4\t\n5\tfrom mcp.server.mcpserver import MCPServer\n6\tfrom mcp.server.mcpserver.exceptions import ToolError\n7\tfrom pydantic import Field\n8\t\n9\tfrom app import config\n10\t\n11\tserver = MCPServer(\n12\t    name=\"git\",\n13\t    version=\"1.2.0\",\n14\t    instructions=\"Git-репозиторий проекта, о котором отвечает ассистент: текущая ветка, незакоммиченные \"\n15\t                 \"изменения, список файлов, diff, история коммитов, файлы любого коммита и изменения pull request \"\n16\t                 \"между двумя ветками. Инструменты только читают, ничего не меняют.\",\n17\t)\n18\t\n19\tSTATUS = {\"M\": \"изменён\", \"A\": \"добавлен\", \"D\": \"удалён\", \"R\": \"переименован\", \"?\": \"новый\", \"U\": \"конфликт\"}\n20\tRef = Annotated[str, Field(description=\"Ветка или коммит, например main\")]\n21\t# diff PR разбирается кодом: один формат при любых настройках git пользователя (цвет, префиксы, внешний diff)\n22\tPLAIN = [\"--no-color\", \"--no-ext-diff\", \"--no-renames\"]\n23\t\n24\t\n25\tdef git(*args):\n26\t    # quotepath=false — пути не по-латински приходят как есть, а не восьмеричными кодами\n27\t    done = subprocess.run([\"git\", \"-c\", \"core.quotepath=false\", \"-C\", str(config.PROJECT_DIR), *args],\n28\t                          capture_output=True, text=True, encoding=\"utf-8\", errors=\"replace\", timeout=15)\n29\t    if done.returncode != 0:\n30\t        # ToolError доходит до клиента своим текстом; любое другое исключение SDK прячет за общей фразой\n31\t        raise ToolError(done.stderr.strip() or f\"git {' '.join(args)} завершился с кодом {done.returncode}\")\n32\t    return done.stdout\n33\t\n34\t\n35\t@server.tool()\n36\tdef git_branch() -> dict[str, Any]:\n37\t    \"\"\"Текущая ветка, все локальные ветки и последний коммит.\"\"\"\n38\t    return {\n39\t        \"branch\": git(\"branch\", \"--show-current\").strip() or \"(detached HEAD)\",\n40\t        \"branches\": git(\"branch\", \"--format=%(refname:short)\").split(),\n41\t        # точная дата, а не «5 минут назад»: начало промпта не меняется, и Ollama берёт его из кэша\n42\t        \"last_commit\": git(\"log\", \"-1\", \"--format=%h %s · %cd\", \"--date=format:%d.%m.%Y %H:%M\").strip(),\n43\t    }\n44\t\n45\t\n46\t@server.tool()\n47\tdef git_status() -> dict[str, Any]:\n48\t    \"\"\"Незакоммиченные изменения: какие файлы изменены, добавлены, удалены или новые.\"\"\"\n49\t    changed = []\n50\t    for line in git(\"status\", \"--porcelain=v1\", \"--untracked-files=all\").splitlines():\n51\t        code = line[:2].strip()\n52\t        changed.append({\"path\": line[3:].strip('\"'), \"status\": STATUS.get(code[:1], code)})\n53\t    return {\"clean\": not changed, \"count\": len(changed), \"changed\": changed}\n54\t\n55\t\n56\t@server.tool()\n57\tdef list_files(\n58\t    path: Annotated[str, Field(description=\"Папка внутри проекта, например src/ml; пусто — весь проект\")] = \"\",\n59\t    ref: Annotated[str, Field(description=\"Ветка или коммит; пусто — рабочая папка с новыми файлами\")] = \"\",\n60\t) -> dict[str, Any]:\n61\t    \"\"\"Файлы проекта — отслеживаемые git и новые, без игнорируемых (.venv, data, models); или файлы коммита.\"\"\"\n62\t    if ref:\n63\t        found = git(\"ls-tree\", \"-r\", \"--name-only\", ref, \"--\", path or \".\").splitlines()\n64\t    else:\n65\t        found = git(\"ls-files\", \"--cached\", \"--others\", \"--exclude-standard\", \"--\", path or \".\").splitlines()\n66\t    return {\"path\": path or \".\", \"ref\": ref, \"count\": len(found), \"files\": found}\n67\t\n68\t\n69\t@server.tool()\n70\tdef read_file(\n71\t    path: Annotated[str, Field(description=\"Файл внутри проекта, например src/ml/model.py\")],\n72\t    ref: Ref = \"HEAD\",\n73\t) -> dict[str, Any]:\n74\t    \"\"\"Текст файла в указанном коммите или ветке.\"\"\"\n75\t    return {\"path\": path, \"ref\": ref, \"text\": git(\"show\", f\"{ref}:{path}\")}\n76\t\n77\t\n78\t@server.tool()\n79\tdef git_diff(\n80\t    path: Annotated[str, Field(description=\"Файл внутри проекта; пусто — все изменения\")] = \"\",\n81\t    max_lines: Annotated[int, Field(ge=10, le=400, description=\"Сколько строк diff вернуть\")] = 80,\n82\t) -> dict[str, Any]:\n83\t    \"\"\"Незакоммиченные правки отслеживаемых файлов (git diff HEAD): что именно поменялось.\"\"\"\n84\t    lines = git(\"diff\", \"HEAD\", \"--\", path or \".\").splitlines()\n85\t    return {\"path\": path or \".\", \"lines\": len(lines), \"truncated\": len(lines) > max_lines,\n86\t            \"diff\": \"\\n\".join(lines[:max_lines])}\n87\t\n88\t\n89\t@server.tool()\n90\tdef git_log(\n91\t    n: Annotated[int, Field(ge=1, le=50, description=\"Сколько последних коммитов\")] = 20,\n92\t    path: Annotated[str, Field(description=\"Только коммиты, которые меняли этот файл или папку; пусто — все\")] = \"\",\n93\t    oldest_first: Annotated[bool, Field(description=\"Сначала старые коммиты — история по порядку\")] = False,\n94\t) -> dict[str, Any]:\n95\t    \"\"\"История текущей ветки без merge-коммитов, новые сверху: дата, хеш, сообщение, изменённые файлы и\n96\t    сколько строк добавлено и удалено.\"\"\"\n97\t    commits = []\n98\t    out = git(\"log\", f\"-{n}\", \"--no-merges\", *([\"--reverse\"] if oldest_first else []), *PLAIN, \"--numstat\",\n99\t              \"--date=format:%d.%m.%Y\", \"--format=%x1e%h%x1f%ad%x1f%s\", \"--\", path or \".\")\n100\t    for record in out.split(\"\\x1e\")[1:]:\n101\t        head, *lines = record.strip(\"\\n\").split(\"\\n\")\n102\t        sha, date, subject = head.split(\"\\x1f\")\n103\t        stats = [line.split(\"\\t\", 2) for line in lines if line]\n104\t        commits.append({\"date\": date, \"hash\": sha, \"subject\": subject, \"files\": [file for _, _, file in stats],\n105\t                        # «-» вместо числа — двоичный файл\n106\t                        \"added\": sum(int(a) for a, _, _ in stats if a != \"-\"),\n107\t                        \"deleted\": sum(int(d) for _, d, _ in stats if d != \"-\")})\n108\t    return {\"count\": len(commits), \"commits\": commits}\n109\t\n110\t\n111\t@server.tool()\n112\tdef pr_files(base: Ref, head: Ref) -> dict[str, Any]:\n113\t    \"\"\"Изменённые файлы pull request — что сделано в head с момента ответвления от base: статус файла и\n114\t    сколько строк добавлено и удалено. Переименование показывается как удаление и добавление.\"\"\"\n115\t    changes = f\"{base}...{head}\"\n116\t    counts = {}\n117\t    for line in git(\"diff\", \"--numstat\", *PLAIN, changes).splitlines():\n118\t        added, deleted, path = line.split(\"\\t\", 2)\n119\t        counts[path] = (int(added), int(deleted)) if added != \"-\" else (0, 0)  # «-» — двоичный файл\n120\t    files = []\n121\t    for line in git(\"diff\", \"--name-status\", *PLAIN, changes).splitlines():\n122\t        code, path = line.split(\"\\t\", 1)\n123\t        added, deleted = counts.get(path, (0, 0))\n124\t        files.append({\"path\": path, \"status\": STATUS.get(code[:1], code), \"added\": added, \"deleted\": deleted})\n125\t    return {\n126\t        \"base\": base, \"head\": head,\n127\t        \"merge_base\": git(\"merge-base\", base, head).strip(),\n128\t        \"head_sha\": git(\"rev-parse\", head).strip(),\n129\t        \"files\": files,\n130\t        \"added\": sum(f[\"added\"] for f in files),\n131\t        \"deleted\": sum(f[\"deleted\"] for f in files),\n132\t    }\n133\t\n134\t\n135\t@server.tool()\n136\tdef pr_diff(\n137\t    base: Ref,\n138\t    head: Ref,\n139\t    path: Annotated[str, Field(description=\"Файл внутри проекта; пусто — все файлы\")] = \"\",\n140\t    max_lines: Annotated[int, Field(ge=10, le=5000, description=\"Сколько строк diff вернуть\")] = 2000,\n141\t) -> dict[str, Any]:\n142\t    \"\"\"Diff pull request (git diff base...head): изменения head с момента ответвления от base,\n143\t    по 5 строк контекста вокруг правок.\"\"\"\n144\t    lines = git(\"diff\", \"-U5\", *PLAIN, \"--src-prefix=a/\", \"--dst-prefix=b/\", f\"{base}...{head}\", \"--\",\n145\t                path or \".\").splitlines()\n146\t    return {\"path\": path or \".\", \"lines\": len(lines), \"truncated\": len(lines) > max_lines,\n147\t            \"diff\": \"\\n\".join(lines[:max_lines])}\n148\t"}]},"parent_tool_use_id":"toolu_d9ac83738e4b463f83bf6056","agent_id":"ab6837536fdbfa00f","session_id":"2c89cc0e-e853-420b-95de-b23eb454af39","uuid":"f56dbf65-9a3e-4534-b8f3-667c41d90966","timestamp":"2026-10-24T23:43:24.553Z","tool_result_meta":[{"id":"toolu_eae7cbf6d7f64c18b6abb129","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}],"subagent_type":"bug-fix","task_description":"Fix git MCP for empty repo"}
