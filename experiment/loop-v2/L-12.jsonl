nk(temp.name)\n\n\nclass TestFindTickets(unittest.TestCase):\n    \"\"\"find_tickets ищет по номеру, теме, сообщению, имени и вузу; новые сверху.\"\"\"\n\n    def setUp(self):\n        \"\"\"Подготовка временного CRM-файла.\"\"\"\n        self.crm_data = {\n            \"users\": [\n                {\"id\": \"U-01\", \"name\": \"Иван Ветров\", \"org\": \"МГУ\"},\n                {\"id\": \"U-02\", \"name\": \"Анна Сидорова\", \"org\": \"СПбГУ\"},\n            ],\n            \"tickets\": [\n                {\"id\": \"T-1041\", \"user_id\": \"U-01\", \"subject\": \"Ошибка входа\", \"message\": \"Не могу войти\",\n                 \"status\": \"открыт\", \"priority\": \"высокий\", \"created\": \"2024-01-05T14:00:00\"},\n                {\"id\": \"T-1033\", \"user_id\": \"U-01\", \"subject\": \"Вопрос по тарифам\", \"message\": \"Как оплатить?\",\n                 \"status\": \"решён\", \"priority\": \"средний\", \"created\": \"2024-01-03T10:00:00\"},\n                {\"id\": \"T-1045\", \"user_id\": \"U-02\", \"subject\": \"Техническая проблема\", \"message\": \"Сломалось всё\",\n                 \"status\": \"открыт\", \"priority\": \"критический\", \"created\": \"2024-01-06T09:00:00\"},\n            ]\n        }\n        self.temp_file = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, self.temp_file, ensure_ascii=False)\n        self.temp_file.close()\n\n    def tearDown(self):\n        \"\"\"Удаление временного файла.\"\"\"\n        import os\n        os.unlink(self.temp_file.name)\n\n    @patch.object(crm_mcp.config, 'CRM_FILE', new=Path(tempfile.NamedTemporaryFile(suffix='.json', delete=False).name))\n    def test_find_by_name(self):\n        \"\"\"Поиск по имени «ветров» → T-1041, T-1033 в таком порядке.\"\"\"\n        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, temp, ensure_ascii=False)\n        temp.close()\n\n        with patch.object(crm_mcp.config, 'CRM_FILE', Path(temp.name)):\n            result = crm_mcp.find_tickets(\"ветров\")\n\n        self.assertEqual(result[\"count\"], 2)\n        self.assertEqual(result[\"tickets\"][0][\"id\"], \"T-1041\")\n        self.assertEqual(result[\"tickets\"][1][\"id\"], \"T-1033\")\n        os.unlink(temp.name)\n\n    @patch.object(crm_mcp.config, 'CRM_FILE', new=Path(tempfile.NamedTemporaryFile(suffix='.json', delete=False).name))\n    def test_find_by_ticket_number(self):\n        \"\"\"Поиск по номеру «t-1045» → только T-1045.\"\"\"\n        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, temp, ensure_ascii=False)\n        temp.close()\n\n        with patch.object(crm_mcp.config, 'CRM_FILE', Path(temp.name)):\n            result = crm_mcp.find_tickets(\"t-1045\")\n\n        self.assertEqual(result[\"count\"], 1)\n        self.assertEqual(result[\"tickets\"][0][\"id\"], \"T-1045\")\n        os.unlink(temp.name)\n\n    @patch.object(crm_mcp.config, 'CRM_FILE', new=Path(tempfile.NamedTemporaryFile(suffix='.json', delete=False).name))\n    def test_find_empty_query(self):\n        \"\"\"Пустой запрос — ToolError.\"\"\"\n        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, temp, ensure_ascii=False)\n        temp.close()\n\n        with patch.object(crm_mcp.config, 'CRM_FILE', Path(temp.name)):\n            with self.assertRaises(ToolError) as ctx:\n                crm_mcp.find_tickets(\"\")\n\n        self.assertEqual(str(ctx.exception), \"Введите текст поиска\")\n        os.unlink(temp.name)\n\n    @patch.object(crm_mcp.config, 'CRM_FILE', new=Path(tempfile.NamedTemporaryFile(suffix='.json', delete=False).name))\n    def test_find_whitespace_only(self):\n        \"\"\"Одни пробелы — ToolError.\"\"\"\n        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n        json.dump(self.crm_data, temp, ensure_ascii=False)\n