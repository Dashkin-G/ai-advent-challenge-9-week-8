{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_f620e6d653144733bcae5dfa","type":"tool_result","content":"1\t\"\"\"MCP-сервер git: ветка, изменения, файлы и diff проекта, история, изменения pull request. Только чтение.\"\"\"\n2\timport subprocess\n3\tfrom typing import Annotated, Any\n4\t\n5\tfrom mcp.server.mcpserver import MCPServer\n6\tfrom mcp.server.mcpserver.exceptions import ToolError\n7\tfrom pydantic import Field\n8\t\n9\tfrom app import config\n10\t\n11\tserver = MCPServer(\n12\t    name=\"git\",\n13\t    version=\"1.2.0\",\n14\t    instructions=\"Git-репозиторий проекта, о котором отвечает ассистент: текущая ветка, незакоммиченные \"\n15\t                 \"изменения, список файлов, diff, история коммитов, файлы любого коммита и изменения pull request \"\n16\t                 \"между двумя ветками. Инструменты только читают, ничего не меняют.\",\n17\t)\n18\t\n19\tSTATUS = {\"M\": \"изменён\", \"A\": \"добавлен\", \"D\": \"удалён\", \"R\": \"переименован\", \"?\": \"новый\", \"U\": \"конфликт\"}\n20\tRef = Annotated[str, Field(description=\"Ветка или коммит, например main\")]\n21\t# diff PR разбирается кодом: один формат при любых настройках git пользователя (цвет, префиксы, внешний diff)\n22\tPLAIN = [\"--no-color\", \"--no-ext-diff\", \"--no-renames\"]\n23\t\n24\t\n25\tdef git(*args):\n26\t    # quotepath=false — пути не по-латински приходят как есть, а не восьмеричными кодами\n27\t    done = subprocess.run([\"git\", \"-c\", \"core.quotepath=false\", \"-C\", str(config.PROJECT_DIR), *args],\n28\t                          capture_output=True, text=True, encoding=\"utf-8\", errors=\"replace\", timeout=15)\n29\t    if done.returncode != 0:\n30\t        # ToolError доходит до клиента своим текстом; любое другое исключение SDK прячет за общей фразой\n31\t        raise ToolError(done.stderr.strip() or f\"git {' '.join(args)} завершился с кодом {done.returncode}\")\n32\t    return done.stdout\n33\t\n34\t\n35\t@server.tool()\n36\tdef git_branch() -> dict[str, Any]:\n37\t    \"\"\"Текущая ветка, все локальные ветки и последний коммит.\"\"\"\n38\t    # log может не иметь выода в репозитории без коммитов — возвращаем сообщение по умолчанию\n39\t    try:\n40\t        last_commit = git(\"log\", \"-1\", \"--format=%h %s · %cd\", \"--date=format:%d.%m.%Y %H:%M\").strip()\n41\t    except ToolError:\n42\t        last_commit = \"коммитов нет\"\n43\t    return {\n44\t        \"branch\": git(\"branch\", \"--show-current\").strip() or \"(detached HEAD)\",\n45\t        \"branches\": git(\"branch\", \"--format=%(refname:short)\").split(),\n46\t        # точная дата, а не «5 минут назад»: начало промпта не меняется, и Ollama берёт его из кэша\n47\t        \"last_commit\": last_commit,\n48\t    }\n49\t\n50\t\n51\t@server.tool()\n52\tdef git_status() -> dict[str, Any]:\n53\t    \"\"\"Незакоммиченные изменения: какие файлы изменены, добавлены, удалены или новые.\"\"\"\n54\t    changed = []\n55\t    for line in git(\"status\", \"--porcelain=v1\", \"--untracked-files=all\").splitlines():\n56\t        code = line[:2].strip()\n57\t        changed.append({\"path\": line[3:].strip('\"'), \"status\": STATUS.get(code[:1], code)})\n58\t    return {\"clean\": not changed, \"count\": len(changed), \"changed\": changed}\n59\t\n60\t\n61\t@server.tool()\n62\tdef list_files(\n63\t    path: Annotated[str, Field(description=\"Папка внутри проекта, например src/ml; пусто — весь проект\")] = \"\",\n64\t    ref: Annotated[str, Field(description=\"Ветка или коммит; пусто — рабочая папка с новыми файлами\")] = \"\",\n65\t) -> dict[str, Any]:\n66\t    \"\"\"Файлы проекта — отслеживаемые git и новые, без игнорируемых (.venv, data, models); или файлы коммита.\"\"\"\n67\t    if ref:\n68\t        found = git(\"ls-tree\", \"-r\", \"--name-only\", ref, \"--\", path or \".\").splitlines()\n69\t    else:\n70\t        found = git(\"ls-files\", \"--cached\", \"--others\", \"--exclude-standard\", \"--\", path or \".\").splitlines()\n71\t    return {\"path\": path or \".\", \"ref\": ref, \"count\": len(found), \"files\": found}\n72\t\n73\t\n74\t@server.tool()\n75\tdef read_file(\n76\t    path: Annotated[str, Field(description=\"Файл внутри проекта, например src/ml/model.py\")],\n77\t    ref: Ref = \"HEAD\",\n78\t) -> dict[str, Any]:\n79\t    \"\"\"Текст файла в указанном коммите или ветке.\"\"\"\n80\t    return {\"path\": path, \"ref\": ref, \"text\": git(\"show\", f\"{ref}:{path}\")}\n81\t\n82\t\n83\t@server.tool()\n84\tdef git_diff(\n85\t    path: Annotated[str, Field(description=\"Файл внутри проекта; пусто — все изменения\")] = \"\",\n86\t    max_lines: Annotated[int, Field(ge=10, le=400, description=\"Сколько строк diff вернуть\")] = 80,\n87\t) -> dict[str, Any]:\n88\t    \"\"\"Незакоммиченные правки отслеживаемых файлов (git diff HEAD): что именно поменялось.\"\"\"\n89\t    lines = git(\"diff\", \"HEAD\", \"--\", path or \".\").splitlines()\n90\t    return {\"path\": path or \".\", \"lines\": len(lines), \"truncated\": len(lines) > max_lines,\n91\t            \"diff\": \"\\n\".join(lines[:max_lines])}\n92\t\n93\t\n94\t@server.tool()\n95\tdef git_log(\n96\t    n: Annotated[int, Field(ge=1, le=50, description=\"Сколько последних коммитов\")] = 20,\n97\t    path: Annotated[str, Field(description=\"Только коммиты, которые меняли этот файл или папку; пусто — все\")] = \"\",\n98\t    oldest_first: Annotated[bool, Field(description=\"Сначала старые коммиты — история по порядку\")] = False,\n99\t) -> dict[str, Any]:\n100\t    \"\"\"История текущей ветки без merge-коммитов, новые сверху: дата, хеш, сообщение, изменённые файлы и\n101\t    сколько строк добавлено и удалено.\"\"\"\n102\t    commits = []\n103\t    # в пустом репозитории log возвращает stderr «fatal: your current branch...» — возвращаем пустой список\n104\t    try:\n105\t        out = git(\"log\", f\"-{n}\", \"--no-merges\", *([\"reverse\"] if oldest_first else []), *PLAIN, \"--numstat\",\n106\t                  \"--date=format:%d.%m.%Y\", \"--format=%x1e%h%x1f%ad%x1f%s\", \"--\", path or \".\")\n107\t    except ToolError:\n108\t        return {\"count\": 0, \"commits\": []}\n109\t    for record in out.split(\"\\x1e\")[1:]:\n110\t        head, *lines = record.strip(\"\\n\").split(\"\\n\")\n111\t        sha, date, subject = head.split(\"\\x1f\")\n112\t        stats = [line.split(\"\\t\", 2) for line in lines if line]\n113\t        commits.append({\"date\": date, \"hash\": sha, \"subject\": subject, \"files\": [file for _, _, file in stats],\n114\t                        # «-» вместо числа — двоичный файл\n115\t                        \"added\": sum(int(a) for a, _, _ in stats if a != \"-\"),\n116\t                        \"deleted\": sum(int(d) for _, d, _ in stats if d != \"-\")})\n117\t    return {\"count\": len(commits), \"commits\": commits}\n118\t\n119\t\n120\t@server.tool()\n121\tdef pr_files(base: Ref, head: Ref) -> dict[str, Any]:\n122\t    \"\"\"Изменённые файлы pull request — что сделано в head с момента ответвления от base: статус файла и\n123\t    сколько строк добавлено и удалено. Переименование показывается как удаление и добавление.\"\"\"\n124\t    changes = f\"{base}...{head}\"\n125\t    counts = {}\n126\t    for line in git(\"diff\", \"--numstat\", *PLAIN, changes).splitlines():\n127\t        added, deleted, path = line.split(\"\\t\", 2)\n128\t        counts[path] = (int(added), int(deleted)) if added != \"-\" else (0, 0)  # «-» — двоичный файл\n129\t    files = []\n130\t    for line in git(\"diff\", \"--name-status\", *PLAIN, changes).splitlines():\n131\t        code, path = line.split(\"\\t\", 1)\n132\t        added, deleted = counts.get(path, (0, 0))\n133\t        files.append({\"path\": path, \"status\": STATUS.get(code[:1], code), \"added\": added, \"deleted\": deleted})\n134\t    return {\n135\t        \"base\": base, \"head\": head,\n136\t        \"merge_base\": git(\"merge-base\", base, head).strip(),\n137\t        \"head_sha\": git(\"rev-parse\", head).strip(),\n138\t        \"files\": files,\n139\t        \"added\": sum(f[\"added\"] for f in files),\n140\t        \"deleted\": sum(f[\"deleted\"] for f in files),\n141\t    }\n142\t\n143\t\n144\t@server.tool()\n145\tdef pr_diff(\n146\t    base: Ref,\n147\t    head: Ref,\n148\t    path: Annotated[str, Field(description=\"Файл внутри проекта; пусто — все файлы\")] = \"\",\n149\t    max_lines: Annotated[int, Field(ge=10, le=5000, description=\"Сколько строк diff вернуть\")] = 2000,\n150\t) -> dict[str, Any]:\n151\t    \"\"\"Diff pull request (git diff base...head): изменения head с момента ответвления от base,\n152\t    по 5 строк контекста вокруг правок.\"\"\"\n153\t    lines = git(\"diff\", \"-U5\", *PLAIN, \"--src-prefix=a/\", \"--dst-prefix=b/\", f\"{base}...{head}\", \"--\",\n154\t                path or \".\").splitlines()\n155\t    return {\"path\": path or \".\", \"lines\": len(lines), \"truncated\": len(lines) > max_lines,\n156\t            \"diff\": \"\\n\".join(lines[:max_lines])}\n157\t"}]},"parent_tool_use_id":null,"session_id":"2c89cc0e-e853-420b-95de-b23eb454af39","uuid":"aab27a78-16d6-4c9b-a4f6-04f2b5a0429e","timestamp":"2026-10-24T23:44:11.927Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\USER\\AppData\\Local\\Temp\\claude-rules\\loop-v2\\app\\git_mcp.py","content":"\"\"\"MCP-сервер git: ветка, изменения, файлы и diff проекта, история, изменения pull request. Только чтение.\"\"\"\nimport subprocess\nfrom typing import Annotated, Any\n\nfrom mcp.server.mcpserver import MCPServer\nfrom mcp.server.mcpserver.exceptions import ToolError\nfrom pydantic import Field\n\nfrom app import config\n\nserver = MCPServer(\n    name=\"git\",\n    version=\"1.2.0\",\n    instructions=\"Git-репозиторий проекта, о котором отвечает ассистент: текущая ветка, незакоммиченные \"\n                 \"изменения, список файлов, diff, история коммитов, файлы любого коммита и изменения pull request \"\n                 \"между двумя ветками. Инструменты только читают, ничего не меняют.\",\n)\n\nSTATUS = {\"M\": \"изменён\", \"A\": \"добавлен\", \"D\": \"удалён\", \"R\": \"переименован\", \"?\": \"новый\", \"U\": \"конфликт\"}\nRef = Annotated[str, Field(description=\"Ветка или коммит, например main\")]\n# diff PR разбирается кодом: один формат при любых настройках git пользователя (цвет, префиксы, внешний diff)\nPLAIN = [\"--no-color\", \"--no-ext-diff\", \"--no-renames\"]\n\n\ndef git(*args):\n    # quotepath=false — пути не по-латински приходят как есть, а не восьмеричными кодами\n    done = subprocess.run([\"git\", \"-c\", \"core.quotepath=false\", \"-C\", str(config.PROJECT_DIR), *args],\n                          capture_output=True, text=True, encoding=\"utf-8\", errors=\"replace\", timeout=15)\n    if done.returncode != 0:\n        # ToolError доходит до клиента своим текстом; любое другое исключение SDK прячет за общей фразой\n        raise ToolError(done.stderr.strip() or f\"git {' '.join(args)} завершился с кодом {done.returncode}\")\n    return done.stdout\n\n\n@server.tool()\ndef git_branch() -> dict[str, Any]:\n    \"\"\"Текущая ветка, все локальные ветки и последний коммит.\"\"\"\n    # log может не иметь выода в репозитории без коммитов — возвращаем сообщение по умолчанию\n    try:\n        last_commit = git(\"log\", \"-1\", \"--format=%h %s · %cd\", \"--date=format:%d.%m.%Y %H:%M\").strip()\n    except ToolError:\n        last_commit = \"коммитов нет\"\n    return {\n        \"branch\": git(\"branch\", \"--show-current\").strip() or \"(detached HEAD)\",\n        \"branches\": git(\"branch\", \"--format=%(refname:short)\").split(),\n        # точная дата, а не «5 минут назад»: начало промпта не меняется, и Ollama берёт его из кэша\n        \"last_commit\": last_commit,\n    }\n\n\n@server.tool()\ndef git_status() -> dict[str, Any]:\n    \"\"\"Незакоммиченные изменения: какие файлы изменены, добавлены, удалены или новые.\"\"\"\n    changed = []\n    for line in git(\"status\", \"--porcelain=v1\", \"--untracked-files=all\").splitlines():\n        code = line[:2].strip()\n        changed.append({\"path\": line[3:].strip('\"'), \"status\": STATUS.get(code[:1], code)})\n    return {\"clean\": not changed, \"count\": len(changed), \"changed\": changed}\n\n\n@server.tool()\ndef list_files(\n    path: Annotated[str, Field(description=\"Папка внутри проекта, например src/ml; пусто — весь проект\")] = \"\",\n    ref: Annotated[str, Field(description=\"Ветка или коммит; пусто — рабочая папка с новыми файлами\")] = \"\",\n) -> dict[str, Any]:\n    \"\"\"Файлы проекта — отслеживаемые git и новые, без игнорируемых (.venv, data, models); или файлы коммита.\"\"\"\n    if ref:\n        found = git(\"ls-tree\", \"-r\", \"--name-only\", ref, \"--\", path or \".\").splitlines()\n    else:\n        found = git(\"ls-files\", \"--cached\", \"--others\", \"--exclude-standard\", \"--\", path or \".\").splitlines()\n    return {\"path\": path or \".\", \"ref\": ref, \"count\": len(found), \"files\": found}\n\n\n@server.tool()\ndef read_file(\n    path: Annotated[str, Field(description=\"Файл внутри проекта, например src/ml/model.py\")],\n    ref: Ref = \"HEAD\",\n) -> dict[str, Any]:\n    \"\"\"Текст файла в указанном коммите или ветке.\"\"\"\n    return {\"path\": path, \"ref\": ref, \"text\": git(\"show\", f\"{ref}:{path}\")}\n\n\n@server.tool()\ndef git_diff(\n    path: Annotated[str, Field(description=\"Файл внутри проекта; пусто — все изменения\")] = \"\",\n    max_lines: Annotated[int, Field(ge=10, le=400, description=\"Сколько строк diff вернуть\")] = 80,\n) -> dict[str, Any]:\n    \"\"\"Незакоммиченные правки отслеживаемых файлов (git diff HEAD): что именно поменялось.\"\"\"\n    lines = git(\"diff\", \"HEAD\", \"--\", path or \".\").splitlines()\n    return {\"path\": path or \".\", \"lines\": len(lines), \"truncated\": len(lines) > max_lines,\n            \"diff\": \"\\n\".join(lines[:max_lines])}\n\n\n@server.tool()\ndef git_log(\n    n: Annotated[int, Field(ge=1, le=50, description=\"Сколько последних коммитов\")] = 20,\n    path: Annotated[str, Field(description=\"Только коммиты, которые меняли этот файл или папку; пусто — все\")] = \"\",\n    oldest_first: Annotated[bool, Field(description=\"Сначала старые коммиты — история по порядку\")] = False,\n) -> dict[str, Any]:\n    \"\"\"История текущей ветки без merge-коммитов, новые сверху: дата, хеш, сообщение, изменённые файлы и\n    сколько строк добавлено и удалено.\"\"\"\n    commits = []\n    # в пустом репозитории log возвращает stderr «fatal: your current branch...» — возвращаем пустой список\n    try:\n        out = git(\"log\", f\"-{n}\", \"--no-merges\", *([\"reverse\"] if oldest_first else []), *PLAIN, \"--numstat\",\n                  \"--date=format:%d.%m.%Y\", \"--format=%x1e%h%x1f%ad%x1f%s\", \"--\", path or \".\")\n    except ToolError:\n        return {\"count\": 0, \"commits\": []}\n    for record in out.split(\"\\x1e\")[1:]:\n        head, *lines = record.strip(\"\\n\").split(\"\\n\")\n        sha, date, subject = head.split(\"\\x1f\")\n        stats = [line.split(\"\\t\", 2) for line in lines if line]\n        commits.append({\"date\": date, \"hash\": sha, \"subject\": subject, \"files\": [file for _, _, file in stats],\n                        # «-» вместо числа — двоичный файл\n                        \"added\": sum(int(a) for a, _, _ in stats if a != \"-\"),\n                        \"deleted\": sum(int(d) for _, d, _ in stats if d != \"-\")})\n    return {\"count\": len(commits), \"commits\": commits}\n\n\n@server.tool()\ndef pr_files(base: Ref, head: Ref) -> dict[str, Any]:\n    \"\"\"Изменённые файлы pull request — что сделано в head с момента ответвления от base: статус файла и\n    сколько строк добавлено и удалено. Переименование показывается как удаление и добавление.\"\"\"\n    changes = f\"{base}...{head}\"\n    counts = {}\n    for line in git(\"diff\", \"--numstat\", *PLAIN, changes).splitlines():\n        added, deleted, path = line.split(\"\\t\", 2)\n        counts[path] = (int(added), int(deleted)) if added != \"-\" else (0, 0)  # «-» — двоичный файл\n    files = []\n    for line in git(\"diff\", \"--name-status\", *PLAIN, changes).splitlines():\n        code, path = line.split(\"\\t\", 1)\n        added, deleted = counts.get(path, (0, 0))\n        files.append({\"path\": path, \"status\": STATUS.get(code[:1], code), \"added\": added, \"deleted\": deleted})\n    return {\n        \"base\": base, \"head\": head,\n        \"merge_base\": git(\"merge-base\", base, head).strip(),\n        \"head_sha\": git(\"rev-parse\", head).strip(),\n        \"files\": files,\n        \"added\": sum(f[\"added\"] for f in files),\n        \"deleted\": sum(f[\"deleted\"] for f in files),\n    }\n\n\n@server.tool()\ndef pr_diff(\n    base: Ref,\n    head: Ref,\n    path: Annotated[str, Field(description=\"Файл внутри проекта; пусто — все файлы\")] = \"\",\n    max_lines: Annotated[int, Field(ge=10, le=5000, description=\"Сколько строк diff вернуть\")] = 2000,\n) -> dict[str, Any]:\n    \"\"\"Diff pull request (git diff base...head): изменения head с момента ответвления от base,\n    по 5 строк контекста вокруг правок.\"\"\"\n    lines = git(\"diff\", \"-U5\", *PLAIN, \"--src-prefix=a/\", \"--dst-prefix=b/\", f\"{base}...{head}\", \"--\",\n                path or \".\").splitlines()\n    return {\"path\": path or \".\", \"lines\": len(lines), \"truncated\": len(lines) > max_lines,\n            \"diff\": \"\\n\".join(lines[:max_lines])}\n","numLines":157,"startLine":1,"totalLines":157}},"tool_result_meta":[{"id":"toolu_f620e6d653144733bcae5dfa","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
