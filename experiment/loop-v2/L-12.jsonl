{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_74875605e54544ea9357a606","type":"tool_result","content":"1\t\"\"\"Тесты app/crm_mcp.py: list_tickets, get_ticket, get_user, find_tickets.\"\"\"\n2\timport json\n3\timport os\n4\timport tempfile\n5\timport unittest\n6\tfrom pathlib import Path\n7\tfrom unittest.mock import patch\n8\t\n9\tfrom mcp.server.mcpserver.exceptions import ToolError\n10\t\n11\tfrom app import crm_mcp\n12\t\n13\t\n14\tclass TestListTickets(unittest.TestCase):\n15\t    \"\"\"list_tickets возвращает открытые обращения новыми сверху; include_closed=True — все.\"\"\"\n16\t\n17\t    def setUp(self):\n18\t        \"\"\"Подготовка временного CRM-файла.\"\"\"\n19\t        self.crm_data = {\n20\t            \"users\": [\n21\t                {\"id\": \"U-01\", \"name\": \"Иван Петров\", \"org\": \"МГУ\"},\n22\t                {\"id\": \"U-02\", \"name\": \"Анна Сидорова\", \"org\": \"СПбГУ\"},\n23\t            ],\n24\t            \"tickets\": [\n25\t                {\"id\": \"T-1001\", \"user_id\": \"U-01\", \"subject\": \"Проблема 1\", \"message\": \"Сообщение 1\",\n26\t                 \"status\": \"открыт\", \"priority\": \"высокий\", \"created\": \"2024-01-01T10:00:00\"},\n27\t                {\"id\": \"T-1002\", \"user_id\": \"U-02\", \"subject\": \"Проблема 2\", \"message\": \"Сообщение 2\",\n28\t                 \"status\": \"решён\", \"priority\": \"средний\", \"created\": \"2024-01-02T11:00:00\"},\n29\t                {\"id\": \"T-1003\", \"user_id\": \"U-01\", \"subject\": \"Проблема 3\", \"message\": \"Сообщение 3\",\n30\t                 \"status\": \"открыт\", \"priority\": \"низкий\", \"created\": \"2024-01-03T12:00:00\"},\n31\t            ]\n32\t        }\n33\t        self.temp_file = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n34\t        json.dump(self.crm_data, self.temp_file, ensure_ascii=False)\n35\t        self.temp_file.close()\n36\t\n37\t    def tearDown(self):\n38\t        \"\"\"Удаление временного файла.\"\"\"\n39\t        import os\n40\t        os.unlink(self.temp_file.name)\n41\t\n42\t    @patch.object(crm_mcp.config, 'CRM_FILE', new=Path(tempfile.NamedTemporaryFile(suffix='.json', delete=False).name))\n43\t    def test_list_tickets_only_open_newest_first(self):\n44\t        \"\"\"Без include_closed — только открытые, новые сверху: T-1003, T-1001.\"\"\"\n45\t        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n46\t        json.dump(self.crm_data, temp, ensure_ascii=False)\n47\t        temp.close()\n48\t\n49\t        with patch.object(crm_mcp.config, 'CRM_FILE', Path(temp.name)):\n50\t            result = crm_mcp.list_tickets()\n51\t\n52\t        self.assertEqual(result[\"count\"], 2)\n53\t        self.assertEqual(result[\"tickets\"][0][\"id\"], \"T-1003\")\n54\t        self.assertEqual(result[\"tickets\"][1][\"id\"], \"T-1001\")\n55\t        os.unlink(temp.name)\n56\t\n57\t    @patch.object(crm_mcp.config, 'CRM_FILE', new=Path(tempfile.NamedTemporaryFile(suffix='.json', delete=False).name))\n58\t    def test_list_tickets_include_closed(self):\n59\t        \"\"\"С include_closed=True — все обращения, новые сверху: T-1003, T-1002, T-1001.\"\"\"\n60\t        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n61\t        json.dump(self.crm_data, temp, ensure_ascii=False)\n62\t        temp.close()\n63\t\n64\t        with patch.object(crm_mcp.config, 'CRM_FILE', Path(temp.name)):\n65\t            result = crm_mcp.list_tickets(include_closed=True)\n66\t\n67\t        self.assertEqual(result[\"count\"], 3)\n68\t        self.assertEqual(result[\"tickets\"][0][\"id\"], \"T-1003\")\n69\t        self.assertEqual(result[\"tickets\"][1][\"id\"], \"T-1002\")\n70\t        self.assertEqual(result[\"tickets\"][2][\"id\"], \"T-1001\")\n71\t        os.unlink(temp.name)\n72\t\n73\t    @patch.object(crm_mcp.config, 'CRM_FILE', new=Path(tempfile.NamedTemporaryFile(suffix='.json', delete=False).name))\n74\t    def test_list_tickets_user_info(self):\n75\t        \"\"\"Каждое обращение содержит user с id, name, org.\"\"\"\n76\t        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n77\t        json.dump(self.crm_data, temp, ensure_ascii=False)\n78\t        temp.close()\n79\t\n80\t        with patch.object(crm_mcp.config, 'CRM_FILE', Path(temp.name)):\n81\t            result = crm_mcp.list_tickets()\n82\t\n83\t        ticket = result[\"tickets\"][0]\n84\t        self.assertIn(\"user\", ticket)\n85\t        self.assertEqual(ticket[\"user\"][\"id\"], \"U-01\")\n86\t        self.assertEqual(ticket[\"user\"][\"name\"], \"Иван Петров\")\n87\t        self.assertEqual(ticket[\"user\"][\"org\"], \"МГУ\")\n88\t        os.unlink(temp.name)\n89\t\n90\t\n91\tclass TestGetTicket(unittest.TestCase):\n92\t    \"\"\"get_ticket находит обращение по номеру без учёта регистра и пробелов.\"\"\"\n93\t\n94\t    def setUp(self):\n95\t        \"\"\"Подготовка временного CRM-файла.\"\"\"\n96\t        self.crm_data = {\n97\t            \"users\": [{\"id\": \"U-01\", \"name\": \"Иван\", \"org\": \"Вуз\"}],\n98\t            \"tickets\": [\n99\t                {\"id\": \"T-1041\", \"user_id\": \"U-01\", \"subject\": \"Тема\", \"message\": \"Сообщение\",\n100\t                 \"status\": \"открыт\", \"priority\": \"высокий\", \"created\": \"2024-01-01T10:00:00\",\n101\t                 \"query\": \"Запрос\", \"response\": \"Ответ\", \"log\": \"Лог\"}\n102\t            ]\n103\t        }\n104\t        self.temp_file = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n105\t        json.dump(self.crm_data, self.temp_file, ensure_ascii=False)\n106\t        self.temp_file.close()\n107\t\n108\t    def tearDown(self):\n109\t        \"\"\"Удаление временного файла.\"\"\"\n110\t        import os\n111\t        os.unlink(self.temp_file.name)\n112\t\n113\t    @patch.object(crm_mcp.config, 'CRM_FILE', new=Path(tempfile.NamedTemporaryFile(suffix='.json', delete=False).name))\n114\t    def test_get_ticket_exact_match(self):\n115\t        \"\"\"Точное совпадение номера: T-1041.\"\"\"\n116\t        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n117\t        json.dump(self.crm_data, temp, ensure_ascii=False)\n118\t        temp.close()\n119\t\n120\t        with patch.object(crm_mcp.config, 'CRM_FILE', Path(temp.name)):\n121\t            result = crm_mcp.get_ticket(\"T-1041\")\n122\t\n123\t        self.assertEqual(result[\"id\"], \"T-1041\")\n124\t        self.assertEqual(result[\"subject\"], \"Тема\")\n125\t        os.unlink(temp.name)\n126\t\n127\t    @patch.object(crm_mcp.config, 'CRM_FILE', new=Path(tempfile.NamedTemporaryFile(suffix='.json', delete=False).name))\n128\t    def test_get_ticket_case_insensitive(self):\n129\t        \"\"\"Регистр не важен: t-1041 → T-1041.\"\"\"\n130\t        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n131\t        json.dump(self.crm_data, temp, ensure_ascii=False)\n132\t        temp.close()\n133\t\n134\t        with patch.object(crm_mcp.config, 'CRM_FILE', Path(temp.name)):\n135\t            result = crm_mcp.get_ticket(\"t-1041\")\n136\t\n137\t        self.assertEqual(result[\"id\"], \"T-1041\")\n138\t        os.unlink(temp.name)\n139\t\n140\t    @patch.object(crm_mcp.config, 'CRM_FILE', new=Path(tempfile.NamedTemporaryFile(suffix='.json', delete=False).name))\n141\t    def test_get_ticket_whitespace_stripped(self):\n142\t        \"\"\"Пробелы игнорируются: « t-1041 » → T-1041.\"\"\"\n143\t        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n144\t        json.dump(self.crm_data, temp, ensure_ascii=False)\n145\t        temp.close()\n146\t\n147\t        with patch.object(crm_mcp.config, 'CRM_FILE', Path(temp.name)):\n148\t            result = crm_mcp.get_ticket(\" t-1041 \")\n149\t\n150\t        self.assertEqual(result[\"id\"], \"T-1041\")\n151\t        os.unlink(temp.name)\n152\t\n153\t    @patch.object(crm_mcp.config, 'CRM_FILE', new=Path(tempfile.NamedTemporaryFile(suffix='.json', delete=False).name))\n154\t    def test_get_ticket_not_found(self):\n155\t        \"\"\"Нет такого номера — ToolError с нормализованным числом T-9999.\"\"\"\n156\t        temp = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n157\t        json.dump(self.crm_data, temp, ensure_ascii=False)\n158\t        temp.close()\n159\t\n160\t        with patch.object(crm_mcp.config, 'CRM_FILE', Path(temp.name)):\n161\t            with self.assertRaises(ToolError) as ctx:\n162\t                crm_mcp.get_ticket(\" t-9999 \")\n163\t\n164\t        self.assertEqual(str(ctx.exception), \"Обращения T-9999 нет в CRM\")\n165\t        os.unlink(temp.name)\n166\t\n167\t\n168\tclass TestGetUser(unittest.TestCase):\n169\t    \"\"\"get_user находит клиента по номеру без учёта регистра и пробелов.\"\"\"\n170\t\n171\t    def setUp(self):\n172\t        \"\"\"Подготовка временного CRM-файла.\"\"\"\n173\t        self.crm_data = {\n174\t            \"users\": [\n175\t                {\"id\": \"U-01\", \"name\": \"Иван Петров\", \"org\": \"МГУ\", \"role\": \"оператор\",\n176\t                 \"preferred_contact\": \"email\", \"notes\": \"Заметка\"},\n177\t            ],\n178\t            \"tickets\": [\n179\t                {\"id\": \"T-1001\", \"user_id\": \"U-01\", \"subject\": \"Тема 1\", \"status\": \"открыт\",\n180\t                 \"created\": \"2024-01-01T10:00:00\", \"resolution\": \"Решено 1\"},\n181\t                {\"id\": \"T-1002\", \"user_id\": \"U-01\", \"subject\": \"Тема 2\", \"status\": \"решён\",\n182\t                 \"created\": \"2024-01-02T11:00:00\"},\n183\t            ]\n184\t        }\n185\t        self.temp_file = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n186\t        json.dump(self.crm_data, self.temp_file, ensure_ascii=False)\n187\t        self.temp_file.close()\n188\t\n189\t    def tearDown(self):\n190\t        \"\"\"Удаление временного файла.\"\"