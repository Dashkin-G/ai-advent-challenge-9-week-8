{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_6c50daa8c96c417eaa4307fe","type":"tool_result","content":"1\t\"\"\"Ollama по HTTP: векторы для поиска (bge-m3) и ответ потоком (qwen3.5:4b).\"\"\"\n2\timport json\n3\t\n4\timport httpx2\n5\t\n6\tfrom app import config\n7\t\n8\t\n9\tclass LLMError(Exception):\n10\t    \"\"\"Ошибка по-человечески: что случилось и что сделать.\"\"\"\n11\t\n12\t\n13\t# Под ответ по фрагментам: факты, а не творчество (подобрано на неделе 6, день 29)\n14\tOPTIONS = {\"temperature\": 0.1, \"top_p\": 0.8, \"presence_penalty\": 0, \"num_predict\": 512, \"num_ctx\": 4096}\n15\tNOT_RUNNING = \"Ollama не запущен — откройте его из меню «Пуск»\"\n16\t\n17\t\n18\tdef _client(read=None):\n19\t    return httpx2.AsyncClient(base_url=config.OLLAMA_URL, trust_env=False, timeout=httpx2.Timeout(10, read=read))\n20\t\n21\t\n22\tdef _missing(model):\n23\t    return LLMError(f\"Модели {model} нет — скачайте: ollama pull {model}\")\n24\t\n25\t\n26\tasync def status():\n27\t    \"\"\"Запущен ли Ollama и скачаны ли обе модели.\"\"\"\n28\t    try:\n29\t        async with _client(5) as client:\n30\t            version = (await client.get(\"/api/version\")).json()[\"version\"]\n31\t            names = {m[\"name\"] for m in (await client.get(\"/api/tags\")).json()[\"models\"]}\n32\t    except httpx2.HTTPError:\n33\t        return {\"running\": False}\n34\t    return {\"running\": True, \"version\": version,\n35\t            \"models\": {model: model in names or f\"{model}:latest\" in names for model in (config.MODEL, config.EMBED_MODEL)}}\n36\t\n37\t\n38\tasync def load():\n39\t    \"\"\"Загрузить модель в память заранее — иначе первый ответ ждёт ещё 5–8 с.\"\"\"\n40\t    try:\n41\t        async with _client(120) as client:\n42\t            await client.post(\"/api/generate\", json={\"model\": config.MODEL})\n43\t    except httpx2.ConnectError:\n44\t        raise LLMError(NOT_RUNNING)\n45\t\n46\t\n47\tasync def embed(texts):\n48\t    \"\"\"Векторы bge-m3 для списка текстов.\"\"\"\n49\t    try:\n50\t        async with _client(600) as client:\n51\t            response = await client.post(\"/api/embed\", json={\"model\": config.EMBED_MODEL, \"input\": texts})\n52\t    except httpx2.ConnectError:\n53\t        raise LLMError(NOT_RUNNING)\n54\t    if response.status_code == 404:\n55\t        raise _missing(config.EMBED_MODEL)\n56\t    response.raise_for_status()\n57\t    return response.json()[\"embeddings\"]\n58\t\n59\t\n60\tasync def chat(messages, options=None, schema=None, tools=None):\n61\t    \"\"\"Ответ потоком: {\"type\": \"text\"} кусочками, вызовы инструментов — {\"type\": \"tool_calls\"}, в конце\n62\t    {\"type\": \"done\"} со счётчиками. options дополняют OPTIONS; schema — JSON Schema, от которой Ollama не даст\n63\t    модели отойти; tools — инструменты, которые модель может вызвать сама.\"\"\"\n64\t    body = {\"model\": config.MODEL, \"messages\": messages, \"stream\": True, \"think\": False,\n65\t            \"options\": {**OPTIONS, **(options or {})}}\n66\t    if schema:\n67\t        body[\"format\"] = schema\n68\t    if tools:\n69\t        body[\"tools\"] = tools\n70\t    try:\n71\t        async with _client() as client, client.stream(\"POST\", \"/api/chat\", json=body) as response:\n72\t            if response.status_code == 404:\n73\t                raise _missing(config.MODEL)\n74\t            if response.status_code != 200:\n75\t                raise LLMError(f\"Ollama ответил {response.status_code}: {(await response.aread()).decode()[:200]}\")\n76\t            async for line in response.aiter_lines():\n77\t                if not line:\n78\t                    continue\n79\t                part = json.loads(line)\n80\t                if part.get(\"error\"):\n81\t                    raise LLMError(part[\"error\"])\n82\t                if text := part.get(\"message\", {}).get(\"content\"):\n83\t                    yield {\"type\": \"text\", \"text\": text}\n84\t                if calls := part.get(\"message\", {}).get(\"tool_calls\"):\n85\t                    yield {\"type\": \"tool_calls\", \"calls\": calls}\n86\t                if part.get(\"done\"):\n87\t                    yield {\"type\": \"done\", **_counters(part)}\n88\t    except httpx2.ConnectError:\n89\t        raise LLMError(NOT_RUNNING)\n90\t\n91\t\n92\tdef _counters(part):\n93\t    sec = lambda key: part.get(key, 0) / 1e9  # Ollama отдаёт наносекунды\n94\t    tokens = part.get(\"eval_count\", 0)\n95\t    return {\n96\t        \"tokens\": tokens,\n97\t        \"speed\": round(tokens / sec(\"eval_duration\"), 1) if part.get(\"eval_duration\") else 0,\n98\t        \"prompt\": part.get(\"prompt_eval_count\", 0),\n99\t        \"reading\": round(sec(\"prompt_eval_duration\"), 2),\n100\t        \"writing\": round(sec(\"eval_duration\"), 2),\n101\t        \"load\": round(sec(\"load_duration\"), 2),\n102\t        \"seconds\": round(sec(\"total_duration\"), 2),\n103\t    }\n104\t"}]},"parent_tool_use_id":null,"session_id":"c7fb8109-f3fd-4db1-89da-bdb17becddd6","uuid":"bd98dea6-0d02-46d8-b3cd-257bbbe32758","timestamp":"2026-10-24T23:46:50.715Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\USER\\AppData\\Local\\Temp\\claude-rules\\loop-v2\\app\\llm.py","content":"\"\"\"Ollama по HTTP: векторы для поиска (bge-m3) и ответ потоком (qwen3.5:4b).\"\"\"\nimport json\n\nimport httpx2\n\nfrom app import config\n\n\nclass LLMError(Exception):\n    \"\"\"Ошибка по-человечески: что случилось и что сделать.\"\"\"\n\n\n# Под ответ по фрагментам: факты, а не творчество (подобрано на неделе 6, день 29)\nOPTIONS = {\"temperature\": 0.1, \"top_p\": 0.8, \"presence_penalty\": 0, \"num_predict\": 512, \"num_ctx\": 4096}\nNOT_RUNNING = \"Ollama не запущен — откройте его из меню «Пуск»\"\n\n\ndef _client(read=None):\n    return httpx2.AsyncClient(base_url=config.OLLAMA_URL, trust_env=False, timeout=httpx2.Timeout(10, read=read))\n\n\ndef _missing(model):\n    return LLMError(f\"Модели {model} нет — скачайте: ollama pull {model}\")\n\n\nasync def status():\n    \"\"\"Запущен ли Ollama и скачаны ли обе модели.\"\"\"\n    try:\n        async with _client(5) as client:\n            version = (await client.get(\"/api/version\")).json()[\"version\"]\n            names = {m[\"name\"] for m in (await client.get(\"/api/tags\")).json()[\"models\"]}\n    except httpx2.HTTPError:\n        return {\"running\": False}\n    return {\"running\": True, \"version\": version,\n            \"models\": {model: model in names or f\"{model}:latest\" in names for model in (config.MODEL, config.EMBED_MODEL)}}\n\n\nasync def load():\n    \"\"\"Загрузить модель в память заранее — иначе первый ответ ждёт ещё 5–8 с.\"\"\"\n    try:\n        async with _client(120) as client:\n            await client.post(\"/api/generate\", json={\"model\": config.MODEL})\n    except httpx2.ConnectError:\n        raise LLMError(NOT_RUNNING)\n\n\nasync def embed(texts):\n    \"\"\"Векторы bge-m3 для списка текстов.\"\"\"\n    try:\n        async with _client(600) as client:\n            response = await client.post(\"/api/embed\", json={\"model\": config.EMBED_MODEL, \"input\": texts})\n    except httpx2.ConnectError:\n        raise LLMError(NOT_RUNNING)\n    if response.status_code == 404:\n        raise _missing(config.EMBED_MODEL)\n    response.raise_for_status()\n    return response.json()[\"embeddings\"]\n\n\nasync def chat(messages, options=None, schema=None, tools=None):\n    \"\"\"Ответ потоком: {\"type\": \"text\"} кусочками, вызовы инструментов — {\"type\": \"tool_calls\"}, в конце\n    {\"type\": \"done\"} со счётчиками. options дополняют OPTIONS; schema — JSON Schema, от которой Ollama не даст\n    модели отойти; tools — инструменты, которые модель может вызвать сама.\"\"\"\n    body = {\"model\": config.MODEL, \"messages\": messages, \"stream\": True, \"think\": False,\n            \"options\": {**OPTIONS, **(options or {})}}\n    if schema:\n        body[\"format\"] = schema\n    if tools:\n        body[\"tools\"] = tools\n    try:\n        async with _client() as client, client.stream(\"POST\", \"/api/chat\", json=body) as response:\n            if response.status_code == 404:\n                raise _missing(config.MODEL)\n            if response.status_code != 200:\n                raise LLMError(f\"Ollama ответил {response.status_code}: {(await response.aread()).decode()[:200]}\")\n            async for line in response.aiter_lines():\n                if not line:\n                    continue\n                part = json.loads(line)\n                if part.get(\"error\"):\n                    raise LLMError(part[\"error\"])\n                if text := part.get(\"message\", {}).get(\"content\"):\n                    yield {\"type\": \"text\", \"text\": text}\n                if calls := part.get(\"message\", {}).get(\"tool_calls\"):\n                    yield {\"type\": \"tool_calls\", \"calls\": calls}\n                if part.get(\"done\"):\n                    yield {\"type\": \"done\", **_counters(part)}\n    except httpx2.ConnectError:\n        raise LLMError(NOT_RUNNING)\n\n\ndef _counters(part):\n    sec = lambda key: part.get(key, 0) / 1e9  # Ollama отдаёт наносекунды\n    tokens = part.get(\"eval_count\", 0)\n    return {\n        \"tokens\": tokens,\n        \"speed\": round(tokens / sec(\"eval_duration\"), 1) if part.get(\"eval_duration\") else 0,\n        \"prompt\": part.get(\"prompt_eval_count\", 0),\n        \"reading\": round(sec(\"prompt_eval_duration\"), 2),\n        \"writing\": round(sec(\"eval_duration\"), 2),\n        \"load\": round(sec(\"load_duration\"), 2),\n        \"seconds\": round(sec(\"total_duration\"), 2),\n    }\n","numLines":104,"startLine":1,"totalLines":104}},"tool_result_meta":[{"id":"toolu_6c50daa8c96c417eaa4307fe","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
