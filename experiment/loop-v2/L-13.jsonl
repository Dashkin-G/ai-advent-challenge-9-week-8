{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_8eba3de05557457c8200f48f","type":"tool_result","content":"1\t\"\"\"Ассистент разработчика и поддержки: страница /help, место оператора поддержки /support, работа с файлами\n2\tпроекта /files, MCP-серверы git на /mcp/git, CRM на /mcp/crm и файлов на /mcp/files.\"\"\"\n3\timport asyncio\n4\timport logging\n5\tfrom contextlib import asynccontextmanager\n6\t\n7\timport uvicorn\n8\tfrom fastapi import FastAPI, HTTPException, Request\n9\tfrom fastapi.exceptions import RequestValidationError\n10\tfrom fastapi.responses import FileResponse, JSONResponse, StreamingResponse\n11\tfrom pydantic import BaseModel\n12\t\n13\tfrom app import assistant, config, crm_mcp, files, files_mcp, git_mcp, llm, rag, support\n14\t\n15\tlogging.basicConfig(level=logging.INFO)\n16\tlogger = logging.getLogger(__name__)\n17\t\n18\tPAGE = config.ROOT / \"static\" / \"index.html\"\n19\tSUPPORT_PAGE = config.ROOT / \"static\" / \"support.html\"\n20\tFILES_PAGE = config.ROOT / \"static\" / \"files.html\"\n21\t\n22\t\n23\tasync def warm_up():\n24\t    \"\"\"Векторы документации и базы знаний, модель — при старте, чтобы первый вопрос не ждал.\"\"\"\n25\t    try:\n26\t        logger.info(\"Индекс документации: %s\", await rag.ensure_index())\n27\t        logger.info(\"База знаний поддержки: %s\", await support.ensure_index())\n28\t        await llm.load()\n29\t        logger.info(\"Модель %s загружена в память\", config.MODEL)\n30\t    except Exception as exc:\n31\t        logger.warning(\"Подготовка не завершена: %s\", exc)\n32\t\n33\t\n34\t@asynccontextmanager\n35\tasync def lifespan(app):\n36\t    \"\"\"Жизненный цикл приложения — менеджеры MCP-сессий и прогрев.\"\"\"\n37\t    # у смонтированных приложений MCP свой lifespan не запускается — менеджеры сессий поднимаем здесь\n38\t    async with git_mcp.server.session_manager.run(), crm_mcp.server.session_manager.run(), \\\n39\t            files_mcp.server.session_manager.run():\n40\t        task = asyncio.create_task(warm_up())\n41\t        yield\n42\t        task.cancel()\n43\t\n44\t\n45\tapp = FastAPI(title=\"Ассистент разработчика и поддержки\", lifespan=lifespan)\n46\t\n47\t\n48\t@app.exception_handler(RequestValidationError)\n49\tasync def validation_exception_handler(request: Request, exc: RequestValidationError):\n50\t    \"\"\"Преобразует ошибки валидации FastAPI в 400 с русским текстом.\"\"\"\n51\t    errors = exc.errors()\n52\t    detail = \"Ошибка валидации\"\n53\t\n54\t    for error in errors:\n55\t        loc = error.get(\"loc\", [])\n56\t        # body > text | body > question | body > goal\n57\t        if len(loc) >= 2 and loc[0] == \"body\":\n58\t            field = loc[1]\n59\t            if field == \"text\":\n60\t                detail = \"Поле text требуется и должно быть строкой\"\n61\t            elif field == \"question\":\n62\t                detail = \"Поле question требуется и должно быть строкой\"\n63\t            elif field == \"goal\":\n64\t                detail = \"Поле goal требуется и должно быть строкой\"\n65\t            break\n66\t\n67\t    return JSONResponse(status_code=400, content={\"detail\": detail})\n68\t\n69\t\n70\tapp.mount(\"/mcp/git\", git_mcp.server.streamable_http_app(streamable_http_path=\"/\"))\n71\tapp.mount(\"/mcp/crm\", crm_mcp.server.streamable_http_app(streamable_http_path=\"/\"))\n72\tapp.mount(\"/mcp/files\", files_mcp.server.streamable_http_app(streamable_http_path=\"/\"))\n73\t\n74\t\n75\tclass Command(BaseModel):\n76\t    text: str\n77\t\n78\t\n79\tclass Question(BaseModel):\n80\t    question: str\n81\t    ticket_id: str | None = None\n82\t\n83\t\n84\tclass Task(BaseModel):\n85\t    goal: str\n86\t\n87\t\n88\t@app.get(\"/\", include_in_schema=False)\n89\tasync def page():\n90\t    \"\"\"Главная страница ассистента.\"\"\"\n91\t    return FileResponse(PAGE)\n92\t\n93\t\n94\t@app.get(\"/support\", include_in_schema=False)\n95\tasync def support_page():\n96\t    \"\"\"Страница поддержки оператора.\"\"\"\n97\t    return FileResponse(SUPPORT_PAGE)\n98\t\n99\t\n100\t@app.get(\"/files\", include_in_schema=False)\n101\tasync def files_page():\n102\t    \"\"\"Страница работы с файлами проекта.\"\"\"\n103\t    return FileResponse(FILES_PAGE)\n104\t\n105\t\n106\t@app.get(\"/api/status\")\n107\tasync def status():\n108\t    \"\"\"Статус системы — Ollama, модель, документы.\"\"\"\n109\t    ollama, project = await asyncio.gather(llm.status(), assistant.project())\n110\t    return {\"project\": {**project, \"path\": str(config.PROJECT_DIR)}, \"ollama\": ollama,\n111\t            \"model\": config.MODEL, \"embed_model\": config.EMBED_MODEL, \"docs\": rag.info()}\n112\t\n113\t\n114\t@app.post(\"/api/help\")\n115\tasync def help_command(command: Command):\n116\t    \"\"\"Ответ ассистента на вопрос о проекте.\"\"\"\n117\t    question = assistant.parse(command.text)\n118\t    if question is None:\n119\t        raise HTTPException(status_code=400, detail=\"Команда ассистента: /help <вопрос о проекте>\")\n120\t\n121\t    async def stream():\n122\t        async for event in assistant.answer(question):\n123\t            yield assistant.dumps(event)\n124\t\n125\t    return StreamingResponse(stream(), media_type=\"application/x-ndjson\")\n126\t\n127\t\n128\t@app.get(\"/api/support/status\")\n129\tasync def support_status():\n130\t    \"\"\"Статус поддержки — очередь и база знаний.\"\"\"\n131\t    ollama, crm = await asyncio.gather(llm.status(), support.queue())\n132\t    return {\"ollama\": ollama, \"model\": config.MODEL, \"embed_model\": config.EMBED_MODEL,\n133\t            \"kb\": support.index.info(), \"crm\": crm}\n134\t\n135\t\n136\t@app.post(\"/api/support/answer\")\n137\tasync def support_answer(body: Question):\n138\t    \"\"\"Ответ поддержке на вопрос клиента.\"\"\"\n139\t    question = body.question.strip()\n140\t    if not question:\n141\t        raise HTTPException(status_code=400, detail=\"Напишите вопрос клиента\")\n142\t\n143\t    async def stream():\n144\t        async for event in support.answer(body.ticket_id, question):\n145\t            yield assistant.dumps(event)\n146\t\n147\t    return StreamingResponse(stream(), media_type=\"application/x-ndjson\")\n148\t\n149\t\n150\t@app.post(\"/api/files/run\")\n151\tasync def files_run(task: Task):\n152\t    \"\"\"Запуск задачи по файлам проекта.\"\"\"\n153\t    goal = task.goal.strip()\n154\t    if not goal:\n155\t        raise HTTPException(status_code=400, detail=\"Напишите задачу: что найти, обновить или создать\")\n156\t\n157\t    async def stream():\n158\t        async for event in files.run(goal):\n159\t            yield assistant.dumps(event)\n160\t\n161\t    return StreamingResponse(stream(), media_type=\"application/x-ndjson\")\n162\t\n163\t\n164\t@app.post(\"/api/files/apply\")\n165\tasync def files_apply():\n166\t    \"\"\"Применить черновик правок файлов.\"\"\"\n167\t    return await files.apply()\n168\t\n169\t\n170\t@app.post(\"/api/files/discard\")\n171\tasync def files_discard():\n172\t    \"\"\"Отменить черновик правок файлов.\"\"\"\n173\t    return await files.discard()\n174\t\n175\t\n176\t@app.get(\"/api/search\")\n177\tasync def search_docs(q: str = \"\", top: int | None = None):\n178\t    \"\"\"Поиск по документации проекта — фрагменты с близостью.\"\"\"\n179\t    query = q.strip()\n180\t    if not query:\n181\t        raise HTTPException(status_code=400, detail=\"Поле q требуется и должно быть строкой без пробелов\")\n182\t\n183\t    t = top if top is not None else config.TOP\n184\t    if t < 1 or t > 10:\n185\t        raise HTTPException(status_code=400, detail=\"top должен быть от 1 до 10\")\n186\t\n187\t    import time\n188\t    started = time.perf_counter()\n189\t    try:\n190\t        hits = await rag.search(query, top=t)\n191\t    except (llm.LLMError, FileNotFoundError) as exc:\n192\t        raise HTTPException(status_code=503, detail=str(exc))\n193\t    return {\"query\": query, \"hits\": hits, \"seconds\": round(time.perf_counter() - started, 2)}\n194\t\n195\t\n196\tif __name__ == \"__main__\":\n197\t    uvicorn.run(app, host=config.HOST, port=config.PORT)\n198\t"}]},"parent_tool_use_id":null,"session_id":"c7fb8109-f3fd-4db1-89da-bdb17becddd6","uuid":"cf172e02-5ebc-44ef-a726-b4c2eac29b6d","timestamp":"2026-10-24T23:46:45.495Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\USER\\AppData\\Local\\Temp\\claude-rules\\loop-v2\\app\\main.py","content":"\"\"\"Ассистент разработчика и поддержки: страница /help, место оператора поддержки /support, работа с файлами\nпроекта /files, MCP-серверы git на /mcp/git, CRM на /mcp/crm и файлов на /mcp/files.\"\"\"\nimport asyncio\nimport logging\nfrom contextlib import asynccontextmanager\n\nimport uvicorn\nfrom fastapi import FastAPI, HTTPException, Request\nfrom fastapi.exceptions import RequestValidationError\nfrom fastapi.responses import FileResponse, JSONResponse, StreamingResponse\nfrom pydantic import BaseModel\n\nfrom app import assistant, config, crm_mcp, files, files_mcp, git_mcp, llm, rag, support\n\nlogging.basicConfig(level=logging.INFO)\nlogger = logging.getLogger(__name__)\n\nPAGE = config.ROOT / \"static\" / \"index.html\"\nSUPPORT_PAGE = config.ROOT / \"static\" / \"support.html\"\nFILES_PAGE = config.ROOT / \"static\" / \"files.html\"\n\n\nasync def warm_up():\n    \"\"\"Векторы документации и базы знаний, модель — при старте, чтобы первый вопрос не ждал.\"\"\"\n    try:\n        logger.info(\"Индекс документации: %s\", await rag.ensure_index())\n        logger.info(\"База знаний поддержки: %s\", await support.ensure_index())\n        await llm.load()\n        logger.info(\"Модель %s загружена в память\", config.MODEL)\n    except Exception as exc:\n        logger.warning(\"Подготовка не завершена: %s\", exc)\n\n\n@asynccontextmanager\nasync def lifespan(app):\n    \"\"\"Жизненный цикл приложения — менеджеры MCP-сессий и прогрев.\"\"\"\n    # у смонтированных приложений MCP свой lifespan не запускается — менеджеры сессий поднимаем здесь\n    async with git_mcp.server.session_manager.run(), crm_mcp.server.session_manager.run(), \\\n            files_mcp.server.session_manager.run():\n        task = asyncio.create_task(warm_up())\n        yield\n        task.cancel()\n\n\napp = FastAPI(title=\"Ассистент разработчика и поддержки\", lifespan=lifespan)\n\n\n@app.exception_handler(RequestValidationError)\nasync def validation_exception_handler(request: Request, exc: RequestValidationError):\n    \"\"\"Преобразует ошибки валидации FastAPI в 400 с русским текстом.\"\"\"\n    errors = exc.errors()\n    detail = \"Ошибка валидации\"\n\n    for error in errors:\n        loc = error.get(\"loc\", [])\n        # body > text | body > question | body > goal\n        if len(loc) >= 2 and loc[0] == \"body\":\n            field = loc[1]\n            if field == \"text\":\n                detail = \"Поле text требуется и должно быть строкой\"\n            elif field == \"question\":\n                detail = \"Поле question требуется и должно быть строкой\"\n            elif field == \"goal\":\n                detail = \"Поле goal требуется и должно быть строкой\"\n            break\n\n    return JSONResponse(status_code=400, content={\"detail\": detail})\n\n\napp.mount(\"/mcp/git\", git_mcp.server.streamable_http_app(streamable_http_path=\"/\"))\napp.mount(\"/mcp/crm\", crm_mcp.server.streamable_http_app(streamable_http_path=\"/\"))\napp.mount(\"/mcp/files\", files_mcp.server.streamable_http_app(streamable_http_path=\"/\"))\n\n\nclass Command(BaseModel):\n    text: str\n\n\nclass Question(BaseModel):\n    question: str\n    ticket_id: str | None = None\n\n\nclass Task(BaseModel):\n    goal: str\n\n\n@app.get(\"/\", include_in_schema=False)\nasync def page():\n    \"\"\"Главная страница ассистента.\"\"\"\n    return FileResponse(PAGE)\n\n\n@app.get(\"/support\", include_in_schema=False)\nasync def support_page():\n    \"\"\"Страница поддержки оператора.\"\"\"\n    return FileResponse(SUPPORT_PAGE)\n\n\n@app.get(\"/files\", include_in_schema=False)\nasync def files_page():\n    \"\"\"Страница работы с файлами проекта.\"\"\"\n    return FileResponse(FILES_PAGE)\n\n\n@app.get(\"/api/status\")\nasync def status():\n    \"\"\"Статус системы — Ollama, модель, документы.\"\"\"\n    ollama, project = await asyncio.gather(llm.status(), assistant.project())\n    return {\"project\": {**project, \"path\": str(config.PROJECT_DIR)}, \"ollama\": ollama,\n            \"model\": config.MODEL, \"embed_model\": config.EMBED_MODEL, \"docs\": rag.info()}\n\n\n@app.post(\"/api/help\")\nasync def help_command(command: Command):\n    \"\"\"Ответ ассистента на вопрос о проекте.\"\"\"\n    question = assistant.parse(command.text)\n    if question is None:\n        raise HTTPException(status_code=400, detail=\"Команда ассистента: /help <вопрос о проекте>\")\n\n    async def stream():\n        async for event in assistant.answer(question):\n            yield assistant.dumps(event)\n\n    return StreamingResponse(stream(), media_type=\"application/x-ndjson\")\n\n\n@app.get(\"/api/support/status\")\nasync def support_status():\n    \"\"\"Статус поддержки — очередь и база знаний.\"\"\"\n    ollama, crm = await asyncio.gather(llm.status(), support.queue())\n    return {\"ollama\": ollama, \"model\": config.MODEL, \"embed_model\": config.EMBED_MODEL,\n            \"kb\": support.index.info(), \"crm\": crm}\n\n\n@app.post(\"/api/support/answer\")\nasync def support_answer(body: Question):\n    \"\"\"Ответ поддержке на вопрос клиента.\"\"\"\n    question = body.question.strip()\n    if not question:\n        raise HTTPException(status_code=400, detail=\"Напишите вопрос клиента\")\n\n    async def stream():\n        async for event in support.answer(body.ticket_id, question):\n            yield assistant.dumps(event)\n\n    return StreamingResponse(stream(), media_type=\"application/x-ndjson\")\n\n\n@app.post(\"/api/files/run\")\nasync def files_run(task: Task):\n    \"\"\"Запуск задачи по файлам проекта.\"\"\"\n    goal = task.goal.strip()\n    if not goal:\n        raise HTTPException(status_code=400, detail=\"Напишите задачу: что найти, обновить или создать\")\n\n    async def stream():\n        async for event in files.run(goal):\n            yield assistant.dumps(event)\n\n    return StreamingResponse(stream(), media_type=\"application/x-ndjson\")\n\n\n@app.post(\"/api/files/apply\")\nasync def files_apply():\n    \"\"\"Применить черновик правок файлов.\"\"\"\n    return await files.apply()\n\n\n@app.post(\"/api/files/discard\")\nasync def files_discard():\n    \"\"\"Отменить черновик правок файлов.\"\"\"\n    return await files.discard()\n\n\n@app.get(\"/api/search\")\nasync def search_docs(q: str = \"\", top: int | None = None):\n    \"\"\"Поиск по документации проекта — фрагменты с близостью.\"\"\"\n    query = q.strip()\n    if not query:\n        raise HTTPException(status_code=400, detail=\"Поле q требуется и должно быть строкой без пробелов\")\n\n    t = top if top is not None else config.TOP\n    if t < 1 or t > 10:\n        raise HTTPException(status_code=400, detail=\"top должен быть от 1 до 10\")\n\n    import time\n    started = time.perf_counter()\n    try:\n        hits = await rag.search(query, top=t)\n    except (llm.LLMError, FileNotFoundError) as exc:\n        raise HTTPException(status_code=503, detail=str(exc))\n    return {\"query\": query, \"hits\": hits, \"seconds\": round(time.perf_counter() - started, 2)}\n\n\nif __name__ == \"__main__\":\n    uvicorn.run(app, host=config.HOST, port=config.PORT)\n","numLines":198,"startLine":1,"totalLines":198}},"tool_result_meta":[{"id":"toolu_8eba3de05557457c8200f48f","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
