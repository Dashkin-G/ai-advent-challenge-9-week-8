{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_61229b42638044579beb0c9f","type":"tool_result","content":"1\t\"\"\"Команда /help: контекст проекта по MCP → поиск по документации → ответ локальной модели.\"\"\"\n2\timport json\n3\timport time\n4\t\n5\tfrom mcp import Client\n6\t\n7\tfrom app import config, llm, rag\n8\t\n9\tSYSTEM = \"\"\"Ты — ассистент разработчика проекта ml-student-dropout. Отвечай по-русски, коротко: 2–5 предложений или список.\n10\tОпирайся только на «Контекст проекта» и «Фрагменты документации».\n11\tПосле утверждения из документации ставь ссылку на фрагмент — его заголовок в квадратных скобках, например [docs/model.md › Причины риска].\n12\tПро ветку, изменения и файлы отвечай по контексту проекта.\n13\tЕсли ответа нет ни там, ни там — так и скажи: «В документации этого нет».\n14\tКоманды, пути, имена файлов и полей пиши в `обратных кавычках`.\"\"\"\n15\t\n16\tOVERVIEW = \"Что это за проект, как он устроен и как его запустить?\"\n17\tCHANGES = (\"измен\", \"правк\", \"поменя\", \"diff\", \"дифф\")  # вопрос про правки — нужен ещё и diff\n18\tGROUPS = {\"изменён\": \"изменены\", \"новый\": \"новые\", \"удалён\": \"удалены\", \"добавлен\": \"добавлены\",\n19\t          \"переименован\": \"переименованы\", \"конфликт\": \"с конфликтом\"}\n20\t\n21\t\n22\tdef parse(text):\n23\t    \"\"\"'/help вопрос' → вопрос; просто '/help' — вопрос о проекте в целом; без /help — None.\"\"\"\n24\t    text = text.strip()\n25\t    if text != \"/help\" and not text.startswith(\"/help \"):\n26\t        return None\n27\t    return text[len(\"/help\"):].strip() or OVERVIEW\n28\t\n29\t\n30\tdef server_info(client):\n31\t    return {\"name\": client.server_info.name if client.server_info else \"?\",\n32\t            \"version\": client.server_info.version if client.server_info else \"\",\n33\t            \"protocol\": client.protocol_version}\n34\t\n35\t\n36\tasync def call(client, calls, name, args):\n37\t    \"\"\"Вызов инструмента MCP: запись с временем и результатом — в calls; вернёт результат или None при ошибке.\"\"\"\n38\t    started = time.perf_counter()\n39\t    result = await client.call_tool(name, args)\n40\t    text = \"\".join(getattr(part, \"text\", \"\") for part in result.content)\n41\t    calls.append({\"tool\": name, \"args\": args, \"ok\": not result.is_error,\n42\t                  \"result\": result.structured_content if result.structured_content is not None else text,\n43\t                  \"ms\": round((time.perf_counter() - started) * 1000)})\n44\t    return calls[-1][\"result\"] if calls[-1][\"ok\"] else None\n45\t\n46\t\n47\tasync def call_tools(plan):\n48\t    \"\"\"Одна сессия MCP: вызовы инструментов по очереди с временем и результатом.\"\"\"\n49\t    calls = []\n50\t    async with Client(config.MCP_URL, read_timeout_seconds=30) as client:\n51\t        server = server_info(client)\n52\t        for name, args in plan:\n53\t            await call(client, calls, name, args)\n54\t    return server, calls\n55\t\n56\t\n57\tdef context_text(calls):\n58\t    \"\"\"Результаты MCP — коротким текстом для модели.\"\"\"\n59\t    got = {c[\"tool\"]: c[\"result\"] for c in calls if c[\"ok\"]}\n60\t    lines = [f\"Проект: {config.PROJECT_DIR.name}\"]\n61\t    if branch := got.get(\"git_branch\"):\n62\t        lines.append(f\"Текущая ветка: {branch['branch']}; ветки: {', '.join(branch['branches'])}; \"\n63\t                     f\"последний коммит: {branch['last_commit']}\")\n64\t    if status := got.get(\"git_status\"):\n65\t        groups = {}\n66\t        for c in status[\"changed\"]:\n67\t            groups.setdefault(GROUPS.get(c[\"status\"], c[\"status\"]), []).append(c[\"path\"])\n68\t        parts = [f\"{name} ({len(paths)}): {', '.join(paths[:12])}{' …' if len(paths) > 12 else ''}\"\n69\t                 for name, paths in groups.items()]\n70\t        lines.append(\"Незакоммиченных изменений нет\" if status[\"clean\"]\n71\t                     else f\"Незакоммиченные изменения — {status['count']} файлов. \" + \"; \".join(parts))\n72\t    if files := got.get(\"list_files\"):\n73\t        lines.append(f\"Файлы проекта ({files['count']}): {', '.join(files['files'])}\")\n74\t    if diff := got.get(\"git_diff\"):\n75\t        lines.append(f\"Diff ({diff['lines']} строк{', начало' if diff['truncated'] else ''}):\\n{diff['diff'] or '(пусто)'}\")\n76\t    return \"\\n\".join(lines)\n77\t\n78\t\n79\tdef messages(question, context, hits):\n80\t    # Неизменная часть — системный промпт и контекст проекта — идёт первой: Ollama кэширует начало промпта\n81\t    fragments = \"\\n\\n\".join(f\"[{h['file']} › {h['title']}]\\n{h['text']}\" for h in hits)\n82\t    user = (f\"Контекст проекта (git, получен через MCP):\\n{context}\\n\\nВопрос: {question}\\n\\n\"\n83\t            f\"Фрагменты документации:\\n\\n{fragments}\\n\\nВопрос: {question}\")\n84\t    return [{\"role\": \"system\", \"content\": SYSTEM}, {\"role\": \"user\", \"content\": user}]\n85\t\n86\t\n87\tasync def answer(question):\n88\t    \"\"\"Шаги ответа событиями: mcp → sources → prompt → text… → done; ошибка — error с номером шага.\"\"\"\n89\t    yield {\"type\": \"question\", \"question\": question}\n90\t\n91\t    step = \"mcp\"\n92\t    try:\n93\t        started = time.perf_counter()\n94\t        plan = [(\"git_branch\", {}), (\"git_status\", {}), (\"list_files\", {})]\n95\t        if any(word in question.lower() for word in CHANGES):\n96\t            plan.append((\"git_diff\", {}))\n97\t        server, calls = await call_tools(plan)\n98\t        context = context_text(calls)\n99\t        yield {\"type\": \"mcp\", \"server\": server, \"calls\": calls, \"seconds\": round(time.perf_counter() - started, 2)}\n100\t\n101\t        step = \"sources\"\n102\t        started = time.perf_counter()\n103\t        hits = await rag.search(question)\n104\t        yield {\"type\": \"sources\", \"hits\": hits, \"index\": rag.info(), \"seconds\": round(time.perf_counter() - started, 2)}\n105\t\n106\t        step = \"answer\"\n107\t        prompt = messages(question, context, hits)\n108\t        yield {\"type\": \"prompt\", \"messages\": prompt, \"chars\": sum(len(m[\"content\"]) for m in prompt)}\n109\t        async for event in llm.chat(prompt):\n110\t            yield event\n111\t    except llm.LLMError as exc:\n112\t        yield {\"type\": \"error\", \"step\": step, \"message\": str(exc)}\n113\t    except Exception as exc:  # MCP, git, файлы — показываем словами, а не падением\n114\t        yield {\"type\": \"error\", \"step\": step, \"message\": reason(exc)}\n115\t\n116\t\n117\tdef reason(exc):\n118\t    \"\"\"Причина ошибки; клиент MCP бросает ExceptionGroup — достаём первую настоящую.\"\"\"\n119\t    while isinstance(exc, BaseExceptionGroup) and exc.exceptions:\n120\t        exc = exc.exceptions[0]\n121\t    return getattr(exc, \"message\", None) or str(exc) or type(exc).__name__\n122\t\n123\t\n124\tasync def project():\n125\t    \"\"\"Шапка страницы: проект и ветка — тоже через MCP.\"\"\"\n126\t    try:\n127\t        _, calls = await call_tools([(\"git_branch\", {})])\n128\t        return {\"name\": config.PROJECT_DIR.name, \"branch\": calls[0][\"result\"][\"branch\"] if calls[0][\"ok\"] else None}\n129\t    except Exception as exc:\n130\t        return {\"name\": config.PROJECT_DIR.name, \"branch\": None, \"error\": reason(exc)}\n131\t\n132\t\n133\tdef dumps(event):\n134\t    return json.dumps(event, ensure_ascii=False) + \"\\n\"\n135\t"}]},"parent_tool_use_id":null,"session_id":"c7fb8109-f3fd-4db1-89da-bdb17becddd6","uuid":"4346502e-3d3b-46b9-b5c8-a2c1f74cfe20","timestamp":"2026-10-24T23:46:51.213Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\USER\\AppData\\Local\\Temp\\claude-rules\\loop-v2\\app\\assistant.py","content":"\"\"\"Команда /help: контекст проекта по MCP → поиск по документации → ответ локальной модели.\"\"\"\nimport json\nimport time\n\nfrom mcp import Client\n\nfrom app import config, llm, rag\n\nSYSTEM = \"\"\"Ты — ассистент разработчика проекта ml-student-dropout. Отвечай по-русски, коротко: 2–5 предложений или список.\nОпирайся только на «Контекст проекта» и «Фрагменты документации».\nПосле утверждения из документации ставь ссылку на фрагмент — его заголовок в квадратных скобках, например [docs/model.md › Причины риска].\nПро ветку, изменения и файлы отвечай по контексту проекта.\nЕсли ответа нет ни там, ни там — так и скажи: «В документации этого нет».\nКоманды, пути, имена файлов и полей пиши в `обратных кавычках`.\"\"\"\n\nOVERVIEW = \"Что это за проект, как он устроен и как его запустить?\"\nCHANGES = (\"измен\", \"правк\", \"поменя\", \"diff\", \"дифф\")  # вопрос про правки — нужен ещё и diff\nGROUPS = {\"изменён\": \"изменены\", \"новый\": \"новые\", \"удалён\": \"удалены\", \"добавлен\": \"добавлены\",\n          \"переименован\": \"переименованы\", \"конфликт\": \"с конфликтом\"}\n\n\ndef parse(text):\n    \"\"\"'/help вопрос' → вопрос; просто '/help' — вопрос о проекте в целом; без /help — None.\"\"\"\n    text = text.strip()\n    if text != \"/help\" and not text.startswith(\"/help \"):\n        return None\n    return text[len(\"/help\"):].strip() or OVERVIEW\n\n\ndef server_info(client):\n    return {\"name\": client.server_info.name if client.server_info else \"?\",\n            \"version\": client.server_info.version if client.server_info else \"\",\n            \"protocol\": client.protocol_version}\n\n\nasync def call(client, calls, name, args):\n    \"\"\"Вызов инструмента MCP: запись с временем и результатом — в calls; вернёт результат или None при ошибке.\"\"\"\n    started = time.perf_counter()\n    result = await client.call_tool(name, args)\n    text = \"\".join(getattr(part, \"text\", \"\") for part in result.content)\n    calls.append({\"tool\": name, \"args\": args, \"ok\": not result.is_error,\n                  \"result\": result.structured_content if result.structured_content is not None else text,\n                  \"ms\": round((time.perf_counter() - started) * 1000)})\n    return calls[-1][\"result\"] if calls[-1][\"ok\"] else None\n\n\nasync def call_tools(plan):\n    \"\"\"Одна сессия MCP: вызовы инструментов по очереди с временем и результатом.\"\"\"\n    calls = []\n    async with Client(config.MCP_URL, read_timeout_seconds=30) as client:\n        server = server_info(client)\n        for name, args in plan:\n            await call(client, calls, name, args)\n    return server, calls\n\n\ndef context_text(calls):\n    \"\"\"Результаты MCP — коротким текстом для модели.\"\"\"\n    got = {c[\"tool\"]: c[\"result\"] for c in calls if c[\"ok\"]}\n    lines = [f\"Проект: {config.PROJECT_DIR.name}\"]\n    if branch := got.get(\"git_branch\"):\n        lines.append(f\"Текущая ветка: {branch['branch']}; ветки: {', '.join(branch['branches'])}; \"\n                     f\"последний коммит: {branch['last_commit']}\")\n    if status := got.get(\"git_status\"):\n        groups = {}\n        for c in status[\"changed\"]:\n            groups.setdefault(GROUPS.get(c[\"status\"], c[\"status\"]), []).append(c[\"path\"])\n        parts = [f\"{name} ({len(paths)}): {', '.join(paths[:12])}{' …' if len(paths) > 12 else ''}\"\n                 for name, paths in groups.items()]\n        lines.append(\"Незакоммиченных изменений нет\" if status[\"clean\"]\n                     else f\"Незакоммиченные изменения — {status['count']} файлов. \" + \"; \".join(parts))\n    if files := got.get(\"list_files\"):\n        lines.append(f\"Файлы проекта ({files['count']}): {', '.join(files['files'])}\")\n    if diff := got.get(\"git_diff\"):\n        lines.append(f\"Diff ({diff['lines']} строк{', начало' if diff['truncated'] else ''}):\\n{diff['diff'] or '(пусто)'}\")\n    return \"\\n\".join(lines)\n\n\ndef messages(question, context, hits):\n    # Неизменная часть — системный промпт и контекст проекта — идёт первой: Ollama кэширует начало промпта\n    fragments = \"\\n\\n\".join(f\"[{h['file']} › {h['title']}]\\n{h['text']}\" for h in hits)\n    user = (f\"Контекст проекта (git, получен через MCP):\\n{context}\\n\\nВопрос: {question}\\n\\n\"\n            f\"Фрагменты документации:\\n\\n{fragments}\\n\\nВопрос: {question}\")\n    return [{\"role\": \"system\", \"content\": SYSTEM}, {\"role\": \"user\", \"content\": user}]\n\n\nasync def answer(question):\n    \"\"\"Шаги ответа событиями: mcp → sources → prompt → text… → done; ошибка — error с номером шага.\"\"\"\n    yield {\"type\": \"question\", \"question\": question}\n\n    step = \"mcp\"\n    try:\n        started = time.perf_counter()\n        plan = [(\"git_branch\", {}), (\"git_status\", {}), (\"list_files\", {})]\n        if any(word in question.lower() for word in CHANGES):\n            plan.append((\"git_diff\", {}))\n        server, calls = await call_tools(plan)\n        context = context_text(calls)\n        yield {\"type\": \"mcp\", \"server\": server, \"calls\": calls, \"seconds\": round(time.perf_counter() - started, 2)}\n\n        step = \"sources\"\n        started = time.perf_counter()\n        hits = await rag.search(question)\n        yield {\"type\": \"sources\", \"hits\": hits, \"index\": rag.info(), \"seconds\": round(time.perf_counter() - started, 2)}\n\n        step = \"answer\"\n        prompt = messages(question, context, hits)\n        yield {\"type\": \"prompt\", \"messages\": prompt, \"chars\": sum(len(m[\"content\"]) for m in prompt)}\n        async for event in llm.chat(prompt):\n            yield event\n    except llm.LLMError as exc:\n        yield {\"type\": \"error\", \"step\": step, \"message\": str(exc)}\n    except Exception as exc:  # MCP, git, файлы — показываем словами, а не падением\n        yield {\"type\": \"error\", \"step\": step, \"message\": reason(exc)}\n\n\ndef reason(exc):\n    \"\"\"Причина ошибки; клиент MCP бросает ExceptionGroup — достаём первую настоящую.\"\"\"\n    while isinstance(exc, BaseExceptionGroup) and exc.exceptions:\n        exc = exc.exceptions[0]\n    return getattr(exc, \"message\", None) or str(exc) or type(exc).__name__\n\n\nasync def project():\n    \"\"\"Шапка страницы: проект и ветка — тоже через MCP.\"\"\"\n    try:\n        _, calls = await call_tools([(\"git_branch\", {})])\n        return {\"name\": config.PROJECT_DIR.name, \"branch\": calls[0][\"result\"][\"branch\"] if calls[0][\"ok\"] else None}\n    except Exception as exc:\n        return {\"name\": config.PROJECT_DIR.name, \"branch\": None, \"error\": reason(exc)}\n\n\ndef dumps(event):\n    return json.dumps(event, ensure_ascii=False) + \"\\n\"\n","numLines":135,"startLine":1,"totalLines":135}},"tool_result_meta":[{"id":"toolu_61229b42638044579beb0c9f","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"id":"msg_a8b539ed-4707-90fe-8069-cc74816514ee","type":"message","role":"assistant","model":"qwen3.5-122b-a10b","content":[{"type":"tool_use","id":"toolu_cb79b349ac73407381c4f39a","name":"Read","input":{"file_path":"C:\\Users\\USER\\AppData\\Local\\Temp\\claude-rules\\loop-v2\\app\\support.py"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":14288,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"c7fb8109-f3fd-4db1-89da-bdb17becddd6","uuid":"ece09017-7be0-4bc5-b863-7c13aaa92994","timestamp":"2026-10-24T23:46:51.693Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_cb79b349ac73407381c4f39a","type":"tool_result","content":"1\t\"\"\"Ассистент поддержки: обращение и клиент из CRM по MCP → поиск по FAQ и документации → ответ клиенту.\"\"\"\n2\timport asyncio\n3\timport json\n4\timport time\n5\t\n6\tfrom mcp import Client\n7\t\n8\tfrom app import assistant, config, llm, rag\n9\t\n10\tSYSTEM = \"\"\"Ты — ассистент поддержки сервиса «Риск отчисления студентов». Пишешь ответ клиенту от имени поддержки: по-русски, на «вы», начни с обращения по имени клиента из CRM; коротко — 3–6 предложений или список шагов.\n11\tОпирайся только на «Данные из CRM» и «Фрагменты базы знаний». Фрагменты найдены поиском и бывают не по теме: бери только те, что отвечают на вопрос клиента.\n12\tЕсли причина видна в технических данных обращения или в профиле клиента — назови её конкретно: поле, значение, текст ошибки, команду — и скажи, что сделать. Прошлые обращения упоминай, только если они о той же проблеме.\n13\tУчитывай, кто клиент и как он работает с сервисом: дашборд — простыми словами и кнопками страницы; API или Docker — полями, запросами и командами. Если сделать нужное клиент сам не может, а в профиле сказано, кто ведёт сервис, — подскажи, к кому обратиться.\n14\tПосле утверждения из базы знаний ставь ссылку на фрагмент — его заголовок в квадратных скобках, например [FAQ › Что значит ошибка 422?].\n15\tНе придумывай полей, команд, настроек, кнопок и эндпоинтов, которых нет во фрагментах и данных CRM. Если ответа нет — так и скажи и пообещай передать вопрос разработчикам.\n16\tПоля, команды и адреса пиши в `обратных кавычках`.\"\"\"\n17\t\n18\tNO_TICKET = \"Обращения нет: вопрос о продукте без данных клиента — отвечай без обращения по имени.\"\n19\t\n20\tindex = rag.Index(\"support-embeddings\")  # FAQ поддержки + README и docs/ проекта\n21\t_lock = asyncio.Lock()  # сборка при старте и первый вопрос не считают векторы дважды\n22\t\n23\t\n24\tasync def ensure_index():\n25\t    \"\"\"База знаний актуальна: поменяли FAQ или документацию — пересчитываются векторы только новых фрагментов.\"\"\"\n26\t    async with _lock:\n27\t        texts = {\"FAQ\": config.FAQ.read_text(encoding=\"utf-8\")}\n28\t        texts.update({p.relative_to(config.PROJECT_DIR).as_posix(): p.read_text(encoding=\"utf-8\") for p in rag.files()})\n29\t        await index.build(texts)\n30\t        return index.info()\n31\t\n32\t\n33\tasync def queue():\n34\t    \"\"\"Очередь обращений для страницы — тоже через MCP.\"\"\"\n35\t    started, calls = time.perf_counter(), []\n36\t    try:\n37\t        async with Client(config.CRM_MCP_URL, read_timeout_seconds=30) as client:\n38\t            server = assistant.server_info(client)\n39\t            found = await assistant.call(client, calls, \"list_tickets\", {})\n40\t    except Exception as exc:\n41\t        return {\"error\": assistant.reason(exc)}\n42\t    if found is None:\n43\t        return {\"error\": calls[0][\"result\"]}\n44\t    return {\"server\": server, \"tickets\": found[\"tickets\"], \"ms\": round((time.perf_counter() - started) * 1000)}\n45\t\n46\t\n47\tasync def crm(ticket_id):\n48\t    \"\"\"Одна сессия MCP: обращение, затем его клиент — с временем и результатом каждого вызова.\"\"\"\n49\t    calls = []\n50\t    async with Client(config.CRM_MCP_URL, read_timeout_seconds=30) as client:\n51\t        server = assistant.server_info(client)\n52\t        ticket = await assistant.call(client, calls, \"get_ticket\", {\"ticket_id\": ticket_id})\n53\t        user = await assistant.call(client, calls, \"get_user\", {\"user_id\": ticket[\"user_id\"]}) if ticket else None\n54\t    return server, calls, ticket, user\n55\t\n56\t\n57\tdef context_text(ticket, user):\n58\t    \"\"\"Клиент и обращение — коротким текстом для модели.\"\"\"\n59\t    lines = [f\"Клиент: {user['name']} — {user['role']}, {user['org']}. \"\n60\t             f\"Работает с сервисом через {user['channel']}: {user['setup']}.\"]\n61\t    if user.get(\"notes\"):\n62\t        lines.append(f\"Заметки поддержки: {user['notes']}\")\n63\t    if past := [t for t in user[\"tickets\"] if t[\"id\"] != ticket[\"id\"]]:\n64\t        lines.append(\"Прошлые обращения: \" + \"; \".join(\n65\t            f\"{t['id']} «{t['subject']}» — {t['status']}\" + (f\": {t['resolution']}\" if t.get(\"resolution\") else \"\")\n66\t            for t in past))\n67\t    lines.append(f\"Обращение {ticket['id']} «{ticket['subject']}» — {ticket['status']}, \"\n68\t                 f\"приоритет {ticket['priority']}, {ticket['created']}.\")\n69\t    lines.append(f\"Сообщение клиента: {ticket['message']}\")\n70\t    if ticket[\"technical\"]:\n71\t        lines.append(\"Технические данные обращения:\")\n72\t        lines += [f\"- {k}: {v if isinstance(v, str) else json.dumps(v, ensure_ascii=False)}\"\n73\t                  for k, v in ticket[\"technical\"].items()]\n74\t    return \"\\n\".join(lines)\n75\t\n76\t\n77\tdef queries(question, ticket):\n78\t    \"\"\"Запросы к базе знаний: вопрос и тексты ошибок сервиса из обращения — каждый отдельно. Сообщение клиента\n79\t    в запрос не идёт: длинный текст размывает вектор, и нужный раздел FAQ уходит с первого места.\"\"\"\n80\t    errors = [v[\"details\"] for v in (ticket or {}).get(\"technical\", {}).values()\n81\t              if isinstance(v, dict) and v.get(\"details\")]\n82\t    return list(dict.fromkeys([question, *errors]))\n83\t\n84\t\n85\tdef messages(question, context, hits):\n86\t    fragments = \"\\n\\n\".join(f\"[{rag.source(h)}]\\n{h['text']}\" for h in hits)\n87\t    crm_part = f\"Данные из CRM (получены через MCP):\\n{context}\" if context else NO_TICKET\n88\t    user = f\"{crm_part}\\n\\nВопрос: {question}\\n\\nФрагменты базы знаний:\\n\\n{fragments}\\n\\nВопрос: {question}\"\n89\t    return [{\"role\": \"system\", \"content\": SYSTEM}, {\"role\": \"user\", \"content\": user}]\n90\t\n91\t\n92\tasync def answer(ticket_id, question):\n93\t    \"\"\"Шаги ответа событиями: mcp (если выбрано обращение) → sources → prompt → text… → done;\n94\t    ошибка — error с шагом.\"\"\"\n95\t    yield {\"type\": \"question\", \"question\": question, \"ticket_id\": ticket_id}\n96\t    step = \"mcp\"\n97\t    try:\n98\t        ticket = context = None\n99\t        if ticket_id:\n100\t            started = time.perf_counter()\n101\t            server, calls, ticket, user = await crm(ticket_id)\n102\t            yield {\"type\": \"mcp\", \"server\": server, \"calls\": calls, \"seconds\": round(time.perf_counter() - started, 2)}\n103\t            if not user:\n104\t                yield {\"type\": \"error\", \"step\": step, \"message\": next(c[\"result\"] for c in calls if not c[\"ok\"])}\n105\t                return\n106\t            context = context_text(ticket, user)\n107\t\n108\t        step = \"sources\"\n109\t        started = time.perf_counter()\n110\t        await ensure_index()\n111\t        asked = queries(question, ticket)\n112\t        hits = index.nearest(await llm.embed(asked), config.TOP)\n113\t        yield {\"type\": \"sources\", \"hits\": hits, \"queries\": asked, \"index\": index.info(),\n114\t               \"seconds\": round(time.perf_counter() - started, 2)}\n115\t\n116\t        step = \"answer\"\n117\t        prompt = messages(question, context, hits)\n118\t        yield {\"type\": \"prompt\", \"messages\": prompt, \"chars\": sum(len(m[\"content\"]) for m in prompt)}\n119\t        async for event in llm.chat(prompt, options={\"seed\": 42}):  # то же обращение — тот же ответ\n120\t            yield event\n121\t    except llm.LLMError as exc:\n122\t        yield {\"type\": \"error\", \"step\": step, \"message\": str(exc)}\n123\t    except Exception as exc:  # MCP, файл CRM — показываем словами, а не падением\n124\t        yield {\"type\": \"error\", \"step\": step, \"message\": assistant.reason(exc)}\n125\t"}]},"parent_tool_use_id":null,"session_id":"c7fb8109-f3fd-4db1-89da-bdb17becddd6","uuid":"4406b6a5-0ff7-407a-b472-ee0b07ca0cc1","timestamp":"2026-10-24T23:46:51.711Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\USER\\AppData\\Local\\Temp\\claude-rules\\loop-v2\\app\\support.py","content":"\"\"\"Ассистент поддержки: обращение и клиент из CRM по MCP → поиск по FAQ и документации → ответ клиенту.\"\"\"\nimport asyncio\nimport json\nimport time\n\nfrom mcp import Client\n\nfrom app import assistant, config, llm, rag\n\nSYSTEM = \"\"\"Ты — ассистент поддержки сервиса «Риск отчисления студентов». Пишешь ответ клиенту от имени поддержки: по-русски, на «вы», начни с обращения по имени клиента из CRM; коротко — 3–6 предложений или список шагов.\nОпирайся только на «Данные из CRM» и «Фрагменты базы знаний». Фрагменты найдены поиском и бывают не по теме: бери только те, что отвечают на вопрос клиента.\nЕсли причина видна в технических данных обращения или в профиле клиента — назови её конкретно: поле, значение, текст ошибки, команду — и скажи, что сделать. Прошлые обращения упоминай, только если они о той же проблеме.\nУчитывай, кто клиент и как он работает с сервисом: дашборд — простыми словами и кнопками страницы; API или Docker — полями, запросами и командами. Если сделать нужное клиент сам не может, а в профиле сказано, кто ведёт сервис, — подскажи, к кому обратиться.\nПосле утверждения из базы знаний ставь ссылку на фрагмент — его заголовок в квадратных скобках, например [FAQ › Что значит ошибка 422?].\nНе придумывай полей, команд, настроек, кнопок и эндпоинтов, которых нет во фрагментах и данных CRM. Если ответа нет — так и скажи и пообещай передать вопрос разработчикам.\nПоля, команды и адреса пиши в `обратных кавычках`.\"\"\"\n\nNO_TICKET = \"Обращения нет: вопрос о продукте без данных клиента — отвечай без обращения по имени.\"\n\nindex = rag.Index(\"support-embeddings\")  # FAQ поддержки + README и docs/ проекта\n_lock = asyncio.Lock()  # сборка при старте и первый вопрос не считают векторы дважды\n\n\nasync def ensure_index():\n    \"\"\"База знаний актуальна: поменяли FAQ или документацию — пересчитываются векторы только новых фрагментов.\"\"\"\n    async with _lock:\n        texts = {\"FAQ\": config.FAQ.read_text(encoding=\"utf-8\")}\n        texts.update({p.relative_to(config.PROJECT_DIR).as_posix(): p.read_text(encoding=\"utf-8\") for p in rag.files()})\n        await index.build(texts)\n        return index.info()\n\n\nasync def queue():\n    \"\"\"Очередь обращений для страницы — тоже через MCP.\"\"\"\n    started, calls = time.perf_counter(), []\n    try:\n        async with Client(config.CRM_MCP_URL, read_timeout_seconds=30) as client:\n            server = assistant.server_info(client)\n            found = await assistant.call(client, calls, \"list_tickets\", {})\n    except Exception as exc:\n        return {\"error\": assistant.reason(exc)}\n    if found is None:\n        return {\"error\": calls[0][\"result\"]}\n    return {\"server\": server, \"tickets\": found[\"tickets\"], \"ms\": round((time.perf_counter() - started) * 1000)}\n\n\nasync def crm(ticket_id):\n    \"\"\"Одна сессия MCP: обращение, затем его клиент — с временем и результатом каждого вызова.\"\"\"\n    calls = []\n    async with Client(config.CRM_MCP_URL, read_timeout_seconds=30) as client:\n        server = assistant.server_info(client)\n        ticket = await assistant.call(client, calls, \"get_ticket\", {\"ticket_id\": ticket_id})\n        user = await assistant.call(client, calls, \"get_user\", {\"user_id\": ticket[\"user_id\"]}) if ticket else None\n    return server, calls, ticket, user\n\n\ndef context_text(ticket, user):\n    \"\"\"Клиент и обращение — коротким текстом для модели.\"\"\"\n    lines = [f\"Клиент: {user['name']} — {user['role']}, {user['org']}. \"\n             f\"Работает с сервисом через {user['channel']}: {user['setup']}.\"]\n    if user.get(\"notes\"):\n        lines.append(f\"Заметки поддержки: {user['notes']}\")\n    if past := [t for t in user[\"tickets\"] if t[\"id\"] != ticket[\"id\"]]:\n        lines.append(\"Прошлые обращения: \" + \"; \".join(\n            f\"{t['id']} «{t['subject']}» — {t['status']}\" + (f\": {t['resolution']}\" if t.get(\"resolution\") else \"\")\n            for t in past))\n    lines.append(f\"Обращение {ticket['id']} «{ticket['subject']}» — {ticket['status']}, \"\n                 f\"приоритет {ticket['priority']}, {ticket['created']}.\")\n    lines.append(f\"Сообщение клиента: {ticket['message']}\")\n    if ticket[\"technical\"]:\n        lines.append(\"Технические данные обращения:\")\n        lines += [f\"- {k}: {v if isinstance(v, str) else json.dumps(v, ensure_ascii=False)}\"\n                  for k, v in ticket[\"technical\"].items()]\n    return \"\\n\".join(lines)\n\n\ndef queries(question, ticket):\n    \"\"\"Запросы к базе знаний: вопрос и тексты ошибок сервиса из обращения — каждый отдельно. Сообщение клиента\n    в запрос не идёт: длинный текст размывает вектор, и нужный раздел FAQ уходит с первого места.\"\"\"\n    errors = [v[\"details\"] for v in (ticket or {}).get(\"technical\", {}).values()\n              if isinstance(v, dict) and v.get(\"details\")]\n    return list(dict.fromkeys([question, *errors]))\n\n\ndef messages(question, context, hits):\n    fragments = \"\\n\\n\".join(f\"[{rag.source(h)}]\\n{h['text']}\" for h in hits)\n    crm_part = f\"Данные из CRM (получены через MCP):\\n{context}\" if context else NO_TICKET\n    user = f\"{crm_part}\\n\\nВопрос: {question}\\n\\nФрагменты базы знаний:\\n\\n{fragments}\\n\\nВопрос: {question}\"\n    return [{\"role\": \"system\", \"content\": SYSTEM}, {\"role\": \"user\", \"content\": user}]\n\n\nasync def answer(ticket_id, question):\n    \"\"\"Шаги ответа событиями: mcp (если выбрано обращение) → sources → prompt → text… → done;\n    ошибка — error с шагом.\"\"\"\n    yield {\"type\": \"question\", \"question\": question, \"ticket_id\": ticket_id}\n    step = \"mcp\"\n    try:\n        ticket = context = None\n        if ticket_id:\n            started = time.perf_counter()\n            server, calls, ticket, user = await crm(ticket_id)\n            yield {\"type\": \"mcp\", \"server\": server, \"calls\": calls, \"seconds\": round(time.perf_counter() - started, 2)}\n            if not user:\n                yield {\"type\": \"error\", \"step\": step, \"message\": next(c[\"result\"] for c in calls if not c[\"ok\"])}\n                return\n            context = context_text(ticket, user)\n\n        step = \"sources\"\n        started = time.perf_counter()\n        await ensure_index()\n        asked = queries(question, ticket)\n        hits = index.nearest(await llm.embed(asked), config.TOP)\n        yield {\"type\": \"sources\", \"hits\": hits, \"queries\": asked, \"index\": index.info(),\n               \"seconds\": round(time.perf_counter() - started, 2)}\n\n        step = \"answer\"\n        prompt = messages(question, context, hits)\n        yield {\"type\": \"prompt\", \"messages\": prompt, \"chars\": sum(len(m[\"content\"]) for m in prompt)}\n        async for event in llm.chat(prompt, options={\"seed\": 42}):  # то же обращение — тот же ответ\n            yield event\n    except llm.LLMError as exc:\n        yield {\"type\": \"error\", \"step\": step, \"message\": str(exc)}\n    except Exception as exc:  # MCP, файл CRM — показываем словами, а не падением\n        yield {\"type\": \"error\", \"step\": step, \"message\": assistant.reason(exc)}\n","numLines":125,"startLine":1,"totalLines":125}},"tool_result_meta":[{"id":"toolu_cb79b349ac73407381c4f39a","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
{"type":"assistant","message":{"id":"msg_a8b539ed-4707-90fe-8069-cc74816514ee","type":"message","role":"assistant","model":"qwen3.5-122b-a10b","content":[{"type":"tool_use","id":"toolu_673da2a7162a474d8b49cf31","name":"Read","input":{"file_path":"C:\\Users\\USER\\AppData\\Local\\Temp\\claude-rules\\loop-v2\\app\\files.py"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":14288,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"c7fb8109-f3fd-4db1-89da-bdb17becddd6","uuid":"e9fb4cc8-6d83-4f96-9bd1-1b39ef25f86f","timestamp":"2026-10-24T23:46:52.101Z"}
{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_673da2a7162a474d8b49cf31","type":"tool_result","content":"1\t\"\"\"Ассистент по файлам проекта: задача словами → модель сама вызывает инструменты MCP — ищет, читает, правит\n2\tи создаёт файлы → правки копятся в черновике → diff, который пользователь применяет или отменяет.\"\"\"\n3\timport json\n4\timport time\n5\t\n6\tfrom mcp import Client\n7\t\n8\tfrom app import assistant, config, llm\n9\t\n10\tSYSTEM = \"\"\"Ты — ассистент разработчика проекта ml-student-dropout: сервис на FastAPI и scikit-learn — API в src/api, модель в src/ml, схемы в src/schemas, дашборд в static/, тесты в tests/, документация в README.md и docs/. Задачу выполняешь сам через инструменты: ищешь, читаешь, правишь и создаёшь файлы проекта. Пользователя ни о чём не спрашивай.\n11\tПравила:\n12\t- Начинай с search, а не с чтения файлов целиком. Ищи так, как написано в файлах: имена функций, классов, констант, адреса эндпоинтов, числа, слова из документации; несколько вариантов — в одном запросе через |.\n13\t- read_file — только строки вокруг найденного: start и end по номерам из search.\n14\t- edit_file: old — точная строка из файла без номера, new — она же после правки; каждое место — отдельной правкой. Новый файл — write_file. Правки идут в черновик, на диск их запишет пользователь.\n15\t- Меняй только то, что требует задача. Не выдумывай файлов, функций, чисел и фактов — бери только то, что видел в файлах и git; замеры (время, скорость, проценты) не пересчитывай.\n16\tТиповые задачи:\n17\t- «Где используется X» — search по всем вариантам имени (функция, класс, эндпоинт, русское название) и перечисли каждое место.\n18\t- «Обнови документацию по изменениям в коде» — git_diff; по строкам «-» и «+» пойми, что было и что стало. Документация пишет значения, а не имена констант: поменялось число или строка — search прежнего значения по всему проекту. Поправь в README.md и docs/ каждое место с прежним значением, другие места не трогай. Перед отчётом — search прежнего значения ещё раз: в документации его не осталось.\n19\t- «Составь CHANGELOG по истории» — git_log с oldest_first=true, затем write_file: «# Журнал изменений» и по строке на коммит в том же порядке — «- дата — что изменилось (хеш)», например «- дд.мм.гггг — Добавлена выгрузка отчёта в CSV (1a2b3c4)». Даты — как в git_log. Что изменилось — по сообщению и файлам коммита, по-русски своими словами; у общего сообщения вроде «init commit» — какие части сервиса появились, словами, без путей; термины вроде pull request и CI не переводи. Без других заголовков, списков файлов и чисел строк.\n20\tКогда задача выполнена, ответь без вызова инструментов: коротко по-русски, что нашёл (`файл:строка`) и что изменил — только правки, которые прошли.\"\"\"\n21\t\n22\t# Что получает модель; apply_draft и discard_draft зовёт только код — по кнопке пользователя\n23\tMODEL_TOOLS = {\"files\": [\"list_files\", \"read_file\", \"search\", \"edit_file\", \"write_file\"],\n24\t               \"git\": [\"git_status\", \"git_diff\", \"git_log\"]}\n25\tMAX_STEPS = 12  # ходов модели; дальше — просим подвести итог\n26\tOPTIONS = {\"num_ctx\": 16384, \"num_predict\": 1500, \"seed\": 7}  # разговор с файлами длинный; seed — та же задача, тот же путь\n27\tBLOCKS = {\"text\", \"diff\"}  # текст файла и diff модель получает как есть, а не строкой JSON\n28\tFINISH = \"Шаги закончились. Не вызывай инструменты — коротко отчитайся: что нашёл и что изменил.\"\n29\t# 4B-модель пропускает проверку из промпта; после правок код один раз просит её сам — что искать, решает модель\n30\tCHECK = (\"Перед отчётом проверь себя: search того, что было до правки, по всему проекту — не осталось ли его в \"\n31\t         \"документации. Осталось — поправь. Потом дай итоговый отчёт: что нашёл (`файл:строка`) и что изменил.\")\n32\t\n33\t\n34\tdef spec(tool):\n35\t    \"\"\"Инструмент MCP → функция для Ollama; заголовки из JSON Schema модели не нужны — лишние токены.\"\"\"\n36\t    def clean(node):\n37\t        if isinstance(node, dict):\n38\t            return {k: clean(v) for k, v in node.items() if not (k == \"title\" and isinstance(v, str))}\n39\t        return node\n40\t    return {\"type\": \"function\",\n41\t            \"function\": {\"name\": tool.name, \"description\": tool.description, \"parameters\": clean(tool.input_schema)}}\n42\t\n43\t\n44\tdef for_model(result):\n45\t    \"\"\"Результат инструмента — текстом: файл, совпадения и diff — строками как есть, список записей — по строке\n46\t    на запись. В JSON кавычки экранируются, и модель копирует \\\\\" в правку, а по вложенному JSON 4B-модель\n47\t    теряет порядок записей.\"\"\"\n48\t    if not isinstance(result, dict):\n49\t        return str(result)\n50\t    head, blocks = {}, []\n51\t    for key, value in result.items():\n52\t        if key in BLOCKS and isinstance(value, str):\n53\t            blocks.append(value)\n54\t        elif isinstance(value, list) and value and all(isinstance(v, str) for v in value):\n55\t            blocks.append(\"\\n\".join(value))\n56\t        elif isinstance(value, list) and value and all(isinstance(v, dict) for v in value):\n57\t            blocks.append(\"\\n\".join(\" · \".join(f\"{k}: {', '.join(map(str, v)) if isinstance(v, list) else v}\"\n58\t                                               for k, v in item.items()) for item in value))\n59\t        else:\n60\t            head[key] = value\n61\t    return \"\\n\".join([json.dumps(head, ensure_ascii=False), *blocks])\n62\t\n63\t\n64\tasync def turn(messages, tools=None):\n65\t    \"\"\"Один ход модели: текст потоком, в конце — {\"type\": \"turn\"} с текстом, вызовами и счётчиками.\"\"\"\n66\t    text, calls, counters = \"\", [], {}\n67\t    async for event in llm.chat(messages, options=OPTIONS, tools=tools):\n68\t        if event[\"type\"] == \"text\":\n69\t            text += event[\"text\"]\n70\t            yield event\n71\t        elif event[\"type\"] == \"tool_calls\":\n72\t            calls += event[\"calls\"]\n73\t        else:\n74\t            counters = event\n75\t    yield {\"type\": \"turn\", \"text\": text, \"calls\": calls, \"llm\": counters}\n76\t\n77\t\n78\tasync def run(goal):\n79\t    \"\"\"Работа над задачей событиями: goal → context → (thinking → text… → step)… → [check → ещё шаги] → report →\n80\t    draft → done; ошибка — error.\"\"\"\n81\t    yield {\"type\": \"goal\", \"goal\": goal}\n82\t    started, step = time.perf_counter(), 0\n83\t    try:\n84\t        async with Client(config.FILES_MCP_URL, read_timeout_seconds=60) as files, \\\n85\t                Client(config.MCP_URL, read_timeout_seconds=60) as git:\n86\t            await files.call_tool(\"discard_draft\", {})  # неприменённые правки прошлой задачи сюда не смешиваем\n87\t            servers = {\"files\": files, \"git\": git}\n88\t\n89\t            # контекст зовёт код: ветка, изменения и список файлов — чтобы модель не гадала пути\n90\t            calls = []\n91\t            await assistant.call(git, calls, \"git_branch\", {})\n92\t            await assistant.call(git, calls, \"git_status\", {})\n93\t            await assistant.call(files, calls, \"list_files\", {})\n94\t            owners, specs, tools = {}, [], []\n95\t            for name, client in servers.items():\n96\t                for tool in (await client.list_tools()).tools:\n97\t                    if tool.name in MODEL_TOOLS[name]:\n98\t                        owners[tool.name] = name\n99\t                        specs.append(spec(tool))\n100\t                        tools.append({\"name\": tool.name, \"server\": name, \"description\": tool.description})\n101\t            messages = [{\"role\": \"system\", \"content\": SYSTEM},\n102\t                        {\"role\": \"user\", \"content\": f\"{assistant.context_text(calls)}\\n\\nЗадача: {goal}\"}]\n103\t            yield {\"type\": \"context\", \"calls\": calls, \"tools\": tools, \"prompt\": messages,\n104\t                   \"servers\": {name: assistant.server_info(client) for name, client in servers.items()},\n105\t                   \"seconds\": round(time.perf_counter() - started, 2)}\n106\t            # вызов → его запись: 4B-модель иногда повторяет тот же вызов. Ключ — с версией черновика: после\n107\t            # правки те же чтение и поиск дают новое, и проверить себя модели можно\n108\t            seen, version, checked = {}, 0, False\n109\t            while True:\n110\t                step += 1\n111\t                last = step > MAX_STEPS\n112\t                if last:\n113\t                    messages.append({\"role\": \"user\", \"content\": FINISH})\n114\t                yield {\"type\": \"thinking\", \"step\": step}\n115\t                async for event in turn(messages, None if last else specs):\n116\t                    if event[\"type\"] == \"text\":\n117\t                        yield event\n118\t                    else:\n119\t                        reply = event\n120\t                messages.append({\"role\": \"assistant\", \"content\": reply[\"text\"],\n121\t                                 **({\"tool_calls\": reply[\"calls\"]} if reply[\"calls\"] else {})})\n122\t                if not reply[\"calls\"]:\n123\t                    edited = any(r[\"ok\"] and r[\"tool\"] == \"edit_file\" for r in seen.values())\n124\t                    if edited and not checked and not last:\n125\t                        checked = True\n126\t                        messages.append({\"role\": \"user\", \"content\": CHECK})\n127\t                        yield {\"type\": \"check\", \"step\": step, \"text\": reply[\"text\"], \"llm\": reply[\"llm\"]}\n128\t                        continue\n129\t                    yield {\"type\": \"report\", \"step\": step, \"text\": reply[\"text\"], \"llm\": reply[\"llm\"]}\n130\t                    break\n131\t\n132\t                done = []\n133\t                for call in reply[\"calls\"]:\n134\t                    name, args = call[\"function\"][\"name\"], call[\"function\"].get(\"arguments\") or {}\n135\t                    key = json.dumps([name, args, version], sort_keys=True, ensure_ascii=False)\n136\t                    if name not in owners:\n137\t                        done.append({\"tool\": name, \"args\": args, \"ok\": False, \"result\": f\"Инструмента {name} нет\", \"ms\": 0})\n138\t                    elif key in seen:\n139\t                        before = seen[key]\n140\t                        done.append({\"tool\": name, \"args\": args, \"ok\": False, \"ms\": 0, \"result\":\n141\t                                     \"Этот вызов уже был, его результат выше. Сделай другой шаг или закончи.\" if before[\"ok\"]\n142\t                                     else f\"Этот вызов уже был и не прошёл: {before['result']} Исправь аргументы или закончи.\"})\n143\t                    else:\n144\t                        await assistant.call(servers[owners[name]], done, name, args)\n145\t                        done[-1][\"server\"] = owners[name]\n146\t                        seen[key] = done[-1]\n147\t                        version += done[-1][\"ok\"] and name in (\"edit_file\", \"write_file\")\n148\t                    messages.append({\"role\": \"tool\", \"tool_name\": name, \"content\": for_model(done[-1][\"result\"])})\n149\t                yield {\"type\": \"step\", \"step\": step, \"thought\": reply[\"text\"], \"calls\": done, \"llm\": reply[\"llm\"]}\n150\t\n151\t            draft = (await files.call_tool(\"draft_diff\", {})).structured_content\n152\t            yield {\"type\": \"draft\", **draft}\n153\t        yield {\"type\": \"done\", \"steps\": step, \"seconds\": round(time.perf_counter() - started, 1)}\n154\t    except llm.LLMError as exc:\n155\t        yield {\"type\": \"error\", \"step\": step, \"message\": str(exc)}\n156\t    except Exception as exc:  # MCP, git, файлы — словами, а не падением\n157\t        yield {\"type\": \"error\", \"step\": step, \"message\": assistant.reason(exc)}\n158\t\n159\t\n160\tasync def apply():\n161\t    \"\"\"Записать черновик в проект — по кнопке пользователя; git status после записи показывает, что файлы\n162\t    правда изменились.\"\"\"\n163\t    calls = []\n164\t    async with Client(config.FILES_MCP_URL, read_timeout_seconds=60) as files:\n165\t        written = await assistant.call(files, calls, \"apply_draft\", {})\n166\t    async with Client(config.MCP_URL, read_timeout_seconds=60) as git:\n167\t        status = await assistant.call(git, calls, \"git_status\", {})\n168\t    return {\"written\": written, \"status\": status, \"calls\": calls}\n169\t\n170\t\n171\tasync def discard():\n172\t    async with Client(config.FILES_MCP_URL, read_timeout_seconds=60) as files:\n173\t        return (await files.call_tool(\"discard_draft\", {})).structured_content\n174\t"}]},"parent_tool_use_id":null,"session_id":"c7fb8109-f3fd-4db1-89da-bdb17becddd6","uuid":"7f1e87a3-1fdb-4f35-b8db-cc114feb8fd0","timestamp":"2026-10-24T23:46:52.119Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\USER\\AppData\\Local\\Temp\\claude-rules\\loop-v2\\app\\files.py","content":"\"\"\"Ассистент по файлам проекта: задача словами → модель сама вызывает инструменты MCP — ищет, читает, правит\nи создаёт файлы → правки копятся в черновике → diff, который пользователь применяет или отменяет.\"\"\"\nimport json\nimport time\n\nfrom mcp import Client\n\nfrom app import assistant, config, llm\n\nSYSTEM = \"\"\"Ты — ассистент разработчика проекта ml-student-dropout: сервис на FastAPI и scikit-learn — API в src/api, модель в src/ml, схемы в src/schemas, дашборд в static/, тесты в tests/, документация в README.md и docs/. Задачу выполняешь сам через инструменты: ищешь, читаешь, правишь и создаёшь файлы проекта. Пользователя ни о чём не спрашивай.\nПравила:\n- Начинай с search, а не с чтения файлов целиком. Ищи так, как написано в файлах: имена функций, классов, констант, адреса эндпоинтов, числа, слова из документации; несколько вариантов — в одном запросе через |.\n- read_file — только строки вокруг найденного: start и end по номерам из search.\n- edit_file: old — точная строка из файла без номера, new — она же после правки; каждое место — отдельной правкой. Новый файл — write_file. Правки идут в черновик, на диск их запишет пользователь.\n- Меняй только то, что требует задача. Не выдумывай файлов, функций, чисел и фактов — бери только то, что видел в файлах и git; замеры (время, скорость, проценты) не пересчитывай.\nТиповые задачи:\n- «Где используется X» — search по всем вариантам имени (функция, класс, эндпоинт, русское название) и перечисли каждое место.\n- «Обнови документацию по изменениям в коде» — git_diff; по строкам «-» и «+» пойми, что было и что стало. Документация пишет значения, а не имена констант: поменялось число или строка — search прежнего значения по всему проекту. Поправь в README.md и docs/ каждое место с прежним значением, другие места не трогай. Перед отчётом — search прежнего значения ещё раз: в документации его не осталось.\n- «Составь CHANGELOG по истории» — git_log с oldest_first=true, затем write_file: «# Журнал изменений» и по строке на коммит в том же порядке — «- дата — что изменилось (хеш)», например «- дд.мм.гггг — Добавлена выгрузка отчёта в CSV (1a2b3c4)». Даты — как в git_log. Что изменилось — по сообщению и файлам коммита, по-русски своими словами; у общего сообщения вроде «init commit» — какие части сервиса появились, словами, без путей; термины вроде pull request и CI не переводи. Без других заголовков, списков файлов и чисел строк.\nКогда задача выполнена, ответь без вызова инструментов: коротко по-русски, что нашёл (`файл:строка`) и что изменил — только правки, которые прошли.\"\"\"\n\n# Что получает модель; apply_draft и discard_draft зовёт только код — по кнопке пользователя\nMODEL_TOOLS = {\"files\": [\"list_files\", \"read_file\", \"search\", \"edit_file\", \"write_file\"],\n               \"git\": [\"git_status\", \"git_diff\", \"git_log\"]}\nMAX_STEPS = 12  # ходов модели; дальше — просим подвести итог\nOPTIONS = {\"num_ctx\": 16384, \"num_predict\": 1500, \"seed\": 7}  # разговор с файлами длинный; seed — та же задача, тот же путь\nBLOCKS = {\"text\", \"diff\"}  # текст файла и diff модель получает как есть, а не строкой JSON\nFINISH = \"Шаги закончились. Не вызывай инструменты — коротко отчитайся: что нашёл и что изменил.\"\n# 4B-модель пропускает проверку из промпта; после правок код один раз просит её сам — что искать, решает модель\nCHECK = (\"Перед отчётом проверь себя: search того, что было до правки, по всему проекту — не осталось ли его в \"\n         \"документации. Осталось — поправь. Потом дай итоговый отчёт: что нашёл (`файл:строка`) и что изменил.\")\n\n\ndef spec(tool):\n    \"\"\"Инструмент MCP → функция для Ollama; заголовки из JSON Schema модели не нужны — лишние токены.\"\"\"\n    def clean(node):\n        if isinstance(node, dict):\n            return {k: clean(v) for k, v in node.items() if not (k == \"title\" and isinstance(v, str))}\n        return node\n    return {\"type\": \"function\",\n            \"function\": {\"name\": tool.name, \"description\": tool.description, \"parameters\": clean(tool.input_schema)}}\n\n\ndef for_model(result):\n    \"\"\"Результат инструмента — текстом: файл, совпадения и diff — строками как есть, список записей — по строке\n    на запись. В JSON кавычки экранируются, и модель копирует \\\\\" в правку, а по вложенному JSON 4B-модель\n    теряет порядок записей.\"\"\"\n    if not isinstance(result, dict):\n        return str(result)\n    head, blocks = {}, []\n    for key, value in result.items():\n        if key in BLOCKS and isinstance(value, str):\n            blocks.append(value)\n        elif isinstance(value, list) and value and all(isinstance(v, str) for v in value):\n            blocks.append(\"\\n\".join(value))\n        elif isinstance(value, list) and value and all(isinstance(v, dict) for v in value):\n            blocks.append(\"\\n\".join(\" · \".join(f\"{k}: {', '.join(map(str, v)) if isinstance(v, list) else v}\"\n                                               for k, v in item.items()) for item in value))\n        else:\n            head[key] = value\n    return \"\\n\".join([json.dumps(head, ensure_ascii=False), *blocks])\n\n\nasync def turn(messages, tools=None):\n    \"\"\"Один ход модели: текст потоком, в конце — {\"type\": \"turn\"} с текстом, вызовами и счётчиками.\"\"\"\n    text, calls, counters = \"\", [], {}\n    async for event in llm.chat(messages, options=OPTIONS, tools=tools):\n        if event[\"type\"] == \"text\":\n            text += event[\"text\"]\n            yield event\n        elif event[\"type\"] == \"tool_calls\":\n            calls += event[\"calls\"]\n        else:\n            counters = event\n    yield {\"type\": \"turn\", \"text\": text, \"calls\": calls, \"llm\": counters}\n\n\nasync def run(goal):\n    \"\"\"Работа над задачей событиями: goal → context → (thinking → text… → step)… → [check → ещё шаги] → report →\n    draft → done; ошибка — error.\"\"\"\n    yield {\"type\": \"goal\", \"goal\": goal}\n    started, step = time.perf_counter(), 0\n    try:\n        async with Client(config.FILES_MCP_URL, read_timeout_seconds=60) as files, \\\n                Client(config.MCP_URL, read_timeout_seconds=60) as git:\n            await files.call_tool(\"discard_draft\", {})  # неприменённые правки прошлой задачи сюда не смешиваем\n            servers = {\"files\": files, \"git\": git}\n\n            # контекст зовёт код: ветка, изменения и список файлов — чтобы модель не гадала пути\n            calls = []\n            await assistant.call(git, calls, \"git_branch\", {})\n            await assistant.call(git, calls, \"git_status\", {})\n            await assistant.call(files, calls, \"list_files\", {})\n            owners, specs, tools = {}, [], []\n            for name, client in servers.items():\n                for tool in (await client.list_tools()).tools:\n                    if tool.name in MODEL_TOOLS[name]:\n                        owners[tool.name] = name\n                        specs.append(spec(tool))\n                        tools.append({\"name\": tool.name, \"server\": name, \"description\": tool.description})\n            messages = [{\"role\": \"system\", \"content\": SYSTEM},\n                        {\"role\": \"user\", \"content\": f\"{assistant.context_text(calls)}\\n\\nЗадача: {goal}\"}]\n            yield {\"type\": \"context\", \"calls\": calls, \"tools\": tools, \"prompt\": messages,\n                   \"servers\": {name: assistant.server_info(client) for name, client in servers.items()},\n                   \"seconds\": round(time.perf_counter() - started, 2)}\n            # вызов → его запись: 4B-модель иногда повторяет тот же вызов. Ключ — с версией черновика: после\n            # правки те же чтение и поиск дают новое, и проверить себя модели можно\n            seen, version, checked = {}, 0, False\n            while True:\n                step += 1\n                last = step > MAX_STEPS\n                if last:\n                    messages.append({\"role\": \"user\", \"content\": FINISH})\n                yield {\"type\": \"thinking\", \"step\": step}\n                async for event in turn(messages, None if last else specs):\n                    if event[\"type\"] == \"text\":\n                        yield event\n                    else:\n                        reply = event\n                messages.append({\"role\": \"assistant\", \"content\": reply[\"text\"],\n                                 **({\"tool_calls\": reply[\"calls\"]} if reply[\"calls\"] else {})})\n                if not reply[\"calls\"]:\n                    edited = any(r[\"ok\"] and r[\"tool\"] == \"edit_file\" for r in seen.values())\n                    if edited and not checked and not last:\n                        checked = True\n                        messages.append({\"role\": \"user\", \"content\": CHECK})\n                        yield {\"type\": \"check\", \"step\": step, \"text\": reply[\"text\"], \"llm\": reply[\"llm\"]}\n                        continue\n                    yield {\"type\": \"report\", \"step\": step, \"text\": reply[\"text\"], \"llm\": reply[\"llm\"]}\n                    break\n\n                done = []\n                for call in reply[\"calls\"]:\n                    name, args = call[\"function\"][\"name\"], call[\"function\"].get(\"arguments\") or {}\n                    key = json.dumps([name, args, version], sort_keys=True, ensure_ascii=False)\n                    if name not in owners:\n                        done.append({\"tool\": name, \"args\": args, \"ok\": False, \"result\": f\"Инструмента {name} нет\", \"ms\": 0})\n                    elif key in seen:\n                        before = seen[key]\n                        done.append({\"tool\": name, \"args\": args, \"ok\": False, \"ms\": 0, \"result\":\n                                     \"Этот вызов уже был, его результат выше. Сделай другой шаг или закончи.\" if before[\"ok\"]\n                                     else f\"Этот вызов уже был и не прошёл: {before['result']} Исправь аргументы или закончи.\"})\n                    else:\n                        await assistant.call(servers[owners[name]], done, name, args)\n                        done[-1][\"server\"] = owners[name]\n                        seen[key] = done[-1]\n                        version += done[-1][\"ok\"] and name in (\"edit_file\", \"write_file\")\n                    messages.append({\"role\": \"tool\", \"tool_name\": name, \"content\": for_model(done[-1][\"result\"])})\n                yield {\"type\": \"step\", \"step\": step, \"thought\": reply[\"text\"], \"calls\": done, \"llm\": reply[\"llm\"]}\n\n            draft = (await files.call_tool(\"draft_diff\", {})).structured_content\n            yield {\"type\": \"draft\", **draft}\n        yield {\"type\": \"done\", \"steps\": step, \"seconds\": round(time.perf_counter() - started, 1)}\n    except llm.LLMError as exc:\n        yield {\"type\": \"error\", \"step\": step, \"message\": str(exc)}\n    except Exception as exc:  # MCP, git, файлы — словами, а не падением\n        yield {\"type\": \"error\", \"step\": step, \"message\": assistant.reason(exc)}\n\n\nasync def apply():\n    \"\"\"Записать черновик в проект — по кнопке пользователя; git status после записи показывает, что файлы\n    правда изменились.\"\"\"\n    calls = []\n    async with Client(config.FILES_MCP_URL, read_timeout_seconds=60) as files:\n        written = await assistant.call(files, calls, \"apply_draft\", {})\n    async with Client(config.MCP_URL, read_timeout_seconds=60) as git:\n        status = await assistant.call(git, calls, \"git_status\", {})\n    return {\"written\": written, \"status\": status, \"calls\": calls}\n\n\nasync def discard():\n    async with Client(config.FILES_MCP_URL, read_timeout_seconds=60) as files:\n        return (await files.call_tool(\"discard_draft\", {})).structured_content\n","numLines":174,"startLine":1,"totalLines":174}},"tool_result_meta":[{"id":"toolu_673da2a7162a474d8b49cf31","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
