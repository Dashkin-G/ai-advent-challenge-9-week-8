{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_dadec8dbdabd471ebfb90ba0","type":"tool_result","content":"1\t\"\"\"Тесты app/files_mcp.py: защита от путей вне проекта и в .git; черновик правок виден при чтении/поиске,\n2\tно не на диске; write_file создаёт только новый файл.\"\"\"\n3\timport json\n4\timport os\n5\timport re\n6\timport subprocess\n7\timport tempfile\n8\timport unittest\n9\tfrom pathlib import Path\n10\tfrom unittest.mock import patch\n11\t\n12\tfrom mcp.server.mcpserver.exceptions import ToolError\n13\t\n14\tfrom app import config, files_mcp, git_mcp\n15\t\n16\t\n17\tdef _init_git_repo(tmp):\n18\t    \"\"\"Инициализирует пустой git-репозиторий в tmp, возвращает путь.\"\"\"\n19\t    subprocess.run([\"git\", \"init\", \"-q\"], cwd=tmp, check=True)\n20\t    subprocess.run(\n21\t        [\"git\", \"-c\", \"user.name=test\", \"-c\", \"user.email=test@example.com\", \"commit\", \"-q\", \"--allow-empty\", \"-m\", \"init\"],\n22\t        cwd=tmp, check=True, capture_output=True\n23\t    )\n24\t    return Path(tmp)\n25\t\n26\t\n27\tclass TestPathValidation(unittest.TestCase):\n28\t    \"\"\"Защита от путей вне проекта и в папке .git.\"\"\"\n29\t\n30\t    def setUp(self):\n31\t        \"\"\"Создаёт временный git-репозиторий.\"\"\"\n32\t        self.tmp = tempfile.TemporaryDirectory()\n33\t        self.repo = _init_git_repo(self.tmp.name)\n34\t        self.dummy = self.repo / \"dummy.txt\"\n35\t        self.dummy.write_text(\"content\\n\", encoding=\"utf-8\")\n36\t\n37\t    def tearDown(self):\n38\t        \"\"\"Удаляет временный репозиторий.\"\"\"\n39\t        self.tmp.cleanup()\n40\t\n41\t    def test_path_outside_project(self):\n42\t        \"\"\"Путь ../x.txt — ToolError.\"\"\"\n43\t        with patch.object(config, 'PROJECT_DIR', self.repo):\n44\t            with self.assertRaises(ToolError) as ctx:\n45\t                files_mcp._rel(\"../x.txt\")\n46\t\n47\t        self.assertIn(\"вне проекта\", str(ctx.exception))\n48\t\n49\t    def test_path_in_git_folder(self):\n50\t        \"\"\"Путь .git/config — ToolError.\"\"\"\n51\t        with patch.object(config, 'PROJECT_DIR', self.repo):\n52\t            with self.assertRaises(ToolError) as ctx:\n53\t                files_mcp._rel(\".git/config\")\n54\t\n55\t        self.assertIn(\".git\", str(ctx.exception))\n56\t\n57\t    def test_valid_path_inside_project(self):\n58\t        \"\"\"Путь dummy.txt внутри проекта разрешён.\"\"\"\n59\t        with patch.object(config, 'PROJECT_DIR', self.repo):\n60\t            rel = files_mcp._rel(\"dummy.txt\")\n61\t\n62\t        self.assertEqual(rel, \"dummy.txt\")\n63\t\n64\t\n65\tclass TestEditFile(unittest.TestCase):\n66\t    \"\"\"edit_file пишет правку в черновик; она видна read_file и search, но не на диске.\"\"\"\n67\t\n68\t    def setUp(self):\n69\t        \"\"\"Создаёт временный git-репозиторий с файлом.\"\"\"\n70\t        self.tmp = tempfile.TemporaryDirectory()\n71\t        self.repo = _init_git_repo(self.tmp.name)\n72\t        self.test_file = self.repo / \"test.txt\"\n73\t        self.test_file.write_text(\"строка 1\\nстрока 2\\nстрока 3\\n\", encoding=\"utf-8\")\n74\t        # Очищаем черновик перед каждым тестом\n75\t        files_mcp.draft.clear()\n76\t\n77\t    def tearDown(self):\n78\t        \"\"\"Удаляет черновик и репозиторий.\"\"\"\n79\t        files_mcp.draft.clear()\n80\t        self.tmp.cleanup()\n81\t\n82\t    def test_edit_appears_in_read_file(self):\n83\t        \"\"\"Правка edit_file видна сразу в read_file.\"\"\"\n84\t        with patch.object(config, 'PROJECT_DIR', self.repo):\n85\t            result = files_mcp.edit_file(\"test.txt\", \"строка 2\", \"замена 2\")\n86\t\n87\t        self.assertIn(\"diff\", result)\n88\t        self.assertTrue(result[\"added\"] > 0 or result[\"removed\"] > 0)\n89\t\n90\t        with patch.object(config, 'PROJECT_DIR', self.repo):\n91\t            text_result = files_mcp.read_file(\"test.txt\")\n92\t        self.assertIn(\"замена 2\", text_result[\"text\"])\n93\t\n94\t    def test_edit_appears_in_search(self):\n95\t        \"\"\"Правка edit_file видна в search.\"\"\"\n96\t        with patch.object(config, 'PROJECT_DIR', self.repo):\n97\t            files_mcp.edit_file(\"test.txt\", \"строка 2\", \"новая строка\")\n98\t\n99\t        result = files_mcp.search(\"новая\")\n100\t        self.assertEqual(result[\"count\"], 1)\n101\t        self.assertIn(\"new_line\", result[\"matches\"][0].lower() if False else True)\n102\t\n103\t    def test_edit_not_on_disk(self):\n104\t        \"\"\"Правка edit_file НЕ записана на диск.\"\"\"\n105\t        original = self.test_file.read_text(encoding=\"utf-8\")\n106\t\n107\t        with patch.object(config, 'PROJECT_DIR', self.repo):\n108\t            files_mcp.edit_file(\"test.txt\", \"строка 2\", \"замена\")\n109\t\n110\t        disk_content = self.test_file.read_text(encoding=\"utf-8\")\n111\t        self.assertEqual(original, disk_content)\n112\t\n113\t    def test_edit_file_not_found(self):\n114\t        \"\"\"Редактирование несуществующего файла — ToolError.\"\"\"\n115\t        with patch.object(config, 'PROJECT_DIR', self.repo):\n116\t            with self.assertRaises(ToolError) as ctx:\n117\t                files_mcp.edit_file(\"nonexistent.txt\", \"текст\", \"замена\")\n118\t\n119\t        self.assertIn(\"такого файла нет\", str(ctx.exception).lower())\n120\t\n121\t\n122\tclass TestWriteFile(unittest.TestCase):\n123\t    \"\"\"write_file создаёт новый файл в черновике; записывать поверх существующего запрещено.\"\"\"\n124\t\n125\t    def setUp(self):\n126\t        \"\"\"Создаёт временный git-репозиторий с файлом.\"\"\"\n127\t        self.tmp = tempfile.TemporaryDirectory()\n128\t        self.repo = _init_git_repo(self.tmp.name)\n129\t        self.existing_file = self.repo / \"existing.txt\"\n130\t        self.existing_file.write_text(\"старое содержимое\\n\", encoding=\"utf-8\")\n131\t        files_mcp.draft.clear()\n132\t\n133\t    def tearDown(self):\n134\t        \"\"\"Удаляет черновик и репозиторий.\"\"\"\n135\t        files_mcp.draft.clear()\n136\t        self.tmp.cleanup()\n137\t\n138\t    def test_write_new_file(self):\n139\t        \"\"\"write_file создаёт новый файл в черновике.\"\"\"\n140\t        with patch.object(config, 'PROJECT_DIR', self.repo):\n141\t            result = files_mcp.write_file(\"new.txt\", \"новый текст\\n\")\n142\t\n143\t        self.assertTrue(result.get(\"created\"))\n144\t        self.assertEqual(result[\"lines\"], 1)\n145\t\n146\t        with patch.object(config, 'PROJECT_DIR', self.repo):\n147\t            text_result = files_mcp.read_file(\"new.txt\")\n148\t        self.assertIn(\"новый текст\", text_result[\"text\"])\n149\t\n150\t    def test_write_over_existing_fails(self):\n151\t        \"\"\"write_file поверх существующего файла — ToolError.\"\"\"\n152\t        with patch.object(config, 'PROJECT_DIR', self.repo):\n153\t            with self.assertRaises(ToolError) as ctx:\n154\t                files_mcp.write_file(\"existing.txt\", \"новое содержимое\")\n155\t\n156\t        self.assertIn(\"уже есть\", str(ctx.exception))\n157\t\n158\t    def test_write_creates_in_draft_not_disk(self):\n159\t        \"\"\"Файл write_file создаётся только в черновике, не на диске.\"\"\"\n160\t        with patch.object(config, 'PROJECT_DIR', self.repo):\n161\t            files_mcp.write_file(\"brand_new.txt\", \"содержимое\")\n162\t\n163\t        self.assertFalse((self.repo / \"brand_new.txt\").exists())\n164\t        self.assertIn(\"brand_new.txt\", files_mcp.draft)\n165\t\n166\t\n167\tclass TestDiscardDraft(unittest.TestCase):\n168\t    \"\"\"discard_draft очищает черновик.\"\"\"\n169\t\n170\t    def setUp(self):\n171\t        \"\"\"Создаёт репозиторий и добавляет правки в черновик.\"\"\"\n172\t        self.tmp = tempfile.TemporaryDirectory()\n173\t        self.repo = _init_git_repo(self.tmp.name)\n174\t        files_mcp.draft.clear()\n175\t\n176\t    def tearDown(self):\n177\t        \"\"\"Удаляет черновик и репозиторий.\"\"\"\n178\t        files_mcp.draft.clear()\n179\t        self.tmp.cleanup()\n180\t\n181\t    def test_discard_clears_draft(self):\n182\t        \"\"\"discard_draft удаляет все правки из черновика.\"\"\"\n183\t        with patch.object(config, 'PROJECT_DIR', self.repo):\n184\t            (self.repo / \"test.txt\").write_text(\"a\\n\", encoding=\"utf-8\")\n185\t            files_mcp.draft[\"test.txt\"] = \"modified content\"\n186\t\n187\t            result = files_mcp.discard_draft()\n188\t\n189\t        self.assertEqual(result[\"discarded\"], 1)\n190\t        self.assertEqual(len(files_mcp.draft), 0)\n191\t\n192\t\n193\tclass TestListFilesSearch(unittest.TestCase):\n194\t    \"\"\"list_files и search видят файлы черновика.\"\"\"\n195\t\n196\t    def setUp(self):\n197\t        \"\"\"Создаёт репозиторий с одним файлом.\"\"\"\n198\t        self.tmp = tempfile.TemporaryDirectory()\n199\t        self.repo = _init_git_repo(self.tmp.name)\n200\t        existing = self.repo / \"existing.txt\"\n201\t        existing.write_text(\"search me\\n\", encoding=\"utf-8\")\n202\t        files_mcp.draft.clear()\n203\t\n204\t    def tearDown(self):\n205\t        \"\"\"Удаляет черновик и репозиторий.\"\"\"\n206\t        files_mcp.draft.clear()\n207\t        self.tmp.cleanup()\n208\t\n209\t    def test_list_files_includes_draft(self):\n210\t        \"\"\"list_files включает новые файлы черновика.\"\"\"\n211\t        with patch.object(config, 'PROJECT_DIR', self.repo):\n212\t            files_mcp.draft[\"draft_only.txt\"] = \"content\"\n213\t            result = files_mcp.list_files()\n214\t\n215\t        self.assertIn(\"draft_only.txt\", result[\"files\"])\n216\t\n217\t    def test_search_includes_draft(self):\n218\t        \"\"\"search ищет по файлам черновика.\"\"\"\n219\t        with patch.object(config, 'PROJECT_DIR', self.repo):\n220\t            files_mcp.draft[\"search_test.txt\"] = \"unique word here\"\n221\t            result = files_mcp.search(\"unique\")\n222\t\n223\t        self.assertEqual(result[\"count\"], 1)\n224\t        self.assertIn(\"search_test.txt\", result[\"matches\"][0])\n225\t\n226\t\n227\tif __name__ == '__main__':\n228\t    unittest.main()\n229\t"}]},"parent_tool_use_id":null,"session_id":"3640ce19-2e9c-4811-bcf2-ee2281dfe9d0","uuid":"1dbd2be4-ea1f-4a7e-a65c-fda706d59093","timestamp":"2026-10-24T23:50:36.109Z","tool_use_result":{"type":"text","file":{"filePath":"C:\\Users\\USER\\AppData\\Local\\Temp\\claude-rules\\loop-v2\\tests\\test_files_mcp.py","content":"\"\"\"Тесты app/files_mcp.py: защита от путей вне проекта и в .git; черновик правок виден при чтении/поиске,\nно не на диске; write_file создаёт только новый файл.\"\"\"\nimport json\nimport os\nimport re\nimport subprocess\nimport tempfile\nimport unittest\nfrom pathlib import Path\nfrom unittest.mock import patch\n\nfrom mcp.server.mcpserver.exceptions import ToolError\n\nfrom app import config, files_mcp, git_mcp\n\n\ndef _init_git_repo(tmp):\n    \"\"\"Инициализирует пустой git-репозиторий в tmp, возвращает путь.\"\"\"\n    subprocess.run([\"git\", \"init\", \"-q\"], cwd=tmp, check=True)\n    subprocess.run(\n        [\"git\", \"-c\", \"user.name=test\", \"-c\", \"user.email=test@example.com\", \"commit\", \"-q\", \"--allow-empty\", \"-m\", \"init\"],\n        cwd=tmp, check=True, capture_output=True\n    )\n    return Path(tmp)\n\n\nclass TestPathValidation(unittest.TestCase):\n    \"\"\"Защита от путей вне проекта и в папке .git.\"\"\"\n\n    def setUp(self):\n        \"\"\"Создаёт временный git-репозиторий.\"\"\"\n        self.tmp = tempfile.TemporaryDirectory()\n        self.repo = _init_git_repo(self.tmp.name)\n        self.dummy = self.repo / \"dummy.txt\"\n        self.dummy.write_text(\"content\\n\", encoding=\"utf-8\")\n\n    def tearDown(self):\n        \"\"\"Удаляет временный репозиторий.\"\"\"\n        self.tmp.cleanup()\n\n    def test_path_outside_project(self):\n        \"\"\"Путь ../x.txt — ToolError.\"\"\"\n        with patch.object(config, 'PROJECT_DIR', self.repo):\n            with self.assertRaises(ToolError) as ctx:\n                files_mcp._rel(\"../x.txt\")\n\n        self.assertIn(\"вне проекта\", str(ctx.exception))\n\n    def test_path_in_git_folder(self):\n        \"\"\"Путь .git/config — ToolError.\"\"\"\n        with patch.object(config, 'PROJECT_DIR', self.repo):\n            with self.assertRaises(ToolError) as ctx:\n                files_mcp._rel(\".git/config\")\n\n        self.assertIn(\".git\", str(ctx.exception))\n\n    def test_valid_path_inside_project(self):\n        \"\"\"Путь dummy.txt внутри проекта разрешён.\"\"\"\n        with patch.object(config, 'PROJECT_DIR', self.repo):\n            rel = files_mcp._rel(\"dummy.txt\")\n\n        self.assertEqual(rel, \"dummy.txt\")\n\n\nclass TestEditFile(unittest.TestCase):\n    \"\"\"edit_file пишет правку в черновик; она видна read_file и search, но не на диске.\"\"\"\n\n    def setUp(self):\n        \"\"\"Создаёт временный git-репозиторий с файлом.\"\"\"\n        self.tmp = tempfile.TemporaryDirectory()\n        self.repo = _init_git_repo(self.tmp.name)\n        self.test_file = self.repo / \"test.txt\"\n        self.test_file.write_text(\"строка 1\\nстрока 2\\nстрока 3\\n\", encoding=\"utf-8\")\n        # Очищаем черновик перед каждым тестом\n        files_mcp.draft.clear()\n\n    def tearDown(self):\n        \"\"\"Удаляет черновик и репозиторий.\"\"\"\n        files_mcp.draft.clear()\n        self.tmp.cleanup()\n\n    def test_edit_appears_in_read_file(self):\n        \"\"\"Правка edit_file видна сразу в read_file.\"\"\"\n        with patch.object(config, 'PROJECT_DIR', self.repo):\n            result = files_mcp.edit_file(\"test.txt\", \"строка 2\", \"замена 2\")\n\n        self.assertIn(\"diff\", result)\n        self.assertTrue(result[\"added\"] > 0 or result[\"removed\"] > 0)\n\n        with patch.object(config, 'PROJECT_DIR', self.repo):\n            text_result = files_mcp.read_file(\"test.txt\")\n        self.assertIn(\"замена 2\", text_result[\"text\"])\n\n    def test_edit_appears_in_search(self):\n        \"\"\"Правка edit_file видна в search.\"\"\"\n        with patch.object(config, 'PROJECT_DIR', self.repo):\n            files_mcp.edit_file(\"test.txt\", \"строка 2\", \"новая строка\")\n\n        result = files_mcp.search(\"новая\")\n        self.assertEqual(result[\"count\"], 1)\n        self.assertIn(\"new_line\", result[\"matches\"][0].lower() if False else True)\n\n    def test_edit_not_on_disk(self):\n        \"\"\"Правка edit_file НЕ записана на диск.\"\"\"\n        original = self.test_file.read_text(encoding=\"utf-8\")\n\n        with patch.object(config, 'PROJECT_DIR', self.repo):\n            files_mcp.edit_file(\"test.txt\", \"строка 2\", \"замена\")\n\n        disk_content = self.test_file.read_text(encoding=\"utf-8\")\n        self.assertEqual(original, disk_content)\n\n    def test_edit_file_not_found(self):\n        \"\"\"Редактирование несуществующего файла — ToolError.\"\"\"\n        with patch.object(config, 'PROJECT_DIR', self.repo):\n            with self.assertRaises(ToolError) as ctx:\n                files_mcp.edit_file(\"nonexistent.txt\", \"текст\", \"замена\")\n\n        self.assertIn(\"такого файла нет\", str(ctx.exception).lower())\n\n\nclass TestWriteFile(unittest.TestCase):\n    \"\"\"write_file создаёт новый файл в черновике; записывать поверх существующего запрещено.\"\"\"\n\n    def setUp(self):\n        \"\"\"Создаёт временный git-репозиторий с файлом.\"\"\"\n        self.tmp = tempfile.TemporaryDirectory()\n        self.repo = _init_git_repo(self.tmp.name)\n        self.existing_file = self.repo / \"existing.txt\"\n        self.existing_file.write_text(\"старое содержимое\\n\", encoding=\"utf-8\")\n        files_mcp.draft.clear()\n\n    def tearDown(self):\n        \"\"\"Удаляет черновик и репозиторий.\"\"\"\n        files_mcp.draft.clear()\n        self.tmp.cleanup()\n\n    def test_write_new_file(self):\n        \"\"\"write_file создаёт новый файл в черновике.\"\"\"\n        with patch.object(config, 'PROJECT_DIR', self.repo):\n            result = files_mcp.write_file(\"new.txt\", \"новый текст\\n\")\n\n        self.assertTrue(result.get(\"created\"))\n        self.assertEqual(result[\"lines\"], 1)\n\n        with patch.object(config, 'PROJECT_DIR', self.repo):\n            text_result = files_mcp.read_file(\"new.txt\")\n        self.assertIn(\"новый текст\", text_result[\"text\"])\n\n    def test_write_over_existing_fails(self):\n        \"\"\"write_file поверх существующего файла — ToolError.\"\"\"\n        with patch.object(config, 'PROJECT_DIR', self.repo):\n            with self.assertRaises(ToolError) as ctx:\n                files_mcp.write_file(\"existing.txt\", \"новое содержимое\")\n\n        self.assertIn(\"уже есть\", str(ctx.exception))\n\n    def test_write_creates_in_draft_not_disk(self):\n        \"\"\"Файл write_file создаётся только в черновике, не на диске.\"\"\"\n        with patch.object(config, 'PROJECT_DIR', self.repo):\n            files_mcp.write_file(\"brand_new.txt\", \"содержимое\")\n\n        self.assertFalse((self.repo / \"brand_new.txt\").exists())\n        self.assertIn(\"brand_new.txt\", files_mcp.draft)\n\n\nclass TestDiscardDraft(unittest.TestCase):\n    \"\"\"discard_draft очищает черновик.\"\"\"\n\n    def setUp(self):\n        \"\"\"Создаёт репозиторий и добавляет правки в черновик.\"\"\"\n        self.tmp = tempfile.TemporaryDirectory()\n        self.repo = _init_git_repo(self.tmp.name)\n        files_mcp.draft.clear()\n\n    def tearDown(self):\n        \"\"\"Удаляет черновик и репозиторий.\"\"\"\n        files_mcp.draft.clear()\n        self.tmp.cleanup()\n\n    def test_discard_clears_draft(self):\n        \"\"\"discard_draft удаляет все правки из черновика.\"\"\"\n        with patch.object(config, 'PROJECT_DIR', self.repo):\n            (self.repo / \"test.txt\").write_text(\"a\\n\", encoding=\"utf-8\")\n            files_mcp.draft[\"test.txt\"] = \"modified content\"\n\n            result = files_mcp.discard_draft()\n\n        self.assertEqual(result[\"discarded\"], 1)\n        self.assertEqual(len(files_mcp.draft), 0)\n\n\nclass TestListFilesSearch(unittest.TestCase):\n    \"\"\"list_files и search видят файлы черновика.\"\"\"\n\n    def setUp(self):\n        \"\"\"Создаёт репозиторий с одним файлом.\"\"\"\n        self.tmp = tempfile.TemporaryDirectory()\n        self.repo = _init_git_repo(self.tmp.name)\n        existing = self.repo / \"existing.txt\"\n        existing.write_text(\"search me\\n\", encoding=\"utf-8\")\n        files_mcp.draft.clear()\n\n    def tearDown(self):\n        \"\"\"Удаляет черновик и репозиторий.\"\"\"\n        files_mcp.draft.clear()\n        self.tmp.cleanup()\n\n    def test_list_files_includes_draft(self):\n        \"\"\"list_files включает новые файлы черновика.\"\"\"\n        with patch.object(config, 'PROJECT_DIR', self.repo):\n            files_mcp.draft[\"draft_only.txt\"] = \"content\"\n            result = files_mcp.list_files()\n\n        self.assertIn(\"draft_only.txt\", result[\"files\"])\n\n    def test_search_includes_draft(self):\n        \"\"\"search ищет по файлам черновика.\"\"\"\n        with patch.object(config, 'PROJECT_DIR', self.repo):\n            files_mcp.draft[\"search_test.txt\"] = \"unique word here\"\n            result = files_mcp.search(\"unique\")\n\n        self.assertEqual(result[\"count\"], 1)\n        self.assertIn(\"search_test.txt\", result[\"matches\"][0])\n\n\nif __name__ == '__main__':\n    unittest.main()\n","numLines":229,"startLine":1,"totalLines":229}},"tool_result_meta":[{"id":"toolu_dadec8dbdabd471ebfb90ba0","permission_decision":{"decision":"accept","source":"config","reason_type":"mode"}}]}
