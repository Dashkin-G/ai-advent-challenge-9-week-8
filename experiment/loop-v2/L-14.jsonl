{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_413a470ef6044dbfaf8d6aef","type":"tool_result","content":"1\t\"\"\"Тесты app/crm_mcp.py: list_tickets, get_ticket, get_user, find_tickets.\"\"\"\n2\timport json\n3\timport os\n4\timport tempfile\n5\timport unittest\n6\tfrom pathlib import Path\n7\tfrom unittest.mock import patch\n8\t\n9\tfrom mcp.server.mcpserver.exceptions import ToolError\n10\t\n11\tfrom app import crm_mcp\n12\t\n13\t\n14\tclass TestListTickets(unittest.TestCase):\n15\t    \"\"\"list_tickets возвращает открытые обращения новыми сверху; include_closed=True — все.\"\"\"\n16\t\n17\t    def setUp(self):\n18\t        \"\"\"Подготовка временного CRM-файла.\"\"\"\n19\t        self.crm_data = {\n20\t            \"users\": [\n21\t                {\"id\": \"U-01\", \"name\": \"Иван Петров\", \"org\": \"МГУ\"},\n22\t                {\"id\": \"U-02\", \"name\": \"Анна Сидорова\", \"org\": \"СПбГУ\"},\n23\t            ],\n24\t            \"tickets\": [\n25\t                {\"id\": \"T-1001\", \"user_id\": \"U-01\", \"subject\": \"Проблема 1\", \"message\": \"Сообщение 1\",\n26\t                 \"status\": \"открыт\", \"priority\": \"высокий\", \"created\": \"2024-01-01T10:00:00\"},\n27\t                {\"id\": \"T-1002\", \"user_id\": \"U-02\", \"subject\": \"Проблема 2\", \"message\": \"Сообщение 2\",\n28\t                 \"status\": \"решён\", \"priority\": \"средний\", \"created\": \"2024-01-02T11:00:00\"},\n29\t                {\"id\": \"T-1003\", \"user_id\": \"U-01\", \"subject\": \"Проблема 3\", \"message\": \"Сообщение 3\",\n30\t                 \"status\": \"открыт\", \"priority\": \"низкий\", \"created\": \"2024-01-03T12:00:00\"},\n31\t            ]\n32\t        }\n33\t        self.temp_file = tempfile.NamedTemporaryFile(mode='w', suffix='.json', delete=False)\n34\t        json.dump(self.crm_data, self.temp_file, ensure_ascii=False)\n35\t        self.temp_file.close()\n36\t\n37\t    def tearDown(self):\n38\t        \"\"\"Уда