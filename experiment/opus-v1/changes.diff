+async def find(query, top=config.TOP):
+    """Фрагменты документации по запросу и время поиска — без модели ответа, только векторы bge-m3."""
+    started = time.perf_counter()
+    hits = await search(query, top)
+    return {"query": query, "hits": [{"file": h["file"], "title": h["title"], "score": h["score"], "text": h["text"]}
+                                     for h in hits], "seconds": round(time.perf_counter() - started, 2)}
