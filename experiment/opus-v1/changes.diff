+@app.get("/api/search")
+async def search(q: str = "", top: int = config.TOP):
+    """Фрагменты документации по запросу и секунды поиска — без модели ответа, только векторы."""
+    query = q.strip()
+    if not query:
+        raise HTTPException(status_code=400, detail="Напишите запрос: /api/search?q=<что найти в документации>")
+    if not 1 <= top <= config.SEARCH_TOP:
+        raise HTTPException(status_code=400, detail=f"top — от 1 до {config.SEARCH_TOP} фрагментов")
+    try:
+        return await rag.find(query, top)
+    except (llm.LLMError, FileNotFoundError) as exc:
+        raise HTTPException(status_code=503, detail=str(exc))
