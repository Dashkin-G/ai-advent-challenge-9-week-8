+"""Тесты app/support.py: контекст обращения для модели и запросы к базе знаний."""
+import unittest
+from pathlib import Path
+
+from app import support
+
+
+class QueriesTest(unittest.TestCase):
+    """Функция queries формирует список запросов к базе знаний."""
+
+    def test_question_only(self):
+        """При отсутствии ticket возвращается только вопрос."""
+        self.assertEqual(support.queries("Почему ошибка?", None), ["Почему ошибка?"])
+
+    def test_question_and_error_details(self):
+        """В запросах — вопрос и текст ошибки сервиса из обращения."""
+        ticket = {"technical": {"Ответ сервиса": {"code": 422, "details": "body: ошибка валидации"}}}
+        result = support.queries("Почему 422?", ticket)
+        self.assertEqual(result, ["Почему 422?", "body: ошибка валидации"])
+
+    def test_multiple_errors_deduplicated(self):
+        """Повторяющиеся details удаляются из запросов."""
+        ticket = {
+            "technical": {
+                "Ошибка 1": {"code": 400, "details": "bad request"},
+                "Ошибка 2": {"code": 500, "details": "bad request"},
+            }
+        }
+        result = support.queries("Что случилось?", ticket)
+        self.assertEqual(len(result), 2)  # вопрос + один unique error
+        self.assertIn("bad request", result)
+
+    def test_no_details_ignored(self):
+        """Поля technical без ключа details игнорируются."""
+        ticket = {"technical": {"Log": "something happened", "NoError": {"code": 500}}}
+        result = support.queries("Проверка?", ticket)
+        self.assertEqual(result, ["Проверка?"])
+
+
+class ContextTextTest(unittest.TestCase):
+    """Функция context_text форматирует контекст клиента и обращения для промпта."""
+
+    def setUp(self):
+        """Подготавливаем тестовые данные."""
+        self.ticket = {
+            "id": "T-1041",
+            "subject": "Ошибка при вызове API",
+            "status": "open",
+            "priority": "high",
+            "created": "21.10.2026",
+            "message": "Не могу получить векторы.",
+            "user_id": "U-01",
+            "technical": {"Запрос": {"method": "POST", "url": "/api/embed"}},
+        }
+        self.user = {
+            "name": "Иван Петров",
+            "role": "Data Scientist",
+            "org": "МГУ",
+            "channel": "API",
+            "setup": "Docker container",
+            "notes": "Использует API с июля",
+            "tickets": [
+                {"id": "T-1001", "subject": "Вопрос по документации", "status": "решён", "resolution": "Объяснили endpoint"},
+                {"id": "T-1030", "subject": "Ошибка авторизации", "status": "open"},
+            ],
+        }
+
+    def test_basic_context(self):
+        """Базовый контекст содержит клиента и обращение."""
+        result = support.context_text(self.ticket, self.user)
+        self.assertIn("Клиент: Иван Петров", result)
+        self.assertIn("Обращение T-1041", result)
+
+    def test_user_notes_included(self):
+        """Заметки поддержки включаются в контекст."""
+        result = support.context_text(self.ticket, self.user)
+        self.assertIn("Заметки поддержки: Использует API с июля", result)
+
+    def test_past_tickets_shown(self):
+        """Прошлые обращения показываются в контексте."""
+        result = support.context_text(self.ticket, self.user)
+        self.assertIn("T-1001", result)
+        self.assertIn("T-1030", result)
+        self.assertIn("прошлые", result.lower() if hasattr(result, 'lower') else "")
+
+    def test_technical_data_included(self):
+        """Технические данные обращения включаются."""
+        result = support.context_text(self.ticket, self.user)
+        self.assertIn("Технические данные обращения:", result)
+        self.assertIn("Запрос", result)
+
+
+class EnsureIndexTest(unittest.TestCase):
+    """Функция ensure_index строит индекс базы знаний."""
+
+    def setUp(self):
+        """Создаём временную папку с FAQ."""
+        self.tmp = Path(__file__).parent / ".." / ".tmp-test-support"
+        self.tmp.mkdir(exist_ok=True)
+        (self.tmp / "faq.md").write_text("# FAQ\n## Вопрос\nОтвет на вопрос.\n", encoding="utf-8")
+        self.original_faq = support.config.FAQ
+        self.original_project = support.config.PROJECT_DIR
+        support.config.FAQ = self.tmp / "faq.md"
+        support.config.PROJECT_DIR = self.tmp
+
+    def tearDown(self):
+        """Восстанавливаем оригинальные настройки."""
+        import shutil
+        if self.tmp.exists():
+            shutil.rmtree(self.tmp)
+        support.config.FAQ = self.original_faq
+        support.config.PROJECT_DIR = self.original_project
+
+    def test_builds_with_valid_faq(self):
+        """Индекс успешно строится при наличии FAQ."""
+        import asyncio
+        info = asyncio.run(support.ensure_index())
+        self.assertIn("files", info)
+        self.assertIn("chunks", info)
+
+
+if __name__ == "__main__":
+    unittest.main()
