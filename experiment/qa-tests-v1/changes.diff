+"""Тесты app/assistant.py: парсинг запросов /help, форматирование событий и обработка ошибок."""
+import unittest
+
+from app import assistant
+
+
+class ParseTest(unittest.TestCase):
+    """Функция parse извлекает вопрос из команды /help."""
+
+    def test_overview_without_question(self):
+        """Только '/help' возвращает общий вопрос о проекте."""
+        self.assertEqual(assistant.parse("/help"), assistant.OVERVIEW)
+
+    def test_question_extracted(self):
+        """Вопрос после '/help ' извлекается корректно."""
+        self.assertEqual(assistant.parse("/help Как запустить проект?"), "Как запустить проект?")
+        self.assertEqual(assistant.parse("/help  Что такое RAG?"), "Что такое RAG?")
+
+    def test_none_when_not_help(self):
+        """Любой текст без '/help' возвращает None."""
+        self.assertIsNone(assistant.parse("Привет"))
+        self.assertIsNone(assistant.parse(""))
+        self.assertIsNone(assistant.parse("Какой вариант помощи нужен?"))
+
+    def test_whitespace_stripped(self):
+        """Избыточные пробелы убираются."""
+        self.assertEqual(assistant.parse("   /help   Вопрос   "), "Вопрос")
+
+
+class DumpsTest(unittest.TestCase):
+    """Функция dumps сериализует события в NDJSON."""
+
+    def test_simple_event(self):
+        """Простое событие превращается в строку JSON с переводом строки."""
+        event = {"type": "question", "text": "тест"}
+        result = assistant.dumps(event)
+        self.assertTrue(result.endswith("\n"))
+        self.assertIn('"type": "question"', result)
+
+    def test_unicode_preserved(self):
+        """Кириллица сохраняется без экранирования."""
+        event = {"message": "Ошибка на русском"}
+        result = assistant.dumps(event)
+        self.assertIn("Ошибка на русском", result)
+        self.assertNotIn("\\u043e\\u0448", result.lower())  # не должно быть unicode-эскейпов
+
+    def test_nested_structure(self):
+        """Вложенные структуры правильно сериализуются."""
+        event = {"data": {"nested": [1, 2, 3]}, "count": 42}
+        result = assistant.dumps(event)
+        self.assertIn('[1, 2, 3]', result)
+
+
+class ReasonTest(unittest.TestCase):
+    """Функция reason преобразует исключения в читаемые сообщения."""
+
+    def test_exception_with_message_attr(self):
+        """Исключение с атрибутом message возвращает его текст."""
+        class MockExc(Exception):
+            message = "Особая ошибка"
+        self.assertEqual(assistant.reason(MockExc()), "Особая ошибка")
+
+    def test_regular_exception(self):
+        """Обычное исключение возвращает str()."""
+        exc = ValueError("что-то пошло не так")
+        self.assertEqual(assistant.reason(exc), "что-то пошло не так")
+
+    def test_string_conversion(self):
+        """Если нет ничего, используется str()."""
+        exc = Exception()
+        result = assistant.reason(exc)
+        self.assertIsInstance(result, str)
+
+
+class ServerInfoTest(unittest.TestCase):
+    """Функция server_info извлекает информацию о сервере MCP."""
+
+    def test_server_info_present(self):
+        """Информация о сервере читается из client.server_info."""
+        from mcp import ClientSession
+
+        class MockServerInfo:
+            name = "test-server"
+            version = "1.2.3"
+
+        class MockClient:
+            protocol_version = "2025-06-01"
+            server_info = MockServerInfo()
+
+        info = assistant.server_info(MockClient())
+        self.assertEqual(info["name"], "test-server")
+        self.assertEqual(info["version"], "1.2.3")
+        self.assertEqual(info["protocol"], "2025-06-01")
+
+    def test_missing_server_info(self):
+        """При отсутствии server_info ставятся знаки вопроса."""
+        class MockClient:
+            protocol_version = "2025-01-01"
+            server_info = None
+
+        info = assistant.server_info(MockClient())
+        self.assertEqual(info["name"], "?")
+        self.assertEqual(info["version"], "")
+
+
+class ContextTextTest(unittest.TestCase):
+    """Функция context_text форматирует результаты вызовов MCP."""
+
+    def test_branch_included(self):
+        """Информация о ветке включается в контекст."""
+        calls = [{"tool": "git_branch", "ok": True, "result": {
+            "branch": "main", "branches": ["main", "dev"], "last_commit": "abc123 fix"}}]
+        result = assistant.context_text(calls)
+        self.assertIn("Текущая ветка: main", result)
+        self.assertIn("main, dev", result) or self.assertIn("main", result)
+
+    def test_clean_status_message(self):
+        """При чистом статусе git сообщается об отсутствии изменений."""
+        calls = [{"tool": "git_branch", "ok": True, "result": {"branch": "main", "branches": ["main"], "last_commit": "abc fix"}},
+                 {"tool": "git_status", "ok": True, "result": {"clean": True, "count": 0, "changed": []}}]
+        result = assistant.context_text(calls)
+        self.assertIn("Незакоммиченных изменений нет", result)
+
+    def test_changed_files_grouped(self):
+        """Изменённые файлы группируются по статусу."""
+        calls = [{"tool": "git_branch", "ok": True, "result": {"branch": "dev", "branches": ["main", "dev"], "last_commit": "xyz feature"}},
+                 {"tool": "git_status", "ok": True, "result": {
+                     "clean": False,
+                     "count": 3,
+                     "changed": [
+                         {"path": "app/main.py", "status": "изменён"},
+                         {"path": "app/test.py", "status": "новый"},
+                         {"path": "docs/readme.md", "status": "изменён"},
+                     ]}}]
+        result = assistant.context_text(calls)
+        self.assertIn("изменены", result)
+        self.assertIn("новые", result)
+
+
+if __name__ == "__main__":
+    unittest.main()
