{"type":"assistant","message":{"id":"msg_85f0924e-40b9-9db0-afa7-873a6576c3e4","type":"message","role":"assistant","model":"qwen3.5-122b-a10b","content":[{"type":"tool_use","id":"toolu_6969eed17a2a49c585f88bc3","name":"Write","input":{"file_path":"C:\\Users\\USER\\AppData\\Local\\Temp\\claude-rules\\loop-v1\\tests\\test_review.py","content":"\"\"\"Тесты app/review.py — склонение слов и форматирование чисел.\"\"\"\nimport unittest\n\nfrom app import review\n\n\nclass TestCount(unittest.TestCase):\n    \"\"\"count(n, words) — склонение слов: 1 файл, 2 файла, 5 файлов.\"\"\"\n\n    def test_count_singular(self):\n        \"\"\"Единственное число: 1, 21, 101.\"\"\"\n        words = (\"файл\", \"файла\", \"файлов\")\n        self.assertEqual(review.count(1, words), \"1 файл\")\n        self.assertEqual(review.count(21, words), \"21 файл\")\n        self.assertEqual(review.count(101, words), \"101 файл\")\n        self.assertEqual(review.count(111, words), \"111 файлов\")  # 111 — исключения\n\n    def test_count_few(self):\n        \"\"\"Редкое число: 2–4, 22–24.\"\"\"\n        words = (\"фрагмент\", \"фрагмента\", \"фрагментов\")\n        self.assertEqual(review.count(2, words), \"2 фрагмента\")\n        self.assertEqual(review.count(3, words), \"3 фрагмента\")\n        self.assertEqual(review.count(4, words), \"4 фрагмента\")\n        self.assertEqual(review.count(22, words), \"22 фрагмента\")\n        self.assertEqual(review.count(24, words), \"24 фрагмента\")\n\n    def test_count_many(self):\n        \"\"\"Множественное число: 5–20, 25–30.\"\"\"\n        words = (\"токен\", \"токена\", \"токенов\")\n        self.assertEqual(review.count(5, words), \"5 токенов\")\n        self.assertEqual(review.count(10, words), \"10 токенов\")\n        self.assertEqual(review.count(20, words), \"20 токенов\")\n        self.assertEqual(review.count(25, words), \"25 токенов\")\n\n    def test_count_teens_exception(self):\n        \"\"\"Исключение 11–14: всегда множественное.\"\"\"\n        words = (\"файл\", \"файла\", \"файлов\")\n        self.assertEqual(review.count(11, words), \"11 файлов\")\n        self.assertEqual(review.count(12, words), \"12 файлов\")\n        self.assertEqual(review.count(13, words), \"13 файлов\")\n        self.assertEqual(review.count(14, words), \"14 файлов\")\n        self.assertEqual(review.count(112, words), \"112 файлов\")\n        self.assertEqual(review.count(114, words), \"114 файлов\")\n\n\nclass TestNumber(unittest.TestCase):\n    \"\"\"number(x, digits) — форматирование чисел: пробел между тысячами, запятая вместо точки.\"\"\"\n\n    def test_number_thousands_separator(self):\n        \"\"\"Пробел между тысячами.\"\"\"\n        self.assertEqual(review.number(1000, 0), \"1 000\")\n        self.assertEqual(review.number(1234, 0), \"1 234\")\n        self.assertEqual(review.number(1234567, 0), \"1 234 567\")\n\n    def test_number_decimal_comma(self):\n        \"\"\"Запятая вместо точки.\"\"\"\n        self.assertEqual(review.number(1234.5, 1), \"1 234,5\")\n        self.assertEqual(review.number(0.5, 1), \"0,5\")\n        self.assertEqual(review.number(3.14159, 2), \"3,14\")\n\n    def test_number_digits_format(self):\n        \"\"\"digits контролирует количество знаков после запятой.\"\"\"\n        self.assertEqual(review.number(1.234, 0), \"1\")\n        self.assertEqual(review.number(1.234, 1), \"1,2\")\n        self.assertEqual(review.number(1.234, 2), \"1,23\")\n        self.assertEqual(review.number(1.234, 3), \"1,234\")\n\n\nif __name__ == \"__main__\":\n    unittest.main()\n"}}],"stop_reason":null,"stop_sequence":null,"usage":{"input_tokens":17775,"output_tokens":0},"context_management":null},"parent_tool_use_id":null,"session_id":"c5d79d30-f805-41b8-b1da-5977cb188b56","uuid":"f8eefcb3-f6b4-4089-a6c2-f88219819b4a","timestamp":"2026-10-24T22:34:20.514Z"}
